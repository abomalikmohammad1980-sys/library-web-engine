لَى وَزْنِ: (مُؤَفْعَلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (رسل) .\n\nإِلَّا: {إِلَّا} : حَرْفٌ مَبْنِيٌّ.\n\nمُبَشِّرِينَ: {مُبَشِّرِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُبَشِّرٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (بَشَّرَ) ، مِنْ بَابِ: (فَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْمِيمِ وَحَرْفٍ مُضَعَّفٍ، عَلَى وَزْنِ: (مُفَعِّلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (بشر) .\n\nوَمُنْذِرِينَ: {مُنْذِرِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُنْذِرٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَنْذَرَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَنْذِرٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (نذر) .\n\nوَيُجَادِلُ: {يُجَادِلُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ وَالْيَاءِ، مِنْ بَابِ: (فَاعَلَ) ، عَلَى وَزْنِ: (يُفَاعِلُ) ، مِنْ مَادَّةِ: (جدل) .\n\nالَّذِينَ: {الَّذِينَ} : اسْمٌ مَبْنِيٌّ.\n\nكَفَرُوا: {كَفَرُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (كفر) .\n\nبِالْبَاطِلِ: {الْبَاطِلِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (بَطَلَ يَبْطُلُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (بطل) .\n\nلِيُدْحِضُوا: {يُدْحِضُوا} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَدْحِضُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (دحض) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nالْحَقَّ: {الْحَقَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حقق) .\n\nوَاتَّخَذُوا: {اتَّخَذُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (اأْتَخَذَ) ، عَلَى وَزْنِ: (افْتَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ يَاءً لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، وَفِيهِ إِبْدَالُ حَرْفِ: الْيَاءِ تَاءً، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أخذ) .\n\nآيَاتِي: {آيَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (آيَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (أَيَيٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (أيي) .\n\nوَمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nأُنْذِرُوا: {أُنْذِرُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أُفْعِلَ) ، مِنْ مَادَّةِ: (نذر) .\n\nهُزُوًا: {هُزُوًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (هَزَأَ يَهْزَأُ) ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعُلٌ) ، مِنْ مَادَّةِ: (هزأ) .","words":[{"wordId":38426,"position":1,"word":"وَمَا","text":"{مَا} : حَرْفٌ مَبْنِيٌّ."},{"wordId":38427,"position":2,"word":"نُرْسِلُ","text":"{نُرْسِلُ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: النُّونِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (نُؤَرْسِلُ) ، عَلَى وَزْنِ: (نُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (رسل) ."},{"wordId":38428,"position":3,"word":"الْ