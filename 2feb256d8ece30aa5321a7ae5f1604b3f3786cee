َرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، مِنْ مَادَّةِ: (غرب) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nعَيْنٍ: {عَيْنٍ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (عين) .\n\nحَمِئَةٍ: {حَمِئَةٍ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فَعِلَةٌ) ، مِنْ مَادَّةِ: (حمأ) .\n\nوَوَجَدَ: {وَجَدَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (وجد) .\n\nعِنْدَهَا: {عِنْدَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (عند) .\n\nقَوْمًا: {قَوْمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nقُلْنَا: {قُلْنَا} : فِعْلٌ مَاضٍ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (قول) .\n\nيَاذَا: {يَا} : حَرْفٌ مَبْنِيٌّ، {ذَا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، أَصْلُهُ: (ذَوَيٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (ذو) .\n\nالْقَرْنَيْنِ: {الْقَرْنَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُثَنًّى، مُفْرَدُهُ: (قَرْنٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قرن) .\n\nإِمَّا: {إِمَّا} : حَرْفٌ مَبْنِيٌّ.\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nتُعَذِّبَ: {تُعَذِّبَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (تُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَ