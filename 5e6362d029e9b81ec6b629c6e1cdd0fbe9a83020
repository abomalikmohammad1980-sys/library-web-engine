يٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (دعو) .\n\nلِتَغْفِرَ: {تَغْفِرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (تَفْعِلُ) ، مِنْ مَادَّةِ: (غفر) .\n\nلَهُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nجَعَلُوا: {جَعَلُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nأَصَابِعَهُمْ: {أَصَابِعَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (إِصْبَعٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفَاعِلُ) ، مِنْ مَادَّةِ: (صبع) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nآذَانِهِمْ: {آذَانِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (أُذُنٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، أَصْلُهُ: (أَأْذَانٌ) ، عَلَى وَزْنِ: (أَفْعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أذن) .\n\nوَاسْتَغْشَوْا: {اسْتَغْشَوْا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، سُدَاسِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: الْأَلِفِ وَالتَّاءِ وَالسِّينِ، مِنْ بَابِ: (اسْتَفْعَلَ) ، أَصْلُهُ: (اسْتَغْشَيَ) ، عَلَى وَزْنِ: (اسْتَفْعَلَ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (غشي) .\n\nثِيَابَهُمْ: {ثِيَابَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (ثَوْبٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (ثِوَابٌ) ، عَلَى وَزْنِ: (فِعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (ثوب) .\n\nوَأَصَرُّوا: {أَصَرُّوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَصْرَرَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (صرر) .\n\nوَاسْتَكْبَرُوا: {اسْتَكْبَرُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، سُدَاسِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: الْأَلِفِ وَالتَّاءِ وَالسِّينِ، مِنْ بَابِ: (اسْتَفْعَلَ) ، عَلَى وَزْنِ: (اسْتَفْعَلَ) ، مِنْ مَادَّةِ: (كبر) .\n\nاسْتِكْبَارًا: {اسْتِكْبَارًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ السُّدَاسِيِّ: (اسْتَكْبَرَ) ، مِنْ بَابِ: (اسْتَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: الْأَلِفِ وَالتَّاءِ وَالسِّينِ، عَلَى وَزْنِ: (اسْتِفْعَالٌ) ، مِنْ مَادَّةِ: (كبر) .","words":[{"wordId":73627,"position":1,"word":"وَإِنِّي","text":"{إِنَّ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":73628,"position":2,"word":"كُلَّمَا","text":"{كُلَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (كلل) ، {مَا} : حَرْفٌ مَبْنِيٌّ."},{"wordId":73629,"position":3,"word":"دَعَوْتُهُمْ","text":"{دَعَوْتُ} : فِعْلٌ مَاضٍ لِلْمُتَكَلِّمِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (دعو) ."},{"wordId":73630,"position":4,"word":"لِتَغْفِرَ","text":"{تَغْفِرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (تَفْعِلُ) ، مِنْ مَادَّةِ: (غفر) ."},{"wordId":73631,"position":5,"word":"لَهُمْ","text":"(اللَّامُ) : حَرْفٌ مَبْنِيٌّ."},{"wordId":73632,"position":6,"word":"جَعَلُوا","text":"{جَعَلُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْ