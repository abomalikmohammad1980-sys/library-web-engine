{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":44,"records":[{"ayah":1,"from":1,"to":1,"text":"﴿حمٓ﴾ تقدم الكلام على نظائرها في بداية سورة البقرة."},{"ayah":2,"from":2,"to":2,"text":"أقسم الله بالقرآن الموضح لطريق الهداية إلى الحق."},{"ayah":3,"from":3,"to":3,"text":"إنا أنزلنا القرآن في ليلة القدر، وهي ليلة كثيرة الخيرات، إنا كنا مخوِّفين بهذا القرآن."},{"ayah":4,"from":4,"to":4,"text":"في هذه الليلة يفصل كل أمر محكم يتعلق بالأرزاق والآجال وغيرهما مما يحدثه الله تلك السنة."},{"ayah":5,"from":5,"to":5,"text":"نفصل كل أمر محكم من عندنا، إنا كنا باعثين الرسل."},{"ayah":6,"from":6,"to":6,"text":"نبعث الرسل رحمة من ربك - أيها الرسول - لمن أرسلوا إليهم، إنه سبحانه هو السميع لأقوال عباده، العليم بأفعالهم ونياتهم، لا يخفى عليه شيء من ذلك."},{"ayah":7,"from":7,"to":7,"text":"رب السماوات ورب الأرض ورب ما بينهما إن كنتم موقنين بذلك فآمنوا برسولي."},{"ayah":8,"from":8,"to":8,"text":"لا معبود بحق غيره، يحيي ويميت، لا محيي ولا مميت غيره، ربكم ورب آبائكم المتقدمين."},{"ayah":9,"from":9,"to":9,"text":"ليس هؤلاء المشركون بموقنين بذلك، بل هم في شك منه يلهون عنه بما هم فيه من الباطل."},{"ayah":10,"from":10,"to":10,"text":"فانتظر - أيها الرسول - عذاب قومك القريب يوم تأتي السماء بدخان واضح يرونه بأعينهم من شدة الوجع."},{"ayah":11,"from":11,"to":11,"text":"يعمّ قومك، ويقال لهم: هذا العذاب الذي أصابكم عذاب موجع."},{"ayah":12,"from":12,"to":12,"text":"فيتضرعون إلى ربهم سائلين: ربنا اصرف عنا العذاب الذي أرسلته علينا، إنا مؤمنون بك وبرسولك إن صرفته عنا."},{"ayah":13,"from":13,"to":13,"text":"كيف لهم أن يتذكروا وينيبوا إلى ربهم وقد جاءهم رسول بيّن الرسالة، وعرفوا صدقه وأمانته؟!"},{"ayah":14,"from":14,"to":14,"text":"ثم أعرضوا عن التصديق به، وقالوا عنه: هو معلَّم يُعلِّمه غيره وليس برسول، وقالوا عنه: هو مجنون."},{"ayah":15,"from":15,"to":15,"text":"إنا حين نصرف عنكم العذاب قليلًا، إنكم عائدون إلى كفركم وتكذيبكم."},{"ayah":16,"from":16,"to":16,"text":"وانتظرهم - أيها الرسول - يوم نبطش بكفار قومك البطشة الكبرى يوم بدر، إنا منتقمون منهم لكفرهم بالله وتكذيبهم رسوله."},{"ayah":17,"from":17,"to":17,"text":"ولقد اختبرنا قبلهم قوم فرعون، وجاءهم رسول من الله كريم يدعوهم إلى توحيد الله وعبادته، وهو موسى عليه السلام."},{"ayah":18,"from":18,"to":18,"text":"قال موسى لفرعون وقومه: اتركوا لي بني إسرائيل، فهم عباد الله، ليس لكم حق أن تستعبدوهم، إني لكم رسول من الله، أمين على ما أمرني أن أبلغكم، لا أنقص منه شيئًا ولا أزيده."},{"ayah":19,"from":19,"to":19,"text":"وألا تتكبروا على الله بترك عبادته، والاستعلاء على عباده، إني آتيكم بحجة واضحة."},{"ayah":20,"from":20,"to":20,"text":"وإني اعتصمت بربي وربكم من أن تقتلوني بالرجم بالحجارة."},{"ayah":21,"from":21,"to":21,"text":"وإن لم تصدقوا بما جئت به فاعتزلوني، ولا تقربوني بسوء."},{"ayah":22,"from":22,"to":22,"text":"فدعا موسى عليه السلام ربه: أن هؤلاء القوم - فرعون وملأه - قوم مجرمون يستحقّون تعجيل العقاب."},{"ayah":23,"from":23,"to":23,"text":"فأمر الله موسى أن يسري بقومه ليلًا، وأخبره أن فرعون وقومه سيتبعونهم."},{"ayah":24,"from":24,"to":24,"text":"وأمره إذا اجتاز البحر هو وبنو إسرائيل أن يتركه ساكنًا كما كان، إن فرعون وجنده مهلكون بالغرق في البحر."},{"ayah":25,"from":25,"to":25,"text":"كم خلَّف فرعون وقومه وراءهم من بساتين وعيون جارية!"},{"ayah":26,"from":26,"to":26,"text":"وكم خلفوا وراءهم من زروع ومجلس حسن!"},{"ayah":27,"from":27,"to":27,"text":"وكم خلَّفوا وراءهم من عيشة كانوا فيها متنعّمين!"},{"ayah":28,"from":28,"to":28,"text":"هكذا حدث لهم ما وُصِفَ لكم، وأورثنا جناتهم وعيونهم وزروعهم ومقاماتهم قومًا آخرين هم بنو إسرائيل."},{"ayah":29,"from":29,"to":29,"text":"فما بكت على فرعون وقومه السماء والأرض حين غرقوا، وما كانوا مُمْهَلين حتى يتوبوا."},{"ayah":30,"from":30,"to":30,"text":"ولقد أنقذنا بني إسرائيل من العذاب المُذِل، حيث كان فرعون وقومه يقتلون أبناءهم، ويستحيون نساءهم."},{"ayah":31,"from":31,"to":31,"text":"أنقذناهم من عذاب فرعون، إنه كان مستكبرًا من المتجاوزين لأمر الله ودينه."},{"ayah":32,"from":32,"to":32,"text":"ولقد اخترنا بني إسرائيل على علم منا على عالمي زمانهم لكثرة أنبيائهم."},{"ayah":33,"from":33,"to":33,"text":"وأعطيناهم من الدلائل والبراهين التي أيّدنا بها موسى ما فيه نعمة ظاهرة لهم كالمنّ والسلوى وغيرهما."},{"ayah":34,"from":34,"to":34,"text":"إن هؤلاء المشركين المكذبين ليقولون منكرين للبعث:"},{"ayah":35,"from":35,"to":35,"text":"ما هي إلا موتتنا الأولى فلا حياة بعدها، وما نحن بمبعوثين بعد هذه الموتة."},{"ayah":36,"from":36,"to":36,"text":"فأت - يا محمد - أنت ومن معك من أتباعك بآبائنا الذين ماتوا أحياء إن كنتم صادقين فيما تدّعونه من أن الله يبعث الموتى أحياء للحساب والجزاء."},{"ayah":37,"from":37,"to":37,"text":"أهؤلاء المشركون المكذبون بك - أيها الرسول - خير في القوة والمنعة، أم قوم تُبَّع والذين من قبلهم مثل عاد وثمود، أهلكناهم جميعًا، إنهم كانوا مجرمين."},{"ayah":38,"from":38,"to":38,"text":"وما خلقنا السماوات والأرض وما بينهما لاعبين بخلقها."},{"ayah":39,"from":39,"to":39,"text":"ما خلقنا السماوات والأرض إلا لحكمة بالغة، ولكن معظم المشركين لا يعلمون ذلك."},{"ayah":40,"from":40,"to":40,"text":"إن يوم القيامة الذي يفصل الله به بين العباد ميعاد للخلائق جميعًا يجمعهم الله فيه."},{"ayah":41,"from":41,"to":41,"text":"يوم لا ينفع قريب قريبه، ولا صديق صديقه، ولا هم يمنعون من عذاب الله؛ لأن الملك يومئذ لله، لا أحد يستطيع ادعاءه."},{"ayah":42,"from":42,"to":42,"text":"إلا من رحمه الله من الناس، فإنه ينتفع بما قدم من عمل صالح، إن الله هو العزيز الذي لا يغلبه أحد، الرحيم بمن تاب من عباده."},{"ayah":43,"from":43,"to":43,"text":"إن شجرة الزقوم التي أنبتها الله في أصل الجحيم."},{"ayah":44,"from":44,"to":44,"text":"طعام ذِي الإثم العظيم وهو الكافر يأكل من ثمرها الخبيث."},{"ayah":45,"from":45,"to":45,"text":"هذا الثمر مثل الزيت الأسود، يغلي في بطونهم من شدة حرارته."},{"ayah":46,"from":46,"to":46,"text":"كغلي الماء المتناهي في الحرارة."},{"ayah":47,"from":47,"to":47,"text":"ويقال لزبانية النار: خذوه فجرّوه بعنف وغلظة إلى وسط الجحيم."},{"ayah":48,"from":48,"to":48,"text":"ثم صبوا فوق رأس هذا المُعَذَّب الماء الحار فلا يفارقه العذاب."},{"ayah":49,"from":49,"to":49,"text":"ويقال له تهكُّمًا: ذق هذا العذاب الأليم؛ إنك أنت العزيز الذي لا يُضام جنابك الكريم في قومك."},{"ayah":50,"from":50,"to":50,"text":"إن هذا العذاب هو الذي كنتم تشكّون في وقوعه يوم القيامة، فقد زال عنكم الشك بمعاينته."},{"ayah":51,"from":51,"to":51,"text":"إن المتقين لربهم بامتثال أوامره واجتناب نواهيه في موضع إقامة آمنون من كل مكروه يصيبهم."},{"ayah":52,"from":52,"to":52,"text":"في بساتين وعيون جارية."},{"ayah":53,"from":53,"to":53,"text":"يلبسون في الجنة رقيق الديباج وغليظه، يقابل بعضهم بعضًا، ولا ينظر أحدهم قفا الآخر."},{"ayah":54,"from":54,"to":54,"text":"كما أكرمناهم بذلك المذكور زوجناهم في الجنة بالحسان من النساء واسعات الأعين مع شدّة بياض بياضها وشدّة سواد سوادها."},{"ayah":55,"from":55,"to":55,"text":"يدعون خدمهم فيها ليأتوهم بكل فاكهة أرادوها آمنين من انقطاعها، ومن مضارّها."},{"ayah":56,"from":56,"to":56,"text":"خالدين فيها، لا يذوقون فيها الموت إلا الموتة الأولى في الحياة الدنيا، ووقاهم ربهم عذاب النار."},{"ayah":57,"from":57,"to":57,"text":"تفضلًا وإحسانًا من ربك بهم، ذلك المذكور - من إدخالهم الجنة، ووقايتهم من النار - هو الفوز العظيم الذي لا يدانيه فوز."},{"ayah":58,"from":58,"to":58,"text":"فإنما يسّرنا هذا القرآن وسهَّلناه بإنزاله بلسانك العربي - أيها الرسول - لعلَّهم يتعظون."},{"ayah":59,"from":59,"to":59,"text":"فانتظر نصرك وهلاكهم، إنهم منتظرون هلاكك."}]}