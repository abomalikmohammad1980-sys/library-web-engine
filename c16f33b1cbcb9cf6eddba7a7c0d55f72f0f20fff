import { describe, expect, it } from "vitest";
import { SOURCE_FORMAT_CAPABILITIES, type ImmutableSourceEdition, type LogicalWork, type SourceFormat } from "@library/source-sync";
import { SourceEditionAuthority, type SourceEditionPersistence, type StoredEditionAttachment } from "./source-editions.js";
const hex="a".repeat(64);
function edition(format:SourceFormat,id=`e-${format}`):ImmutableSourceEdition{return{editionId:id,operationId:`op-${id}`,workId:"work",format,role:"authoritative",objectKey:`immutable/${hex}/${id}`,fingerprint:{algorithm:"sha256",hex,byteLength:10},mediaType:SOURCE_FORMAT_CAPABILITIES[format].mediaTypes[0]!,sourceName:`x.${format}`,createdAt:"now",createdByDeviceId:"device"}}
class Store implements SourceEditionPersistence{work:LogicalWork={workId:"work",title:"كتاب",authority:null,recordVersion:0};operations=new Map<string,StoredEditionAttachment>();owner=true;device=true;isOwner=async()=>this.owner;isActiveDevice=async()=>this.device;getWork=async()=>structuredClone(this.work);findAttachment=async(_w:string,op:string)=>this.operations.get(op)??null;commit=async(i:any)=>{if(this.work.recordVersion!==i.expectedWorkVersion)return false;this.work=i.nextWork;this.operations.set(i.edition.operationId,{operationId:i.edition.operationId,workId:"work",editionId:i.edition.editionId,intent:i.intent,expectedWorkVersion:i.expectedWorkVersion,result:i.nextWork});return true}}
describe("source edition persistence authority",()=>{it("establishes and replays an immutable Word authority idempotently",async()=>{const s=new Store(),a=new SourceEditionAuthority(s),input={deviceId:"device",edition:edition("docx"),intent:"establish-authority"as const,expectedWorkVersion:0};const first=await a.attach({userId:"user"},input);expect(first).toMatchObject({authority:{kind:"word-live"},recordVersion:1});expect(await a.attach({userId:"user"},input)).toEqual(first);expect(s.operations).toHaveLength(1)});it("rejects IDOR, inactive/device mismatch, operation reuse, and stale CAS",async()=>{const s=new Store(),a=new SourceEditionAuthority(s),base={deviceId:"device",edition:edition("pdf"),intent:"establish-authority"as const,expectedWorkVersion:0};s.owner=false;await expect(a.attach({userId:"other"},base)).rejects.toMatchObject({status:404});s.owner=true;s.device=false;await expect(a.attach({userId:"user"},base)).rejects.toMatchObject({code:"device_not_active"});s.device=true;await expect(a.attach({userId:"user"},{...base,edition:{...base.edition,createdByDeviceId:"other"}})).rejects.toMatchObject({code:"edition_device_mismatch"});await a.attach({userId:"user"},base);await expect(a.attach({userId:"user"},{...base,intent:"attach-alternate"})).rejects.toMatchObject({code:"operation_reuse_conflict"});await expect(a.attach({userId:"user"},{...base,edition:edition("pdf","e2"),expectedWorkVersion:0})).rejects.toMatchObject({status:409})})});
