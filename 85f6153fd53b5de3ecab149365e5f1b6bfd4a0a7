import{describe,expect,it}from"vitest";import{AccountUsageHttpRouter}from"./usage.js";describe("account usage",()=>{it("reads only the authenticated principal",async()=>{let seen="";const router=new AccountUsageHttpRouter({get:async u=>{seen=u;return{committedBytes:1,reservedBytes:2,maxAccountStorageBytes:3,maxSourceBytes:3,maxBookRevisions:4,windowRequests:1,maxRequestsPerWindow:5,rateWindowSeconds:60,recordVersion:1}}},{authenticate:async()=>({userId:"owner"})});expect((await router.handle(new Request("https://x/account/usage"))).status).toBe(200);expect(seen).toBe("owner")});it("does not accept caller-selected account ids",async()=>{let seen="";const router=new AccountUsageHttpRouter({get:async u=>{seen=u;return null}},{authenticate:async()=>({userId:"owner"})});await router.handle(new Request("https://x/account/usage?principal_sub=other"));expect(seen).toBe("owner")})});
