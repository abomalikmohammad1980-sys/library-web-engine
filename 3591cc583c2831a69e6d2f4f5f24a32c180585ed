import{describe,expect,it}from"vitest";import{SOURCE_FORMAT_CAPABILITIES,type ImmutableSourceEdition,type LogicalWork,type SourceFormat}from"@library/source-sync";import type{D1DatabaseBinding,D1PreparedStatementBinding}from"./bindings.js";import{D1SourceEditionPersistence}from"./d1-source-editions.js";
const hex="b".repeat(64);function edition(format:SourceFormat):ImmutableSourceEdition{return{editionId:`e-${format}`,operationId:`op-${format}`,workId:"work",format,role:"authoritative",objectKey:`immutable/${hex}`,fingerprint:{algorithm:"sha256",hex,byteLength:5},mediaType:SOURCE_FORMAT_CAPABILITIES[format].mediaTypes[0]!,sourceName:`x.${format}`,createdAt:"now",createdByDeviceId:"device"}}
function harness(withBatch=true){const sql:string[]=[],batches:string[][]=[];const db:D1DatabaseBinding={prepare(text){sql.push(text);let values:unknown[]=[];const statement:D1PreparedStatementBinding={bind(...v){values=v;return statement},first:async()=>{if(text.includes("FROM logical_works WHERE id")&&text.includes("owner_id"))return{owned:1};if(text.includes("FROM devices"))return{active:1};if(text.startsWith("SELECT * FROM logical_works"))return{id:"work",title:"كتاب",authority_kind:null,authority_edition_id:null,authority_format:null,record_version:0};if(text.includes("source_edition_operations o"))return null;return null},all:async()=>({success:true,results:[]}),run:async()=>({success:true,meta:{changes:1}})};return statement}};if(withBatch)db.batch=async statements=>{batches.push(statements.map((_,i)=>sql[sql.length-statements.length+i]!));return statements.map(()=>({success:true,meta:{changes:1}}))};return{db,sql,batches}}
describe("D1 source edition persistence",()=>{it("commits an authority edition, CAS operation, pointer, and audit in one batch",async()=>{const h=harness(),s=new D1SourceEditionPersistence(h.db),e=edition("docx"),next:LogicalWork={workId:"work",title:"كتاب",authority:{kind:"word-live",editionId:e.editionId,format:"docx"},recordVersion:1};expect(await s.commit({userId:"user",deviceId:"device",edition:e,intent:"establish-authority",expectedWorkVersion:0,nextWork:next})).toBe(true);const joined=h.batches[0]!.join(" ");expect(joined).toContain("INSERT INTO source_editions");expect(joined).toContain("INSERT INTO source_edition_operations");expect(joined).toContain("UPDATE logical_works SET authority_kind");expect(joined).toContain("source_edition_attach")});it("stores an alternate without changing authority and fails closed without D1 batch",async()=>{const h=harness(),s=new D1SourceEditionPersistence(h.db),e={...edition("epub"),role:"alternate"as const};const work:LogicalWork={workId:"work",title:"كتاب",authority:null,recordVersion:0};expect(await s.commit({userId:"user",deviceId:"device",edition:e,intent:"attach-alternate",expectedWorkVersion:0,nextWork:work})).toBe(true);expect(h.batches[0]!.join(" ")).not.toContain("UPDATE logical_works SET authority_kind");await expect(new D1SourceEditionPersistence(harness(false).db).commit({userId:"user",deviceId:"device",edition:e,intent:"attach-alternate",expectedWorkVersion:0,nextWork:work})).rejects.toThrow(/batch_required/)})});
