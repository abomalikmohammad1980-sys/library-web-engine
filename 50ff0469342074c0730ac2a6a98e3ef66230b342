import { mkdtemp,readFile,rm,writeFile } from "node:fs/promises";import { tmpdir } from "node:os";import { join } from "node:path";import { afterEach,describe,expect,it,vi } from "vitest";import { loadSourceSyncCliConfig,runSourceSyncCli } from "./source-sync-cli.js";import type { SourceSyncDaemon } from "./source-sync-daemon.js";
const roots:string[]=[];afterEach(async()=>Promise.all(roots.splice(0).map(r=>rm(r,{recursive:true,force:true}))));async function fixture(){const root=await mkdtemp(join(tmpdir(),"sync-cli-"));roots.push(root);const file=join(root,"config.json"),config={managedRoot:join(root,"books"),stateFile:join(root,"state.json"),lockFile:join(root,"daemon.lock"),healthFile:join(root,"health.json"),reconcileIntervalMs:100,outboxIntervalMs:100,buildIntervalMs:100};await writeFile(file,JSON.stringify(config));return{root,file,config:await loadSourceSyncCliConfig(file,{})}}
describe("source sync CLI",()=>{it("validates config and permits explicit non-secret env path overrides",async()=>{const f=await fixture();const c=await loadSourceSyncCliConfig(f.file,{KHIZANA_MANAGED_ROOT:join(f.root,"override")});expect(c.managedRoot).toContain("override");expect(c).not.toHaveProperty("token");const logs:string[]=[];expect(await runSourceSyncCli("config-check",c,{createDaemon:async()=>{throw Error()}},{stdout:s=>logs.push(s),stderr:s=>logs.push(s)})).toBe(0);expect(logs.join(" ")).not.toContain(c.managedRoot)});it("runs once, writes health atomically, and rejects a concurrent lock",async()=>{const f=await fixture(),logs:string[]=[];const daemon={drainOnce:vi.fn(async()=>({ok:true})),health:()=>({state:"stopped"})} as unknown as SourceSyncDaemon,deps={createDaemon:async()=>daemon};expect(await runSourceSyncCli("once",f.config,deps,{stdout:s=>logs.push(s),stderr:s=>logs.push(s)})).toBe(0);expect(JSON.parse(await readFile(f.config.healthFile,"utf8"))).toEqual({state:"stopped"});await writeFile(f.config.lockFile,"busy");expect(await runSourceSyncCli("once",f.config,deps,{stdout:s=>logs.push(s),stderr:s=>logs.push(s)})).toBe(4);expect(logs.some(x=>x.includes("already-running"))).toBe(true);expect(logs.join(" ")).not.toContain(f.config.lockFile)});it("returns a distinct health-unavailable exit code",async()=>{const f=await fixture();expect(await runSourceSyncCli("health",f.config,{createDaemon:async()=>{throw Error()}},{stdout:()=>{},stderr:()=>{}})).toBe(3)});});
