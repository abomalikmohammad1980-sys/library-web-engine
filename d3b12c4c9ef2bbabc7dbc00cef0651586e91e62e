import{describe,expect,it}from"vitest";import{HttpSourceRevisionApi}from"./source-sync-api-client.js";import{runUserCommand}from"./user-commands.js";import type{NodeRuntimeConfig}from"./node-runtime-factory.js";
const config={apiBase:"https://sync.example/",tokenSource:{kind:"env",name:"USER_TOKEN"},serviceTokenSource:{kind:"env",name:"SERVICE_TOKEN"}}as NodeRuntimeConfig;
describe("user-auth sync client/CLI",()=>{it("uses only the user bearer for read-only contracts",async()=>{const seen:RequestInit[]=[];const api=new HttpSourceRevisionApi(config.apiBase,async()=>"user-secret",async(_u,i)=>{seen.push(i!);return Response.json([])});await api.devices();expect((seen[0]!.headers as any).authorization).toBe("Bearer user-secret");expect(JSON.stringify(seen[0])).not.toContain("SERVICE_TOKEN")});it("keeps mutations dry-run until --confirm",async()=>{let calls=0;const out:string[]=[];expect(await runUserCommand("device-revoke",config,["--device","d"],{out:s=>out.push(s),err:s=>out.push(s)},async()=>{calls++;return Response.json({})})).toBe(0);expect(calls).toBe(0);expect(out.join()).toContain("dryRun")});it("maps IDOR and conflicts to stable exit codes",async()=>{process.env.USER_TOKEN="token";const response=(status:number,code:string)=>runUserCommand("device-revoke",config,["--device","d","--confirm"],{out:()=>{},err:()=>{}},async()=>Response.json({error:{code}},{status}));expect(await response(404,"device_not_found")).toBe(6);expect(await response(409,"device_revoked")).toBe(7)});it("supports JSON output for usage",async()=>{process.env.USER_TOKEN="token";const out:string[]=[];expect(await runUserCommand("usage",config,["--json"],{out:s=>out.push(s),err:()=>{}},async()=>Response.json({committedBytes:1}))).toBe(0);expect(JSON.parse(out[0]!)).toEqual({committedBytes:1})})});
