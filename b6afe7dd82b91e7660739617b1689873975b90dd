{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":71,"records":[{"ayah":1,"from":1,"to":1,"text":"إنا بعثنا نوحًا إلى قومه يدعوهم ليخوّف قومه من قبل أن يأتيهم عذاب موجع بسبب ما هم عليه من الشرك بالله."},{"ayah":2,"from":2,"to":2,"text":"قال نوح لقومه: يا قوم، إني لكم مُنْذِرٌ بَيِّنُ الإنذار من عذاب ينتظركم إن لم تتوبوا إلى الله."},{"ayah":3,"from":3,"to":3,"text":"ومقتضى إنذاري لكم أن أقول لكم: اعبدوا الله وحده، ولا تشركوا به شيئًا، واتقوه بامتثال أوامره، واجتناب نواهيه، وأطيعوني فيما آمركم به."},{"ayah":4,"from":4,"to":4,"text":"إنكم إن تفعلوا ذلك يغفر الله لكم من ذنوبكم ما لا يتعلق بحقوق العباد، ويُطِلْ أمد أمّتكم في الحياة إلى وقت محدد في علم الله، تعمرون الأرض ما استقمتم على ذلك، إن الموت إذا جاء لا يؤخَّر، لو كنتم تعلمون لبادرتم إلى الإيمان بالله والتوبة مما أنتم عليه من الشرك والضلال."},{"ayah":5,"from":5,"to":5,"text":"قال نوح: يا رب، إني دعوت قومي إلى عبادتك وتوحيدك، ليلًا ونهارًا باستمرار."},{"ayah":6,"from":6,"to":6,"text":"فلم تزدهم دعوتي لهم إلا نفورًا وبُعْدًا مما أدعوهم إليه."},{"ayah":7,"from":7,"to":7,"text":"وإني كلما دعوتهم إلى ما فيه سبب غفران ذنوبهم؛ من عبادتك وحدك ومن طاعتك وطاعة رسولك - سدّوا آذانهم بأصابعهم؛ ليمنعوها من سماع دعوتي، وغطّوا وجوههم بثيابهم حتى لا يروني، واستمرّوا على ما هم عليه من الشرك، وتكبّروا عن قبول ما أدعوهم إليه، والإذعان له."},{"ayah":8,"from":8,"to":8,"text":"ثم إني - يا رب - دعوتهم علانية."},{"ayah":9,"from":9,"to":9,"text":"ثم إني رفعت لهم صوتي بالدعوة، وأسررت إسرارًا خفيًّا، ودعوتهم بصوت منخفض؛ منوّعًا لهم أسلوب دعوتي."},{"ayah":10,"from":10,"to":10,"text":"فقلت لهم: يا قوم، اطلبوا المغفرة من ربكم بالتوبة إليه، إنه سبحانه كان غفارًا لذنوب من تاب إليه من عباده."},{"ayah":11,"from":11,"to":11,"text":"فإنكم إن فعلتم ذلك ينزل الله عليكم المطر متتابعًا كلما احتجتم إليه، فلا يصيبكم قحط."},{"ayah":12,"from":12,"to":12,"text":"ويعطيكم بكثرةٍ أموالًا وأولادًا، ويجعل لكم بساتين تأكلون من ثمارها، ويجعل لكم أنهارًا تشربون منها وتسقون زروعكم ومواشيكم."},{"ayah":13,"from":13,"to":13,"text":"ما شأنكم - يا قوم - لا تخافون عظمة الله حيث تعصونه دون مبالاة؟!"},{"ayah":14,"from":14,"to":14,"text":"وقد خلقكم طَوْرًا بعد طَوْر من نُطْفة فَعَلَقة فَمُضْغة."},{"ayah":15,"from":15,"to":15,"text":"ألم تروا كيف خلق الله سبع سماوات، سماء فوق سماء؟!"},{"ayah":16,"from":16,"to":16,"text":"وجعل القمر في السماء الدنيا منهن ضياء لأهل الأرض، وجعل الشمس مضيئة."},{"ayah":17,"from":17,"to":17,"text":"والله خلقكم من الأرض بخلق أبيكم آدم من تراب، ثم أنتم تتغذون بما تُنْبِته لكم."},{"ayah":18,"from":18,"to":18,"text":"ثم يعيدكم فيها بعد موتكم، ثم يخرجكم للبعث منها إخراجًا."},{"ayah":19,"from":19,"to":19,"text":"والله جعل لكم الأرض مبسوطة مهيَّأة للسُّكْنى."},{"ayah":20,"from":20,"to":20,"text":"رجاء أن تسلكوا منها طرقًا واسعة سعيًا للكسب الحلال."},{"ayah":21,"from":21,"to":21,"text":"قال نوح: يا رب، إن قومي عصوني فيما أمرتهم به من توحيدك وعبادتك وحدك، واتبع السفلة منهم رؤساءهم الذين أنعمت عليهم بالمال والولد، فلم يزدهم ما أنعمت به عليهم إلا ضلالًا."},{"ayah":22,"from":22,"to":22,"text":"ومكر الأكابر منهم مكرًا عظيمًا بتحريشهم سَفَلَتهم على نوح."},{"ayah":23,"from":23,"to":23,"text":"وقالوا لأتباعهم: لا تتركوا عبادة آلهتكم؛ ولا تتركوا عبادة أصنامكم وَدٍّ ولا سُوَاع ولا يَغُوث ولا يَعُوق ولا نَسْر."},{"ayah":24,"from":24,"to":24,"text":"وقد أضلّوا بأصنامهم هذه كثيرًا من الناس، ولا تزد - يا رب - الظالمين لأنفسهم بالإصرار على الكفر والمعاصي إلا ضلالًا عن الحق."},{"ayah":25,"from":25,"to":25,"text":"بسبب خطيئاتهم التي ارتكبوها أُغْرِقوا بالطوفان في الدنيا، فأُدْخِلوا النار بعد موتهم مباشرة، فلم يجدوا لهم من دون الله أنصارًا ينقذونهم من الغرق والنار."},{"ayah":26,"from":26,"to":26,"text":"وقال نوح لما أخبره الله أنه لن يؤمن من قومه إلا من قد آمن: يا رب، لا تترك على الأرض من الكافرين أحدًا يدور أو يتحرك."},{"ayah":27,"from":27,"to":27,"text":"إنك - ربنا - إن تتركهم وتمهلهم يضلّوا عبادك المؤمنين، ولا يلدوا إلا صاحبَ فجورٍ لا يطيعك، وشديدَ كفرٍ لا يشكرك على نعمك."},{"ayah":28,"from":28,"to":28,"text":"ربّ اغفر لي ذنوبي، واغفر لوالديَّ، واغفر لمن دخل بيتي مؤمنًا، واغفر للمؤمنين والمؤمنات، ولا تزد الظالمين لأنفسهم بالكفر والمعاصي إلا هلاكًا وخسرانًا."}]}