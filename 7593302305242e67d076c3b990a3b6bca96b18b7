import{createHash}from"node:crypto";import{readFile,readdir}from"node:fs/promises";import{fileURLToPath}from"node:url";import{describe,expect,it}from"vitest";import{EXPECTED_MIGRATIONS}from"./readiness.js";describe("pre-deployment migration integrity",()=>{it("matches every ordered 0001-0011 file to its readiness checksum",async()=>{const dir=fileURLToPath(new URL("../migrations/",import.meta.url)),files=(await readdir(dir)).filter(x=>x.endsWith(".sql")).sort();expect(files).toEqual(EXPECTED_MIGRATIONS.map(x=>x.file));for(const migration of EXPECTED_MIGRATIONS){expect(migration.file.startsWith(String(migration.version).padStart(4,"0"))).toBe(true);const bytes=await readFile(new URL(`../migrations/${migration.file}`,import.meta.url));expect(createHash("sha256").update(bytes).digest("hex")).toBe(migration.sha256)}})});
