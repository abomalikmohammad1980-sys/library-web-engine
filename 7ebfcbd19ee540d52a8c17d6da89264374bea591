import { promises as fs } from "node:fs";import { dirname,resolve } from "node:path";import type { SourceSyncDaemon,SourceSyncDaemonConfig } from "./source-sync-daemon.js";import { validateDaemonConfig } from "./source-sync-daemon.js";
import { redactWorkerDetail } from "./log-redaction.js";
export type SourceSyncCliCommand="run"|"once"|"health"|"config-check";export interface SourceSyncCliConfig extends SourceSyncDaemonConfig{lockFile:string;healthFile:string}
export interface SourceSyncCliDependencies{createDaemon(config:SourceSyncCliConfig,emit:(event:unknown)=>void):Promise<SourceSyncDaemon>}
export async function loadSourceSyncCliConfig(file:string,env:NodeJS.ProcessEnv=process.env):Promise<SourceSyncCliConfig>{const raw=JSON.parse(await fs.readFile(resolve(file),"utf8")) as Partial<SourceSyncCliConfig>;const c={...raw,...(env.KHIZANA_MANAGED_ROOT?{managedRoot:env.KHIZANA_MANAGED_ROOT}:{}),...(env.KHIZANA_STATE_FILE?{stateFile:env.KHIZANA_STATE_FILE}:{})} as SourceSyncCliConfig;validateDaemonConfig(c);if(!c.lockFile?.trim()||!c.healthFile?.trim())throw Error("lockFile and healthFile are required");return{...c,managedRoot:resolve(c.managedRoot),stateFile:resolve(c.stateFile),lockFile:resolve(c.lockFile),healthFile:resolve(c.healthFile)}}
export async function runSourceSyncCli(command:SourceSyncCliCommand,config:SourceSyncCliConfig,deps:SourceSyncCliDependencies,io={stdout:(s:string)=>process.stdout.write(s+"\n"),stderr:(s:string)=>process.stderr.write(s+"\n")}):Promise<number>{if(command==="config-check"){io.stdout(JSON.stringify({level:"info",event:"config-valid"}));return 0}if(command==="health"){try{io.stdout(await fs.readFile(config.healthFile,"utf8"));return 0}catch{io.stderr(JSON.stringify({level:"error",event:"health-unavailable"}));return 3}}const release=await acquireLock(config.lockFile).catch(()=>{io.stderr(JSON.stringify({level:"error",event:"already-running"}));return null});if(!release)return 4;try{const log=(event:unknown)=>io.stdout(JSON.stringify({level:"info",at:new Date().toISOString(),event})),daemon=await deps.createDaemon(config,log);if(command==="once"){const result=await daemon.drainOnce();await writeHealth(config.healthFile,daemon.health());log({kind:"once-complete",result:redactWorkerDetail(result)});return 0}const controller=new AbortController(),stop=()=>controller.abort();process.once("SIGINT",stop);process.once("SIGTERM",stop);try{await daemon.start(controller.signal);await writeHealth(config.healthFile,daemon.health());await new Promise<void>(r=>controller.signal.addEventListener("abort",()=>r(),{once:true}));await daemon.stop();await writeHealth(config.healthFile,daemon.health());return 0}finally{process.off("SIGINT",stop);process.off("SIGTERM",stop)}}catch{io.stderr(JSON.stringify({level:"error",event:"fatal",code:"daemon_failed"}));return 1}finally{await release()}}
async function acquireLock(path:string){await fs.mkdir(dirname(path),{recursive:true});const handle=await fs.open(path,"wx");await handle.writeFile(JSON.stringify({pid:process.pid,startedAt:new Date().toISOString()}));return async()=>{await handle.close();await fs.rm(path,{force:true})}}
async function writeHealth(path:string,value:unknown){await fs.mkdir(dirname(path),{recursive:true});const temp=`${path}.tmp-${process.pid}`;await fs.writeFile(temp,JSON.stringify(value));await fs.rename(temp,path)}
