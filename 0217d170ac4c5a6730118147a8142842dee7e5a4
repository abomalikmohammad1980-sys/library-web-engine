َّوَابُّ: {الدَّوَابُّ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (دَابَّةٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (دَبَّ يَدِبُّ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْوَاوِ، أَصْلُهُ: (دَوَابِبُ) ، عَلَى وَزْنِ: (فَوَاعِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْأَلِفِ وَاوًا لِمَجِيئِهَا بَعْدَ ضَمٍّ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (دبب) .\n\nوَكَثِيرٌ: {كَثِيرٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَثُرَ يَكْثُرُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (كثر) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالنَّاسِ: {النَّاسِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (نَوَسٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (نوس) .\n\nوَكَثِيرٌ: {كَثِيرٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَثُرَ يَكْثُرُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (كثر) .\n\nحَقَّ: {حَقَّ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (حَقَقَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (حقق) .\n\nعَلَيْهِ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالْعَذَابُ: {الْعَذَابُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (عذب) .\n\nوَمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nيُهِنِ: {يُهِنْ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَهْوِنُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ وَالْيَاءِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (هون) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nفَمَا: {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nلَهُ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nمُكْرِمٍ: {مُكْرِمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَكْرَمَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَكْرِمٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (كرم) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nيَفْعَلُ: {يَفْعَلُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، مِنْ مَادَّةِ: (فعل) .\n\nمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nيَشَاءُ: {يَشَاءُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ اللَّامِ، أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، أَصْلُهُ: (يَشْيَأُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْفَتْحَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (شيأ) .","words":[{"wordId":42894,"position":1,"word":"أَلَمْ","text":"{لَمْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":42895,"position":2,"word":"تَرَ","text":"{تَرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَ