ٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَشْرِكُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (شرك) .\n\nبِاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nفَكَأَنَّمَا: {كَأَنَّ} : حَرْفٌ مَبْنِيٌّ، {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nخَرَّ: {خَرَّ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (خَرَرَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (خرر) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالسَّمَاءِ: {السَّمَاءِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (سَمَاوٌ) ، عَلَى وَزْنِ: (فَعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (سمو) .\n\nفَتَخْطَفُهُ: {تَخْطَفُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، مِنْ مَادَّةِ: (خطف) .\n\nالطَّيْرُ: {الطَّيْرُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (طير) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nتَهْوِي: {تَهْوِي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَقْرُونٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (تَفْعِلُ) ، مِنْ مَادَّةِ: (هوي) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nالرِّيحُ: {الرِّيحُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (رِوْحٌ) ، عَلَى وَزْنِ: (فِعْلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (روح) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nمَكَانٍ: {مَكَانٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَق