: {جِهَادِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (جَاهَدَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (جهد) .\n\nهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nاجْتَبَاكُمْ: {اجْتَبَى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (اجْتَبَيَ) ، عَلَى وَزْنِ: (افْتَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (جبي) .\n\nوَمَا: {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nجَعَلَ: {جَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nعَلَيْكُمْ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nالدِّينِ: {الدِّينِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (دين) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nحَرَجٍ: {حَرَجٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (حرج) .\n\nمِلَّةَ: {مِلَّةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ملل) .\n\nأَبِيكُمْ: {أَبِي} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (أَبَوٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (أبو) .\n\nإِبْرَاهِيمَ: {إِبْرَاهِيمَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (إبراهيم) .\n\nهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nسَمَّاكُمُ: {سَمَّى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، أَصْلُهُ: (سَمَّيَ) ، عَلَى وَزْنِ: (فَعَّلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (سمو) .\n\nالْمُسْلِمِينَ: {الْمُسْلِمِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُسْلِمٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَسْلَمَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَسْلِمٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (سلم) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nقَبْلُ: {قَبْلُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قبل) .\n\nوَفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nهَذَا: {هَذَا} : اسْمٌ مَبْنِيٌّ.\n\nلِيَكُونَ: {يَكُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَكْوُنُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nالرَّسُولُ: {الرَّسُولُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nشَهِيدًا: {شَهِيدًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَهِدَ يَشْهَدُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (شهد) .\n\nعَلَيْكُمْ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nوَتَكُونُوا: {تَكُونُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (تَكْوُنُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nشُهَدَاءَ: {شُهَدَاءَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (شَهِيدٌ) ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَهِدَ يَشْهَدُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، مَمْدُودٌ، عَلَى وَزْنِ: (فُعَلَاءُ) ، مِنْ مَادَّةِ: (شهد) .\n\nعَلَى: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالنَّاسِ: {النَّاسِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (نَوَسٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (نوس) .\n\nفَأَقِيمُوا: {أَقِيمُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَقْوِمْ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (قوم) .\n\nالصَّلَاةَ: {الصَّلَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (صَلَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (صلو) .\n\nوَآتُوا: {آتُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْفَاءِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَأْتِي) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِثِقَلِ الضَّمَّةِ عَلَى الْيَاءِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أتي) .\n\nالزَّكَاةَ: {الزَّكَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (زَكَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (زكو) .\n\nوَاعْتَصِمُوا: {اعْتَصِمُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، عَلَى وَزْنِ: (افْتَعِلْ) ، مِنْ مَادَّةِ: (عصم) .\n\nبِاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nمَوْلَاكُمْ: {مَوْلَى} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، مَقْصُورٌ، أَصْلُهُ: (مَوْلَيٌ) ، عَلَى وَزْنِ: (مَفْعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (ولي) .\n\nفَنِعْمَ: {نِعْمَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، جَامِدٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (فَعِلَ) ، مِنْ مَادَّةِ: (نِعم) .\n\nالْمَوْلَى: {الْمَوْلَى} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، مَقْصُورٌ، أَصْلُهُ: (مَوْلَيٌ) ، عَلَى وَزْنِ: (مَفْعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (ولي) .\n\nوَنِعْمَ: {نِعْمَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، جَامِدٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (فَعِلَ) ، مِنْ مَادَّةِ: (نِعم) .\n\nالنَّصِيرُ: {النَّصِيرُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (نَصَرَ يَنْصُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (نصر) .","words":[{"wordId":43820,"position":1,"word":"وَجَاهِدُوا","text":"{جَاهِدُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مِنْ بَابِ: (فَاعَلَ) ، عَلَى وَزْنِ: (فَاعِلْ) ، مِنْ مَادَّةِ: (جهد) ."},{"wordId":43821,"position":2,"word":"فِي","text":"{فِي} : حَرْفٌ مَبْنِيٌّ."},{"wordId":43822,"position":3,"word":"اللَّهِ","text":"{اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) ."},{"word