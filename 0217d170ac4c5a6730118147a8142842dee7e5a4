ِكْ: {تُشْرِكْ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (تُؤَشْرِكُ) ، عَلَى وَزْنِ: (تُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (شرك) .\n\nبِي: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nشَيْئًا: {شَيْئًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (شيأ) .\n\nوَطَهِّرْ: {طَهِّرْ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (فَعِّلْ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (طهر) .\n\nبَيْتِيَ: {بَيْتِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بيت) .\n\nلِلطَّائِفِينَ: {الطَّائِفِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (طَائِفٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (طَافَ يَطُوفُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (طَاوِفٌ) ، عَلَى وَزْنِ: (فَاعِلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (طوف) .\n\nوَالْقَائِمِينَ: {الْقَائِمِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (قَائِمٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (قَامَ يَقُومُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (قَاوِمٌ) ، عَلَى وَزْنِ: (فَاعِلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (قوم) .\n\nوَالرُّكَّعِ: {الرُّكَّعِ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (رَاكِعٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (رَكَعَ يَرْكَعُ) ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، عَلَى وَزْنِ: (فُعَّلٌ) ، فِيهِ إِدْغَا