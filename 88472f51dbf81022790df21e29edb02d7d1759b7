رأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع.\n\nوَجَاءُوا: ورش عن نافع قرأ بالفتح، مع تحقيق الهمزة، وتثليث مد البدل. ابن ذكوان عن ابن عامر وَخلف العاشر قرأ بالإمالة، مع تحقيق الهمزة، وقصر مد البدل. حمزة قرأ بالإمالة، مع تحقيق الهمزة وصلاً، ووقف بتسهيل الهمزة مع المد والقصر. باقي الرواة قرؤوا بالفتح، مع تحقيق الهمزة، وقصر مد البدل.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nبِسِحْرٍ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعَظِيمٍ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nخلف عن حمزة قرأ بالإدغام مع ترك الغنة. باقي الرواة قرؤوا بالإدغام مع الغنة.","words":[{"wordId":21007,"position":1,"word":"قَالَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21008,"position":2,"word":"أَلْقُوا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21009,"position":3,"word":"فَلَمَّا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21010,"position":4,"word":"أَلْقَوْا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21011,"position":5,"word":"سَحَرُوا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21012,"position":6,"word":"أَعْيُنَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21013,"position":7,"word":"النَّاسِ","text":"الدوري عن أبي عمرو قرأ بالإمالة بلا خلاف عنه. باقي الرواة قرؤوا بالفتح بلا خلاف عنه.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21014,"position":8,"word":"وَاسْتَرْهَبُوهُمْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع."},{"wordId":21015,"position":9,"word":"وَجَاءُوا","text":"ورش عن نافع قرأ بالفتح، مع تحقيق الهمزة، وتثليث مد البدل. ابن ذكوان عن ابن عامر وَخلف العاشر قرأ بالإمالة، مع تحقيق الهمزة، وقصر مد البدل. حمزة قرأ بالإمالة، مع تحقيق الهمزة وصلاً، ووقف بتسهيل الهمزة مع المد والقصر. باقي الرواة قرؤوا بالفتح، مع تحقيق الهمزة، وقصر مد البدل.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21016,"position":10,"word":"بِسِحْرٍ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21017,"position":11,"word":"عَظِيمٍ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nخلف عن حمزة قرأ بالإدغام مع ترك الغنة. باقي الرواة قرؤوا بالإدغام مع الغنة."}]},{"ayah":117,"from":117,"to":117,"text":"وَأَوْحَيْنَا: حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nإِلَى: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nمُوسَى: ورش عن نافع قرأ بالتقليل بخلف عنه. أبو عمرو قرأ بالتقليل بلا خلاف عنه. حمزة وَالكسائي وَخلف العاشر قرأ بالإمالة وصلاً ووقفا. باقي الرواة قرؤوا بالفتح وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nأَنْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nورش عن نافع قرأ بالنقل وصلاً ووقفا. خلف عن حمزة قرأ بالسكت وعدمه وصلاً، ووقف بالسكت، والنقل، وتركهما. خلاد عن حمزة قرأ بترك السكت وصلاً، ووقف بالنقل والتحقيق. باقي الرواة قرؤوا بترك السكت مع تحقيق الهمزة وصلاً ووقفا.\n\nأَلْقِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعَصَاكَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nفَإِذَا: حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nهِيَ: يعقوب وقف بهاء السكت باتفاق. باقي الرواة وقف بترك هاء السكت.\n\nعند الوصل\nالبزي عن ابن كثير قرأ بفتح اللام، وتشديد القاف، مع تشديد التاء وصلاً، ويبتدأ بها مخففة. حفص عن عاصم قرأ بتخفيف القاف وإسكان اللام. باقي الرواة قرؤوا بفتح اللام، وتشديد القاف.\n\nتَلْقَفُ: البزي عن ابن كثير قرأ بفتح اللام، وتشديد القاف، مع تشديد التاء وصلاً، ويبتدأ بها مخففة. حفص عن عاصم قرأ بتخفيف القاف وإسكان اللام. باقي الرواة قرؤوا بفتح اللام، وتشديد القاف.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nمَا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nيَأْفِكُونَ: ورش عن نافع وَأبو جعفر وَالسوسي عن أبي عمرو قرأ بإبدال الهمزة الساكنة حرفا مديا من جنس حركة ما قبلها. حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بإبدالها حرفا مديا. باقي الرواة قرؤوا بتحقيق الهمزة الساكنة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":21018,"position":1,"word":"وَأَوْحَيْنَا","text":"حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21019,"position":2,"word":"إِلَى","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21020,"position":3,"word":"مُوسَى","text":"ورش عن نافع قرأ بالتقليل بخلف عنه. أبو عمرو قرأ بالتقليل بلا خلاف عنه. حمزة وَالكسائي وَخلف العاشر قرأ بالإمالة وصلاً ووقفا. باقي الرواة قرؤوا بالفتح وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21021,"position":4,"word":"أَنْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nورش عن نافع قرأ بالنقل وصلاً ووقفا. خلف عن حمزة قرأ بالسكت وعدمه وصلاً، ووقف بالسكت، والنقل، وتركهما. خلاد عن حمزة قرأ بترك السكت وصلاً، ووقف بالنقل والتحقيق. باقي الرواة قرؤوا بترك السكت مع تحقيق الهمزة وصلاً ووقفا."},{"wordId":21022,"position":5,"word":"أَلْقِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21023,"position":6,"word":"عَصَاكَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":21024,"position":7,"word":"فَإِذَا","text":"حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2