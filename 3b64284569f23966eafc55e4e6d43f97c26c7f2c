import{describe,expect,it}from"vitest";import{D1RevisionHistoryStore}from"./d1-revision-history-store.js";import type{D1DatabaseBinding}from"./bindings.js";
function fake(firsts:unknown[]=[]){const sql:string[]=[];const db:D1DatabaseBinding={prepare(s){sql.push(s);return{bind(){return this},first:async()=>firsts.shift() as any??null,all:async()=>({success:true,results:firsts.shift() as any??[]}),run:async()=>({success:true,meta:{changes:1}})}}};return{db,sql}}
describe("D1 revision history",()=>{it("scopes ownership and snapshots to the book",async()=>{const f=fake([{owned:1},{active_source_revision_id:"r",active_build_id:"b",desired_source_revision_id:null,record_version:7},[]]),s=new D1RevisionHistoryStore(f.db);expect(await s.isOwner("book","user")).toBe(true);expect((await s.snapshot("book")).recordVersion).toBe(7);expect(f.sql[0]).toContain("owner_id=?2");expect(f.sql[2]).toContain("WHERE book_id=?1")});it("uses CAS and switches ready builds atomically",async()=>{const f=fake(),s=new D1RevisionHistoryStore(f.db);expect((await s.commitRollback({bookId:"b",operationId:"op",targetRevisionId:"r",buildId:"ready",expectedRecordVersion:4,deviceId:"d"})).recordVersion).toBe(5);expect(f.sql[0]).toContain("record_version=?4");expect(f.sql[0]).toContain("desired_source_revision_id=NULL");expect(f.sql[1]).toContain("INSERT OR IGNORE")});it("enqueues all derivative jobs only on the missing-build path",async()=>{const f=fake(),s=new D1RevisionHistoryStore(f.db);await s.enqueue("b","r");expect(f.sql.filter(x=>x.includes("build_jobs")).length).toBe(5)})});
