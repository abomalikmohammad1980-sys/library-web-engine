{
  "$schema": "../../../../alpha-publish/node_modules/wrangler/config-schema.json",
  "name": "khizana-book-index-jobs-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "BOOK_INDEX_QUEUE_ENABLED": "false", "INDEXNOW_ENABLED": "false", "INDEXNOW_SUBMISSION_APPROVED": "false" },
  "triggers": { "crons": ["* * * * *", "0 */6 * * *"] },
  "d1_databases": [{ "binding": "VISITORS_DB", "database_name": "khizana-bok-acceptance-20260917", "database_id": "9133fe99-c4e1-4a1e-84f3-127735883279" }],
  "queues": {
    "producers": [
      { "binding": "BOOK_INDEX_JOBS", "queue": "book-index-jobs-preview" },
      { "binding": "BOOK_INDEX_DLQ", "queue": "book-index-jobs-preview-dlq" }
    ],
    "consumers": [{ "queue": "book-index-jobs-preview", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 4, "dead_letter_queue": "book-index-jobs-preview-dlq", "max_concurrency": 1 }]
  },
  "services": [{ "binding": "EXTRACTOR", "service": "khizana-book-index-actions-preview" }],
  "observability": { "enabled": true }
}
