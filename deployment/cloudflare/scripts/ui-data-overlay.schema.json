{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alkhizana.invalid/schemas/ui-data-overlay-1.json",
  "title": "Alkhizana unapplied UI data overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "deploymentStatus", "candidatePayloadFingerprint", "corpus", "search"],
  "properties": {
    "contract": { "const": "alkhizana-ui-data-overlay/1" },
    "deploymentStatus": { "const": "expected-not-verified" },
    "candidatePayloadFingerprint": { "$ref": "#/$defs/sha256" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "releaseId", "releaseManifestSha256", "projects"],
      "properties": {
        "contract": { "const": "alkhizana-pages-client/1" },
        "releaseId": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "projects": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/corpusProject" } }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "releaseId", "readyManifestSha256", "sourceManifestSha256", "runtimeConfig", "projects"],
      "properties": {
        "contract": { "const": "shamela-search-v2/pages-ready-1" },
        "releaseId": { "type": "string", "minLength": 1 },
        "readyManifestSha256": { "$ref": "#/$defs/sha256" },
        "sourceManifestSha256": { "$ref": "#/$defs/sha256" },
        "runtimeConfig": {
          "type": "object", "additionalProperties": false, "required": ["controlBaseUrl", "projectBaseUrls"],
          "properties": { "controlBaseUrl": { "type": "string", "format": "uri" }, "projectBaseUrls": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "format": "uri" } } }
        },
        "projects": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/searchProject" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "corpusProject": {
      "type": "object", "additionalProperties": false, "required": ["name", "manifestProject", "baseUrl", "files", "bytes", "assetCount"],
      "properties": { "name": { "const": "khezana-corpus-01" }, "manifestProject": { "const": "corpus-01" }, "baseUrl": { "const": "https://khezana-corpus-01.pages.dev" }, "files": { "type": "integer" }, "bytes": { "type": "integer" }, "assetCount": { "type": "integer" } }
    },
    "searchProject": {
      "type": "object", "additionalProperties": false, "required": ["name", "baseUrl", "deploymentManifestSha256", "files", "bytes", "maxBytes"],
      "properties": { "name": { "type": "string", "pattern": "^khezana-search-v2-0[0-7]$" }, "baseUrl": { "type": "string", "format": "uri" }, "deploymentManifestSha256": { "$ref": "#/$defs/sha256" }, "files": { "type": "integer" }, "bytes": { "type": "integer" }, "maxBytes": { "type": "integer" } }
    }
  }
}
