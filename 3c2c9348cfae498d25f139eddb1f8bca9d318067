import{describe,expect,it}from"vitest";import{createBoundSourceSyncWorker}from"./worker.js";import type{D1DatabaseBinding,SourceSyncCloudflareEnv}from"./bindings.js";
function env(owner="owner",ready=false){const rows=new Map<string,any>();const db:D1DatabaseBinding={prepare(sql){let v:unknown[]=[];return{bind(...x:unknown[]){v=x;return this},first:async()=>{if(sql.includes("FROM devices"))return{active:1};if(sql.includes("owner_id"))return v[1]===owner?{owned:1}:null;if(sql.includes("book_publications"))return{active_source_revision_id:"r2",active_build_id:"b2",desired_source_revision_id:null,record_version:4};if(sql.includes("source_revision_rollbacks"))return rows.get(String(v[1]))??null;if(sql.includes("book_builds"))return ready?{id:"build:r1"}:null;return null},all:async()=>({success:true,results:sql.includes("book_source_revisions")?[{id:"r1",book_id:"book",operation_id:"seed",base_revision_id:null,sha256:"a".repeat(64),byte_length:1,source_name:"x.docx",created_at:"2026-01-01",created_by_device_id:"d",status:"ready"}]:[]}),run:async()=>{if(sql.includes("source_revision_rollbacks"))rows.set(String(v[1]),{target_revision_id:v[2],status:ready?"published":"queued",publication_record_version:5});return{success:true,meta:{changes:1}}}}}};const bucket={head:async()=>null,get:async()=>null,put:async()=>null,delete:async()=>{}};return{DB:db,SOURCE_OBJECTS:bucket,SOURCE_UPLOAD_SIGNING_KEY:"secret",SOURCE_SYNC_PUBLIC_BASE_URL:"https://sync.example",BUILD_SERVICE_TOKEN_CURRENT:"service"}as SourceSyncCloudflareEnv}
const worker=createBoundSourceSyncWorker({identity:{verifyBearer:async t=>({kind:"account",userId:t})},inspection:{inspect:async()=>({kind:"accepted"})},ids:{uploadId:()=>"u",revisionId:()=>"r"}});function rollback(e:SourceSyncCloudflareEnv,op="op",version=4){return worker.fetch(new Request("https://x/books/book/source-revisions/rollback",{method:"POST",headers:{authorization:"Bearer owner","content-type":"application/json"},body:JSON.stringify({operationId:op,targetRevisionId:"r1",expectedRecordVersion:version,deviceId:"d"})}),e)}
describe("bound worker revision history",()=>{it("uses user auth and hides IDOR",async()=>expect((await worker.fetch(new Request("https://x/books/book/source-revisions",{headers:{authorization:"Bearer intruder"}}),env())).status).toBe(404));it("preserves idempotency and enqueues",async()=>{const e=env();expect(await(await rollback(e)).json()).toMatchObject({status:"queued",recordVersion:5});expect(await(await rollback(e)).json()).toMatchObject({status:"queued",recordVersion:5})});it("publishes ready and rejects stale CAS",async()=>{expect(await(await rollback(env("owner",true))).json()).toMatchObject({status:"published"});expect((await rollback(env(),"stale",3)).status).toBe(409)})});
