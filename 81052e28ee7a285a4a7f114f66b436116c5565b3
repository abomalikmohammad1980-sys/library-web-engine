{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":104,"records":[{"ayah":1,"from":1,"to":1,"text":"وبال وشدة عذاب لكثير الاغتياب للناس، والطعن فيهم."},{"ayah":2,"from":2,"to":2,"text":"الذي همّه جمع المال وإحصاؤه، لا همَّ له غير ذلك."},{"ayah":3,"from":3,"to":3,"text":"يظن أن ماله الذي جمعه سينجيه من الموت، فيبقى خالدًا في الحياة الدنيا."},{"ayah":4,"from":4,"to":4,"text":"ليس الأمر كما تصوّر هذا الجاهل، ليطرحنّ في نار جهنم التي تدق وتكسر كل ما طُرِح فيها لشدة بأسها."},{"ayah":5,"from":5,"to":5,"text":"وما أعلمك - أيها الرسول - ما هذه النار التي تحطم كل ما طُرِح فيها؟!"},{"ayah":6,"from":6,"to":6,"text":"إنها نار الله المستعرة."},{"ayah":7,"from":7,"to":7,"text":"التي تنفذ من أجسام الناس إلى قلوبهم."},{"ayah":8,"from":8,"to":8,"text":"إنها على المُعَذَّبين فيها مغلقة."},{"ayah":9,"from":9,"to":9,"text":"بعَمَد ممتدة طويلة حتى لا يخرجوا منها."}]}