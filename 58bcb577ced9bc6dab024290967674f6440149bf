{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":79,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم الله بالملائكة التي تجذب أرواح الكفار بشدة وعنف."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالملائكة التي تستلُّ أرواح المؤمنين بسهولة ويسر."},{"ayah":3,"from":3,"to":3,"text":"وأقسم بالملائكة التي تَسْبَح من السماء إلى الأرض بأمر الله."},{"ayah":4,"from":4,"to":4,"text":"وأقسم بالملائكة التي تسبق بعضها في أداء أمر الله."},{"ayah":5,"from":5,"to":5,"text":"وأقسم بالملائكة التي تنفذ ما أمرهم الله به من قضائه مثل الملائكة الموكلين بأعمال العباد؛ أقسم بذلك كله ليبعثنَّهم للحساب والجزاء."},{"ayah":6,"from":6,"to":6,"text":"يوم تهتزّ الأرض عند النفخة الأولى."},{"ayah":7,"from":7,"to":7,"text":"تتبع هذه النفخة نفخة ثانية."},{"ayah":8,"from":8,"to":8,"text":"قلوب بعض الناس في ذلك اليوم خائفة."},{"ayah":9,"from":9,"to":9,"text":"يظهر على أبصارها أثر الذلة."},{"ayah":10,"from":10,"to":10,"text":"وكانوا يقولون: هل نرجع إلى الحياة بعد أن متنا؟!"},{"ayah":11,"from":11,"to":11,"text":"أإذا كنا عظامًا بالية فارغة نرجع بعد ذلك؟!"},{"ayah":12,"from":12,"to":12,"text":"قالوا: إذا رجعنا تكون تلك الرجعة خاسرة، مغبونًا صاحبها."},{"ayah":13,"from":13,"to":13,"text":"أَمْر البعث يسير، فإنما هي صيحة واحدة من الملك الموكل بالنفخ."},{"ayah":14,"from":14,"to":14,"text":"فإذا الجميع أحياء على وجه الأرض بعد أن كانوا أمواتًا في بطنها."},{"ayah":15,"from":15,"to":15,"text":"هل جاءك - أيها الرسول - خبر موسى مع ربه ومع عدوّه فرعون؟!"},{"ayah":16,"from":16,"to":16,"text":"حين ناداه ربه سبحانه بوادي طُوَى المطهر."},{"ayah":17,"from":17,"to":17,"text":"قال له فيما قال: سرْ إلى فرعون، إنه تجاوز الحد في الظلم والاستكبار."},{"ayah":18,"from":18,"to":18,"text":"فقل له: هل لك - يا فرعون - أن تتطهر من الكفر والمعاصي؟"},{"ayah":19,"from":19,"to":19,"text":"وأرشدك إلى ربك الذي خلقك ورعاك فتخشاه، فتعمل بما يرضيه، وتتجنب ما يسخطه؟"},{"ayah":20,"from":20,"to":20,"text":"فأظهر له موسى عليه السلام العلامة العظمى الدالة على أنه رسول من ربه، وهي اليد والعصا."},{"ayah":21,"from":21,"to":21,"text":"فما كان من فرعون إلا أنه كذّب بهذه العلامة، وعصى ما أمره به موسى عليه السلام."},{"ayah":22,"from":22,"to":22,"text":"ثم أعرض عن الإيمان بما جاء به موسى."},{"ayah":23,"from":23,"to":23,"text":"ورجع يجمع جنوده لمغالبة موسى، فنادى قومه قائلًا:"},{"ayah":24,"from":24,"to":24,"text":"أنا ربكم الأعلى، فلا طاعة لغيري عليكم."},{"ayah":25,"from":25,"to":25,"text":"فأخذه الله فعاقبه في الدنيا بالغرق في البحر، وعاقبه في الآخرة بإدخاله في أشدّ العذاب."},{"ayah":26,"from":26,"to":26,"text":"إن فيما عاقبنا به فرعون في الدنيا والآخرة لموعظة لمن يخشى الله؛ فهو الذي ينتفع بالمواعظ."},{"ayah":27,"from":27,"to":27,"text":"أإيجادكم على الله - أيها المكذبون بالبعث - أصعب، أم إيجاد السماء التي بناها؟!"},{"ayah":28,"from":28,"to":28,"text":"جعل سَمْتها في جهة العلوّ رفيعًا، فجعلها مستوية، لا فطور فيها ولا شقوق ولا عيب."},{"ayah":29,"from":29,"to":29,"text":"وأظلم ليلها إذا غربت شمسها، وأظهر نورها إذا أشرقت."},{"ayah":30,"from":30,"to":30,"text":"والأرض بعد أن خلق السماء بسطها، وأودع فيها منافعها."},{"ayah":31,"from":31,"to":31,"text":"أخرج منها ماءها عيونًا تجري، وأنبت فيها من النبات ما ترعاه الدواب."},{"ayah":32,"from":32,"to":32,"text":"والجبال جعلها ثابتة على الأرض."},{"ayah":33,"from":33,"to":33,"text":"كل ذلك منافع لكم - أيها الناس - ولأنعامكم، فالذي خلق هذا كله لا يعجز عن إعادة خلقهم من جديد."},{"ayah":34,"from":34,"to":34,"text":"فإذا جاءت النفخة الثانية التي تغمر كل شيء بهولها، وقامت القيامة."},{"ayah":35,"from":35,"to":35,"text":"يوم تجيء يتذكر الإنسان ما قدم من عمل، خيرًا كان أو شرًّا."},{"ayah":36,"from":36,"to":36,"text":"وجيء بجهنم وأُظْهِرت عيانًا لمن يبصرها."},{"ayah":37,"from":37,"to":37,"text":"فأما من تجاوز الحدّ في الضلال."},{"ayah":38,"from":38,"to":38,"text":"وفضّل الحياة الدنيا الفانية على الحياة الأخرى الباقية."},{"ayah":39,"from":39,"to":39,"text":"فإن النار هي مستقرّه الذي يأوي إليه."},{"ayah":40,"from":40,"to":40,"text":"٤٠ - ٤١ - وأما من خاف قيامه بين يدي ربه، وكفّ نفسه عن اتباع ما تهواه مما حرّمه الله، فإن الجنة هي مستقرّه الذي يأوي إليه."},{"ayah":41,"from":41,"to":41,"text":"٤٠ - ٤١ - وأما من خاف قيامه بين يدي ربه، وكفّ نفسه عن اتباع ما تهواه مما حرّمه الله، فإن الجنة هي مستقرّه الذي يأوي إليه."},{"ayah":42,"from":42,"to":42,"text":"يسألك - أيها الرسول - هؤلاء المكذبون بالبعث: متى تقع الساعة؟"},{"ayah":43,"from":43,"to":43,"text":"ليس لك علم بها حتى تذكرها لهم، وليس من شأنك ذلك، إنما شأنك الاستعداد لها."},{"ayah":44,"from":44,"to":44,"text":"إلى ربك وحده مُنْتهى علم الساعة."},{"ayah":45,"from":45,"to":45,"text":"إنما أنت منذر من يخشى الساعة؛ لأنه الذي ينتفع بإنذارك."},{"ayah":46,"from":46,"to":46,"text":"كأنهم يوم يرون الساعة مشاهدة، لم يلبثوا في حياتهم الدنيا إلا عشية يوم واحد أو بكرته."}]}