{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":69,"records":[{"ayah":1,"from":1,"to":1,"text":"يذكر الله ساعة البعث التي تحق على الجميع."},{"ayah":2,"from":2,"to":2,"text":"ثم يعظم أمرها بهذا السؤال. أي شيء هي الحاقة؟"},{"ayah":3,"from":3,"to":3,"text":"وما أعلمك ما هذه الحاقة؟"},{"ayah":4,"from":4,"to":4,"text":"كذبت ثمود قوم صالح، وعاد قوم هود، بالقيامة التي تقرع الناس من شدة أهوالها."},{"ayah":5,"from":5,"to":5,"text":"فأما ثمود فقد أهلكهم الله بالصيحة التي بلغت الغاية في الشدة والهول."},{"ayah":6,"from":6,"to":6,"text":"وأما عاد فقد أهلكهم الله بريح شديدة البرد قاسية بلغت الغاية في القسوة عليهم."},{"ayah":7,"from":7,"to":7,"text":"أرسلها الله عليهم مدة سبع ليالٍ وثمانية أيام تفنيهم عن بكرة أبيهم، فترى القوم في ديارهم هَلْكَى مصروعين في الأرض، كأنهم بعد إهلاكهم أصول نخل ساقطة على الأرض بالية."},{"ayah":8,"from":8,"to":8,"text":"فهل ترى لهم نفسًا باقية بعد ما أصابهم من العذاب؟!"},{"ayah":9,"from":9,"to":9,"text":"وجاء فرعون ومن قبله من الأمم، والقرى التي عذبت بقلب عاليها سافلها، وهم قوم لوط، بالأفعال الخاطئة من الشرك والمعاصي."},{"ayah":10,"from":10,"to":10,"text":"فعصى كل منهم رسوله الذي بعث إليهم وكذبوه، فأخذهم الله أَخْذَة زائدة على ما يتمّ به هلاكهم."},{"ayah":11,"from":11,"to":11,"text":"إنا لما تجاوز الماء حدَّه في الارتفاع حملنا من كنتم في أصلابهم في السفينة الجارية التي صنعها نوح عليه السلام بأمرنا، فكان حَمْلًا لكم."},{"ayah":12,"from":12,"to":12,"text":"لنجعل السفينة وقصتها موعظة يُسْتدلّ بها على إهلاك أهل الكفر، وإنجاء أهل الإيمان، وتحفظها أذن حافظة لما تسمع."},{"ayah":13,"from":13,"to":13,"text":"فإذا نفخ الملك الموكل بالنفخ في القرن نفخة واحدة وهي النفخة الثانية."},{"ayah":14,"from":14,"to":14,"text":"ورُفِعت الأرض والجبال، فَدُقَّتا دقَّة واحدة شديدة فَرَّقَت أجزاء الأرض وأجزاء جبالها."},{"ayah":15,"from":15,"to":15,"text":"فيوم يحصل ذلك كله تقع القيامة."},{"ayah":16,"from":16,"to":16,"text":"وتشققت السماء يومئذ لنزول الملائكة منها، فهي في ذلك اليوم ضعيفة بعد أن كانت شديدة متماسكة."},{"ayah":17,"from":17,"to":17,"text":"والملائكة على أطرافها وحافَّاتها، ويحمل عرشَ ربك في ذلك اليوم العظيم ثمانيةٌ من الملائكة المقربين."},{"ayah":18,"from":18,"to":18,"text":"في ذلك اليوم تُعْرَضون - أيها الناس - على الله، لا تخفى على الله منكم خافية أيًّا كانت، بل الله عليم بها مطّلع عليها."},{"ayah":19,"from":19,"to":19,"text":"فأما من أُعْطِي كتاب أعماله بيمينه فهو يقول من السرور والبهجة: خذوا اقرؤوا كتاب أعمالي."},{"ayah":20,"from":20,"to":20,"text":"إني علمت في الدنيا وأيقنت أني مبعوث، وملاقٍ جزائي."},{"ayah":21,"from":21,"to":21,"text":"فهو في عيشة مرضية؛ لما يراه من النعيم الدائم."},{"ayah":22,"from":22,"to":22,"text":"في جنة رفيعة المكان والمكانة."},{"ayah":23,"from":23,"to":23,"text":"ثمارها قريبة ممن يتناولها."},{"ayah":24,"from":24,"to":24,"text":"يقال تكريمًا لهم: كلوا واشربوا أكلًا وشربًا لا أذى فيه بما قدمتم من الأعمال الصالحات في الأيام الماضية في الدنيا."},{"ayah":25,"from":25,"to":25,"text":"وأما من أُعْطِي كتاب أعماله بشماله، فيقول من شدة الندم: يا ليتني لم أعط كتاب أعمالي لما فيه من الأعمال السيئة المستوجبة لعذابي."},{"ayah":26,"from":26,"to":26,"text":"ويا ليتني لم أعرف أي شيء يكون حسابي."},{"ayah":27,"from":27,"to":27,"text":"يا ليت الموتة التي متّها كانت الموتة التي لا أُبْعَث بعدها أبدًا."},{"ayah":28,"from":28,"to":28,"text":"لم يدفع عني مالي من عذاب الله شيئًا."},{"ayah":29,"from":29,"to":29,"text":"غابت عني حجتي وما كنت أعتمد عليه من قوة وجاهٍ."},{"ayah":30,"from":30,"to":30,"text":"ويقال: خذوه - أيها الملائكة - واجمعوا يده إلى عنقه."},{"ayah":31,"from":31,"to":31,"text":"ثم أدخلوه النار ليعاني حرّها."},{"ayah":32,"from":32,"to":32,"text":"ثم أدخلوه في سلسلة طولها سبعون ذراعًا."},{"ayah":33,"from":33,"to":33,"text":"إنه كان لا يؤمن بالله العظيم."},{"ayah":34,"from":34,"to":34,"text":"ولا يحثّ غيره على إطعام المسكين."},{"ayah":35,"from":35,"to":35,"text":"فليس له يوم القيامة قريب يدفع عنه العذاب."},{"ayah":36,"from":36,"to":36,"text":"وليس له طعام يطعمه إلا من عصارة أبدان أهل النار."},{"ayah":37,"from":37,"to":37,"text":"لا يأكل ذلك الطعام إلا أصحاب الذنوب والمعاصي."},{"ayah":38,"from":38,"to":38,"text":"أَقسم الله بما تشاهدون."},{"ayah":39,"from":39,"to":39,"text":"وأقسم بما لا تشاهدون."},{"ayah":40,"from":40,"to":40,"text":"إن القرآن لكلام الله، يتلوه على الناس رسوله الكريم."},{"ayah":41,"from":41,"to":41,"text":"وليس بقول شاعر؛ لأنه ليس على نظم الشعر، قليلًا ما تؤمنون."},{"ayah":42,"from":42,"to":42,"text":"وليس بقول كاهن، فكلام الكهان أمر مُغَايِر لهذا القرآن، قليلًا ما تتذكرون."},{"ayah":43,"from":43,"to":43,"text":"ولكنه منزّل من رب الخلائق كلهم."},{"ayah":44,"from":44,"to":44,"text":"ولو تَقَوَّل علينا محمد بعض الأقاويل التي لم نقلها."},{"ayah":45,"from":45,"to":45,"text":"لانتقمنا منه وأخذنا منه بالقوة منا والقدرة."},{"ayah":46,"from":46,"to":46,"text":"ثم لقطعنا منه العِرْق المتصل بالقلب."},{"ayah":47,"from":47,"to":47,"text":"فليس منكم من يمنعنا منه، فبعيد أن يَتَقَوَّل علينا من أجلكم."},{"ayah":48,"from":48,"to":48,"text":"وإن القرآن لموعظة للمتقين لربهم بامتثال أوامره واجتناب نواهيه."},{"ayah":49,"from":49,"to":49,"text":"وإنا لنعلم أن من بينكم مَنْ يكذب بهذا القرآن."},{"ayah":50,"from":50,"to":50,"text":"وإن التكذيب بالقرآن لندامة عظيمة يوم القيامة."},{"ayah":51,"from":51,"to":51,"text":"وإن القرآن لهو حق اليقين الذي لا مِرْية ولا ريب أنه من عند الله."},{"ayah":52,"from":52,"to":52,"text":"فنزِّه - أيها الرسول - ربك عما لا يليق به، واذكر اسم ربك العظيم."}]}