import type { ServiceInstallPlan,ServicePlatform } from "./service-descriptors.js";
export interface ServiceFilePort{assertSafeTarget(path:string):Promise<void>;writeAtomic(path:string,content:string):Promise<void>;remove(path:string):Promise<void>}
export interface ServiceCommandPort{run(executable:string,args:readonly string[]):Promise<void>}
export interface ServiceInstallRequest{plan:ServiceInstallPlan;descriptorPath:string;confirm:boolean;dryRun?:boolean;actualPlatform:NodeJS.Platform}
const args=(xs:readonly string[],path:string)=>xs.map(x=>x==="<descriptor-path>"?path:x);
export async function applyServicePlan(r:ServiceInstallRequest,files:ServiceFilePort,commands:ServiceCommandPort){if(r.plan.platform!==r.actualPlatform)throw Error("platform mismatch");if(!r.confirm&&r.dryRun===false)throw Error("--confirm is required");if(r.dryRun!==false)return{applied:false,plan:r.plan};const written=r.plan.operation==="install"&&r.plan.descriptor!==undefined;try{await files.assertSafeTarget(r.descriptorPath);if(written)await files.writeAtomic(r.descriptorPath,r.plan.descriptor!);for(const c of r.plan.commands)await commands.run(c.executable,args(c.args,r.descriptorPath));if(r.plan.operation==="uninstall")await files.remove(r.descriptorPath);return{applied:true,plan:r.plan}}catch(error){if(r.plan.operation==="install")for(const c of r.plan.rollbackCommands)await commands.run(c.executable,args(c.args,r.descriptorPath)).catch(()=>{});if(written)await files.remove(r.descriptorPath).catch(()=>{});throw error}}
