ْلَهَا، مِنْ مَادَّةِ: (جيأ) .\n\nالرُّسُلُ: {الرُّسُلُ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (رَسُولٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعُلٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nبَيْنِ: {بَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بين) .\n\nأَيْدِيهِمْ: {أَيْدِي} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَدٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مَنْقُوصٌ، عَلَى وَزْنِ: (أَفْعُلٌ) ، مِنْ مَادَّةِ: (يدي) .\n\nوَمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nخَلْفِهِمْ: {خَلْفِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (خلف) .\n\nأَلَّا: {أَنْ} : حَرْفٌ مَبْنِيٌّ، {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nتَعْبُدُوا: {تَعْبُدُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، مِنْ مَادَّةِ: (عبد) .\n\nإِلَّا: {إِلَّا} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nقَالُوا: {قَالُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nلَوْ: {لَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nشَاءَ: {شَاءَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ اللَّامِ، أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، أَصْلُهُ: (شَيِئَ) ، عَلَى وَزْنِ: (فَعِلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (شيأ) .\n\nرَبُّنَا: {رَبُّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ