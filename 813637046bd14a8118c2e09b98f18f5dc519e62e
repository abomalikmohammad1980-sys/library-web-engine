لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nالَّذِينَ: {الَّذِينَ} : اسْمٌ مَبْنِيٌّ.\n\nكَفَرُوا: {كَفَرُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (كفر) .\n\nرَبَّنَا: {رَبَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nأَرِنَا: {أَرِ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، مِنْ مَادَّةِ: (رأي) .\n\nاللَّذَيْنِ: {اللَّذَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُثَنًّى، جَامِدٌ، مِنْ مَادَّةِ: (الذي) .\n\nأَضَلَّانَا: {أَضَلَّا} : فِعْلٌ مَاضٍ لِلْغَائِبَيْنِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَضْلَلَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (ضلل) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالْجِنِّ: {الْجِنِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (جنن) .\n\nوَالْإِنْسِ: {الْإِنْسِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (أنس) .\n\nنَجْعَلْهُمَا: {نَجْعَلْ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: النُّونِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (نَفْعَلُ) ، مِنْ مَادَّةِ: (جعل) .\n\nتَحْتَ: {تَحْتَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (تحت) .\n\nأَقْدَامِنَا: {أَقْدَامِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (قَدَمٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (قدم) .\n\nلِيَكُونَا: {يَكُونَا} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَيْنِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَكْوُنُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالْأَسْفَلِينَ: {الْأَسْفَلِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (أَسْفَلُ) ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (سَفُلَ يَسْفُلُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَلُ) ، مِنْ مَادَّةِ: (سفل) .","words":[{"wordId":61754,"position":1,"word":"وَقَالَ","text":"{قَالَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) ."},{"wordId":61755,"position":2,"word":"الَّذِينَ","text":"{الَّذِينَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":61756,"position":3,"word":"كَفَرُوا","text":"{كَفَرُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (كفر) ."},{"wordId":61757,"position":4,"word":"رَبَّنَا","text":"{رَبَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَاد