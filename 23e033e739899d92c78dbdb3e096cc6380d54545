ْنِيٌّ.\n\nالنُّورِ: {النُّورِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (نور) .\n\nوَكَانَ: {كَانَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nبِالْمُؤْمِنِينَ: {الْمُؤْمِنِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُؤْمِنٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (آمَنَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَأْمِنٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (أمن) .\n\nرَحِيمًا: {رَحِيمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (رَحِمَ يَرْحَمُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (رحم) .","words":[{"wordId":54488,"position":1,"word":"هُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":54489,"position":2,"word":"الَّذِي","text":"{الَّذِي} : اسْمٌ مَبْنِيٌّ."},{"wordId":54490,"position":3,"word":"يُصَلِّي","text":"{يُصَلِّي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، أَصْلُهُ: (يُصَلِّوُ) ، عَلَى وَزْنِ: (يُفَعِّلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (صلو) ."},{"wordId":54491,"position":4,"word":"عَلَيْكُمْ","text":"{عَلَى} : حَرْفٌ مَبْنِيٌّ."},{"wordId":54492,"position":5,"word":"وَمَلَائِكَتُهُ","text":"{مَلَائِكَةُ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْج