ِينًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَبَانَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَبْيِنٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (بين) ."}]},{"ayah":59,"from":59,"to":59,"text":"يَاأَيُّهَا: {يَا} : حَرْفٌ مَبْنِيٌّ، {أَيٌّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أي) .\n\nالنَّبِيُّ: {النَّبِيُّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَنْبَأَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (نبأ) .\n\nقُلْ: {قُلْ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (اقْوُلْ) ، عَلَى وَزْنِ: (افْعُلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (قول) .\n\nلِأَزْوَاجِكَ: {أَزْوَاجِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (زَوْجٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (زوج) .\n\nوَبَنَاتِكَ: {بَنَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (بِنْتٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (بِنْتٌ) ، عَلَى وَزْنِ: (فِعْتٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (بنو) .\n\nوَنِسَاءِ: {نِسَاءِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (لَمْ يُسْمَعْ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (نِسَاوٌ) ، عَلَى وَزْنِ: (فِعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (نسو) .\n\nالْمُؤْمِنِينَ: {الْمُؤْمِنِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُؤْمِنٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (آمَنَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَأْمِنٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (أمن) .\n\nيُدْنِينَ: {يُدْنِينَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَاتِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، مِنْ مَادَّةِ: (دنو) .\n\nعَلَيْهِنَّ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nجَلَابِيبِهِنَّ: {جَلَابِيبِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (جِلْبَابٌ) ، جَامِدٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْيَاءِ، عَلَى وَزْنِ: (فَعَالِيلُ) ، مِنْ مَادَّةِ: (جلب) .\n\nذَلِكَ: {ذَلِكَ} : اسْمٌ مَبْنِيٌّ.\n\nأَدْنَى: {أَدْنَى} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (دَنَا يَدْنُو) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مَقْصُورٌ، أَصْلُهُ: (أَدْنَوُ) ، عَلَى وَزْنِ: (أَفْعَلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (دنو) .\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nيُعْرَفْنَ: {يُعْرَفْنَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَاتِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (يُفْعَلُ) ، مِنْ مَادَّةِ: (عرف) .\n\nفَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nيُؤْذَيْنَ: {يُؤْذَيْنَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَاتِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْفَاءِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَأْذَيُ) ، عَلَى وَزْنِ: (يُؤَفْعَلُ)