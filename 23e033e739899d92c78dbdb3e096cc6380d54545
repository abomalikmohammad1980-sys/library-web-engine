ِيٌّ.\n\nبُيُوتِكُنَّ: {بُيُوتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (بَيْتٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فُعُولٌ) ، مِنْ مَادَّةِ: (بيت) .\n\nوَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nتَبَرَّجْنَ: {تَبَرَّجْنَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبَاتِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (تَفَعَّلَ) ، عَلَى وَزْنِ: (تَتَفَعَّلُ) ، وَفِيهِ حَذْفُ إِحْدَى التَّاءَيْنِ مِنَ الْمُضَارِعِ لِلتَّخْفِيفِ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (برج) .\n\nتَبَرُّجَ: {تَبَرُّجَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الْخُمَاسِيِّ: (تَبَرَّجَ) ، مِنْ بَابِ: (تَفَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: التَّاءِ وَحَرْفٍ مُضَعَّفٍ، عَلَى وَزْنِ: (تَفَعُّلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (برج) .\n\nالْجَاهِلِيَّةِ: {الْجَاهِلِيَّةِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (جَهِلَ يَجْهَلُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فَاعِلَةٌ) ، مِنْ مَادَّةِ: (جهل) .\n\nالْأُولَى: {الْأُولَى} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَقْصُورٌ، أَصْلُهُ: (أُولَى) ، عَلَى وَزْنِ: (فُعْلَى) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (أول) .\n\nوَأَقِمْنَ: {أَقِمْنَ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبَاتِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَقْوِمْ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِالْتِقَاءِ السَّاكِنَيْنِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (قوم) .\n\nالصَّلَاةَ: {الصَّلَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (صَلَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (صلو) .\n\nوَآتِينَ: {آتِينَ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبَاتِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْفَاءِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَأْتِي) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أتي) .\n\nالزَّكَاةَ: {الزَّكَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (زَكَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (زكو) .\n\nوَأَطِعْنَ: {أَطِعْنَ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبَاتِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَطْوِعْ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِالْتِقَاءِ السَّاكِنَيْنِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (طوع) .\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَرَسُولَهُ: {رَسُولَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nإِنَّمَا: {إِنَّ} : حَرْفٌ مَبْنِيٌّ، {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nيُرِيدُ: {يُرِيدُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَرْوِدُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (رود) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nلِيُذْهِبَ: {يُذْهِبَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَذْهِبُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (ذهب) .\n\nعَنْكُمُ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالرِّجْسَ: {الرِّجْسَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (رجس) .\n\nأَهْلَ: {أَهْلَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أهل) .\n\nالْبَيْتِ: {الْبَيْتِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بيت) .\n\nوَيُطَهِّرَكُمْ: {يُطَهِّرَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (يُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (طهر) .\n\nتَطْهِيرًا: {تَطْهِيرًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (طَهَّرَ) ، مِنْ بَابِ: (فَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْيَاءِ، عَلَى وَزْنِ: (تَفْعِيلٌ) ، مِنْ مَادَّةِ: (طهر) .","words":[{"wordId":54285,"position":1,"word":"وَقَرْنَ","text":"{قَرْنَ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبَاتِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (اقْرِرْ) ، عَلَى وَزْنِ: (افْعِلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: عَيْنِ الْمُضَعَّفِ لِلتَّخْفِيفِ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (قرر) ."},{"wordId":54286,"position":2,"word":"فِي","text":"{فِي} : حَرْفٌ مَبْنِيٌّ."},{"wordId":54287,"position":3,"word":"بُيُوتِكُنَّ","text":