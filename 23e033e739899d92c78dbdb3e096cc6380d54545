َكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُنَافِقٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (نَافَقَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْمِيمِ، عَلَى وَزْنِ: (مُفَاعِلٌ) ، مِنْ مَادَّةِ: (نفق) .\n\nوَالَّذِينَ: {الَّذِينَ} : اسْمٌ مَبْنِيٌّ.\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nقُلُوبِهِمْ: {قُلُوبِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (قَلْبٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فُعُولٌ) ، مِنْ مَادَّةِ: (قلب) .\n\nمَرَضٌ: {مَرَضٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (مَرِضَ يَمْرَضُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (مرض) .\n\nمَا: {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nوَعَدَنَا: {وَعَدَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (وعد) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَرَسُولُهُ: {رَسُولُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nإِلَّا: {إِلَّا} : حَرْفٌ مَبْنِيٌّ.\n\nغُرُورًا: {غُرُورًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (غَرَّ يَغُرُّ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فُعُولٌ) ، مِنْ مَادَّةِ: (غرر) .","words":[{"wordId":53917,"position":1,"word":"وَإِذْ","text":"{إِذْ} : اسْمٌ مَبْنِيٌّ."},{"wordId":53918,"position":2,"word":"يَقُولُ","text":"{يَقُولُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَقْوُلُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) ."