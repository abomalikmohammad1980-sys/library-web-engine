ه وصلاً، ووقف بالسكت، والنقل، وتركهما. خلاد عن حمزة قرأ بترك السكت وصلاً، ووقف بالنقل والتحقيق. باقي الرواة قرؤوا بترك السكت مع تحقيق الهمزة وصلاً ووقفا."}]},{"ayah":95,"from":95,"to":95,"text":"إِنَّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nهَذَا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nلَهُوَ: قالون عن نافع وَأبو جعفر وَأبو عمرو وَالكسائي قرأ بإسكان الهاء، مع ترك الوقف بهاء السكت. يعقوب قرأ بضم الهاء مع الوقف بهاء السكت باتفاق. باقي الرواة قرؤوا بضم الهاء وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nحَقُّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالْيَقِينِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":69263,"position":1,"word":"إِنَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69264,"position":2,"word":"هَذَا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69265,"position":3,"word":"لَهُوَ","text":"قالون عن نافع وَأبو جعفر وَأبو عمرو وَالكسائي قرأ بإسكان الهاء، مع ترك الوقف بهاء السكت. يعقوب قرأ بضم الهاء مع الوقف بهاء السكت باتفاق. باقي الرواة قرؤوا بضم الهاء وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69266,"position":4,"word":"حَقُّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69267,"position":5,"word":"الْيَقِينِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"}]},{"ayah":96,"from":96,"to":96,"text":"فَسَبِّحْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nبِاسْمِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nرَبِّكَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالْعَظِيمِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعند وصل السورة\nورش عن نافع وَأبو عمرو وَيعقوب وَابن عامر فصل بين السورتين بالبسملة، والوصل، والسكت، وله ما بين الآيات من أحكام الوصل. حمزة وَخلف العاشر قرأ بالوصل بين السورتين بلا بسملة، وله ما بين الآيات من أحكام الوصل. باقي الرواة فصل بالبسملة بين السورتين.","words":[{"wordId":69268,"position":1,"word":"فَسَبِّحْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69269,"position":2,"word":"بِاسْمِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69270,"position":3,"word":"رَبِّكَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":69271,"position":4,"word":"الْعَظِيمِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعند وصل السورة\nورش عن نافع وَأبو عمرو وَيعقوب وَابن عامر فصل بين السورتين بالبسملة، والوصل، والسكت، وله ما بين الآيات من أحكام الوصل. حمزة وَخلف العاشر قرأ بالوصل بين السورتين بلا بسملة، وله ما بين الآيات من أحكام الوصل. باقي الرواة فصل بالبسملة بين السورتين."}]}]}