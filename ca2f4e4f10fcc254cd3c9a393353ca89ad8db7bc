َرْفِ: الْوَاوِ يَاءً لِوُقُوعِ الْوَاوِ لَامًا لِفُعْلَى، مِنْ مَادَّةِ: (دنو) .\n\nوَزِينَتَهَا: {زِينَةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، مِنْ مَادَّةِ: (زين) .\n\nنُوَفِّ: {نُوَفِّ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَفْرُوقٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: النُّونِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (نُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (وفي) .\n\nإِلَيْهِمْ: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nأَعْمَالَهُمْ: {أَعْمَالَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (عَمَلٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (عمل) .\n\nفِيهَا: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nوَهُمْ: {هُمْ} : اسْمٌ مَبْنِيٌّ.\n\nفِيهَا: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nيُبْخَسُونَ: {يُبْخَسُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (يُفْعَلُ) ، مِنْ مَادَّةِ: (بخس) .","words":[{"wordId":28349,"position":1,"word":"مَنْ","text":"{مَنْ} : اسْمٌ مَبْنِيٌّ."},{"wordId":28350,"position":2,"word":"كَانَ","text":"{كَانَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) ."},{"wordId":28351,"position":3,"word":"يُرِيدُ","text":"{يُرِيدُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَرْوِدُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَر