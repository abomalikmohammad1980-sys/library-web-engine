ٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَخْزِيُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (خزي) .\n\nوَمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nكَاذِبٌ: {كَاذِبٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَذَبَ يَكْذِبُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (كذب) .\n\nوَارْتَقِبُوا: {ارْتَقِبُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، عَلَى وَزْنِ: (افْتَعِلْ) ، مِنْ مَادَّةِ: (رقب) .\n\nإِنِّي: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nمَعَكُمْ: {مَعَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (مع) .\n\nرَقِيبٌ: {رَقِيبٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (رَقَبَ يَرْقُبُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (رقب) .","words":[{"wordId":29630,"position":1,"word":"وَيَاقَوْمِ","text":"{يَا} : حَرْفٌ مَبْنِيٌّ، {قَوْمِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) ."},{"wordId":29631,"position":2,"word":"اعْمَلُوا","text":"{اعْمَلُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (افْعَلْ) ، مِنْ مَادَّةِ: (عمل) ."},{"wordId":29632,"position":3,"word":"عَلَى","text":"{عَلَى} : حَرْفٌ مَبْنِيٌّ."},{"wordId":29633,"position":4,"word":"مَكَانَتِكُمْ","text":"{مَكَانَةِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْمِيمِ، أَصْلُهُ: (مَكْوَنَةٌ) ، عَلَى وَزْنِ: (مَفْعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: ا