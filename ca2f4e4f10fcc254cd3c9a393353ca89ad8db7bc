َعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، مِنْ مَادَّةِ: (علم) .\n\nأَنْتَ: {أَنْتَ} : اسْمٌ مَبْنِيٌّ.\n\nوَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nقَوْمُكَ: {قَوْمُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nقَبْلِ: {قَبْلِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قبل) .\n\nهَذَا: {هَذَا} : اسْمٌ مَبْنِيٌّ.\n\nفَاصْبِرْ: {اصْبِرْ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (افْعِلْ) ، مِنْ مَادَّةِ: (صبر) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nالْعَاقِبَةَ: {الْعَاقِبَةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فَاعِلَةٌ) ، مِنْ مَادَّةِ: (عقب) .\n\nلِلْمُتَّقِينَ: {الْمُتَّقِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُتَّقٍ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الْخُمَاسِيِّ: (اتَّقَى) ، مِنْ بَابِ: (افْتَعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْمِيمِ، مَنْقُوصٌ، أَصْلُهُ: (مُوتَقِيٌ) ، عَلَى وَزْنِ: (مُفْتَعِلٌ) ، فِيهِ إِبْدَالُ حَرْفِ: الْوَاوِ تَاءً، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (وقي) .","words":[{"wordId":28928,"position":1,"word":"تِلْكَ","text":"{تِلْكَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":28929,"position":2,"word":"مِنْ","text":"{مِنْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":28930,"position":3,"word":"أَنْبَاءِ","text":"{أَنْبَاءِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (نَبَأٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، مَمْدُودٌ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (نبأ) ."},{"wordId":28931,"position":4,"word":"الْغَيْبِ","text":"{الْغَيْبِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى 