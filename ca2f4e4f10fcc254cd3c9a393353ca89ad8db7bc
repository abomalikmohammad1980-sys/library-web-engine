 ، مِنْ مَادَّةِ: (رهط) .\n\nأَعَزُّ: {أَعَزُّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (عَزَّ يَعِزُّ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، أَصْلُهُ: (أَعْزَزُ) ، عَلَى وَزْنِ: (أَفْعَلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (عزز) .\n\nعَلَيْكُمْ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَاتَّخَذْتُمُوهُ: {اتَّخَذْتُمْ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (اأْتَخَذَ) ، عَلَى وَزْنِ: (افْتَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ يَاءً لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، وَفِيهِ إِبْدَالُ حَرْفِ: الْيَاءِ تَاءً، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أخذ) .\n\nوَرَاءَكُمْ: {وَرَاءَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (وَرَايٌ) ، عَلَى وَزْنِ: (فَعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (وري) .\n\nظِهْرِيًّا: {ظِهْرِيًّا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (ظهر) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nرَبِّي: {رَبِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nبِمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nتَعْمَلُونَ: {تَعْمَلُونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، مِنْ مَادَّةِ: (عمل) .\n\nمُحِيطٌ: {مُحِيطٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَحَاطَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَحْوِطٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (حوط) .","words":[{"wordId":29615,"position":1,"word":"قَالَ","text":"{قَالَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) ."},{"wordId":29616,"position":2,"word":"يَاقَوْمِ","text":"{يَا} : حَرْفٌ مَبْنِيٌّ، {قَوْمِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) ."},{"wordId":29617,"position":3,"word":"أَرَهْطِي","text":"{رَهْطِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (رهط) ."},{"wordId":29618,"position":4,"word":"أَعَزُّ","text":"{أَعَزُّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (عَزَّ يَعِزُّ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، أَصْلُهُ: (أَعْزَزُ) ، عَلَى وَزْنِ: (أَفْعَلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (عزز) ."},{"wordId":29619,"position":5,"word":"عَلَيْكُمْ","text":"{عَلَى} : حَرْفٌ مَبْنِيٌّ."},{"wordId":29620,"position":6,"word":"مِنَ","text":"{مِنْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":29621,"position":7,"word":"اللَّهِ","text":"{اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) ."},{"wordId":29622,"position":8,"word":"وَاتَّخَذْتُمُوهُ","text":"{اتَّخَذْتُمْ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِينِ، مَب