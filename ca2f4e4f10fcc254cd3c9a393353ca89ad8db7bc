َامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nلَجَعَلَ: {جَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nالنَّاسَ: {النَّاسَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (نَوَسٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (نوس) .\n\nأُمَّةً: {أُمَّةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فُعْلَةٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أمم) .\n\nوَاحِدَةً: {وَاحِدَةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فَاعِلَةٌ) ، مِنْ مَادَّةِ: (وحد) .\n\nوَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nيَزَالُونَ: {يَزَالُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، أَصْلُهُ: (يَزْيَلُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْفَتْحَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (زيل) .\n\nمُخْتَلِفِينَ: {مُخْتَلِفِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُخْتَلِفٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الْخُمَاسِيِّ: (اخْتَلَفَ) ، مِنْ بَابِ: (افْتَعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْمِيمِ، عَلَى وَزْنِ: (مُفْتَعِلٌ) ، مِنْ مَادَّةِ: (خلف) .","words":[{"wordId":29961,"position":1,"word":"وَلَوْ","text":"{لَوْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":29962,"position":2,"word":"شَاءَ","text":"{شَاءَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ اللَّامِ، أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَ