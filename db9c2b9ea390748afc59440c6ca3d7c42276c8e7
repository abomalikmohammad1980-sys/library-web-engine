export interface AudioCacheEntry{cacheKey:string;byteLength:number;downloadedRanges:readonly{start:number;endExclusive:number}[];complete:boolean;pinned:boolean;lastAccessedAt:string;checksumSha256:string|null}
export function validateAudioCacheEntry(entry:AudioCacheEntry){if(!entry.cacheKey||!Number.isSafeInteger(entry.byteLength)||entry.byteLength<0||!Number.isFinite(Date.parse(entry.lastAccessedAt))||entry.checksumSha256!==null&&!/^[a-f0-9]{64}$/.test(entry.checksumSha256))throw Error("audio_cache_entry_invalid");let end=0;for(const range of entry.downloadedRanges){if(!Number.isSafeInteger(range.start)||!Number.isSafeInteger(range.endExclusive)||range.start<end||range.endExclusive<=range.start||range.endExclusive>entry.byteLength)throw Error("audio_cache_range_invalid");end=range.endExclusive}if(entry.complete&&(entry.downloadedRanges.length!==1||entry.downloadedRanges[0]!.start!==0||entry.downloadedRanges[0]!.endExclusive!==entry.byteLength||!entry.checksumSha256))throw Error("audio_cache_complete_invalid");return entry}
export function planAudioCacheEviction(entries:readonly AudioCacheEntry[],budgetBytes:number){if(!Number.isSafeInteger(budgetBytes)||budgetBytes<0)throw Error("audio_cache_budget_invalid");for(const entry of entries)validateAudioCacheEntry(entry);const total=entries.reduce((sum,item)=>sum+item.downloadedRanges.reduce((n,r)=>n+r.endExclusive-r.start,0),0);let retained=total;const evict:string[]=[];for(const entry of [...entries].filter(item=>!item.pinned).sort((a,b)=>Date.parse(a.lastAccessedAt)-Date.parse(b.lastAccessedAt)||a.cacheKey.localeCompare(b.cacheKey))){if(retained<=budgetBytes)break;retained-=entry.downloadedRanges.reduce((n,r)=>n+r.endExclusive-r.start,0);evict.push(entry.cacheKey)}return{evict,retainedBytes:retained,overBudget:retained>budgetBytes}}
export interface AudioTimingManifest{schemaVersion:1;timingId:string;workId:string;sourceUrl:string;sourceChecksumSha256:string;durationMs:number;segments:readonly{segmentId:string;chapterId:string;startMs:number;endMs:number;transcriptRef:string|null}[]}
export function validateAudioTimingManifest(value:AudioTimingManifest){if(value.schemaVersion!==1||!value.timingId||!value.workId||new URL(value.sourceUrl).protocol!=="https:"||!/^[a-f0-9]{64}$/.test(value.sourceChecksumSha256)||!Number.isSafeInteger(value.durationMs)||value.durationMs<1)throw Error("audio_timing_invalid");let end=0;const ids=new Set<string>();for(const item of value.segments){if(!item.segmentId||!item.chapterId||ids.has(item.segmentId)||!Number.isSafeInteger(item.startMs)||!Number.isSafeInteger(item.endMs)||item.startMs<end||item.endMs<=item.startMs||item.endMs>value.durationMs)throw Error("audio_timing_segment_invalid");ids.add(item.segmentId);end=item.endMs}return value}
