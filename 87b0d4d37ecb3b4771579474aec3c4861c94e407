{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":37,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم بالملائكة التي تصُفُّ في عبادتها مُتَراصَّة."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالملائكة التي تزجر السحاب، وتسوقه إلى حيث يشاء الله له أن ينزِل."},{"ayah":3,"from":3,"to":3,"text":"وأقسم بالملائكة الذين يتلون كلام الله."},{"ayah":4,"from":4,"to":4,"text":"إن معبودكم بحق - أيها الناس - لواحد لا شريك له، وهو الله."},{"ayah":5,"from":5,"to":5,"text":"رب السماوات، ورب الأرض، ورب ما بينهما، ورب الشمس في مطالعها ومغاربها طول السنة."},{"ayah":6,"from":6,"to":6,"text":"إنا جمَّلنا أقرب السماوات إلى الأرض بزينة جميلة هي الكواكب التي هي في النظر كالجواهر المتلألئة."},{"ayah":7,"from":7,"to":7,"text":"وحفظنا السماء الدنيا بالنجوم من كل شيطان متمرد خارج عن الطاعة؛ فيُرْمَى بها."},{"ayah":8,"from":8,"to":8,"text":"لا يستطيع هؤلاء الشياطين أن يسمعوا الملائكة في السماء إذا تكلموا بما يوحيه إليهم ربهم من شرعه ولا من قدره، ويُرمون بالشُّهُب من كل جانب."},{"ayah":9,"from":9,"to":9,"text":"طردًا لهم وإبعادًا عن الاستماع إليهم، ولهم في الآخرة عذاب مؤلم دائم لا ينقطع."},{"ayah":10,"from":10,"to":10,"text":"إلا من اختطف من الشياطين خَطْفة، وهي كلمة مما يتفاوض فيه الملائكة ويدور بينهم مما لم يصل علمه إلى أهل الأرض، فيتبعه شهاب مضيء يحرقه، وربما يلقي تلك الكلمة قبل أن يحرقه الشهاب إلى إخوانه فتصل إلى الكهان، فيكذبون معها مئة كذبة."},{"ayah":11,"from":11,"to":11,"text":"فاسأل - يا محمد - الكفار المنكرين للبعث: أهم أشد خلقًا وأقوى أجسامًا وأعظم أعضاءً ممن خلقنا من السماوات والأرض والملائكة؟ إنا خلقناهم من طين لَزِج، فكيف ينكرون البعث، وهم مخلوقون من خلق ضعيف وهو الطين اللزِج؟"},{"ayah":12,"from":12,"to":12,"text":"بل عجبتَ - يا محمد - من قدرة الله وتدبيره لشؤون خلقه، وعجبتَ من تكذيب المشركين بالبعث، وهؤلاء المشركون من شدة تكذيبهم بالبعث يسخرون مما تقول بشأنه."},{"ayah":13,"from":13,"to":13,"text":"وإذا وُعظ هؤلاء المشركون بموعظة من المواعظ لم يتعظوا بها، ولم ينتفعوا؛ لما هم عليه من قساوة القلوب."},{"ayah":14,"from":14,"to":14,"text":"وإذا شاهدوا آية من آيات النبي صلّى الله عليه وسلّم الدالة على صدقه بالغوا في السخرية والتعجب منها."},{"ayah":15,"from":15,"to":15,"text":"وقالوا: ما هذا الذي جاء به محمد إلا سحر واضح."},{"ayah":16,"from":16,"to":16,"text":"فإذا متنا وصرنا ترابًا وعظامًا بالية متفتتة أإنا لمبعوثون أحياء بعد ذلك؟! إن هذا لمستبعد."},{"ayah":17,"from":17,"to":17,"text":"أَوَيُبعث آباؤنا الأولون الذين ماتوا قبلنا؟!"},{"ayah":18,"from":18,"to":18,"text":"قل - يا محمد - مجيبًا إياهم: نعم تبعثون بعد أن صرتم ترابًا وعظامًا بالية، ويُبْعث آباؤكم الأولون، تُبْعثون جميعًا وأنتم صاغرون ذليلون."},{"ayah":19,"from":19,"to":19,"text":"فإنما هي نفخة واحدة في الصور (النفخة الثانية) فإذا هم جميعًا ينظرون إلى أهوال يوم القيامة يترقبون ما يفعل الله بهم."},{"ayah":20,"from":20,"to":20,"text":"وقال المشركون المكذبون بالبعث: يا هلاكنا هذا يوم الجزاء الذي يجازي فيه الله عباده على ما قدموا في حياتهم الدنيا من عمل."},{"ayah":21,"from":21,"to":21,"text":"فيقال لهم: هذا يوم القضاء بين العباد الذي كنتم تنكرونه وتكذبون به في الدنيا."},{"ayah":22,"from":22,"to":22,"text":"٢٢ - ٢٣ - ويقال للملائكة في ذلك اليوم: اجمعوا المشركين الظالمين بشركهم هم وأشباههم في الشرك والمُشايعون لهم في التكذيب، وما كانوا يعبدونه من دون الله من الأصنام، فعرِّفوهم طريق النار ودلوهم عليها وسوقوهم إليها، فإنها مصيرهم."},{"ayah":23,"from":23,"to":23,"text":"٢٢ - ٢٣ - ويقال للملائكة في ذلك اليوم: اجمعوا المشركين الظالمين بشركهم هم وأشباههم في الشرك والمُشايعون لهم في التكذيب، وما كانوا يعبدونه من دون الله من الأصنام، فعرِّفوهم طريق النار ودلوهم عليها وسوقوهم إليها، فإنها مصيرهم."},{"ayah":24,"from":24,"to":24,"text":"واحبسوهم قبل إدخالهم النار للحساب، فهم مسؤولون، ثم بعد ذلك سوقوهم إلى النار."},{"ayah":25,"from":25,"to":25,"text":"ويقال لهم توبيخًا لهم: ما بالكم لا ينصر بعضكم بعضًا كما كنتم في الدنيا تتناصرون، وتزعمون أن أصنامكم تنصركم؟!"},{"ayah":26,"from":26,"to":26,"text":"بل هم اليوم منقادون لأمر الله ذليلون، لا ينصر بعضهم بعضًا لعجزهم وقلة حيلتهم."},{"ayah":27,"from":27,"to":27,"text":"وأقبل بعضهم على بعض يتلاومون ويتخاصمون حين لا ينفع التلاوم والتخاصم."},{"ayah":28,"from":28,"to":28,"text":"قال الأتباع للمتبوعين: إنكم - يا كبراءنا - كنتم تأتوننا من جهة الدين والحق فتزينون لنا الكفر والشرك بالله وارتكاب المعاصي، وتنفروننا من الحق الذي جاءت به الرسل من عند الله."},{"ayah":29,"from":29,"to":29,"text":"قال المتبوعون للأتباع: ليس الأمر - كما زعمتم - بل كنتم على الكفر ولم تكونوا مؤمنين، بل كنتم منكرين."},{"ayah":30,"from":30,"to":30,"text":"وما كان لنا عليكم أيها الأتباع من تسلط بقهر أو غلبة حتى نوقعكم في الكفر والشرك وارتكاب المعاصي، بل كنتم قومًا متجاوزين الحد في الكفر والضلال."},{"ayah":31,"from":31,"to":31,"text":"فوجب علينا وعليكم وعيد الله في قوله: ﴿لأَمْلأَنَّ جَهَنَّمَ مِنْكَ وَمِمَّنْ تَبِعَكَ مِنْهُمْ أَجْمَعِينَ﴾ [ص: ٨٥]، ومن ثَمَّ فإنا ذائقون - لا محالة - ما توعد به ربنا."},{"ayah":32,"from":32,"to":32,"text":"فدعوناكم إلى الضلال والكفر، إنا كنا ضالين عن طريق الهدى."},{"ayah":33,"from":33,"to":33,"text":"فإن الأتباع والمتبوعين في العذاب يوم القيامة مشتركون."},{"ayah":34,"from":34,"to":34,"text":"إنا كما فعلنا بهؤلاء من إذاقتهم العذاب، نفعل بالمجرمين من غيرهم."},{"ayah":35,"from":35,"to":35,"text":"إن هؤلاء المشركين كانوا إذا قيل لهم في الدنيا: لا إلـٰه إلا الله للعمل بمقتضاها وترك ما يخالفها، رفضوا الاستجابة لذلك والإذعان له تكبرًا عن الحق وترفعًا عليه."},{"ayah":36,"from":36,"to":36,"text":"ويقولون محتجِّين لكفرهم: أنترك عبادة آلهتنا لقول شاعر مجنون؟! يعنون بقولهم هذا رسولَ الله صلّى الله عليه وسلّم."},{"ayah":37,"from":37,"to":37,"text":"لقد أعظموا الفِرْية، فما كان رسول الله صلّى الله عليه وسلّم مجنونًا ولا شاعرًا، بل جاء بالقرآن الداعي إلى توحيد الله واتباع رسوله، وصدق المرسلين فيما جاؤوا به من عند الله من التوحيد وإثبات المعاد، ولم يخالفهم في شيء."},{"ayah":38,"from":38,"to":38,"text":"إنكم - أيها المشركون - لذائقو العذاب الموجع يوم القيامة بسبب كفركم وتكذيبكم للرسل."},{"ayah":39,"from":39,"to":39,"text":"وما تُجْزَون - أيها المشركون - إلا ما كنتم تعملون في الدنيا من الكفر بالله وارتكاب المعاصي."},{"ayah":40,"from":40,"to":40,"text":"لكن عباد الله المؤمنين الذين أخلصهم الله لعبادته، وأخلصوا له العبادة، هم بمنجاة من هذا العذاب."},{"ayah":41,"from":41,"to":41,"text":"أولئك العباد المخلصون لهم رزق يرزقهم الله إياه، معلوم في طيبه وحسنه ودوامه."},{"ayah":42,"from":42,"to":42,"text":"ومن هذا الرزق أنهم يرزقون فواكه من أطيب ما يأكلونه ويشتهونه، وهم فوق ذلك مكرمون برفع الدرجات وبالنظر إلى وجه الله الكريم."},{"ayah":43,"from":43,"to":43,"text":"كل ذلك ينالونه في جنات النعيم المقيم الثابت الذي لا ينقطع ولا يزول."},{"ayah":44,"from":44,"to":44,"text":"يتكئون على أسِرَّة متقابلين ينظر بعضهم إلى بعض."},{"ayah":45,"from":45,"to":45,"text":"يدار عليهم بكؤوس الخمر التي هي في صفائها كالماء الجاري."},{"ayah":46,"from":46,"to":46,"text":"بيضاء اللون يلتذ بشربها من يشربها لذة كاملة."},{"ayah":47,"from":47,"to":47,"text":"ليست كخمر الدنيا، فليس فيها ما يُذْهِب العقول من السكر، ولا ينتاب متعاطيها صُداع، يَسْلَم لشاربها جسمه وعقله."},{"ayah":48,"from":48,"to":48,"text":"وعندهم في الجنة نساء عفيفات، لا تمتد أبصارهن إلى غير أزواجهن، حسان العيون."},{"ayah":49,"from":49,"to":49,"text":"كأنهن في بياض ألوانهن المشوبة بصفرة بيضُ طائر مصون لم تمسه الأيدي."},{"ayah":50,"from":50,"to":50,"text":"فأقبل بعض أهل الجنة على بعض يتساءلون عن ماضيهم وما حدث لهم في الدنيا."},{"ayah":51,"from":51,"to":51,"text":"قال قائل من هؤلاء المؤمنين: إني كان لي في الدنيا صاحب مُنْكِر للبعث."},{"ayah":52,"from":52,"to":52,"text":"يقول لي منكرًا وساخرًا: هل أنت - أيها الصديق - مِن المصدِّقين ببعث الأموات؟"},{"ayah":53,"from":53,"to":53,"text":"أإذا متنا وصرنا ترابًا وعظامًا نخرة أإنا لمبعوثون ومجازون على أعمالنا التي عملناها في الدنيا؟"},{"ayah":54,"from":54,"to":54,"text":"قال قرينه المؤمن لأصحابه من أهل الجنة: اطَّلعوا معي لنرى مصير ذلك القرين الذي كان ينكر البعث؟"},{"ayah":55,"from":55,"to":55,"text":"فاطلع هو فرأى قرينه في وسط جهنم."},{"ayah":56,"from":56,"to":56,"text":"قال: تالله لقد قاربت - أيها القرين - أن تهلكني بدخول النار بدعوتك لي إلى الكفر وإنكار البعث."},{"ayah":57,"from":57,"to":57,"text":"ولولا إنعام الله علي بالهداية للإيمان والتوفيق له، لكنت من المحضرين إلى العذاب مثلك."},{"ayah":58,"from":58,"to":58,"text":"فلسنا نحن - أصحاب الجنة - بميتين."},{"ayah":59,"from":59,"to":59,"text":"غير موتتنا الأولى في الحياة الدنيا، بل نحن مخلدون في الجنة، ولسنا بمعذبين كما يعذب الكفار."},{"ayah":60,"from":60,"to":60,"text":"إن هذا الذي جازانا به ربنا - من دخول الجنة والخلود فيها والسلامة من النار - لهو الظفر العظيم الذي لا ظفر يساويه."},{"ayah":61,"from":61,"to":61,"text":"لمثل هذا الجزاء العظيم يجب أن يعمل العاملون، فإن هذا هو التجارة الرابحة."},{"ayah":62,"from":62,"to":62,"text":"أذلك النعيم المذكور الذي أعده الله لعباده الذين أخلصهم لطاعته، خير وأفضل مقامًا وكرامة، أم شجرة الزقوم الملعونة في القرآن التي هي طعام الكفار الذي لا يسمن ولا يغني من جوع؟!"},{"ayah":63,"from":63,"to":63,"text":"إنا صيَّرنا هذه الشجرة فتنة يفتتن بها الظالمون بالكفر والمعاصي، حيث قالوا: إن النار تأكل الشجر، فلا يمكن أن ينبت فيها."},{"ayah":64,"from":64,"to":64,"text":"إن شجرة الزقوم شجرة خبيثة المَنْبَت، فهي شجرة تخرج في قعر الجحيم."},{"ayah":65,"from":65,"to":65,"text":"ثمرها الخارج منها كريه المنظر كأنه رؤوس الشياطين، وقبح المنظر دليل على قبح المخبر، وهذا يعني أن ثمرها خبيث الطعم."},{"ayah":66,"from":66,"to":66,"text":"فإن الكفار لآكلون من ثمرها المر القبيح، ومالئون منه بطونهم الخاوية."},{"ayah":67,"from":67,"to":67,"text":"ثم إنهم بعد أكلهم منها لهم شراب خليط قبيح حار."},{"ayah":68,"from":68,"to":68,"text":"ثم إن رجوعهم بعد ذلك لإلى عذاب الجحيم، فهم يتنقلون من عذاب إلى عذاب."},{"ayah":69,"from":69,"to":69,"text":"إن هؤلاء الكفار وجدوا آباءهم ضالين عن طريق الهداية، فتأسوا بهم تقليدًا لا عن حجة."},{"ayah":70,"from":70,"to":70,"text":"فهم يتبعون آثار آبائهم في الضلالة مسرعين."},{"ayah":71,"from":71,"to":71,"text":"ولقد ضل قبلهم أكثر الأولين، فليس قومك - أيها الرسول - أول من ضل من الأمم."},{"ayah":72,"from":72,"to":72,"text":"ولقد أرسلنا في تلك الأمم الأولى رسلًا يخوفونهم من عذاب الله، فكفروا."},{"ayah":73,"from":73,"to":73,"text":"فانظر - أيها الرسول - كيف كانت نهاية الأقوام الذين أنذرتهم رسلهم فلم يستجيبوا لهم، إن نهايتهم كانت دخول النار خالدين فيها بسبب كفرهم وتكذيبهم لرسلهم."},{"ayah":74,"from":74,"to":74,"text":"إلا من أخلصهم الله للإيمان به، فإنهم ناجون من العذاب الذي كان نهاية أولئك المكذبين الكافرين."},{"ayah":75,"from":75,"to":75,"text":"ولقد دعانا نبينا نوح عليه السلام حين دعا على قومه الذين كذبوه، فلنعم المجيبون نحن، فقد سارعنا في إجابة دعائه عليهم."},{"ayah":76,"from":76,"to":76,"text":"ولقد سلمناه وأهل بيته والمؤمنين معه من أذى قومه ومن الغرق بالطوفان العظيم المرسل على الكافرين من قومه."},{"ayah":77,"from":77,"to":77,"text":"ونجينا أهله وأتباعه المؤمنين وحدهم، فقد أغرقنا غيرهم من قومه الكافرين."},{"ayah":78,"from":78,"to":78,"text":"وأبقينا له في الأمم اللاحقة ثناءً حسنًا يثنون به عليه."},{"ayah":79,"from":79,"to":79,"text":"أمان وسلام لنوح من أن يقال فيه سوء في الأمم اللاحقة، بل سيبقى له الثناء والذكر الحسن."},{"ayah":80,"from":80,"to":80,"text":"إن مثل هذا الجزاء الذي جازينا به نوحًا عليه السلام نجزي المحسنين بعبادتهم وطاعتهم لله وحده."},{"ayah":81,"from":81,"to":81,"text":"إن نوحًا من عبادنا المؤمنين العاملين بطاعة الله."},{"ayah":82,"from":82,"to":82,"text":"ثم أغرقنا الباقين بالطوفان الذي أرسلناه عليهم، فلم يبق منهم أحد."},{"ayah":83,"from":83,"to":83,"text":"وإن إبراهيم من أهل دينه الذين وافقوه في الدعوة إلى توحيد الله."},{"ayah":84,"from":84,"to":84,"text":"فاذكر حين جاء ربه بقلب سليم من الشرك ناصح لله في خلقه."},{"ayah":85,"from":85,"to":85,"text":"حين قال لأبيه وقومه المشركين موبخًا لهم: ما الذي تعبدونه من دون الله؟!"},{"ayah":86,"from":86,"to":86,"text":"أآلهة مكذوبة تعبدونها من دون الله؟"},{"ayah":87,"from":87,"to":87,"text":"فما ظنكم - يا قوم - برب العالمين إذا لقيتموه وأنتم تعبدون غيره؟! وماذا ترونه صانعًا بكم؟!"},{"ayah":88,"from":88,"to":88,"text":"فنظر إبراهيم نظرة في النجوم يدبر مكيدة للتخلص من الخروج مع قومه."},{"ayah":89,"from":89,"to":89,"text":"فقال متعللًا عن الخروج مع قومه إلى عيدهم: إني مريض."},{"ayah":90,"from":90,"to":90,"text":"فتركوه وراءهم وذهبوا."},{"ayah":91,"from":91,"to":91,"text":"فمال إلى آلهتهم التي يعبدونها من دون الله، فقال ساخرًا من آلهتهم: ألا تأكلون من الطعام الذي يصنعه المشركون لكم؟!"},{"ayah":92,"from":92,"to":92,"text":"ما شأنكم لا تتكلمون، ولا تجيبون من يسألكم؟! أمثل هذا يُعْبد من دون الله؟!"},{"ayah":93,"from":93,"to":93,"text":"فمال عليهم إبراهيم يضربهم بيده اليمنى ليكسرهم."},{"ayah":94,"from":94,"to":94,"text":"فأقبل إليه عبّاد هذه الأصنام يسرعون."},{"ayah":95,"from":95,"to":95,"text":"فقابلهم إبراهيم بثبات، وقال لهم موبخًا إياهم: أتعبدون من دون الله آلهة أنتم الذين تنحتونها بأيديكم؟!"},{"ayah":96,"from":96,"to":96,"text":"والله سبحانه خلقكم أنتم، وخلق عملكم، ومن عملكم هذه الأصنام، فهو المستحق لأن يعبد وحده، ولا يشرك به غيره."},{"ayah":97,"from":97,"to":97,"text":"فلما عجزوا عن مقارعته بالحجة لجؤوا إلى القوة، فتشاوروا فيما بينهم فيما يفعلونه بإبراهيم، قالوا: ابنوا له بنيانًا، واملؤوه حطبًا وأضرموه، ثم ارموه فيه."},{"ayah":98,"from":98,"to":98,"text":"فأراد قوم إبراهيم بإبراهيم سوءًا بأن يهلكوه فيستريحوا منه، فصيرناهم الخاسرين حين جعلنا النار عليه بردًا وسلامًا."},{"ayah":99,"from":99,"to":99,"text":"وقال إبراهيم: إني مهاجر إلى ربي تاركًا بلد قومي لأتمكن من عبادته، سيدلني ربي على ما فيه الخير لي في الدنيا والآخرة."},{"ayah":100,"from":100,"to":100,"text":"يا رب، ارزقني ولدًا صالحًا يكون لي عونًا وعوضًا عن قومي في الغربة."},{"ayah":101,"from":101,"to":101,"text":"فاستجبنا له دعوته فأخبرناه بما يسره، حيث بشرناه بولد يكبر، ويصير حليمًا، وهذا الولد هو إسماعيل عليه السلام."},{"ayah":102,"from":102,"to":102,"text":"فلما شب إسماعيل، وأدرك سعيُه سعي أبيه رأى أبوه إبراهيم رؤيا، ورؤيا الأنبياء وحي، قال إبراهيم مخبرًا ابنه عن فحوى هذه الرؤيا: يا بني، إني رأيت في النوم أني أذبحك، فانظر ما ترى في ذلك، فأجاب إسماعيل أباه قائلًا: يا أبي، افعل ما أمرك الله به من ذبحي، ستجدني من الصابرين الراضين بحكم الله."},{"ayah":103,"from":103,"to":103,"text":"فلما خضعا لله وانقادا له، وضع إبراهيم ابنه على جانب جبهته لينفذ ما أمر به من ذبحه."},{"ayah":104,"from":104,"to":104,"text":"ونادينا إبراهيم وهو يَهُمُّ بتنفيذ أمر الله بذبح ابنه: أن يا إبراهيم."},{"ayah":105,"from":105,"to":105,"text":"قد حققت الرؤيا التي رأيتها في منامك بعزمك على ذبح ابنك، إنا - كما جزيناك بتخليصك من هذه المحنة العظيمة - نجزي المحسنين فنخلصهم من المحن والشدائد."},{"ayah":106,"from":106,"to":106,"text":"إن هذا لهو الاختبار الواضح، وقد نجح إبراهيم فيه."},{"ayah":107,"from":107,"to":107,"text":"وفدينا إسماعيل بكبش عظيم بدلًا منه يذبح عنه."},{"ayah":108,"from":108,"to":108,"text":"وأبقينا على إبراهيم ثناءً حسنًا في الأمم اللاحقة."},{"ayah":109,"from":109,"to":109,"text":"تحية من الله له، ودعاءً بالسلامة من كل ضر وآفة."},{"ayah":110,"from":110,"to":110,"text":"كما جازينا إبراهيم هذا الجزاء على طاعته نجازي المحسنين."},{"ayah":111,"from":111,"to":111,"text":"إن إبراهيم من عبادنا المؤمنين الذين يفون بما تقتضيه العبودية لله."},{"ayah":112,"from":112,"to":112,"text":"وبشرناه بولد آخر يصير نبيًّا وعبدًا صالحًا وهو إسحاق؛ جزاءً على طاعته لله في ذبح إسماعيل ولده الوحيد."},{"ayah":113,"from":113,"to":113,"text":"وأنزلنا عليه وعلى ابنه إسحاق بركة منا، فأكثرنا لهما النعم، ومنها تكثير ولدهما، ومن ذريتهما محسن بطاعته لربه، ومنهم ظالم لنفسه بالكفر وارتكاب المعاصي واضح الظلم."},{"ayah":114,"from":114,"to":114,"text":"ولقد مننا على موسى وأخيه هارون بالنبوة."},{"ayah":115,"from":115,"to":115,"text":"وسلمناهما وقومهما بني إسرائيل من استعباد فرعون لهم ومن الغرق."},{"ayah":116,"from":116,"to":116,"text":"ونصرناهم على فرعون وجنوده، فكانت الغلبة لهم على عدوهم."},{"ayah":117,"from":117,"to":117,"text":"وأعطينا موسى وأخاه هارون التوراة كتابًا من عند الله واضحًا لا لبس فيه."},{"ayah":118,"from":118,"to":118,"text":"وهديناهما إلى الصراط المستقيم الذي لا اعوجاج فيه، وهو طريق دين الإسلام الموصلة إلى مرضاة الخالق سبحانه."},{"ayah":119,"from":119,"to":119,"text":"وأبقينا عليهما ثناءً حسنًا وذكرًا طيبًا في الأمم اللاحقة."},{"ayah":120,"from":120,"to":120,"text":"تحية من الله طيبة لهما وثناءً عليهما ودعاءً بالسلامة من كل مكروه."},{"ayah":121,"from":121,"to":121,"text":"إنا كما جازينا موسى وهارون هذا الجزاء الحسن نجزي المحسنين بطاعتهم لربهم."},{"ayah":122,"from":122,"to":122,"text":"إن موسى وهارون من عبادنا المؤمنين بالله العاملين بما شرع لهم."},{"ayah":123,"from":123,"to":123,"text":"وإن إلياس لمن المرسلين من ربه، أنعم الله عليه بالنبوة والرسالة."},{"ayah":124,"from":124,"to":124,"text":"إذ قال لقومه الذين أرسل إليهم من بني إسرائيل: يا قوم، ألا تتقون الله؛ بامتثال أوامره، ومنها التوحيد، وباجتناب نواهيه، ومنها الشرك؟!"},{"ayah":125,"from":125,"to":125,"text":"أتعبدون من دون الله صنمكم بَعْلًا، وتتركون عبادة الله أحسن الخالقين؟!"},{"ayah":126,"from":126,"to":126,"text":"والله هو ربكم الذي خلقكم، وخلق آباءكم من قبل، فهو المستحق للعبادة، لا غيره من الأصنام التي لا تنفع ولا تضر."},{"ayah":127,"from":127,"to":127,"text":"فما كان من قومه إلا أن كذبوه، وبسبب تكذيبهم فهم مُحْضرون في العذاب."},{"ayah":128,"from":128,"to":128,"text":"إلا من كان من قومه مؤمنًا مخلصًا لله في عبادته؛ فإنه ناج من الإحضار إلى العذاب."},{"ayah":129,"from":129,"to":129,"text":"وأبقينا عليه ثناءً حسنًا وذكرًا طيبًا في الأمم اللاحقة."},{"ayah":130,"from":130,"to":130,"text":"تحية من الله وثناءً على إلياس."},{"ayah":131,"from":131,"to":131,"text":"إنا كما جازينا إلياس هذا الجزاء الحسن نجزي المحسنين من عبادنا المؤمنين."},{"ayah":132,"from":132,"to":132,"text":"إن إلياس من عبادنا المؤمنين حقًّا الصادقين في إيمانهم بربهم."},{"ayah":133,"from":133,"to":133,"text":"وإن لوطًا لمن رسل الله الذين أرسلهم إلى أقوامهم مبشرين ومنذرين."},{"ayah":134,"from":134,"to":134,"text":"فاذكر حين سلمناه وأهله كلهم من العذاب المرسل على قومه."},{"ayah":135,"from":135,"to":135,"text":"إلا زوجته، فقد كانت امرأة شملها عذاب قومها؛ لكونها كانت كافرة مثلهم."},{"ayah":136,"from":136,"to":136,"text":"ثم أهلكنا الباقين من قومه ممن كذبوا به، ولم يصدقوا بما جاء به."},{"ayah":137,"from":137,"to":137,"text":"وإنكم - يا أهل مكة - لتمرون على منازلهم في أسفاركم إلى الشام في وقت الصباح."},{"ayah":138,"from":138,"to":138,"text":"وتمرون عليها كذلك ليلًا، أفلا تعقلون، وتتعظون بما آل إليه أمرهم بعد تكذيبهم وكفرهم وارتكابهم الفاحشة التي لم يسبقوا إليها؟!"},{"ayah":139,"from":139,"to":139,"text":"وإن عبدنا يونس لمن رسل الله الذين أرسلهم إلى أقوامهم مبشرين ومنذرين."},{"ayah":140,"from":140,"to":140,"text":"حين فرّ من قومه من غير إذن ربه، وركب سفينة مملوءة من الركاب والأمتعة."},{"ayah":141,"from":141,"to":141,"text":"فأوشكت السفينة أن تغرق لامتلائها، فاقترع الركاب لِيُلْقُوا بعضهم؛ خوفًا من غرق السفينة بسبب كثرة الركاب، فكان يونس من هؤلاء المغلوبين، فألقوه في البحر."},{"ayah":142,"from":142,"to":142,"text":"فلما ألقوه في البحر أخذه الحوت، وابتلعه، وهو آت بما يُلام عليه؛ لذهابه إلى البحر بغير إذن ربه."},{"ayah":143,"from":143,"to":143,"text":"فلولا أن يونس كان من الذاكرين الله كثيرًا قبل ما حل به، ولولا تسبيحه في بطن الحوت."},{"ayah":144,"from":144,"to":144,"text":"لمكث في بطن الحوت إلى يوم القيامة بحيث يصير له قبرًا."},{"ayah":145,"from":145,"to":145,"text":"فألقيناه من بطن الحوت بأرض خالية من الشجر والبناء، وهو ضعيف البدن لمكثه مدَّة في بطن الحوت."},{"ayah":146,"from":146,"to":146,"text":"وأنبتنا عليه في تلك الأرض الخالية شجرة من القرع يستظل بها ويأكل منها."},{"ayah":147,"from":147,"to":147,"text":"وأرسلناه إلى قومه وعددهم مئة ألف، بل يزيدون."},{"ayah":148,"from":148,"to":148,"text":"فآمنوا وصدقوا بما جاء به، فمتعهم الله في حياتهم الدنيا إلى أن انقضت آجالهم المحددة لهم."},{"ayah":149,"from":149,"to":149,"text":"فاسأل - يا محمد - المشركين سؤال إنكار: أتجعلون لله البنات اللاتي تكرهونهن، وتجعلون لكم البنين الذين تحبونهم؟! أي قسمة هذه؟!"},{"ayah":150,"from":150,"to":150,"text":"كيف زعموا أن الملائكة إناث، وهم لم يحضروا خلقهم، وما شاهدوه؟!"},{"ayah":151,"from":151,"to":151,"text":"ألا إن المشركين من كذبهم على الله وافترائهم عليه."},{"ayah":152,"from":152,"to":152,"text":"لينسبون له الولد، وإنهم لكاذبون في دعواهم هذه."},{"ayah":153,"from":153,"to":153,"text":"هل اختار الله لنفسه البنات اللاتي تكرهونهن على البنين الذين تحبونهم؟! كلا."},{"ayah":154,"from":154,"to":154,"text":"ما لكم - أيها المشركون - تحكمون هذا الحكم الجائر حيث تجعلون لله البنات، وتجعلون لكم البنين؟!"},{"ayah":155,"from":155,"to":155,"text":"أفلا تتذكرون بطلان ما أنتم عليه من هذا الاعتقاد الفاسد؟! فإنكم لو تذكرتم لما قلتم هذا القول."},{"ayah":156,"from":156,"to":156,"text":"أم لكم حجة جلية وبرهان واضح من كتاب بذلك أو رسول؟!"},{"ayah":157,"from":157,"to":157,"text":"فأْتُوا بكتابكم الذي يحمل لكم الحجة على هذا إن كنتم صادقين فيما تدعونه."},{"ayah":158,"from":158,"to":158,"text":"وجعل المشركون بين الله وبين الملائكة المستورين عنهم نسبًا حين زعموا أن الملائكة بنات الله، ولقد علمت الملائكة أن الله سيحضر المشركين للحساب."},{"ayah":159,"from":159,"to":159,"text":"تنزه الله وتقدس عما يصفه به المشركون مما لا يليق به سبحانه من الولد والشريك وغير ذلك."},{"ayah":160,"from":160,"to":160,"text":"إلا عباد الله المخلصين؛ فإنهم لا يصفون الله إلا بما يليق به سبحانه من صفات الجلال والكمال."},{"ayah":161,"from":161,"to":161,"text":"فإنكم أنتم - أيها المشركون - وما تعبدون من دون الله."},{"ayah":162,"from":162,"to":162,"text":"لستم بمضلين من أحد عن دين الحق."},{"ayah":163,"from":163,"to":163,"text":"إلا من قضى الله عليه أنه من أصحاب النار، فإن الله ينفذ فيه قضاءه فيكفر، ويدخل النار، أما أنتم ومعبوداتكم فلا قدرة لكم على ذلك."},{"ayah":164,"from":164,"to":164,"text":"وقالت الملائكة مبينة عبوديتها لله، وبراءتها مما زعمه المشركون: وليس منا أحد إلا له مقام معلوم في عبادة الله وطاعته."},{"ayah":165,"from":165,"to":165,"text":"١٦٥ - ١٦٦ - وإنا - نحن الملائكة - لواقفون صفوفًا في عبادة الله وطاعته، وإنا لمنزِّهون الله عما لا يليق به من الصفات والنُّعوت."},{"ayah":166,"from":166,"to":166,"text":"١٦٥ - ١٦٦ - وإنا - نحن الملائكة - لواقفون صفوفًا في عبادة الله وطاعته، وإنا لمنزِّهون الله عما لا يليق به من الصفات والنُّعوت."},{"ayah":167,"from":167,"to":167,"text":"١٦٧ - ١٧٠ - وإن المشركين من أهل مكة كانوا يقولون قبل بعثة محمد صلّى الله عليه وسلّم: لو كان عندنا كتاب من كتب الأولين كالتوراة مثلًا؛ لأخلصنا لله العبادة، وهم كاذبون في ذلك، فقد جاءهم محمد صلّى الله عليه وسلّم بالقرآن فكفروا به، فسوف يعلمون ما ينتظرهم من العذاب الشديد يوم القيامة."},{"ayah":168,"from":168,"to":168,"text":"١٦٧ - ١٧٠ - وإن المشركين من أهل مكة كانوا يقولون قبل بعثة محمد صلّى الله عليه وسلّم: لو كان عندنا كتاب من كتب الأولين كالتوراة مثلًا؛ لأخلصنا لله العبادة، وهم كاذبون في ذلك، فقد جاءهم محمد صلّى الله عليه وسلّم بالقرآن فكفروا به، فسوف يعلمون ما ينتظرهم من العذاب الشديد يوم القيامة."},{"ayah":169,"from":169,"to":169,"text":"١٦٧ - ١٧٠ - وإن المشركين من أهل مكة كانوا يقولون قبل بعثة محمد صلّى الله عليه وسلّم: لو كان عندنا كتاب من كتب الأولين كالتوراة مثلًا؛ لأخلصنا لله العبادة، وهم كاذبون في ذلك، فقد جاءهم محمد صلّى الله عليه وسلّم بالقرآن فكفروا به، فسوف يعلمون ما ينتظرهم من العذاب الشديد يوم القيامة."},{"ayah":170,"from":170,"to":170,"text":"١٦٧ - ١٧٠ - وإن المشركين من أهل مكة كانوا يقولون قبل بعثة محمد صلّى الله عليه وسلّم: لو كان عندنا كتاب من كتب الأولين كالتوراة مثلًا؛ لأخلصنا لله العبادة، وهم كاذبون في ذلك، فقد جاءهم محمد صلّى الله عليه وسلّم بالقرآن فكفروا به، فسوف يعلمون ما ينتظرهم من العذاب الشديد يوم القيامة."},{"ayah":171,"from":171,"to":171,"text":"١٧١ - ١٧٣ - ولقد سبقت كلمتنا لرسلنا أنهم منصورون على أعدائهم بما منَّ الله عليهم به من الحجة والقوة، وأن الغلبة لجندنا الذين يقاتلون في سبيل الله لتكون كلمة الله هي العليا."},{"ayah":172,"from":172,"to":172,"text":"١٧١ - ١٧٣ - ولقد سبقت كلمتنا لرسلنا أنهم منصورون على أعدائهم بما منَّ الله عليهم به من الحجة والقوة، وأن الغلبة لجندنا الذين يقاتلون في سبيل الله لتكون كلمة الله هي العليا."},{"ayah":173,"from":173,"to":173,"text":"١٧١ - ١٧٣ - ولقد سبقت كلمتنا لرسلنا أنهم منصورون على أعدائهم بما منَّ الله عليهم به من الحجة والقوة، وأن الغلبة لجندنا الذين يقاتلون في سبيل الله لتكون كلمة الله هي العليا."},{"ayah":174,"from":174,"to":174,"text":"فأعرض - أيها الرسول - عن هؤلاء المشركين المعاندين إلى مدة يعلمها الله حتى يأتي وقت عذابهم."},{"ayah":175,"from":175,"to":175,"text":"وانظرهم حين ينزل بهم العذاب، فسيبصرون هم حين لا ينفعهم إبصار."},{"ayah":176,"from":176,"to":176,"text":"أفيستعجل هؤلاء المشركون بعذاب الله؟!"},{"ayah":177,"from":177,"to":177,"text":"فإذا نزل عذاب الله بهم فبئس الصباح صباحهم."},{"ayah":178,"from":178,"to":178,"text":"وأعرض - أيها الرسول - عنهم حتى يقضي الله بعذابهم."},{"ayah":179,"from":179,"to":179,"text":"وانظر فسينظر هؤلاء ما يحل بهم من عذاب الله وعقابه."},{"ayah":180,"from":180,"to":180,"text":"تنزه ربك - يا محمد - ربّ القوة، وتقدس عما يصفه به المشركون من صفات النقص."},{"ayah":181,"from":181,"to":181,"text":"وتحية الله وثناؤه على رسله الكرام."},{"ayah":182,"from":182,"to":182,"text":"والثناء كله لله سبحانه وتعالى، فهو المستحق له، وهو رب العالمين جميعًا، لا رب لهم سواه."}]}