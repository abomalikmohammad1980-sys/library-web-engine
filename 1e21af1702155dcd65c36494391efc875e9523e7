import{describe,expect,it}from"vitest";import{claimOutboxOperations,type SourceSyncOperation}from"./outbox.js";
function op(bookId:string,index:number):SourceSyncOperation{return{operationId:`${bookId}:${index}`,kind:"source-revision.upload",bookId,payloadDigest:`digest:${bookId}:${index}`,payload:{},state:"pending",attempt:0,createdAtMs:index,nextAttemptAtMs:0,leaseId:null,leaseUntilMs:null,lastErrorCode:null,recordVersion:0}}
describe("source-sync outbox backpressure",()=>{
 it("round-robins books while preserving FIFO within each book",()=>{const operations=[...Array.from({length:10_000},(_,i)=>op("hot",i)),op("book-b",20_000),op("book-c",20_001),op("book-d",20_002)];const batch=claimOutboxOperations(operations,{nowMs:30_000,leaseId:"lease",leaseDurationMs:1_000,limit:4});expect(batch.claimed.map(x=>x.bookId)).toEqual(["hot","book-b","book-c","book-d"]);expect(batch.claimed[0]?.operationId).toBe("hot:0");expect(batch.unchanged).toHaveLength(9_999)});
 it("drains a hot and a cold book without starvation across bounded batches",()=>{let operations=[...Array.from({length:1_000},(_,i)=>op("hot",i)),...Array.from({length:7},(_,i)=>op("cold",10_000+i))];const seen:string[]=[];for(let round=0;round<7;round++){const batch=claimOutboxOperations(operations,{nowMs:20_000,leaseId:`lease-${round}`,leaseDurationMs:1_000,limit:2});seen.push(...batch.claimed.map(x=>x.bookId));const ids=new Set(batch.claimed.map(x=>x.operationId));operations=operations.filter(x=>!ids.has(x.operationId))}expect(seen).toEqual(Array.from({length:7},()=>["hot","cold"]).flat())});
});
