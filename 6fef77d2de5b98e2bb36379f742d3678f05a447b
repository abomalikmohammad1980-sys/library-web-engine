لٌ) ، مِنْ مَادَّةِ: (طمع) .\n\nوَيُنْشِئُ: {يُنْشِئُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ اللَّامِ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَنْشِئُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (نشأ) .\n\nالسَّحَابَ: {السَّحَابَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (سحب) .\n\nالثِّقَالَ: {الثِّقَالَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (ثَقِيلٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (ثقل) .","words":[{"wordId":32029,"position":1,"word":"هُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":32030,"position":2,"word":"الَّذِي","text":"{الَّذِي} : اسْمٌ مَبْنِيٌّ."},{"wordId":32031,"position":3,"word":"يُرِيكُمُ","text":"{يُرِي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَرْئِيُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (رأي) ."},{"wordId":32032,"position":4,"word":"الْبَرْقَ","text":"{الْبَرْقَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (برق) ."},{"wordId":32033,"position":5,"word":"خَوْفًا","text":"{خَوْفًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَافَ يَخَافُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (خوف) ."},{"wordId":32034,"position":6,"word":"وَطَمَعًا","text":"{طَمَعًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (طَمِعَ يَطْمَعُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (طمع