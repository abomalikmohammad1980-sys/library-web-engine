ْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (مَدَدَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (مدد) .\n\nالْأَرْضَ: {الْأَرْضَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أرض) .\n\nوَجَعَلَ: {جَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nفِيهَا: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nرَوَاسِيَ: {رَوَاسِيَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (رَاسِيَةٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (رَسَا يَرْسُو) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْوَاوِ، مَنْقُوصٌ، أَصْلُهُ: (رَوَاسِوُ) ، عَلَى وَزْنِ: (فَوَاعِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْأَلِفِ وَاوًا لِمَجِيئِهَا بَعْدَ ضَمٍّ وَالْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (رسو) .\n\nوَأَنْهَارًا: {أَنْهَارًا} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (نَهَرٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (نهر) .\n\nوَمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nكُلِّ: {كُلِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (كلل) .\n\nالثَّمَرَاتِ: {الثَّمَرَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (ثَمَرَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (ثمر) .\n\nجَعَلَ: {جَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nفِيهَا: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nزَوْجَيْنِ: {زَوْجَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُثَنًّى، مُفْرَدُهُ: (زَوْجٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (زوج) .\n\nاثْنَيْنِ: {اثْنَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُثَنًّى، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (اثْنٌ) ، عَلَى وَزْنِ: (افْعٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (ثني) .\n\nيُغْشِي: {يُغْشِي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَغْشِيُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (غشي) .\n\nاللَّيْلَ: {اللَّيْلَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (ليل) .\n\nالنَّهَارَ: {النَّهَارَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (نهر) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nذَلِكَ: {ذَلِكَ} : اسْمٌ مَبْنِيٌّ.\n\nلَآيَاتٍ: {آيَاتٍ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (آيَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (أَيَيٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (أيي) .\n\nلِقَوْمٍ: {قَوْمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nيَتَفَكَّرُونَ: {يَتَفَكَّرُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (تَفَعَّلَ) ، عَلَى وَزْنِ: (يَتَفَعَّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (فكر) .","words":[{"wordId":31849,"position":1,"word":"وَهُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":31850,"position":2,"word":"الَّذِي