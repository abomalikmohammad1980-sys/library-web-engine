مِنْ مَادَّةِ: (أرض) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nسِتَّةِ: {سِتَّةِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ستت) .\n\nأَيَّامٍ: {أَيَّامٍ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَوْمٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، أَصْلُهُ: (أَيْوَامٌ) ، عَلَى وَزْنِ: (أَفْعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ يَاءٍ سَاكِنَةٍ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (يوم) .\n\nثُمَّ: {ثُمَّ} : حَرْفٌ مَبْنِيٌّ.\n\nاسْتَوَى: {اسْتَوَى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَقْرُونٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (اسْتَوَيَ) ، عَلَى وَزْنِ: (افْتَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (سوي) .\n\nعَلَى: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالْعَرْشِ: {الْعَرْشِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (عرش) .\n\nيُغْشِي: {يُغْشِي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَغْشِيُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (غشي) .\n\nاللَّيْلَ: {اللَّيْلَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (ليل) .\n\nالنَّهَارَ: {النَّهَارَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (نهر) .\n\nيَطْلُبُهُ: {يَطْلُبُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، مِنْ مَادَّةِ: (طلب) .\n\nحَثِيثًا: {حَثِيثًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (حَثَّ يَحُثُّ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (حثث) .\n\nوَالشَّمْسَ: {الشَّمْسَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (شمس) .\n\nوَالْقَمَرَ: {الْقَمَرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (قمر) .\n\nوَالنُّجُومَ: {النُّجُومَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (نَجْمٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فُعُولٌ) ، مِنْ مَادَّةِ: (نجم) .\n\nمُسَخَّرَاتٍ: {مُسَخَّرَاتٍ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (مُسَخَّرَةٌ) ، مُشْتَقٌّ، اسْمُ مَفْعُولٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (سَخَّرَ) ، مِنْ بَابِ: (فَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْمِيمِ وَحَرْفٍ مُضَعَّفٍ، عَلَى وَزْنِ: (مُفَعَّلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (سخر) .\n\nبِأَمْرِهِ: {أَمْرِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (أَمَرَ يَأْمُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أمر) .\n\nأَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nلَهُ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nالْخَلْقُ: {الْخَلْقُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَلَقَ يَخْلُقُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (خلق) .\n\nوَالْأَمْرُ: {الْأَمْرُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (أَمَرَ يَأْمُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أمر) .\n\nتَبَا