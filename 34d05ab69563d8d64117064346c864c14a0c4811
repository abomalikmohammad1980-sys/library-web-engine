َمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَدٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مَنْقُوصٌ، عَلَى وَزْنِ: (أَفْعُلٌ) ، مِنْ مَادَّةِ: (يدي) .\n\nوَمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nخَلْفِهِمْ: {خَلْفِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (خلف) .\n\nوَعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nأَيْمَانِهِمْ: {أَيْمَانِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَمِينٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَالٌ) ، مِنْ مَادَّةِ: (يمن) .\n\nوَعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nشَمَائِلِهِمْ: {شَمَائِلِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (شِمَالٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، أَصْلُهُ: (شَمَائِلُ) ، عَلَى وَزْنِ: (فَعَائِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (شمل) .\n\nوَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nتَجِدُ: {تَجِدُ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (تَوْجِدُ) ، عَلَى وَزْنِ: (تَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِلثِّقَلِ، مِنْ مَادَّةِ: (وجد) .\n\nأَكْثَرَهُمْ: {أَكْثَرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَثُرَ يَكْثُرُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعَلٌ) ، مِنْ مَادَّةِ: (كثر) .\n\nشَاكِرِينَ: {شَاكِرِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (شَاكِرٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَكَرَ يَشْكُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (شكر) .","words":[{"wordId":19384,"position":1,"word":"ثُمَّ","text":"{ثُمَّ} : حَرْفٌ مَ