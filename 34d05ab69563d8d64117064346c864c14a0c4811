ٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nيَاقَوْمِ: {يَا} : حَرْفٌ مَبْنِيٌّ، {قَوْمِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nلَقَدْ: {قَدْ} : حَرْفٌ مَبْنِيٌّ.\n\nأَبْلَغْتُكُمْ: {أَبْلَغْتُ} : فِعْلٌ مَاضٍ لِلْمُتَكَلِّمِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، مِنْ مَادَّةِ: (بلغ) .\n\nرِسَالَةَ: {رِسَالَةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فِعَالَةٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nرَبِّي: {رَبِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nوَنَصَحْتُ: {نَصَحْتُ} : فِعْلٌ مَاضٍ لِلْمُتَكَلِّمِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (نصح) .\n\nلَكُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nوَلَكِنْ: {لَكِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nتُحِبُّونَ: {تُحِبُّونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (تُؤَحْبِبُ) ، عَلَى وَزْنِ: (تُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (حبب) .\n\nالنَّاصِحِينَ: {النَّاصِحِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (نَاصِحٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (نَصَحَ يَنْصَحُ) ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (نصح) .","words":[{"wordId":20506,"position":1,"word":"فَتَوَلَّى","text":"{تَوَلَّى} : فِ