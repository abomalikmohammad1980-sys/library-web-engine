ً: {ذُرِّيَّةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فُعْلَةٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ذرر) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nبَعْدِهِمْ: {بَعْدِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بعد) .\n\nأَفَتُهْلِكُنَا: {تُهْلِكُ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (تُؤَهْلِكُ) ، عَلَى وَزْنِ: (تُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (هلك) .\n\nبِمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nفَعَلَ: {فَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (فعل) .\n\nالْمُبْطِلُونَ: {الْمُبْطِلُونَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُبْطِلٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَبْطَلَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَبْطِلٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (بطل) .","words":[{"wordId":22063,"position":1,"word":"أَوْ","text":"{أَوْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":22064,"position":2,"word":"تَقُولُوا","text":"{تَقُولُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (تَقْوُلُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) ."},{"wordId":22065,"position":3,"word":"إِنَّمَا","text":"{إِنَّ} : حَرْفٌ مَبْنِيٌّ، {مَا} : حَرْفٌ مَبْنِيٌّ."},{"wordId":22066,"position":4,"word":"أَشْرَكَ","text":"{أَشْرَكَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، 