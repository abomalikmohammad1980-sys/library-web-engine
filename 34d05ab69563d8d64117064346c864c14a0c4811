يٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (بشر) ."},{"wordId":22315,"position":27,"word":"لِقَوْمٍ","text":"{قَوْمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) ."},{"wordId":22316,"position":28,"word":"يُؤْمِنُونَ","text":"{يُؤْمِنُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَأْمِنُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (أمن) ."}]},{"ayah":189,"from":189,"to":189,"text":"هُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nالَّذِي: {الَّذِي} : اسْمٌ مَبْنِيٌّ.\n\nخَلَقَكُمْ: {خَلَقَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (خلق) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nنَفْسٍ: {نَفْسٍ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (نفس) .\n\nوَاحِدَةٍ: {وَاحِدَةٍ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فَاعِلَةٌ) ، مِنْ مَادَّةِ: (وحد) .\n\nوَجَعَلَ: {جَعَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (جعل) .\n\nمِنْهَا: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nزَوْجَهَا: {زَوْجَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (زوج) .\n\nلِيَسْكُنَ: {يَسْكُنَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، مِنْ مَادَّةِ: (سكن) .\n\nإِلَيْهَا: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nفَلَمَّا: {لَمَّا} : اسْمٌ مَبْنِيٌّ.\n\nتَغَشَّاهَا: {تَغَشَّى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (تَفَعَّلَ) ، أَصْلُهُ: (تَغَشَّيَ) ، عَلَى وَزْنِ: (تَفَعَّلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (غشي) .\n\nحَمَلَتْ: {حَمَلَتْ} : فِعْلٌ مَاضٍ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (حمل) .\n\nحَمْلًا: {حَمْلًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (حَمَلَ يَحْمِلُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (حمل) .\n\nخَفِيفًا: {خَفِيفًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَفَّ يَخِفُّ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (خفف) .\n\nفَمَرَّتْ: {مَرَّتْ} : فِعْلٌ مَاضٍ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (مَرَرَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (مرر) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nفَلَمَّا: {لَمَّا} : اسْمٌ مَبْنِيٌّ.\n\nأَثْقَلَتْ: {أَثْقَلَتْ} : فِعْلٌ مَاضٍ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، مِنْ مَادَّةِ: (ثقل) .\n\nدَعَوَا: {دَعَوَا} : فِعْلٌ مَاضٍ لِلْغَائِب، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (دعو) .\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nرَبَّهُمَا: {رَبَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nلَئِنْ: {إِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nآتَيْتَنَا: {آتَيْتَ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْفَاءِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَأْتَيَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أتي) .\n\nصَالِحًا: {صَالِحًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (صَلَحَ يَصْلُحُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (صلح) .\n\nلَنَكُونَنَّ: {نَكُونَنَّ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّم، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: النُّونِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (نَكْوُنُ) ، عَلَى وَزْنِ: (نَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالشَّاكِرِينَ: {الشَّاكِرِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (شَاكِرٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَكَرَ يَشْكُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (شكر) .","words":[{"wordId":22317,"position":1,"word":"هُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":22318,"position":2,"word":"الَّذِي","text":"{الَّذِي} : اسْمٌ مَبْنِيٌّ."},{"wordId":22319,"position":3,"word":"خَلَقَكُمْ","text":"{خَلَقَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، م