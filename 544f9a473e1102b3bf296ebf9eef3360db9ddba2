import{describe,expect,it}from"vitest";import{VersionKeyInvalidationWorker}from"./cache-invalidation.js";import type{D1DatabaseBinding}from"./bindings.js";
function db(active=true){const sql:string[]=[],binding:D1DatabaseBinding={prepare(s){sql.push(s);return{bind(){return this},all:async()=>({success:true,results:[{operation_id:"publication:b:b2",book_id:"b",build_id:"b2",manifest_etag:'"build-b2"',attempt:0,record_version:0}]}),first:async()=>active?{buildId:"b2",etag:'"build-b2"'}:null,run:async()=>({success:true,meta:{changes:1}})}}};return{binding,sql}}
describe("version-key invalidation outbox",()=>{it("delivers idempotently without deleting immutable artifacts",async()=>{const x=db(),result=await new VersionKeyInvalidationWorker(x.binding,{batchSize:10,leaseMs:1000,baseRetryMs:100},()=>10).run("lease");expect(result).toEqual({claimed:1,delivered:1,retried:0});expect(x.sql.join(" ")).not.toMatch(/DELETE|SOURCE_OBJECTS/)});it("preserves publication and retries when revalidation cannot observe it",async()=>{const x=db(false),result=await new VersionKeyInvalidationWorker(x.binding,{batchSize:10,leaseMs:1000,baseRetryMs:100},()=>10).run("lease");expect(result.retried).toBe(1);expect(x.sql.join(" ")).toContain("state='retryable'")})});
