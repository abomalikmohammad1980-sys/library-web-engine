{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":80,"records":[{"ayah":1,"from":1,"to":1,"text":"قطّب رسول الله صلّى الله عليه وسلّم وجهه وأعرض."},{"ayah":2,"from":2,"to":2,"text":"لأجل مجيء عبد الله بن أم مكتوم يسترشده، وكان أعمى، جاء والرسول صلّى الله عليه وسلّم منشغل بأكابر المشركين أملًا في هدايتهم."},{"ayah":3,"from":3,"to":3,"text":"وما يُعْلِمُكَ - أيها الرسول - لعل هذا الأعمى يتطهر من ذنوبه؟!"},{"ayah":4,"from":4,"to":4,"text":"أو يتعظ بما يسمع منك من المواعظ، فينتفع بها."},{"ayah":5,"from":5,"to":5,"text":"أما من استغنى بنفسه بما لديه من المال عن الإيمان بما جئت به."},{"ayah":6,"from":6,"to":6,"text":"فأنت تَتَعرَّض له، وتُقبل إليه."},{"ayah":7,"from":7,"to":7,"text":"وأي شيء يلحقك إذا لم يتطهر من ذنوبه بالتوبة إلى الله."},{"ayah":8,"from":8,"to":8,"text":"وأما من جاءك يسعى بحثًا عن الخير."},{"ayah":9,"from":9,"to":9,"text":"وهو يخشى ربه."},{"ayah":10,"from":10,"to":10,"text":"فأنت تتشاغل عنه بغيره من أكابر المشركين."},{"ayah":11,"from":11,"to":11,"text":"ليس الأمر كذلك، إنما هي موعظة وتذكير لمن يقبل."},{"ayah":12,"from":12,"to":12,"text":"فمن شاء أن يذكر الله ذكره، واتعظ بما في هذا القرآن."},{"ayah":13,"from":13,"to":13,"text":"فهذا القرآن في صحف شريفة عند الملائكة."},{"ayah":14,"from":14,"to":14,"text":"مرفوعة في مكان عال، مطهرة لا يصيبها دَنَس ولا رِجْس."},{"ayah":15,"from":15,"to":15,"text":"وهي بأيدي رسل من الملائكة."},{"ayah":16,"from":16,"to":16,"text":"كرام عند ربهم، كثيري فعل الخير والطاعات."},{"ayah":17,"from":17,"to":17,"text":"لُعِن الإنسان الكافر، ما أشدّ كفره بالله!"},{"ayah":18,"from":18,"to":18,"text":"من أيّ شيء خلقه الله حتى يتكبّر في الأرض ويَكْفُرَهُ؟!"},{"ayah":19,"from":19,"to":19,"text":"من ماء قليل خلقه، فَقَدَّر خلقه طورًا بعد طور."},{"ayah":20,"from":20,"to":20,"text":"ثم يسّر له بعد هذه الأطوار الخروج من بطن أمه."},{"ayah":21,"from":21,"to":21,"text":"ثم بعد ما قَدَّر له من عمر في الحياة أماته، وجعل له قبرًا يبقى فيه إلى أن يبعث."},{"ayah":22,"from":22,"to":22,"text":"ثم إذا شاء بَعَثَهُ للحساب والجزاء."},{"ayah":23,"from":23,"to":23,"text":"ليس الأمر كما يتوهم هذا الكافر أنه أدى ما عليه لربه من حق، فهو لم يؤدّ ما أوجب الله عليه من الفرائض."},{"ayah":24,"from":24,"to":24,"text":"فلينظر الإنسان الكافر بالله إلى طعامه الذي يأكله كيف حصل؟!"},{"ayah":25,"from":25,"to":25,"text":"فأصله من المطر النازل من السماء بقوة وغزارة."},{"ayah":26,"from":26,"to":26,"text":"ثم فَتَقْنا الأرض فانشقت عن النبات."},{"ayah":27,"from":27,"to":27,"text":"فأنبتنا فيها الحبوب من قمح وذرة وغيرهما."},{"ayah":28,"from":28,"to":28,"text":"وأنبتنا فيها عنبًا وقتًّا رطبًا؛ ليكون علفًا لدوابهم."},{"ayah":29,"from":29,"to":29,"text":"وأنبتنا فيها زيتونًا ونخلًا."},{"ayah":30,"from":30,"to":30,"text":"وأنبتنا فيها بساتين كثيرة الأشجار."},{"ayah":31,"from":31,"to":31,"text":"وأنبتنا فيها فاكهة، وأنبتنا فيها ما ترعاه بهائمكم."},{"ayah":32,"from":32,"to":32,"text":"لانتفاعكم، وانتفاع بهائمكم."},{"ayah":33,"from":33,"to":33,"text":"فإذا جاءت الصيحة العظيمة التي تصخ الآذان وهي النفخة الثانية."},{"ayah":34,"from":34,"to":34,"text":"يوم يهرب المرء من أخيه."},{"ayah":35,"from":35,"to":35,"text":"ويفرّ من أمه وأبيه."},{"ayah":36,"from":36,"to":36,"text":"ويفرّ من زوجته وأولاده."},{"ayah":37,"from":37,"to":37,"text":"لكلّ واحد منهم ما يشغله عن الآخر من شدّة الكرب في ذلك اليوم."},{"ayah":38,"from":38,"to":38,"text":"وجوه السعداء في ذلك اليوم مضيئة."},{"ayah":39,"from":39,"to":39,"text":"ضاحكة فرحة بما أعدّ الله لها من رحمته."},{"ayah":40,"from":40,"to":40,"text":"ووجوه الأشقياء في ذلك اليوم عليها غبار."},{"ayah":41,"from":41,"to":41,"text":"تغشاها ظلمة."},{"ayah":42,"from":42,"to":42,"text":"أولئك الموصوفون بتلك الحال هم الذين جمعوا بين الكفر والفجور."}]}