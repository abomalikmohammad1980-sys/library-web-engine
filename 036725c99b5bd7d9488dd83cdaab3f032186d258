import { lstat,mkdir,open,rename,rm,stat } from "node:fs/promises";import { dirname } from "node:path";import type { ServiceFilePort } from "./service-install-engine.js";
export class NodeSafeServiceFilePort implements ServiceFilePort{async assertSafeTarget(path:string){const parent=dirname(path);await mkdir(parent,{recursive:true});const p=await stat(parent);if(!p.isDirectory())throw Error("service descriptor parent is not a directory");const uid=process.getuid?.();if(uid!==undefined&&p.uid!==uid)throw Error("service descriptor parent is not owned by current user");try{const t=await lstat(path);if(t.isSymbolicLink())throw Error("refusing to overwrite symlink");if(!t.isFile())throw Error("service descriptor target is not a regular file");if(uid!==undefined&&t.uid!==uid)throw Error("service descriptor is not owned by current user")}catch(e){if((e as NodeJS.ErrnoException).code!=="ENOENT")throw e}}async writeAtomic(path:string,content:string){const temp=`${path}.tmp-${process.pid}-${crypto.randomUUID()}`;const h=await open(temp,"wx",0o600);try{await h.writeFile(content,"utf8");await h.sync()}finally{await h.close()}await rename(temp,path)}remove(path:string){return rm(path,{force:true})}}
