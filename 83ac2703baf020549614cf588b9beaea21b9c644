import{unzipSync}from"fflate";
export interface DocxIntakePolicy{maxBytes:number;maxEntries:number;maxUncompressedBytes:number;maxCompressionRatio:number;allowEmbeddings:boolean;allowExternalRelationships:boolean;allowSignatures:boolean}
export type DocxIntakeReason="invalid_zip"|"unsafe_entry_path"|"encrypted_entry"|"entry_limit"|"expanded_size_limit"|"compression_ratio_limit"|"missing_required_part"|"invalid_content_types"|"macro_present"|"activex_present"|"ole_embedding_present"|"external_relationship_present"|"signature_present";
export type DocxIntakeResult={kind:"allow"}|{kind:"quarantine"|"reject";reason:DocxIntakeReason};
export function validateDocxIntake(bytes:Uint8Array,p:DocxIntakePolicy):DocxIntakeResult{validatePolicy(p);if(bytes.byteLength>p.maxBytes)return reject("expanded_size_limit");const meta=central(bytes,p);if("kind"in meta)return meta;let files:Record<string,Uint8Array>;try{files=unzipSync(bytes)}catch{return reject("invalid_zip")}if(!files["[Content_Types].xml"]||!files["word/document.xml"])return reject("missing_required_part");const types=text(files["[Content_Types].xml"]!);if(!/application\/vnd\.openxmlformats-officedocument\.wordprocessingml\.document\.main\+xml/i.test(types))return reject("invalid_content_types");const names=Object.keys(files).map(x=>x.toLowerCase());if(names.some(x=>x.endsWith("vbaproject.bin")))return quarantine("macro_present");if(names.some(x=>x.startsWith("word/activex/")))return quarantine("activex_present");if(!p.allowEmbeddings&&names.some(x=>x.startsWith("word/embeddings/")))return quarantine("ole_embedding_present");if(!p.allowSignatures&&names.some(x=>x.startsWith("_xmlsignatures/")))return quarantine("signature_present");if(!p.allowExternalRelationships)for(const[n,b]of Object.entries(files))if(n.endsWith(".rels")&&/TargetMode\s*=\s*["']External["']/i.test(text(b)))return quarantine("external_relationship_present");return{kind:"allow"}}
function central(bytes:Uint8Array,p:DocxIntakePolicy):{}|DocxIntakeResult{const v=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength),e=find(v);if(e<0)return reject("invalid_zip");const count=v.getUint16(e+10,true),size=v.getUint32(e+12,true),start=v.getUint32(e+16,true);if(count>p.maxEntries)return reject("entry_limit");let o=start,total=0;for(let i=0;i<count;i++){if(o+46>e||v.getUint32(o,true)!==0x02014b50)return reject("invalid_zip");const flags=v.getUint16(o+8,true),compressed=v.getUint32(o+20,true),raw=v.getUint32(o+24,true),nl=v.getUint16(o+28,true),xl=v.getUint16(o+30,true),cl=v.getUint16(o+32,true),next=o+46+nl+xl+cl;if(flags&1)return reject("encrypted_entry");if(next>e)return reject("invalid_zip");let name="";try{name=new TextDecoder("utf-8",{fatal:true}).decode(bytes.subarray(o+46,o+46+nl))}catch{return reject("invalid_zip")}if(!safe(name))return reject("unsafe_entry_path");total+=raw;if(total>p.maxUncompressedBytes)return reject("expanded_size_limit");if(raw>0&&(compressed===0||raw/compressed>p.maxCompressionRatio))return reject("compression_ratio_limit");o=next}return o===start+size?{}:reject("invalid_zip")}
function find(v:DataView){for(let o=v.byteLength-22;o>=Math.max(0,v.byteLength-65557);o--)if(v.getUint32(o,true)===0x06054b50)return o;return-1}function safe(n:string){return!!n&&!n.includes("\\")&&!n.startsWith("/")&&!/^[A-Za-z]:/.test(n)&&!n.split("/").includes("..")}function text(b:Uint8Array){return new TextDecoder().decode(b)}function reject(reason:DocxIntakeReason){return{kind:"reject"as const,reason}}function quarantine(reason:DocxIntakeReason){return{kind:"quarantine"as const,reason}}function validatePolicy(p:DocxIntakePolicy){for(const k of["maxBytes","maxEntries","maxUncompressedBytes","maxCompressionRatio"]as const)if(!Number.isFinite(p[k])||p[k]<=0)throw Error(`invalid ${k}`)}
