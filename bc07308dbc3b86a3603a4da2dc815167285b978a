َعِلْ) ، فِيهِ إِبْدَالُ حَرْفِ: الْوَاوِ تَاءً، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (وقي) .\n\nرَبَّكُمْ: {رَبَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nوَاخْشَوْا: {اخْشَوْا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، أَصْلُهُ: (اخْشَيْ) ، عَلَى وَزْنِ: (افْعَلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (خشي) .\n\nيَوْمًا: {يَوْمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (يوم) .\n\nلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nيَجْزِي: {يَجْزِي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (يَفْعِلُ) ، مِنْ مَادَّةِ: (جزي) .\n\nوَالِدٌ: {وَالِدٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (وَلَدَ يَلِدُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nوَلَدِهِ: {وَلَدِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nوَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nمَوْلُودٌ: {مَوْلُودٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ مَفْعُولٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (وَلَدَ يَلِدُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْمِيمِ وَالْوَاوِ، عَلَى وَزْنِ: (مَفْعُولٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nجَازٍ: {جَازٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (جَزَى يَجْزِي) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَنْقُوصٌ، أَصْلُهُ: (جَازِيٌ) ، عَلَى وَزْنِ: (فَاعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِثِقَلِ الضَّمَّةِ عَلَى الْيَاءِ، مِنْ مَادَّةِ: (جزي) .\n\nعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nوَالِدِهِ: {وَالِدِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (وَلَدَ يَلِدُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nشَيْئًا: {شَيْئًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (شيأ) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nوَعْدَ: {وَعْدَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (وَعَدَ يَعِدُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (وعد) .\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nحَقٌّ: {حَقٌّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حقق) .\n\nفَلَا: {لَا} : حَرْفٌ مَبْنِيٌّ.\n\nتَغُرَّنَّكُمُ: {تَغُرَّنَّ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (تَغْرُرُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (غرر) .\n\nالْحَيَاةُ: {الْحَيَاةُ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (حَيَيَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (حيي) .\n\nالدُّنْيَا: {الدُّنْيَا} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (دَنَا يَدْنُو) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَقْصُورٌ، أَصْلُهُ: (دُنْوَى) ، عَلَى وَزْ