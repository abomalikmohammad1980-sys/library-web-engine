ارِعٌ لِلْمُتَكَلِّمِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (أَوْجِدُ) ، عَلَى وَزْنِ: (أَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِلثِّقَلِ، مِنْ مَادَّةِ: (وجد) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nأُوحِيَ: {أُوحِيَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَفْرُوقٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أُفْعِلَ) ، مِنْ مَادَّةِ: (وحي) .\n\nإِلَيَّ: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nمُحَرَّمًا: {مُحَرَّمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ مَفْعُولٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (حَرَّمَ) ، مِنْ بَابِ: (فَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْمِيمِ وَحَرْفٍ مُضَعَّفٍ، عَلَى وَزْنِ: (مُفَعَّلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حرم) .\n\nعَلَى: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nطَاعِمٍ: {طَاعِمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (طَعِمَ يَطْعَمُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (طعم) .\n\nيَطْعَمُهُ: {يَطْعَمُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، مِنْ مَادَّةِ: (طعم) .\n\nإِلَّا: {إِلَّا} : حَرْفٌ مَبْنِيٌّ.\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nيَكُونَ: {يَكُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَكْوُنُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nمَيْتَةً: {مَيْتَةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فَعْلَةٌ) ، مِنْ مَادَّةِ: (موت) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nدَمًا: {دَمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (دمم) .\n\nمَسْفُوحًا: {مَسْفُوحًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ مَفْعُولٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (سَفَحَ يَسْفَحُ) ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْمِيمِ وَالْوَاوِ، عَلَى وَزْنِ: (مَفْعُولٌ) ، مِنْ مَادَّةِ: (سفح) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nلَحْمَ: {لَحْمَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (لحم) .\n\nخِنْزِيرٍ: {خِنْزِيرٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فِعْلِيلٌ) ، مِنْ مَادَّةِ: (خنزر) .\n\nفَإِنَّهُ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nرِجْسٌ: {رِجْسٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (رجس) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nفِسْقًا: {فِسْقًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (فسق) .\n\nأُهِلَّ: {أُهِلَّ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أُهْلِلَ) ، عَلَى وَزْنِ: (أُفْعِلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (هلل) .\n\nلِغَيْرِ: {غَيْرِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (غير) .\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nفَمَنِ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nاضْطُرَّ: {اضْطُرَّ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (اضْتُرِرَ) ، ع