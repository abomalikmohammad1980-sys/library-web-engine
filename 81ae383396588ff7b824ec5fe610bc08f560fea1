ِنْ مَادَّةِ: (أله) .\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nيَهْدِيَهُ: {يَهْدِيَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (يَفْعِلُ) ، مِنْ مَادَّةِ: (هدي) .\n\nيَشْرَحْ: {يَشْرَحْ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، مِنْ مَادَّةِ: (شرح) .\n\nصَدْرَهُ: {صَدْرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (صدر) .\n\nلِلْإِسْلَامِ: {الْإِسْلَامِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَسْلَمَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (إِفْعَالٌ) ، مِنْ مَادَّةِ: (سلم) .\n\nوَمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nيُرِدْ: {يُرِدْ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَرْوِدُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ وَالْيَاءِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (رود) .\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nيُضِلَّهُ: {يُضِلَّ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَضْلِلُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (ضلل) .\n\nيَجْعَلْ: {يَجْعَلْ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، مِنْ مَادَّةِ: (جعل) .\n\nصَدْرَهُ: {صَدْرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (صدر) .\n\nضَيِّقًا: {ضَيِّقًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (ضَاقَ يَضِيقُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَيْعِلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ضيق) .\n\nحَرَجًا: {حَرَجًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (حرج) .\n\nكَأَنَّمَا: {كَأَنَّ} : حَرْفٌ مَبْنِيٌّ، {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nيَصَّعَّدُ: {يَصَّعَّدُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (تَفَعَّلَ) ، أَصْلُهُ: (يَتَصَعَّدُ) ، عَلَى وَزْنِ: (يَتَفَعَّلُ) ، فِيهِ إِبْدَالُ حَرْفِ: التَّاءِ حَرْفًا مُجَانِسًا لِمَا بَعْدَهُ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (صعد) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nالسَّمَاءِ: {السَّمَاءِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (سَمَاوٌ) ، عَلَى وَزْنِ: (فَعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (سمو) .\n\nكَذَلِكَ: {ذَلِكَ} : اسْمٌ مَبْنِيٌّ.\n\nيَجْعَلُ: {يَجْعَلُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، مِنْ مَادَّةِ: (جعل) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nالرِّجْسَ: {الرِّجْسَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (رجس) .\n\nعَلَى