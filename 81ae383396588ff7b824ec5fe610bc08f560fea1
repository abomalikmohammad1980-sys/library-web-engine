ْتَعَلَ) ، أَصْلُهُ: (افْتَرَيَ) ، عَلَى وَزْنِ: (افْتَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (فري) .\n\nعَلَى: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nكَذِبًا: {كَذِبًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَذَبَ يَكْذِبُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعِلٌ) ، مِنْ مَادَّةِ: (كذب) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nقَالَ: {قَالَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nأُوحِيَ: {أُوحِيَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَفْرُوقٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أُفْعِلَ) ، مِنْ مَادَّةِ: (وحي) .\n\nإِلَيَّ: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nوَلَمْ: {لَمْ} : حَرْفٌ مَبْنِيٌّ.\n\nيُوحَ: {يُوحَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ لَفِيفٌ مَفْرُوقٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَوْحَيُ) ، عَلَى وَزْنِ: (يُؤَفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (وحي) .\n\nإِلَيْهِ: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nشَيْءٌ: {شَيْءٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (شيأ) .\n\nوَمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nقَالَ: {قَالَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nسَأُنْزِلُ: {أُنْزِلُ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّمِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أُؤَنْزِلُ) ، عَلَى وَزْنِ: (أُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (نزل) .\n\nمِثْلَ: {مِثْلَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (مثل) .\n\nمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nأَنْزَلَ: {أَنْزَلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، مِنْ مَادَّةِ: (نزل) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَلَوْ: {لَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nتَرَى: {تَرَى} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، أَصْلُهُ: (تَرْأَيُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (رأي) .\n\nإِذِ: {إِذْ} : اسْمٌ مَبْنِيٌّ.\n\nالظَّالِمُونَ: {الظَّالِمُونَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (ظَالِمٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (ظَلَمَ يَظْلِمُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (ظلم) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nغَمَرَاتِ: {غَمَرَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (غَمْرَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (غمر) .\n\nالْمَوْتِ: {الْمَوْتِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (موت) .\n\nوَالْمَلَائِكَةُ: {الْمَلَائِكَةُ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (مَلَكٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْهَمْزَةِ، عَلَى وَزْنِ: (فَعَائِلَةٌ) ، مِنْ مَادَّةِ: (ألك) .\n\nبَاسِطُو: {بَاسِطُو} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (بَاسِطٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (بَسَطَ يَبْسُطُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (بسط) .\n\nأَيْدِيهِمْ: {أَيْدِي} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَدٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مَنْقُوصٌ، عَلَى وَزْنِ: (أَفْعُلٌ) ، مِنْ مَادَّةِ: (يدي) .\n\nأَخْرِجُوا: {أَخْرِجُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، مِنْ مَادَّةِ: (خرج) .\n\nأَنْفُسَكُمُ: {أَنْفُسَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (نَفْسٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، عَلَى وَزْنِ: (أَفْعُلٌ) ، مِنْ مَادَّةِ: (نفس) .\n\nالْيَوْمَ: {الْيَوْمَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (يوم) .\n\nتُجْزَوْنَ: {تُجْزَوْنَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (تُجْزَيُ) ، عَلَى وَزْنِ: (تُفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (جزي) .\n\nعَذَابَ: {عَذَابَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (عذب) .\n\nالْهُونِ: {الْهُونِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (هون) .\n\nبِمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nكُنْتُمْ: {كُنْتُمْ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (كون) .\n\nتَقُولُونَ: {تَقُولُونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (تَقْوُلُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nعَلَى: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nغَيْرَ: {غَيْرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (غير) .\n\nالْحَقِّ: {الْحَقِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حقق) .\n\nوَكُنْتُمْ: {كُنْتُمْ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (كون) .\n\nعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nآيَاتِهِ: {آيَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (آيَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (أَيَيٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (أيي) .\n\nتَسْتَكْبِرُونَ: {تَسْتَكْبِرُونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، سُدَاسِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: التَّاءِ وَالسِّينِ، مِنْ بَابِ: (اسْتَفْع