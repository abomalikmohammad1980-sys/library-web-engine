{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":83,"records":[{"ayah":1,"from":1,"to":1,"text":"هلاك وخسار للمُطَفِّفين."},{"ayah":2,"from":2,"to":2,"text":"وهم الذين إذا اكتالوا من غيرهم يستوفون حقهم كاملًا دون نقص."},{"ayah":3,"from":3,"to":3,"text":"وإذا كالوا للناس أو وزنوا لهم ينقصون الكيل والميزان؛ وكان ذلك حال أهل المدينة عند هجرة النبي صلّى الله عليه وسلّم إليهم."},{"ayah":4,"from":4,"to":4,"text":"ألا يتيقن هؤلاء الذين يفعلون هذا المنكر أنهم مبعوثون إلى الله؟!"},{"ayah":5,"from":5,"to":5,"text":"للحساب والجزاء في يوم عظيم لما فيه من المحن والأهوال."},{"ayah":6,"from":6,"to":6,"text":"يوم يقوم الناس لرب الخلائق كلها؛ للحساب."},{"ayah":7,"from":7,"to":7,"text":"ليس الأمر كما تصوّرتم من أنه لا بَعْث بعد الموت، إن كتاب أهل الفجور من الكفار والمنافقين لفي خسار في الأرض السفلى."},{"ayah":8,"from":8,"to":8,"text":"وما أعلمك - أيها الرسول - ما سِجِّين؟!"},{"ayah":9,"from":9,"to":9,"text":"إن كتابهم مكتوب لا يزول، ولا يُزَاد فيه ولا يُنْقص."},{"ayah":10,"from":10,"to":10,"text":"هلاك وخسار في ذلك اليوم للمكذبين."},{"ayah":11,"from":11,"to":11,"text":"الذين يكذبون بيوم الجزاء الذي يجازي فيه الله عباده على أعمالهم في الدنيا."},{"ayah":12,"from":12,"to":12,"text":"وما يكذب بذلك اليوم إلا كل متجاوز لحدود الله، كثير الآثام."},{"ayah":13,"from":13,"to":13,"text":"إذا تُقْرأ عليه آياتنا المنزلة على رسولنا قال: هي أقاصيص الأمم الأولى، وليست من عند الله."},{"ayah":14,"from":14,"to":14,"text":"ليس الأمر كما تصور هؤلاء المكذبون، بل غلب على عقولهم وغطاها ما كانوا يكسبون من المعاصي، فلم يبصروا الحق بقلوبهم."},{"ayah":15,"from":15,"to":15,"text":"حقًّا إنهم عن رؤية ربهم يوم القيامة لممنوعون."},{"ayah":16,"from":16,"to":16,"text":"ثم إنهم لداخلو النار، يعانون حرّها."},{"ayah":17,"from":17,"to":17,"text":"ثم يقال لهم يوم القيامة تقريعًا لهم: هذا العذاب الذي لقيتموه هو ما كنتم تكذبون به في الدنيا عندما يخبركم به رسولكم."},{"ayah":18,"from":18,"to":18,"text":"ليس الأمر كما تصورتم من أنه لا حساب ولا جزاء، إن كتاب أصحاب الطاعة لفي عِلِّيين."},{"ayah":19,"from":19,"to":19,"text":"وما أعلمك - أيها الرسول - ما عِلِّيُّون؟!"},{"ayah":20,"from":20,"to":20,"text":"إن كتابهم مكتوب لا يزول، ولا يُزَاد فيه ولا يُنْقص."},{"ayah":21,"from":21,"to":21,"text":"يحضر هذا الكتاب مقربو كل سماء من الملائكة."},{"ayah":22,"from":22,"to":22,"text":"إن المكثرين من الطاعات لفي نعيم دائم يوم القيامة."},{"ayah":23,"from":23,"to":23,"text":"على الأسرّة المزينة ينظرون إلى ربهم، وإلى كل ما يبهج نفوسهم ويسرهم."},{"ayah":24,"from":24,"to":24,"text":"إذا رأيتهم رأيت في وجوههم أثر التنعّم حُسْنًا وبهاء."},{"ayah":25,"from":25,"to":25,"text":"يسقيهم خدمهم من خمر مختوم على إنائها."},{"ayah":26,"from":26,"to":26,"text":"تفوح رائحة المسك منه إلى نهايته، وفي هذا الجزاء الكريم يجب أن يتسابق المتسابقون، بالعمل بما يرضي الله، وترك ما يسخطه."},{"ayah":27,"from":27,"to":27,"text":"يُخْلط هذا الشراب المختوم من عين تَسْنيم."},{"ayah":28,"from":28,"to":28,"text":"وهي عين في أعلى الجنة يشرب منها المقربون صافية خالصة، ويشرب سائر المؤمنين منها، مخلوطة بغيرها."},{"ayah":29,"from":29,"to":29,"text":"إن الذين أجرموا بما كانوا عليه من الكفر كانوا من الذين آمنوا يضحكون استهزاءً بهم."},{"ayah":30,"from":30,"to":30,"text":"وإذا مرّوا بالمؤمنين غمز بعضهم لبعض سخرية وتَنَدُّرًا."},{"ayah":31,"from":31,"to":31,"text":"وإذا رجعوا إلى أهليهم رجعوا فرحين بما هم عليه من الكفر والاستهزاء بالمؤمنين."},{"ayah":32,"from":32,"to":32,"text":"وإذا شاهدوا المسلمين قالوا: إن هؤلاء لضالون عن طريق الحق، حيث تركوا دين آبائهم."},{"ayah":33,"from":33,"to":33,"text":"وما وكلهم الله على حفظ أعمالهم حتى يقولوا قولهم هذا."},{"ayah":34,"from":34,"to":34,"text":"فيوم القيامة الذين آمنوا بالله يضحكون من الكفار كما كان الكفار يضحكون منهم في الدنيا."},{"ayah":35,"from":35,"to":35,"text":"على الأسرّة المزينة ينظرون إلى ما أعدّ الله لهم من النعيم الدائم."},{"ayah":36,"from":36,"to":36,"text":"لَقَدْ جُوزِي الكفار على أعمالهم التي عملوها في الدنيا بالعذاب المُهِين."}]}