{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":20,"records":[{"ayah":1,"from":1,"to":1,"text":"﴿طه﴾ تقدم الكلام على نظائرها في بداية سورة البقرة."},{"ayah":2,"from":2,"to":2,"text":"ما أنزلنا عليك - أيها الرسول - القرآن ليكون سببًا في إرهاق نفسك أسفًا على إعراض قومك عن الإيمان بك."},{"ayah":3,"from":3,"to":3,"text":"ما أنزلناه إلا ليكون تذكيرًا لمن وفقهم الله لخشيته."},{"ayah":4,"from":4,"to":4,"text":"نزّله الله الذي خلق الأرض، وخلق السماوات المرتفعة، فهو قرآن عظيم؛ لأنه منزل من عند عظيم."},{"ayah":5,"from":5,"to":5,"text":"الرحـمٰ‍‍ن ع‍لا وارتفع على العرش علوًّا يليق بجلاله سبحانه وتعالى."},{"ayah":6,"from":6,"to":6,"text":"له سبحانه وحده ما في السماوات وما في الأرض وما تحت التراب من مخلوقات، خلقًا وملكًا وتدبيرًا."},{"ayah":7,"from":7,"to":7,"text":"وإن تعلن - أيها الرسول - القول، أو تخفه فإنه سبحانه يعلم ذلك كله، فهو يعلم السر وما هو أخفى من السر مثل خواطر النفس، لا يخفى عليه شيء من ذلك."},{"ayah":8,"from":8,"to":8,"text":"الله لا معبود بحق غيره، له وحده الأسماء البالغة الكمال في الحسن."},{"ayah":9,"from":9,"to":9,"text":"ولقد جاءك - أيها الرسول - خبر موسى بن عمران عليه السلام."},{"ayah":10,"from":10,"to":10,"text":"حين عاين في سفره نارًا، فقال لأهله: أقيموا في مكانكم هذا، إني أبصرت نارًا لعلي آتيكم من هذه النار بشعلة، أو أجد من يهديني إلى الطريق."},{"ayah":11,"from":11,"to":11,"text":"فلما جاء النار ناداه الله سبحانه بقوله: يا موسى."},{"ayah":12,"from":12,"to":12,"text":"إني أنا ربك فانزع نعليك استعدادًا لمناجاتي، إنك بالوادي المُطَهَّر (طُوَى)."},{"ayah":13,"from":13,"to":13,"text":"وأنا اصطفيتك - يا موسى - لتبليغ رسالتي، فاستمع لما أوحيه إليك."},{"ayah":14,"from":14,"to":14,"text":"إنني أنا الله لا معبود بحق غيري، فاعبدني وحدي، وأدّ الصلاة على أكمل وجه لتذكُرني فيها."},{"ayah":15,"from":15,"to":15,"text":"إن الساعة آتية لا محالة وواقعة، أكاد أخفيها فلا يعلم وقتها مخلوق، ولكن يعرفون علاماتها بإخبار النبي لهم؛ لكي تُجَازَى كل نفس بما عملته، خيرًا كان أو شرًّا."},{"ayah":16,"from":16,"to":16,"text":"فلا يصرفنّك عن التصديق بها والاستعداد لها بالعمل الصالح من لا يؤمن بها من الكفار، واتبع ما تهواه نفسه من المحرمات، فتهلك بسبب ذلك."},{"ayah":17,"from":17,"to":17,"text":"وما تلك التي بيدك اليمنى يا موسى؟"},{"ayah":18,"from":18,"to":18,"text":"قال موسى عليه السلام: هي عصاي؛ أعتمد عليها في المشي، وأخبط بها الشجر ليسقط ورقها لغنمي، ولي فيها منافع غير ما ذكرت."},{"ayah":19,"from":19,"to":19,"text":"قال الله: ألقها يا موسى."},{"ayah":20,"from":20,"to":20,"text":"فألقاها موسى، فانقلبت حية تمشي بسرعة وخفّة."},{"ayah":21,"from":21,"to":21,"text":"قال الله لموسى عليه السلام: خذ العصا، ولا تخف من انقلابها حية، سنعيدها إذا أخذتها إلى حالتها الأولى."},{"ayah":22,"from":22,"to":22,"text":"واضمم يدك إلى جنبك تخرج بيضاء من غير برص؛ علامة ثانية لك."},{"ayah":23,"from":23,"to":23,"text":"أريناك هاتين العلامتين لنريك - يا موسى - من آياتنا العظمى الدالة على قدرتنا، وعلى أنك رسول من عند الله."},{"ayah":24,"from":24,"to":24,"text":"سر - يا موسى - إلى فرعون، فإنه تجاوز الحد في الكفر والتمرّد على الله."},{"ayah":25,"from":25,"to":25,"text":"قال موسى عليه السلام: رب، وسّع لي صدري لأتحمّل الأذى."},{"ayah":26,"from":26,"to":26,"text":"وسهّل لي أمري."},{"ayah":27,"from":27,"to":27,"text":"وأقدرني على النطق بالفصيح من الكلام."},{"ayah":28,"from":28,"to":28,"text":"ليفهموا كلامي إذا بلّغتهم رسالتك."},{"ayah":29,"from":29,"to":29,"text":"واجعل لي معينًا من أهلي يعينني في أموري."},{"ayah":30,"from":30,"to":30,"text":"هارون بن عمران أخي."},{"ayah":31,"from":31,"to":31,"text":"قوِّ به ظهري."},{"ayah":32,"from":32,"to":32,"text":"واجعله شريكًا لي في الرسالة."},{"ayah":33,"from":33,"to":33,"text":"لكي نسبّحك تسبيحًا كثيرًا."},{"ayah":34,"from":34,"to":34,"text":"ونذكرك ذكرًا كثيرًا."},{"ayah":35,"from":35,"to":35,"text":"إنك كنت بنا بصيرًا، لا يخفى عليك شيء من أمرنا."},{"ayah":36,"from":36,"to":36,"text":"قال الله: قد أعطيناك ما طلبت يا موسى."},{"ayah":37,"from":37,"to":37,"text":"ولقد أنعمنا عليك مرة أخرى."},{"ayah":38,"from":38,"to":38,"text":"إذ ألهمنا أمك ما ألهمناها مما حفظك الله به من مكر فرعون."},{"ayah":39,"from":39,"to":39,"text":"فقد أمرناها حين ألهمناها: أن ارميه بعد ولادته في الصندوق، واطرحي الصندوق في البحر، فسيطرحه البحر بالشاطئ بأمر منّا، فيأخذه عدو لي وله، وهو فرعون، ووضعت عليك محبّة منّي، فأحبّك الناس، ولتتربّى على عيني وفي حفظي ورعايتي."},{"ayah":40,"from":40,"to":40,"text":"إذ خرجت أختك تسير كلما سار التابوت تتابعه، فقالت لمن أخذوه: هل أُرْشِدكم إلى من يحفظه ويرضعه ويربيه؟ فمننّا عليك بإرجاعك إلى أمّك لتسرّ برجوعك إليها، ولا تحزن من أجلك، وقتلت القِبْطِي الذي وَكَزْتَه، فمننّا عليك بإنجائك من العقوبة، وخلصناك مرة بعد مرة من كل امتحان تعرّضت له، فخرجت ومكثت أعوامًا في أهل مَدْين، ثم أتيت في الوقت الذي قُدِّر لك أن تأتي فيه لتكليمك يا موسى."},{"ayah":41,"from":41,"to":41,"text":"واخترتك لتكون رسولًا عنّي تبلّغ الناس ما أوحيت به إليك."},{"ayah":42,"from":42,"to":42,"text":"اذهب أنت - يا موسى - وأخوك هارون، بآياتنا الدالة على قدرة الله ووحدانيته، ولا تضعفا عن الدعوة إليّ، وعن ذكري."},{"ayah":43,"from":43,"to":43,"text":"اذهبا إلى فرعون، فإنه تجاوز الحد في الكفر والتمرّد على الله."},{"ayah":44,"from":44,"to":44,"text":"فقولا له قولًا لطيفًا لا عنف فيه؛ رجاء أن يتذكر، ويخاف الله فيتوب."},{"ayah":45,"from":45,"to":45,"text":"قال موسى وهارون عليهما السلام: إننا نخاف أن يعجّل بالعقوبة قبل إتمام دعوته، أو أن يتجاوز الحد في ظلمنا بالقتل أو غيره."},{"ayah":46,"from":46,"to":46,"text":"قال الله لهما: لا تخافا؛ إنني معكما بالنصر والتأييد، أسمع وأرى ما يحدث بينكما وبينه."},{"ayah":47,"from":47,"to":47,"text":"فأْتياه، فقولا له: إنا رسولا ربك - يا فرعون - فابعث معنا بني إسرائيل، ولا تعذبهم بقتل أبنائهم، واستحياء نسائهم، قد أتيناك ببرهان من ربك على صدقنا، والأمان من عذاب الله لمن آمن، واتبع هدى الله."},{"ayah":48,"from":48,"to":48,"text":"إنا قد أوحى الله إلينا أن العذاب في الدنيا والآخرة على من كذَّب بآيات الله، وأعرض عما جاءت به الرسل."},{"ayah":49,"from":49,"to":49,"text":"قال فرعون منكرًا لما جاءا به: فمن ربكما الذي زعمتما أنه أرسلكما إليّ يا موسى؟"},{"ayah":50,"from":50,"to":50,"text":"قال موسى: ربنا هو الذي أعطى كل شيء صورته وشكله المناسب له، ثم هدى المخلوقات لما خلقها له."},{"ayah":51,"from":51,"to":51,"text":"قال فرعون: فما شأن الأمم السابقة التي كانت على الكفر؟"},{"ayah":52,"from":52,"to":52,"text":"قال موسى عليه السلام لفرعون: عِلْمُ ما كانت عليه تلك الأمم عند ربي، مثبت في اللوح المحفوظ، لا يخطئ ربي في علمها، ولا ينسى ما علمه منها."},{"ayah":53,"from":53,"to":53,"text":"عند ربي الذي صيَّر لكم الأرض مُمَهَّدة للعيش عليها، وجعل لكم فيها طرقًا صالحة للسير عليها، وأنزل من السماء ماء المطر، فأخرجنا بذلك الماء أصنافًا من النباتات مختلفة."},{"ayah":54,"from":54,"to":54,"text":"كلوا - أيها الناس - مما أخرجنا لكم من الطيبات، وارعوا أنعامكم، إن في ذلك المذكور من النعم لدلائل على قدرة الله ووحدانيته لأصحاب العقول."},{"ayah":55,"from":55,"to":55,"text":"من تراب الأرض خلقنا أباكم آدم عليه السلام، وفيها نرجعكم بالدفن إذا مُتُّم، ومنها نخرجكم مرة أخرى للبعث يوم القيامة."},{"ayah":56,"from":56,"to":56,"text":"ولقد أظهرنا لفرعون آياتنا التسع كلها، وشاهدها فكذّب بها، وامتنع أن يستجيب إلى الإيمان بالله."},{"ayah":57,"from":57,"to":57,"text":"قال فرعون: أجئتنا لتخرجنا من مصر بما جئت به من السحر - يا موسى - ليبقى لك ملكها؟"},{"ayah":58,"from":58,"to":58,"text":"فلنأتينّك - يا موسى - بسحر مثل سحرك، فاجعل بيننا وبينك موعدًا في زمان معلوم ومكان محدد، لا نتخلّف نحن ولا تتخلف أنت عنه، وليكن المكان وسطًا بين الفريقين معتدلًا."},{"ayah":59,"from":59,"to":59,"text":"قال موسى عليه السلام لفرعون: الموعد بيننا وبينكم يوم العيد حيث يجتمع الناس محتفلين بعيدهم ضحى."},{"ayah":60,"from":60,"to":60,"text":"فأدبر فرعون منصرفًا، وجمع مَكْرَهُ وحِيَلَه، ثم جاء في الزمان والمكان المحددين للمُغَالبة."},{"ayah":61,"from":61,"to":61,"text":"قال موسى يعظ سحرة فرعون: احذروا، لا تختلقوا على الله كذبًا بما تخدعون به الناس من السحر فيستأصلكم بعذاب من عنده، وقد خسر من اختلق على الله الكذب."},{"ayah":62,"from":62,"to":62,"text":"فتناظر السحرة لما سمعوا كلام موسى عليه السلام، وتناجوا بينهم سرًّا."},{"ayah":63,"from":63,"to":63,"text":"قال بعض السحرة لبعضهم سرًّا: إن موسى وهارون ساحران، يريدان أن يخرجاكم من مصر بسحرهما الذي جاءا به، ويذهبا بسُنَّتكم العليا في الحياة، ومذهبكم الأرقى."},{"ayah":64,"from":64,"to":64,"text":"فأحكموا أمركم، ولا تختلفوا فيه، ثم تقدموا مُصْطَفِّين، وارموا ما عندكم دفعة واحدة، وقد ظفر بالمطلوب اليوم من غلب خصمه."},{"ayah":65,"from":65,"to":65,"text":"قال السحرة لموسى عليه السلام: يا موسى، اختر أحد أمرين: أن تكون البادئ بإلقاء ما لديك من سحر، أو نكون نحن البادئين بذلك."},{"ayah":66,"from":66,"to":66,"text":"قال موسى عليه السلام: بل اطرحوا أنتم ما لديكم أوّلًا، فطرحوا ما عندهم، فإذا حبالهم وعصيّهم التي طرحوها يُخَيّل إلى موسى من سحرهم أنها ثعابين تتحرك بسرعة."},{"ayah":67,"from":67,"to":67,"text":"فأسرّ موسى في نفسه الخوف مما صنعوا."},{"ayah":68,"from":68,"to":68,"text":"قال الله لموسى عليه السلام مطمئنًا إياه: لا تخف مما خُيِّل إليك، إنك - يا موسى - أنت المُسْتَعْلِي عليهم بالغلبة والنصر."},{"ayah":69,"from":69,"to":69,"text":"واطرح العصا التي بيدك اليمنى تنقلب حية تبتلع ما صنعوه من السحر، فما صنعوه ليس إلا كيدًا سحريًّا، ولا يظفر الساحر بمطلوب أين كان."},{"ayah":70,"from":70,"to":70,"text":"فطرح موسى عصاه فانقلبت حية، وابتلعت ما صنعه السحرة، فسجد السحرة لله لما علموا أن ما عند موسى ليس سحرًا، إنما هو من عند الله، قالوا: آمنا برب موسى وهارون، رب جميع المخلوقات."},{"ayah":71,"from":71,"to":71,"text":"قال فرعون منكِرًا على السحرة إيمانهم ومتوعّدًا: هل آمنتم بموسى قبل أن آذن لكم بذلك؟! إن موسى لهو رئيسكم - أيها السحرة - الذي علّمكم السحر، فلأقطّعنّ من كل واحد منكم رِجْلًا ويدًا مخالفًا بين جهتيهما، ولأصلّبنّ أبدانكم على جذوع النخل حتى تموتوا، وتكونوا عبرة لغيركم، ولتعلمنّ عند ذلك أينا أقوى عذابًا، وأدوم: أنا أو رب موسى؟!"},{"ayah":72,"from":72,"to":72,"text":"قال السحرة لفرعون: لن نفضّل اتّباعك - يا فرعون - على اتّباع ما جاءنا من الآيات الواضحات، ولن نفضّلك على الله الذي خلقنا، فاصنع ما أنت صانع بنا، ما لك سلطان علينا إلا في هذه الحياة الفانية، وسيزول سلطانك."},{"ayah":73,"from":73,"to":73,"text":"إنا آمنّا بربنا رجاء أن يمحو عنّا معاصينا السالفة من الكفر وغيره، ويمحو عنا ذنب السحر الذي أجبرتنا على تعلّمه وممارسته ومغالبة موسى به، والله خير جزاءً مما وعدتنا به، وأدْوَم عذابًا مما توعّدتنا به من العذاب."},{"ayah":74,"from":74,"to":74,"text":"إن الشأن والحاصل أن من يأتي ربه يوم القيامة كافرًا به أن له نار جهنم يدخلها ماكثًا فيها أبدًا، لا يموت فيها فيستريح من عذابها، ولا يحيا حياة طيبة."},{"ayah":75,"from":75,"to":75,"text":"ومن يأت ربه يوم القيامة مؤمنًا به قد عمل الأعمال الصالحات فأولئك الموصوفون بتلك الصفات العظيمة لهم المنازل الرفيعة، والدرجات العليّة."},{"ayah":76,"from":76,"to":76,"text":"تلك الدرجات هي جنات إقامة تجري الأنهار من تحت قصورها ماكثين فيها أبدًا، وذلك الجزاء المذكور جزاء كل من تطهّر من الكفر والمعاصي."},{"ayah":77,"from":77,"to":77,"text":"ولقد أوحينا إلى موسى: أن سر بعبادي ليلًا من مصر حتى لا يشعر بهم أحد، واجعل لهم طريقًا في البحر يابسًا بعد ضرب البحر بالعصا، آمنًا لا تخاف أن يلحق بك فرعون وملؤه، ولا تخشى من الغرق في البحر."},{"ayah":78,"from":78,"to":78,"text":"فتبعهم فرعون مصحوبًا بجنوده، فغمره وغمر جنوده من البحر ما غمرهم مما لا يعلم حقيقته إلا الله، فغرقوا جميعًا وهلكوا، ونجا موسى ومن معه."},{"ayah":79,"from":79,"to":79,"text":"وأضلّ فرعون قومه بما حسّنه لهم من الكفر، وخدعهم به من الباطل، ولم يرشدهم إلى طريق الهداية."},{"ayah":80,"from":80,"to":80,"text":"وقلنا لبني إسرائيل بعد أن أنقذناهم من فرعون وجنوده: يا بني إسرائيل، قد أنقذناكم من عدوّكم، وواعدناكم أن نكلّم موسى بالجهة اليمنى من الوادي الواقع بجانب جبل الطور، ونزّلنا عليكم في التِّيه من نعمنا شرابًا حلوًا مثل العسل وطائرًا صغيرًا طيب اللحم يشبه السمانى."},{"ayah":81,"from":81,"to":81,"text":"كلوا من المستلذّات ممّا رزقناكم من الأطعمة الحلال، ولا تتجاوزوا ما أبحناه لكم إلى ما حرّمناه عليكم، فينزل عليكم غضبي، ومن ينزل عليه غضبي فقد هلك وشقي في الدنيا والآخرة."},{"ayah":82,"from":82,"to":82,"text":"وإني لكثير المغفرة والعفو لمن تاب إليّ وآمن، وعمل عملًا صالحًا، ثم استقام على الحق."},{"ayah":83,"from":83,"to":83,"text":"وما الذي جعلك تعجل عن قومك - يا موسى - فتتقدمهم تاركًا إياهم خلفك؟"},{"ayah":84,"from":84,"to":84,"text":"قال موسى عليه السلام: ها هم ورائي وسيلحقونني، وسبقت قومي إليك لترضى عني بمسارعتي إليك."},{"ayah":85,"from":85,"to":85,"text":"قال الله: فإنا قد ابتلينا قومك الذين خلّفتهم وراءك بعبادة العجل، فقد دعاهم إلى عبادته السامري، فأضلّهم بذلك."},{"ayah":86,"from":86,"to":86,"text":"فعاد موسى إلى قومه غضبان لعبادتهم العجل، حزينًا عليهم، قال موسى عليه السلام: يا قوم، أَمَا وعدكم الله وعدًا حسنًا أن ينزل عليكم التوراة، ويدخلكم الجنة، فهل طال عليكم الزمان فنسيتم؟ أم أردتّم بفعلكم هذا أن ينزل عليكم غضب من ربكم، ويقع عليكم عذابه، فلذلك أخلفتم موعدي بالثبات على الطاعة حتى أرجع إليكم؟!"},{"ayah":87,"from":87,"to":87,"text":"قال قوم موسى: ما أخلفنا موعدك - يا موسى - باختيار منّا، بل باضطرار، فقد حملنا أحمالًا وأثقالًا من حُلِيِّ قوم فرعون، فرميناها في حفرة للتخلص منها، فكما رميناها في الحفرة رمى السامريّ ما كان معه من تربة حافر فرس جبريل عليه السلام."},{"ayah":88,"from":88,"to":88,"text":"فأخرج السامري من تلك الحلي لبني إسرائيل جَسَدَ عجل لا روح فيه، له صياح كصياح البقر، فقال المفتونون منهم بعمل السامريّ: هذا هو معبودكم ومعبود موسى، نسيه وتركه هنا."},{"ayah":89,"from":89,"to":89,"text":"أفلا يرى هؤلاء الذين فُتِنوا بالعجل فعبدوه أن العجل لا يكلّمهم ولا يجيبهم، ولا يقدر على دفع ضر عنهم ولا عن غيرهم، ولا جلب نفع له، أو لغيره؟!"},{"ayah":90,"from":90,"to":90,"text":"ولقد قال لهم هارون قبل رجوع موسى إليهم: ما في صياغة العجل من الذهب وخُوَارِه إلا اختبار لكم ليظهر المؤمن من الكافر، وإن ربّكم - يا قوم - هو من يملك الرحمة لا من لا يملك لكم ضرًّا ولا نفعًا فضلًا عن أن يرحمكم، فاتبعوني في عبادته وحده، وأطيعوا أمري بترك عبادة غيره."},{"ayah":91,"from":91,"to":91,"text":"قال المفتونون بعبادة العجل: لن نزال مقيمين على عبادته حتى يعود إلينا موسى."},{"ayah":92,"from":92,"to":92,"text":"قال موسى لأخيه هارون: ما الذي منعك حين رأيتهم ضلّوا بعبادة العجل من دون الله."},{"ayah":93,"from":93,"to":93,"text":"أن تتركهم وتلحق بي؟! أفعصيت أمري لك حين استخلفتك عليهم؟!"},{"ayah":94,"from":94,"to":94,"text":"ولما أخذ موسى بلحية أخيه ورأسه يسحبه إليه مستنكرًا عليه صنيعه قال له هارون مستعطفًا إياه: لا تمسك بلحيتي ولا بشعر رأسي، فإن لي عذرًا في بقائي معهم، فقد خفت إن تركتهم وحدهم أن يتفرّقوا، فتقول: إني فرقت بينهم، وإني لم أحفظ وصيّتك فيهم."},{"ayah":95,"from":95,"to":95,"text":"قال موسى عليه السلام للسامري: فما شأنك أنت يا سامري؟ وما الذي دفعك إلى ما صنعت؟"},{"ayah":96,"from":96,"to":96,"text":"قال السامري لموسى عليه السلام: رأيت ما لم يروه، فقد رأيت جبريل على فرس، فأخذت قبضة من تراب من أثر فرسه، فطرحتها على الحليّ المذاب المسبوك على صورة عجل، فنشأ عن ذلك عجل جَسَد له خُوَار، وكذلك حسّنت لي نفسي ما صنعته."},{"ayah":97,"from":97,"to":97,"text":"قال موسى عليه السلام للسامري: فاذهب أنت فإن لك أن تقول ما دمت حيًّا: لا أَمَسّ ولا أُمَسّ، فتعيش منبوذًا، وإن لك موعدًا يوم القيامة تُحَاسَب فيه وتُعَاقَب، لن يخلفك الله هذا الموعد، وانظر إلى عجلك الذي اتخذته معبودك، وأقمت على عبادته من دون الله، لنشعلنّ عليه نارًا حتى ينصهر، ثم لنَذْرِينّه في البحر حتى لا يبقى له أثر."},{"ayah":98,"from":98,"to":98,"text":"إنما معبودكم بحق - أيها الناس - هو الله الذي لا معبود بحق غيره، أحاط بكل شيء علمًا، فلا يفوته سبحانه علم شيء."},{"ayah":99,"from":99,"to":99,"text":"مثل ما قصصنا عليك - أيها الرسول - خبر موسى وفرعون، وخبر قومهما نقصّ عليك أخبار من سبقوك من الأنبياء والأمم لتكون تسلية لك، وقد أعطيناك من عندنا قرآنًا يتذكر به من تذكر."},{"ayah":100,"from":100,"to":100,"text":"من أعرض عن هذا القرآن المنزل عليك فلم يؤمن به، ولم يعمل بما فيه؛ فإنه يأتي يوم القيامة حاملًا إثمًا عظيمًا، ومستحقًّا عقابًا أليمًا."},{"ayah":101,"from":101,"to":101,"text":"ماكثين في ذلك العذاب دائمًا، وبئس الحمل الذي يحملونه يوم القيامة."},{"ayah":102,"from":102,"to":102,"text":"يوم ينفخ المَلَك في الصور النفخة الثانية للبعث، ونحشر الكفار في ذلك اليوم زُرْقًا لتغيّر ألوانهم وعيونهم من شدة ما لاقوه من أهوال الآخرة."},{"ayah":103,"from":103,"to":103,"text":"يتهامسون بقولهم: ما لبثتم في البَرْزَخ بعد الموت إلا عشر ليال."},{"ayah":104,"from":104,"to":104,"text":"نحن أعلم بما يتسارُّون به، لا يفوتنا منه شيء، إذ يقول أوفرهم عقلًا: ما لبثتم في البَرْزَخ إلا يومًا واحدًا لا أكثر."},{"ayah":105,"from":105,"to":105,"text":"ويسألونك - أيها الرسول - عن حال الجبال يوم القيامة، فقل لهم: الجبال يقتلعها ربي من أصولها ويُذْرِيها، فتكون هباءً."},{"ayah":106,"from":106,"to":106,"text":"فيترك الأرض التي كانت تحملها مستوية لا بناء عليها ولا نبات."},{"ayah":107,"from":107,"to":107,"text":"لا ترى - أيها الناظر إليها - في الأرض من تمام استوائها ميلًا ولا ارتفاعًا ولا انخفاضًا."},{"ayah":108,"from":108,"to":108,"text":"في ذلك اليوم يتبع الناس صوت الداعي إلى المحشر، لا معدل لهم عن اتباعه، وسكتت الأصوات للرحـم‍ٰن رهبة، فلا تسمع في ذلك اليوم إلا صوتًا خفيًّا."},{"ayah":109,"from":109,"to":109,"text":"في ذلك اليوم العظيم لا تنفع الشفاعة من أي شافع إلا شافعًا أذن له الله أن يشفع، ورضي قوله في الشفاعة."},{"ayah":110,"from":110,"to":110,"text":"يعلم الله سبحانه ما يستقبله الناس من أمر الساعة، ويعلم ما استدبروه في دنياهم، ولا يحيط جميع العباد بذات الله وصفاته علمًا."},{"ayah":111,"from":111,"to":111,"text":"وذلّت وجوه العباد، واستكانت للحي الذي لا يموت، القائم بأمور عباده بتدبيرها وتصريفها، وقد خسر من حمل الإثم بإيراده نفسه موارد الهلاك."},{"ayah":112,"from":112,"to":112,"text":"ومن يعمل الأعمال الصالحة وهو مؤمن بالله ورسله فسينال جزاءه وافيًا، ولا يخاف ظلمًا بأن يعذّب بذنب لم يفعله، ولا نقصًا لثواب عمله الصالح."},{"ayah":113,"from":113,"to":113,"text":"ومثل ما أنزلنا من قصص السابقين أنزلنا هذا القرآن بلسان عربي مبين، وبيَّنا فيه أنواع الوعيد من تهديد وتخويف؛ رجاء أن يخافوا الله، أو ينشئ لهم القرآن موعظة واعتبارًا."},{"ayah":114,"from":114,"to":114,"text":"فتعالى الله وتقدّس وجَلَّ، الملك الذي له ملك كل شيء، الذي هو حق وقوله حق، تعالى عما يصفه به المشركون، ولا تسرع - أيها الرسول - بقراءة القرآن مع جبريل قبل أن ينهي إليك إبلاغه، وقل: رب زدني علمًا إلى ما علّمتني."},{"ayah":115,"from":115,"to":115,"text":"ولقد وصينا آدم من قبل بعدم الأكل من الشجرة، ونهيناه عن ذلك، وبيّنا له عاقبته، فنسي الوصية وأكل من الشجرة، ولم يصبر عنها، ولم نر له قوة عزم على حفظ ما وصيناه به."},{"ayah":116,"from":116,"to":116,"text":"واذكر - أيها الرسول - إذ قلنا للملائكة: اسجدوا لآدم سجود تحية، فسجدوا كلهم إلا إبليس - الذي كان معهم ولم يكن منهم - امتنع من السجود تكبرًا."},{"ayah":117,"from":117,"to":117,"text":"فقلنا: يا آدم، إن إبليس عدوّ لك وعدو لزوجك، فلا يخرجنّك أنت وزوجك من الجنة بطاعته فيما يوسوس به، فتتحمّل أنت المشاقّ والمكاره."},{"ayah":118,"from":118,"to":118,"text":"إن لك على الله أن يطعمك في الجنة فلا تجوع، ويكسوك فلا تعرى."},{"ayah":119,"from":119,"to":119,"text":"وأن يسقيك فلا تعطش، ويظلك فلا يصيبك حر الشمس."},{"ayah":120,"from":120,"to":120,"text":"فوسوس الشيطان إلى آدم، وقال له: هل أرشدك إلى شجرة مَنْ أكل منها لا يموت أبدًا، بل يبقى حيًّا مُخَلَّدًا، ويملك ملكًا مستمرًّا لا ينقطع ولا ينتهي؟!"},{"ayah":121,"from":121,"to":121,"text":"فأكل آدم وحواء من الشجرة التي نُهِيا عن الأكل منها، فظهرت لهما عوراتهما بعد أن كانت مستورة، وشرَعا ينزعان من أوراق شجر الجنة، ويستران بها عوراتهما، وخالف آدم أمر ربه إذ لم يمتثل أمره باجتناب الأكل من الشجرة، فتعدّى إلى ما لا يجوز له."},{"ayah":122,"from":122,"to":122,"text":"ثم اختاره الله وقبل توبته، ووفّقه إلى الرشاد."},{"ayah":123,"from":123,"to":123,"text":"قال الله لآدم وحواء: انزلا من الجنة أنتما وإبليس، فهو عدو لكما وأنتما عدوان له، فإن جاءكم مني بيان لسبيلي: فمن اتبع منكم بيان سبيلي وعمل به ولم ينحرف عنه؛ فلا يضلّ عن الحق، ولا يشقى في الآخرة بالعذاب، بل يدخله الله الجنة."},{"ayah":124,"from":124,"to":124,"text":"ومن تولّى عن ذكري ولم يقبله، ولم يستجب له فإن له معيشة ضيقة في الدنيا وفي البَرْزَخ، ونسوقه إلى المحشر يوم القيامة فاقد البصر والحجة."},{"ayah":125,"from":125,"to":125,"text":"يقول هذا المُعْرِض عن الذكر: يا رب، لم حشرتني اليوم أعمى، وقد كنت في الدنيا بصيرًا."},{"ayah":126,"from":126,"to":126,"text":"قال الله تعالى ردًّا عليه: مثل ذلك فعلتَه في الدنيا، فقد جاءتك آياتنا فأعرضت عنها وتركتها، وكذلك فإنك تُتْرَك اليوم في العذاب."},{"ayah":127,"from":127,"to":127,"text":"ومثل هذا الجزاء نجزي من انهمك في الشهوات المحرَّمة، وأعرض عن الإيمان بالدلائل الواضحة من ربه. ولعذاب الله في الآخرة أفظع وأقوى من المعيشة الضَّنْك في الدنيا والبَرْزَخ وأدوم."},{"ayah":128,"from":128,"to":128,"text":"أفلم يتبيّن للمشركين كثرة الأمم التي أهلكناها من قبلهم، يمشون في مساكن تلك الأمم المُهْلَكة، ويعاينون آثار ما أصابهم؟ إن فيما أصاب تلك الأمم الكثيرة من الهلاك والدمار لعبرًا لأصحاب العقول."},{"ayah":129,"from":129,"to":129,"text":"ولولا كلمة سبقت من ربك - أيها الرسول - أنه لا يعذّب أحدًا قبل إقامة الحجة عليه، ولولا أجل مُقَدَّر عنده لهم لعاجلهم العذاب؛ لاستحقاقهم إياه."},{"ayah":130,"from":130,"to":130,"text":"فاصبر - أيها الرسول - على ما يقوله المكذبون بك من أوصاف باطلة، وسبّح بحمد ربك في صلاة الفجر قبل طلوع الشمس، وفي صلاة العصر قبل غروبها، وفي صلاة المغرب والعشاء من ساعات الليل، وفي صلاة الظهر عند الزوال بعد نهاية الطرف الأول من النهار وفي صلاة المغرب بعد نهاية الطرف الثاني منه؛ رجاء أن تنال عند الله من الثواب ما ترضى به."},{"ayah":131,"from":131,"to":131,"text":"ولا تنظر إلى ما جعلناه لأصناف هؤلاء المكذبين متعة يتمتعون بها من زهرة الحياة الدنيا لنختبرهم، فإن ما جعلناه لهم من ذلك زائل، وثواب ربّك الذي وعدك به حتى ترضى خير مما متّعهم به في الدنيا من متع زائلة وأدوم؛ لأنه لا ينقطع."},{"ayah":132,"from":132,"to":132,"text":"وأْمُرْ - أيها الرسول - أهلك بأداء الصلاة، واصطبر أنت على أدائها، لا نطلب منك رزقًا لنفسك ولا لغيرك، نحن نتكفّل برزقك، والعاقبة المحمودة في الدنيا والآخرة لأصحاب التقوى الذين يخافون الله، فيمتثلون أوامره، ويجتنبون نواهيه."},{"ayah":133,"from":133,"to":133,"text":"وقال هؤلاء الكفار المكذبون بالنبي صلّى الله عليه وسلّم: هلَّا يأتينا محمد بعلامة من ربه تدلّ على صدقه وأنه رسول، أَوَلم يأت هؤلاء المكذبين القرآنُ الذي هو تصديق للكتب السماوية من قبله؟!"},{"ayah":134,"from":134,"to":134,"text":"ولو أنَّا أهلكنا هؤلاء المكذبين بالنبي صلّى الله عليه وسلّم بإنزال عذاب عليهم لكفرهم وعنادهم قبل أن نرسل إليهم رسولًا، وننزل عليهم كتابًا لقالوا يوم القيامة معتذرين عن كفرهم: هلَّا أرسلت - ربنا - إلينا رسولًا في الدنيا، فنؤمن به ونتبع ما جاء به من آيات من قبل أن يحلّ بنا الهوان والخزي بسبب عذابك؟!"},{"ayah":135,"from":135,"to":135,"text":"قل - أيها الرسول - لهؤلاء المكذبين: كل واحد منّا ومنكم منتظر ما يُجْرِيه الله، فانتظروا أنتم، فستعلمون - لا محالة - مَن أصحاب الطريق المستقيم، ومَن المهتدون: نحن أم أنتم؟"}]}