: فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (هلك) .\n\nلَيْسَ: {لَيْسَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، جَامِدٌ، مُعْتَلٌّ أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: () ، مِنْ مَادَّةِ: (ليس) .\n\nلَهُ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nوَلَدٌ: {وَلَدٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nوَلَهُ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nأُخْتٌ: {أُخْتٌ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (أُخْتٌ) ، عَلَى وَزْنِ: (فُعْتٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (أخو) .\n\nفَلَهَا: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nنِصْفُ: {نِصْفُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (نصف) .\n\nمَا: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nتَرَكَ: {تَرَكَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (ترك) .\n\nوَهُوَ: {هُوَ} : اسْمٌ مَبْنِيٌّ.\n\nيَرِثُهَا: {يَرِثُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (وَرِثَ يَرِثُ) ، أَصْلُهُ: (يَوْرِثُ) ، عَلَى وَزْنِ: (يَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِلثِّقَلِ، مِنْ مَادَّةِ: (ورث) .\n\nإِنْ: {إِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nلَمْ: {لَمْ} : حَرْفٌ مَبْنِيٌّ.\n\nيَكُنْ: {يَكُنْ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَكْوُنُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِالْتِقَاءِ السَّاكِنَيْنِ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nلَهَا: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nوَلَدٌ: {وَلَدٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (ولد) .\n\nفَإِنْ: {إِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nكَانَتَا: {كَانَتَا} : فِعْلٌ مَاضٍ لِلْغَائِبَتَيْنِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nاثْنَتَيْنِ: {اثْنَتَيْنِ} : اسْمٌ، مُؤَنَّثُ، مُثَنًّى، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (اثْنٌ) ، عَلَى وَزْنِ: (افْعٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ حَذْفًا سَمَاعِيًّا، مِنْ مَادَّةِ: (ثني) .\n\nفَلَهُمَا: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nالثُّلُثَانِ: {الثُّلُثَانِ} : اسْمٌ، مُذَكَّرٌ، مُثَنًّى، مُفْرَدُهُ: (ثُلُثٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعُلٌ) ، مِنْ مَادَّةِ: (ثلث) .\n\nمِمَّا: {مِنْ} : حَرْفٌ مَبْنِيٌّ، {َمَا} : اسْمٌ مَبْنِيٌّ.\n\nتَرَكَ: {تَرَكَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (ترك) .\n\nوَإِنْ: {إِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nكَانُوا: {كَانُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nإِخْوَةً: {إِخْوَةً} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (أَخٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، مِنْ مَادَّةِ: (أخو) .\n\nرِجَالًا: {رِجَالًا} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (رَجُلٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (رجل) .\n\nوَنِسَاءً: {نِسَاءً} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (لَمْ يُسْمَعْ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (نِسَاوٌ) ، عَلَى وَزْنِ: (فِعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (نسو) .\n\nفَلِلذَّكَرِ: {الذَّكَرِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (ذكر) .\n\nمِثْلُ: {مِثْلُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فِعْلٌ) ، مِنْ مَادَّةِ: (مثل) .\n\nحَظِّ: {حَظِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حظظ) .\n\nالْأُنْثَيَيْنِ: {الْأُنْثَيَيْنِ} : اسْمٌ، مُؤَنَّثُ، مُثَنًّى، مُفْرَدُهُ: (أُنْثَى) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، أَصْلُهُ: (أُنْثَى) ، عَلَى وَزْنِ: (فُعْلَى) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْأَلِفِ يَاءً لِمَجِيئِهَا بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (أنث) .\n\nيُبَيِّنُ: {يُبَيِّنُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (يُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (بين) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nلَكُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nتَضِلُّوا: {تَضِلُّوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (تَضْلِلُ) ، عَلَى وَزْنِ: (تَفْعِلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (ضلل) .\n\nوَاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّ