 الْفِعْلِ الثُّلَاثِيِّ: (ضَعُفَ يَضْعُفُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (ضعف) ."}]},{"ayah":77,"from":77,"to":77,"text":"أَلَمْ: {لَمْ} : حَرْفٌ مَبْنِيٌّ.\n\nتَرَ: {تَرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، أَصْلُهُ: (تَرْأَيُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (رأي) .\n\nإِلَى: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالَّذِينَ: {الَّذِينَ} : اسْمٌ مَبْنِيٌّ.\n\nقِيلَ: {قِيلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قُوِلَ) ، عَلَى وَزْنِ: (فُعِلَ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nلَهُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nكُفُّوا: {كُفُّوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (اكْفُفْ) ، عَلَى وَزْنِ: (افْعُلْ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (كفف) .\n\nأَيْدِيَكُمْ: {أَيْدِيَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْقِلَّةِ، مُفْرَدُهُ: (يَدٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مَنْقُوصٌ، عَلَى وَزْنِ: (أَفْعُلٌ) ، مِنْ مَادَّةِ: (يدي) .\n\nوَأَقِيمُوا: {أَقِيمُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَقْوِمْ) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، مِنْ مَادَّةِ: (قوم) .\n\nالصَّلَاةَ: {الصَّلَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (صَلَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (صلو) .\n\nوَآتُوا: {آتُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْفَاءِ، نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَأْتِي) ، عَلَى وَزْنِ: (أَفْعِلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِثِقَلِ الضَّمَّةِ عَلَى الْيَاءِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أتي) .\n\nالزَّكَاةَ: {الزَّكَاةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، أَصْلُهُ: (زَكَوَةٌ) ، عَلَى وَزْنِ: (فَعَلَةٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (زكو) .\n\nفَلَمَّا: {لَمَّا} : اسْمٌ مَبْنِيٌّ.\n\nكُتِبَ: {كُتِبَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فُعِلَ) ، مِنْ مَادَّةِ: (كتب) .\n\nعَلَيْهِمُ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالْقِتَالُ: {الْقِتَالُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (قَاتَلَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (قتل) .\n\nإِذَا: {إِذَا} : حَرْفٌ مَبْنِيٌّ.\n\nفَرِيقٌ: {فَرِيقٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (فرق) .\n\nمِنْهُمْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nيَخْشَوْنَ: {يَخْشَوْنَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، أَصْلُهُ: (يَخْشَيُ) ، عَلَى وَزْنِ: (يَفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْأَلِفِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (خشي) .\n\nالنَّاسَ: {النَّاسَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (نَوَسٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (نوس) .\n\nكَخَشْيَةِ: {خَشْيَةِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَشِيَ يَخْشَى) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فَعْلَةٌ) ، مِنْ مَادَّةِ: (خشي) .\n\nاللَّهِ: {اللَّهِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nأَشَدَّ: {أَشَدَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَدَّ يَشُدُّ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، أَصْلُهُ: (أَشْدَدُ) ، عَلَى وَزْنِ: (أَفْعَلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (شدد) .\n\nخَشْيَةً: {خَشْيَةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَشِيَ يَخْشَى) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فَعْلَةٌ) ، مِنْ مَادَّةِ: (خشي) .\n\nوَقَالُوا: {قَالُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nرَبَّنَا: {رَبَّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (ربب) .\n\nلِمَ: {مَا} : اسْمٌ مَبْنِيٌّ.\n\nكَتَبْتَ: {كَتَبْتَ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (كتب) .\n\nعَلَيْنَا: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالْقِتَالَ: {الْقِتَالَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ قَيَاسِيٌّ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (قَاتَلَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (قتل) .\n\nلَوْلَا: {لَوْلَا} : حَرْفٌ مَبْنِيٌّ.\n\nأَخَّرْتَنَا: {أَخَّرْتَ} : فِعْلٌ مَاضٍ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (فَعَّلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أخر) .\n\nإِلَى: {إِلَى} : حَرْفٌ مَبْنِيٌّ.\n\nأَجَلٍ: {أَجَلٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (أجل) .\n\nقَرِيبٍ: {قَرِيبٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (قَرُبَ يَقْرُبُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (قرب) .\n\nقُلْ: {قُلْ} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (اقْوُلْ) ، عَلَى وَزْنِ: (افْعُلْ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِالْتِقَاءِ السَّاكِنَيْنِ، مِنْ مَادَّةِ: (قول) .\n\nمَتَاعُ: {مَتَاعُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (متع) .\n\nالدُّنْيَا: {الدُّنْيَا} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، مُشْتَقٌّ، أَفْعَلُ التَّفْضِيلِ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (دَنَا يَدْنُو) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَقْصُورٌ، أَصْلُهُ: (دُنْوَى) ، عَلَى وَزْنِ: (فُعْلَى) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِوُقُوعِ الْوَاوِ لَامًا لِفُعْلَى، مِنْ مَادَّةِ: (دنو) .\n\nقَلِيلٌ: {قَلِيلٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ ال