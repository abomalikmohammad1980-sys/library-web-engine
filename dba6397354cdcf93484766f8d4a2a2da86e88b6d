ُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (تُؤَخْفِيُ) ، عَلَى وَزْنِ: (تُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ وَالْيَاءِ، مِنْ مَادَّةِ: (خفي) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nتَعْفُوا: {تَعْفُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (تَعْفُوُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْوَاوِ لِثِقَلِ الضَّمَّةِ عَلَيْهَا، مِنْ مَادَّةِ: (عفو) .\n\nعَنْ: {عَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nسُوءٍ: {سُوءٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (سوأ) .\n\nفَإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nكَانَ: {كَانَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nعَفُوًّا: {عَفُوًّا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (عَفَا يَعْفُو) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (عفو) .\n\nقَدِيرًا: {قَدِيرًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ قِيَاسِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (قَدَرَ يَقْدِرُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (قدر) .","words":[{"wordId":12823,"position":1,"word":"إِنْ","text":"{إِنْ} : حَرْفٌ مَبْنِيٌّ."},{"wordI