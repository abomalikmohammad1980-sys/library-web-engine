export class SourceSyncDaemon{readonly #scheduler:SourceSyncScheduler;readonly #health:DaemonHealth={state:"idle",startedAtMs:null,lastSuccess:{},lastError:{},ticks:{reconcile:0,outbox:0,build:0}};#timers=new Set<ReturnType<typeof setTimeout>>();#controller:AbortController|null=null;readonly #active=new Map<"reconcile"|"outbox"|"build",Promise<unknown>>();
 constructor(readonly config:SourceSyncDaemonConfig,private readonly outbox:BoundedWorker,private readonly build:BoundedWorker,private readonly emit:(e:DaemonEvent)=>void=()=>{},scheduler?:SourceSyncScheduler,private readonly now:()=>number=Date.now){validateDaemonConfig(config);this.#scheduler=scheduler??new SourceSyncScheduler(new NodeManagedSourceAdapter(config.managedRoot),new JsonSourceSyncPersistence(config.stateFile),{onNotice:n=>this.emit({kind:"scheduler",atMs:this.now(),detail:redactSchedulerNotice(n)})})}
