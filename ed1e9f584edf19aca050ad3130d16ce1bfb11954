 async stop(){if(this.#health.state!=="running")return;this.#health.state="stopping";this.#controller?.abort();for(const t of this.#timers)clearTimeout(t);this.#timers.clear();this.#scheduler.stop();const settling=Promise.allSettled([...this.#active.values(),this.#scheduler.idle()]);const timeoutMs=this.config.shutdownTimeoutMs??10_000;let timer:ReturnType<typeof setTimeout>|undefined;const timedOut=await Promise.race([settling.then(()=>false),new Promise<true>(resolve=>{timer=setTimeout(()=>resolve(true),timeoutMs)})]);if(timer!==undefined)clearTimeout(timer);this.#health.state="stopped";this.emit({kind:"stopped",atMs:this.now(),...(timedOut?{detail:{code:"shutdown_timeout"}}:{})})}
