ِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مِثَالٌ يَائِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (فَعَّلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (يسر) .\n\nبِلِسَانِكَ: {لِسَانِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (لسن) .\n\nلِتُبَشِّرَ: {تُبَشِّرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (تُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (بشر) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nالْمُتَّقِينَ: {الْمُتَّقِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُتَّقٍ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الْخُمَاسِيِّ: (اتَّقَى) ، مِنْ بَابِ: (افْتَعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْمِيمِ، مَنْقُوصٌ، أَصْلُهُ: (مُوتَقِيٌ) ، عَلَى وَزْنِ: (مُفْتَعِلٌ) ، فِيهِ إِبْدَالُ حَرْفِ: الْوَاوِ تَاءً، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (وقي) .\n\nوَتُنْذِرَ: {تُنْذِرَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (تُؤَنْذِرُ) ، عَلَى وَزْنِ: (تُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (نذر) .\n\nبِهِ: (الْبَاءُ) : حَرْفٌ مَبْنِيٌّ.\n\nقَوْمًا: {قَوْمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nلُدًّا: {لُدًّا} : اسْمٌ، مُذَكَّرٌ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (أَلَدُّ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (لدد) .","words":[{"wordId":40062,"position":1,"word":"فَإِن