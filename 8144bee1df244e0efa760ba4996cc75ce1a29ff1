import{describe,expect,it,vi}from"vitest";import{RevisionHistoryAuthority,RevisionHistoryHttpRouter,type RevisionHistoryStore}from"./revision-history.js";
const rev=(id:string)=>({revisionId:id,bookId:"b",operationId:id,baseRevisionId:null,fingerprint:{algorithm:"sha256" as const,hex:"a".repeat(64),byteLength:1},sourceName:"x.docx",createdAt:"2026-01-01",createdByDeviceId:"d",status:"ready" as const});
function fixture(ready:string|null=null){const operations=new Map<string,any>(),store:RevisionHistoryStore={isOwner:vi.fn(async(_b,u)=>u==="owner"),snapshot:vi.fn(async()=>({bookId:"b",currentRevisionId:"r2",currentBuildId:"build2",desiredRevisionId:null,recordVersion:4,revisions:[rev("r1"),rev("r2")]})),findRollback:vi.fn(async(_b,o)=>operations.get(o)??null),readyBuild:vi.fn(async()=>ready),enqueue:vi.fn(async()=>{}),commitRollback:vi.fn(async x=>{const v={targetRevisionId:x.targetRevisionId,status:x.buildId?"published":"queued",recordVersion:5};operations.set(x.operationId,v);return{committed:true,recordVersion:5}})};return{store,authority:new RevisionHistoryAuthority(store)}}
describe("revision history",()=>{it("hides another owner's history (IDOR)",async()=>{const f=fixture(),router=new RevisionHistoryHttpRouter(f.authority,{authenticate:async()=>({userId:"intruder"})});expect((await router.handle(new Request("https://x/books/b/source-revisions"))).status).toBe(404)});it("publishes a ready build and is idempotent",async()=>{const f=fixture("build1"),p={userId:"owner"},r={operationId:"op",targetRevisionId:"r1",expectedRecordVersion:4,deviceId:"d"};expect((await f.authority.rollback(p,"b",r)).status).toBe("published");expect((await f.authority.rollback(p,"b",r)).status).toBe("published");expect(f.store.commitRollback).toHaveBeenCalledTimes(1);expect(f.store.enqueue).not.toHaveBeenCalled()});it("enqueues missing derivatives and exposes CAS conflicts",async()=>{const f=fixture(),p={userId:"owner"};expect((await f.authority.rollback(p,"b",{operationId:"op",targetRevisionId:"r1",expectedRecordVersion:4,deviceId:"d"})).status).toBe("queued");expect(f.store.enqueue).toHaveBeenCalled();await expect(f.authority.rollback(p,"b",{operationId:"other",targetRevisionId:"r1",expectedRecordVersion:3,deviceId:"d"})).rejects.toMatchObject({code:"publication_conflict"})})});
