{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":23,"records":[{"ayah":1,"from":1,"to":1,"text":"قد فاز المؤمنون بالله العاملون بشرعه بالحصول على ما يطلبون، والنجاة مما يرهبون."},{"ayah":2,"from":2,"to":2,"text":"الذين هم في صلاتهم مُتَذلِّلون، قد سكنت فيها جوارحهم، وفرغت قلوبهم من الشواغل."},{"ayah":3,"from":3,"to":3,"text":"والذين هم عن الباطل واللهو وما فيه معصية من الأقوال والأفعال معرضون."},{"ayah":4,"from":4,"to":4,"text":"والذين هم لتطهير أنفسهم من الرذائل، وتطهير أموالهم بإخراج زكاتها فاعلون."},{"ayah":5,"from":5,"to":5,"text":"والذين هم لفروجهم بإبعادها عن الزنى واللواط والفواحش حافظون، فهم أعفّاء طاهرون."},{"ayah":6,"from":6,"to":6,"text":"إلا على زوجاتهم أو ما يملكون من الإماء، فإنهم لا يُلامون في الاستمتاع بهنّ بالوطء وغيره."},{"ayah":7,"from":7,"to":7,"text":"فمن طلب الاستمتاع بما عدا الزوجات أو إمائه اللاتي يملكها فهو متجاوز لحدود الله بتجاوز ما أحلّه من التمتع إلى ما حرمه منه."},{"ayah":8,"from":8,"to":8,"text":"والذين هم لما ائتمنهم الله عليه، أو ائتمنهم عباده، ولعهودهم حافظون لا يضيعونها، بل يوفون بها."},{"ayah":9,"from":9,"to":9,"text":"والذين هم على صلواتهم يحافظون بالمداومة عليها، وعلى أدائها في أوقاتها بأركانها وواجباتها ومستحبّاتها."},{"ayah":10,"from":10,"to":10,"text":"أولئك المتصفون بهذه الصفات هم الوارثون."},{"ayah":11,"from":11,"to":11,"text":"الذين يرثون أعلى الجنة هم فيها ماكثون أبدًا، لا ينقطع نعيمهم فيها."},{"ayah":12,"from":12,"to":12,"text":"ولقد خلقنا أبا البشر آدم من طين، أُخِذَت تربته من خلاصة استُخْرِجت من ماء مختلط بتربة الأرض."},{"ayah":13,"from":13,"to":13,"text":"ثم خلقنا ذريته متناسلين من نطفة تستقرّ في الرحم إلى حين الولادة."},{"ayah":14,"from":14,"to":14,"text":"فخلقنا بعد ذلك النطفة المستقرة في الرحم عَلَقَة حمراء، ثم جعلنا تلك العَلَقَة الحمراء كقطعة لحم ممضوغة، فخلقنا قطعة اللحم تلك عظامًا مُتَصَلِّبة، فألبسنا تلك العظام لحمًا، ثم أنشأناه خلقًا آخر بنفخ الروح فيه، وإخراجه إلى الحياة، فتبارك الله أحسن الخالقين."},{"ayah":15,"from":15,"to":15,"text":"ثم إنكم - أيها الناس - بعد ما مررتم به من تلك الأطوار ستموتون عند انقضاء آجالكم."},{"ayah":16,"from":16,"to":16,"text":"ثم إنكم بعد موتكم تبعثون من قبوركم يوم القيامة؛ لتحاسبوا على ما قدمتم من عمل."},{"ayah":17,"from":17,"to":17,"text":"ولقد خلقنا فوقكم - أيها الناس - سبع سماوات بعضها فوق بعض، وما كنا بغافلين عن خلقنا، ولا ناسين إياه."},{"ayah":18,"from":18,"to":18,"text":"وأنزلنا من السماء ماء المطر بمقدار الحاجة، لا كثيرًا فيفسد ولا قليلًا فلا يكفي، فجعلناه يستقر في الأرض ينتفع به الناس والدواب، وإنا لقادرون على أن نذهب به فلا تنتفعون."},{"ayah":19,"from":19,"to":19,"text":"فأنشأنا لكم بذلك الماء بساتين من النخيل والأعناب، لكم فيها فواكه متعددة الأشكال والألوان، كالتِّين والرمان والتفاح، ومنها تأكلون."},{"ayah":20,"from":20,"to":20,"text":"وأنشأنا لكم به شجرة الزيتون التي تخرج في منطقة جبل سيناء، تُنبِت الدهن الذي يستخرج من ثمرها يُدَّهن به ويُؤْتَدَم."},{"ayah":21,"from":21,"to":21,"text":"وإن لكم - أيها الناس - في الأنعام (الإبل، البقر، الغنم) لعبرة ودلالة تستدلّون بها على قدرة الله ولطفه بكم، نسقيكم مما في بطون هذه الأنعام لبنًا خالصًا سائغًا للشاربين، ولكم فيها منافع كثيرة تنتفعون بها منها؛ كالركوب والصوف والوبر والشعر، وتأكلون من لحومها."},{"ayah":22,"from":22,"to":22,"text":"وعلى الإبل من الأنعام في البر، وعلى السفن في البحر تُحْمَلون."},{"ayah":23,"from":23,"to":23,"text":"ولقد بعثنا نوحًا عليه السلام إلى قومه يدعوهم إلى الله، فقال لهم: يا قوم، اعبدوا الله وحده، ما لكم من معبود بحق غيره سبحانه، أفلا تتقون الله بامتثال أوامره واجتناب نواهيه؟!"},{"ayah":24,"from":24,"to":24,"text":"فقال الأشراف والسادة الذين كفروا بالله من قومه لأتباعهم وعامتهم: ما هذا الذي يزعم أنه رسول إلا بشر مثلكم يريد الرئاسة والسيادة عليكم، فلو شاء الله أن يرسل إلينا رسولًا لأرسله من الملائكة، ولم يرسله من البشر، ما سمعنا بمثل ما ادعاه عند أسلافنا الذين سبقونا."},{"ayah":25,"from":25,"to":25,"text":"وما هو إلا رجل به جنون، لا يعي ما يقول، فانتظروا به حتى يتضح أمره للناس."},{"ayah":26,"from":26,"to":26,"text":"قال نوح عليه السلام: رب انصرني عليهم بأن تنتقم لي منهم بسبب تكذيبهم إياي."},{"ayah":27,"from":27,"to":27,"text":"فأوحينا إليه أن اصنع السفينة بمرأى منا وتعليمنا إياك كيف تصنعها، فإذا جاء أمرنا بإهلاكهم، ونبع الماء بقوة من المكان الذي يخبز فيه، فأدخل فيها من كل الأحياء ذكرًا وأنثى ليستمرّ النَّسْل، وأدخل أهلك إلا من سبق عليه القول من الله بالإهلاك مثل زوجتك وابنك، ولا تخاطبني في الذين ظلموا بالكفر بطلب نجاتهم وترك إهلاكهم، إنهم مُهْلَكون - لا محالة - بالغرق في ماء الطوفان."},{"ayah":28,"from":28,"to":28,"text":"فإذا علوت على السفينة أنت ومن معك من المؤمنين الناجين، فقل: الحمد لله الذي أنقذنا من القوم الكافرين فأهلكهم."},{"ayah":29,"from":29,"to":29,"text":"وقل: رب أنزلني من الأرض إنزالًا مباركًا، وأنت خير المُنْزِلين."},{"ayah":30,"from":30,"to":30,"text":"إن في ذلك المذكور من إنجاء نوح والمؤمنين معه، وإهلاك الكافرين؛ لدلالات جلية على قدرتنا على نصر رسلنا وإهلاك المكذبين بهم، وإن كنا لمختبرين قوم نوح بإرساله إليهم ليتضح المؤمن من الكافر والمطيع من العاصي."},{"ayah":31,"from":31,"to":31,"text":"ثم أنشأنا من بعد إهلاك قوم نوح أمة أخرى."},{"ayah":32,"from":32,"to":32,"text":"فبعثنا فيهم رسولًا منهم يدعوهم إلى الله، فقال لهم: اعبدوا الله وحده ما لكم من معبود بحق غيره سبحانه، أفلا تتقون الله باجتناب نواهيه، وامتثال أوامره؟!"},{"ayah":33,"from":33,"to":33,"text":"وقال الأشراف والسادة من قومه الذين كفروا بالله، وكذبوا بالآخرة وما فيها من ثواب وعقاب، وأطغاهم ما وسّعنا لهم من النعم في الحياة الدنيا، قالوا لأتباعهم وعامتهم -: ما هذا إلا بشر مثلكم يأكل مما تأكلون منه، ويشرب مما تشربون منه، فليس له مزية عليكم حتى يُبْعَث رسولًا إليكم."},{"ayah":34,"from":34,"to":34,"text":"ولئن أطعتم بشرًا مثلكم إنكم إذن لخاسرون لعدم انتفاعكم بطاعته لترككم آلهتكم، واتباع من لا فضيلة له عليكم."},{"ayah":35,"from":35,"to":35,"text":"أيعدكم هذا الذي يزعم أنه رسول أنكم إذا متم وصرتم ترابًا وعظامًا بالية أنكم تخرجون من قبوركم أحياء؟! أيعقل هذا؟!"},{"ayah":36,"from":36,"to":36,"text":"بعيد جدًّا ما توعدون به من إخراجكم من قبوركم أحياء بعد موتكم، ومصيركم ترابًا وعظامًا بالية."},{"ayah":37,"from":37,"to":37,"text":"ليست الحياة إلا الحياة الدنيا، لا الحياة الآخرة، تموت الأحياء منا ولا تحيا، ويولد آخرون فيحيون، ولسنا بمُخْرَجين بعد موتنا للحساب يوم القيامة."},{"ayah":38,"from":38,"to":38,"text":"ما هذا الذي يدّعي أنه رسول إليكم إلا رجل اختلق على الله كذبًا بادعائه هذا، ولسنا له بمؤمنين."},{"ayah":39,"from":39,"to":39,"text":"قال الرسول: رب انصرني عليهم بأن تنتقم لي منهم بسبب تكذيبهم إياي."},{"ayah":40,"from":40,"to":40,"text":"فأجابه الله قائلًا: بعد زمن قليل سيصبح هؤلاء المكذبون بما جئت به نادمين على ما وقع منهم من التكذيب."},{"ayah":41,"from":41,"to":41,"text":"فأخذهم صوت شديد مُهلك باستحقاقهم العذاب لتعنُّتهم، فصيّرتهم هلكى مثل غثاء السيل، فهلاكًا للقوم الظالمين."},{"ayah":42,"from":42,"to":42,"text":"ثم بعد إهلاكهم أنشأنا أقوامًا وأممًا آخرين مثل قوم لوط، وقوم شعيب، وقوم يونس."},{"ayah":43,"from":43,"to":43,"text":"لا تتقدم أي أمة من هذه الأمم المكذبة الوقت المحدد لمجيء هلاكها، ولا تتأخر عنه، مهما كان لها من الوسائل."},{"ayah":44,"from":44,"to":44,"text":"ثم بعثنا رسلنا متتابعين رسولًا رسولًا، كلما جاء أمةً من تلك الأمم رسولُها المبعوث إليها كذبوه، فأتبعنا بعضهم ببعض بالهلاك، فلم يبق لهم وجود إلا أحاديث الناس عنهم، فهلاكًا لقوم لا يؤمنون بما جاءتهم به رسلهم من عند ربهم."},{"ayah":45,"from":45,"to":45,"text":"ثم بعثنا موسى وأخاه هارون بآياتنا التسع: (العصا، اليد، الجراد، القُمَّل، الضفادع، الدم، الطوفان، السنون، نقص الثمرات)، وبحجة واضحة."},{"ayah":46,"from":46,"to":46,"text":"بعثناهما إلى فرعون والأشراف من قومه فاستكبروا، فلم ينقادوا للإيمان لهما، وكانوا قومًا مُسْتَعْلِين على الناس بالقهر والظلم."},{"ayah":47,"from":47,"to":47,"text":"فقالوا: أنؤمن لبشرين مثلنا، لا مزية لهما علينا، وقومهما (بنو إسرائيل) لنا مطيعون خاضعون؟!"},{"ayah":48,"from":48,"to":48,"text":"فكذّبوهما فيما جاءا به من عند الله، فكانوا بسبب تكذيبهم من المُهْلَكين بالغرق."},{"ayah":49,"from":49,"to":49,"text":"ولقد أعطينا موسى التوراة رجاء أن يهتدي بها قومه إلى الحق، ويعملوا بها."},{"ayah":50,"from":50,"to":50,"text":"وصيّرنا عيسى بن مريم وأمه مريم علامة دالة على قدرتنا، فقد حملت به من غير أب، وآويناهما إلى مكان مرتفع من الأرض، مستوٍ صالح للاستقرار عليه، فيه ماء جار متجدد."},{"ayah":51,"from":51,"to":51,"text":"يا أيها الرسل، كلوا مما أحللت لكم مما يُسْتَطاب أكله، واعملوا عملًا صالحًا موافقًا للشرع، إني بما تعملون من عمل عليم، لا يخفى عليَّ من أعمالكم شيء."},{"ayah":52,"from":52,"to":52,"text":"وإن ملَّتكم - أيها الرسل - ملة واحدة وهي الإسلام، وأنا ربكم لا ربَّ لكم غيري، فاتقوني بامتثال أوامري، واجتناب نواهيّ."},{"ayah":53,"from":53,"to":53,"text":"فتفرّق أتباعهم بعدهم في الدين، فصاروا أحزابًا وشيعًا، كل حزب معجب بما يؤمن أنه هو الدين المرضي عند الله، ولا يلتفت إلى ما عند غيره."},{"ayah":54,"from":54,"to":54,"text":"فاتركهم - أيها الرسول - فيما هم فيه من الجهل والحيرة إلى حين نزول العذاب بهم."},{"ayah":55,"from":55,"to":55,"text":"٥٥ - ٥٦ - أيظنّ هؤلاء الأحزاب الفرحون بما لديهم أن ما نعطيهم من الأموال والأولاد في الحياة الدنيا هو تعجيل خير لهم يستحقونه؟! ليس الأمر كما ظنوا، إنما نعطيهم ذلك إملاءً واستدراجًا لهم، لكنهم لا يحسُّون بذلك."},{"ayah":56,"from":56,"to":56,"text":"٥٥ - ٥٦ - أيظنّ هؤلاء الأحزاب الفرحون بما لديهم أن ما نعطيهم من الأموال والأولاد في الحياة الدنيا هو تعجيل خير لهم يستحقونه؟! ليس الأمر كما ظنوا، إنما نعطيهم ذلك إملاءً واستدراجًا لهم، لكنهم لا يحسُّون بذلك."},{"ayah":57,"from":57,"to":57,"text":"إن الذين هم مع إيمانهم وإحسانهم وجِلون من ربهم."},{"ayah":58,"from":58,"to":58,"text":"والذين هم بآيات كتابه يؤمنون."},{"ayah":59,"from":59,"to":59,"text":"والذين هم يوحدون ربهم لا يشركون به شيئًا."},{"ayah":60,"from":60,"to":60,"text":"والذين يجتهدون في أعمال البر، ويتقربون إلى الله بالأعمال الصالحة وهم خائفون ألا يتقبل الله منهم إنفاقهم وأعمالهم الصالحة إذا رجعوا إليه يوم القيامة."},{"ayah":61,"from":61,"to":61,"text":"أولئك الموصوفون بهذه الصفات العظيمة يبادرون إلى الأعمال الصالحة، وهم إليها سابقون، ومن أجلها سبقوا غيرهم."},{"ayah":62,"from":62,"to":62,"text":"ولا نكلف نفسًا إلا قدر ما تستطيعه من العمل، وعندنا كتاب أثبتنا فيه عمل كل عامل، ينطق بالحق الذي لا مرية فيه، وهم لا يظلمون بنقص حسناتهم، ولا زيادة سيئاتهم."},{"ayah":63,"from":63,"to":63,"text":"بل قلوب الكفار في غفلة من هذا الكتاب الذي ينطق بالحق، والكتاب الذي نزل عليهم، ولهم أعمال أخرى دون ما هم عليه من الكفر هم لها عاملون."},{"ayah":64,"from":64,"to":64,"text":"حتى إذا عاقبنا منعَّميهم في الدنيا بالعذاب يوم القيامة إذا هم يرفعون أصواتهم مستغيثين."},{"ayah":65,"from":65,"to":65,"text":"فيقال لهم تيئيسًا لهم من رحمة الله: لا تصرخوا ولا تستغيثوا في هذا اليوم، فإنه لا ناصر لكم يمنعكم من عذاب الله."},{"ayah":66,"from":66,"to":66,"text":"قد كانت آيات كتاب الله تُقْرأ عليكم في الدنيا، فكنتم ترجعون مولّين عنها إذا سمعتموها كراهية لها."},{"ayah":67,"from":67,"to":67,"text":"تفعلون ذلك مستكبرين على الناس بما تزعمونه من أنكم أهل الحرم ولستم أهله؛ لأن أهله هم المتقون، وتتسامرون حوله بالسيئ من القول، فأنتم لا تقدسونه."},{"ayah":68,"from":68,"to":68,"text":"أفلم يتدبر هؤلاء المشركون ما أنزل الله من القرآن ليؤمنوا به، ويعملوا بما فيه، أم جاءهم ما لم يأت أسلافهم من قبلهم، فأعرضوا عنه وكذبوا به."},{"ayah":69,"from":69,"to":69,"text":"أم إنهم لم يعرفوا محمدًا صلّى الله عليه وسلّم الذي أرسله الله إليهم، فهم منكرون له، لقد عرفوه وعرفوا صدقه وأمانته."},{"ayah":70,"from":70,"to":70,"text":"بل يقولون: هو مجنون، لقد كذبوا، بل جاءهم بالحق الذي لا مِرْية فيه أنه من عند الله، ومعظمهم كارهون للحق، مبغضون له حسدًا من عند أنفسهم، وتعصبًا لباطلهم."},{"ayah":71,"from":71,"to":71,"text":"ولو أجرى الله الأمور، ودبّرها على وفق ما تهواه أنفسهم لفسدت السماوات والأرض، وفسد من فيهن لجهلهم بعواقب الأمور، وبالصحيح والفاسد من التدبير."},{"ayah":72,"from":72,"to":72,"text":"هل طلبت - أيها الرسول - أجرًا من هؤلاء على ما جئتهم به، وذلك جعلهم يرفضون الدعوة؟ هذا لم يحدث منك، فثواب ربك وأجره خير من ثواب هؤلاء وغيرهم، وهو - سبحانه - خير الرازقين."},{"ayah":73,"from":73,"to":73,"text":"وإنك - أيها الرسول - لتدعو هؤلاء وغيرهم إلى طريق مستقيم لا اعوجاج فيه، وهو طريق الإسلام."},{"ayah":74,"from":74,"to":74,"text":"وإن الذين لا يؤمنون بالآخرة وما فيها من حساب وعقاب وثواب عن طريق الإسلام لمائلون إلى غيرها من الطرق المعوجة الموصلة إلى النار."},{"ayah":75,"from":75,"to":75,"text":"ولو رحمناهم ورفعنا عنهم ما بهم من قحط وجوع لتمادوا في ضلالهم عن الحق يترددون ويتخبّطون."},{"ayah":76,"from":76,"to":76,"text":"ولقد اختبرناهم بأنواع المصائب، فما تَذَلَّلوا لربِّهم ولا خضعوا له، وما دعوه خاشعين ليرفع عنهم المصائب عند نزولها."},{"ayah":77,"from":77,"to":77,"text":"حتى إذا فتحنا عليهم بابًا من العذاب الشديد إذا هم فيه آيسون من كل فَرَج وخير."},{"ayah":78,"from":78,"to":78,"text":"والله سبحانه هو الذي خلق لكم - أيها المكذبون بالبعث - السمع لتسمعوا به، والأبصار لتبصروا بها، والقلوب لتفقهوا بها، ومع ذلك لا تشكرونه على هذه النعم إلا قليلًا."},{"ayah":79,"from":79,"to":79,"text":"وهو الذي خلقكم - أيها الناس - في الأرض، وإليه وحده يوم القيامة تحشرون للحساب والجزاء."},{"ayah":80,"from":80,"to":80,"text":"وهو وحده سبحانه الذي يحيي فلا محيي غيره، وهو وحده الذي يميت فلا مميت سواه، وإليه وحده تقدير اختلاف الليل والنهار ظلمة وإنارة وطولًا وقصرًا، أفلا تعقلون قدرته، وتفرّده بالخلق والتدبير؟!"},{"ayah":81,"from":81,"to":81,"text":"بل قالوا مثل ما قال آباؤهم وأسلافهم في الكفر."},{"ayah":82,"from":82,"to":82,"text":"قالوا على وجه الاستبعاد والإنكار: أإذا متنا وصرنا ترابًا وعظامًا بالية أإنا لمبعوثون أحياءً للحساب؟!"},{"ayah":83,"from":83,"to":83,"text":"لقد وعدنا هذا الوعد - وهو البعث بعد الموت - ووُعِد أسلافنا من قبلُ بذلك، ولم نر ذلك الوعد تحقق، ما هذا إلا أباطيل الأقدمين وأكاذيبهم."},{"ayah":84,"from":84,"to":84,"text":"قل - أيها الرسول - لهؤلاء الكفار المنكرين للبعث: لمن هذه الأرض، ومن عليها إن كان لكم علم؟"},{"ayah":85,"from":85,"to":85,"text":"سيقولون: الأرض ومن عليها لله، فقل لهم: ألا تتذكرون أن من له الأرض ومن عليها قادر على إحيائكم بعد موتكم؟"},{"ayah":86,"from":86,"to":86,"text":"قل لهم: من رب السماوات السبع؟ ومن رب العرش العظيم الذي لا يوجد مخلوق أعظم منه؟"},{"ayah":87,"from":87,"to":87,"text":"سيقولون: السماوات السبع والعرش العظيم ملك لله، فقل لهم: أفلا تتقون الله بامتثال أوامره واجتناب نواهيه لتسلموا من عذابه؟"},{"ayah":88,"from":88,"to":88,"text":"قل لهم: من الذي بيده ملك كل شيء، لا يشذ عن ملكه شيء، وهو يغيث من شاء من عباده، ولا أحد يمتنع ممن أراده هو بسوء، فيدفع عنه العذاب، إن كان لكم علم؟"},{"ayah":89,"from":89,"to":89,"text":"سيقولون: ملك كل شيء بيده سبحانه، فقل لهم: فكيف تذهب عقولكم، وتعبدون غيره مع إقراركم بذلك؟!"},{"ayah":90,"from":90,"to":90,"text":"ليس الأمر كما يدّعون، بل جئناهم بالحق الذي لا مرية فيه، وإنهم لكاذبون فيما يدّعونه لله من الشريك والولد، تعالى الله عن قولهم علوًّا كبيرًا."},{"ayah":91,"from":91,"to":91,"text":"ما اتخذ الله من ولد كما يزعم الكفار، وما كان معه من معبود بحق، ولو فرض أنه معه معبود بحق لذهب كل معبود بنصيبه من الخلق الذي خلقه، وَلَغَالَبَ بعضهم بعضًا، فيفسد نظام الكون، والواقع أن شيئًا من ذلك لم يحدث، فدل على أن المعبود بحق واحد وهو الله وحده، تنزه وتقدس عما يصفه به المشركون مما لا يليق به من الولد والشريك."},{"ayah":92,"from":92,"to":92,"text":"عالم كل ما غاب عن خلقه، وعالم كل ما يشاهد ويدرك بالحواس، لا يخفى عليه شيء من ذلك، فتعالى سبحانه أن يكون له شريك."},{"ayah":93,"from":93,"to":93,"text":"قل - يا أيها الرسول -: رب إما تريني في هؤلاء المشركين ما وعدتهم من العذاب."},{"ayah":94,"from":94,"to":94,"text":"رب إن عاقبتهم وأنا أشاهد ذلك فلا تجعلني فيهم فيصيبني ما أصابهم من العذاب."},{"ayah":95,"from":95,"to":95,"text":"وإنا على أن نجعلك تشاهد وترى ما نعدهم به من العذاب لقادرون، لا نعجز عن ذلك ولا عن غيره."},{"ayah":96,"from":96,"to":96,"text":"ادفع - أيها الرسول - من يسيء إليك بالخصلة التي هي أحسن؛ بأن تصفح عنه، وتصبر على أذاه، نحن أعلم بما يصفون من الشرك والتكذيب، وبما يصفونك به مما لا يليق بك كالسحر والجنون."},{"ayah":97,"from":97,"to":97,"text":"وقل: رب أعتصم بك من نَزَغَات الشياطين ووساوسهم."},{"ayah":98,"from":98,"to":98,"text":"وأعوذ بك رب أن يحضروني في شيء من أموري."},{"ayah":99,"from":99,"to":99,"text":"حتى إذا جاء أحدَ هؤلاء المشركين الموتُ، وعاين ما ينزل به قال ندمًا على ما فات من عمره، وما فرّط في جنب الله: رب ارجعني إلى الحياة الدنيا."},{"ayah":100,"from":100,"to":100,"text":"لعلّي أعمل عملًا صالحًا إذا رجعت إليها، كلا، ليس الأمر كما طلبت، إنها مجرد كلمة هو قائلها، فلو رُدَّ إلى الحياة الدنيا لما وفى بما وعد به، وسيبقى هؤلاء المتوفّون في حاجز بين الدنيا والآخرة إلى يوم البعث والنشور، فلا يرجعون منه إلى الدنيا ليستدركوا ما فاتهم، ويصلحوا ما أفسدوه."},{"ayah":101,"from":101,"to":101,"text":"فإذا نفخ الملك الموكل بالنفخ في القرن النفخة الثانية المؤذنة بالقيامة، فلا أنساب بينهم يتفاخرون بها لانشغالهم بأهوال الآخرة، ولا يسأل بعضهم بعضًا لانشغالهم بما يهمهم."},{"ayah":102,"from":102,"to":102,"text":"فمن ثقلت موازينه برجحان حسناته على سيئاته فأولئك هم المفلحون بما ينالونه من مطلوبهم، وما يجنّبون من مرهوبهم."},{"ayah":103,"from":103,"to":103,"text":"ومن خفّت موازينه لرجحان سيئاته على حسناته فأولئك هم الذين ضيعوا أنفسهم بفعل ما يضرّها، وترك ما ينفعها من الإيمان والعمل الصالح، فهم في نار جهنم ماكثون، لا يخرجون منها."},{"ayah":104,"from":104,"to":104,"text":"تحرق وجوههم النار، وهم فيها قد تقلّصت شفاههم العليا والسفلى عن أسنانهم من شدة العبوس."},{"ayah":105,"from":105,"to":105,"text":"ويقال لهم تقريعًا لهم: ألم تكن آيات القرآن تقرأ عليكم في الدنيا، فكنتم بها تكذبون؟!"},{"ayah":106,"from":106,"to":106,"text":"قالوا: ربنا غلب علينا ما سبق في علمك من شقاوتنا، وكنا قومًا ضالين عن الحق."},{"ayah":107,"from":107,"to":107,"text":"ربنا أخرجنا من النار، فإن رجعنا إلى ما كنا عليه من الكفر والضلال فإنا ظالمون لأنفسنا، قد انقطع عذرنا."},{"ayah":108,"from":108,"to":108,"text":"قال الله: اسكنوا أذلاء مهانين في النار، ولا تكلموني."},{"ayah":109,"from":109,"to":109,"text":"إنه كان فريق من عبادي الذين آمنوا بي يقولون: ربنا آمنا بك فاغفر لنا ذنوبنا، وارحمنا برحمتك، وأنت خير الراحمين."},{"ayah":110,"from":110,"to":110,"text":"فاتخذتم هؤلاء المؤمنين الداعين ربهم محلًّا للاستهزاء تسخرون منهم، وتستهزئون بهم حتى أنساكم الانشغالُ بالسخرية منهم ذكرَ الله، وكنتم تضحكون منهم سخرية واستهزاء."},{"ayah":111,"from":111,"to":111,"text":"إني جزيت هؤلاء المؤمنين الفوز بالجنة يوم القيامة؛ لصبرهم على طاعة الله وعلى ما كانوا يتلقونه منكم من الأذى."},{"ayah":112,"from":112,"to":112,"text":"قال: كم مكثتم في الأرض من السنين؟ وكم أضعتم فيها من وقت؟"},{"ayah":113,"from":113,"to":113,"text":"فيجيبون بقولهم: مكثنا يومًا أو جزءًا من يوم، فاسأل الذين يُعْنَوْن بحساب الأيام والشهور."},{"ayah":114,"from":114,"to":114,"text":"قال: ما مكثتم في الدنيا إلا زمنًا قليلًا يسهل الصبر فيه على الطاعة لو أنكم كنتم تعلمون مقدار مكثكم."},{"ayah":115,"from":115,"to":115,"text":"أفحسبتم - أيها الناس - أنما خلقناكم لعبًا دون حكمة، فلا ثواب ولا عقاب مثل البهائم، وأنكم لا ترجعون إلينا يوم القيامة للحساب والجزاء؟!"},{"ayah":116,"from":116,"to":116,"text":"فتنزّه الله الملك المتصرّف في خلقه بما يشاء، الذي هو حق، ووعده حق، وقوله حق، لا معبود بحق غيره، رب العرش الكريم الذي هو أعظم المخلوقات، ومن كان ربًّا لأعظم المخلوقات فهو ربها كلها."},{"ayah":117,"from":117,"to":117,"text":"ومن يدع مع الله معبودًا آخر لا حجة له على استحقاقه العبادة (وهذا شأن كل معبود غير الله) فإنما جزاء عمله السيئ عند ربه سبحانه، فهو الذي يجازيه بالعذاب عليه، إنه لا يفوز الكافرون بنيل ما يطلبون، ولا بالنجاة مما يرهبون."},{"ayah":118,"from":118,"to":118,"text":"وقل - أيها الرسول -: رب اغفر لي ذنوبي، وارحمني برحمتك وأنت خير من رحم ذا ذنبٍ، فقبل توبته."}]}