ذا الموضع\n\nإِيَابَهُمْ: أبو جعفر قرأ بتشديد الياء. باقي الرواة قرؤوا بتخفيف الياء.\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع.","words":[{"wordId":76397,"position":1,"word":"إِنَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":76398,"position":2,"word":"إِلَيْنَا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":76399,"position":3,"word":"إِيَابَهُمْ","text":"أبو جعفر قرأ بتشديد الياء. باقي الرواة قرؤوا بتخفيف الياء.\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع."}]},{"ayah":26,"from":26,"to":26,"text":"ثُمَّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nإِنَّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعَلَيْنَا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nحِسَابَهُمْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعند وصل السورة\nورش عن نافع وَأبو عمرو وَيعقوب وَابن عامر فصل بين السورتين بالبسملة، والوصل، والسكت، وله ما بين الآيات من أحكام الوصل. حمزة وَخلف العاشر قرأ بالوصل بين السورتين بلا بسملة، وله ما بين الآيات من أحكام الوصل. باقي الرواة فصل بالبسملة بين السورتين.","words":[{"wordId":76400,"position":1,"word":"ثُمَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":76401,"position":2,"word":"إِنَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":76402,"position":3,"word":"عَلَيْنَا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":76403,"position":4,"word":"حِسَابَهُمْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعند وصل السورة\nورش عن نافع وَأبو عمرو وَيعقوب وَابن عامر فصل بين السورتين بالبسملة، والوصل، والسكت، وله ما بين الآيات من أحكام الوصل. حمزة وَخلف العاشر قرأ بالوصل بين السورتين بلا بسملة، وله ما بين الآيات من أحكام الوصل. باقي الرواة فصل بالبسملة بين السورتين."}]}]}