س حركة ما قبلها. حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بإبدالها حرفا مديا. باقي الرواة قرؤوا بتحقيق الهمزة الساكنة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالْمِهَادُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":3870,"position":1,"word":"وَإِذَا","text":"حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3871,"position":2,"word":"قِيلَ","text":"رويس عن يعقوب وَهشام عن ابن عامر وَالكسائي قرأ بإشمام الكسرةِ الضمَّ. باقي الرواة قرؤوا بالكسرة الخالصة.\n\nعند الوصل\nالسوسي عن أبي عمرو قرأ بالإدغام الكبير. باقي الرواة قرؤوا بالإظهار."},{"wordId":3872,"position":3,"word":"لَهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3873,"position":4,"word":"اتَّقِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3874,"position":5,"word":"اللَّهَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3875,"position":6,"word":"أَخَذَتْهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3876,"position":7,"word":"الْعِزَّةُ","text":"الكسائي قرأ بإمالة هاء التأنيث وقفا. باقي الرواة قرؤوا بفتح هاء التأنيث.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3877,"position":8,"word":"بِالْإِثْمِ","text":"ورش عن نافع قرأ بالنقل مع ترك السكت. خلف عن حمزة قرأ بالسكت وصلاً، ووقف بالسكت والنقل. خلاد عن حمزة قرأ بالسكت وعدمه وصلاً، ووقف بالسكت والنقل. باقي الرواة قرؤوا بترك السكت مع تحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3878,"position":9,"word":"فَحَسْبُهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3879,"position":10,"word":"جَهَنَّمُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3880,"position":11,"word":"وَلَبِئْسَ","text":"ورش عن نافع وَأبو جعفر وَالسوسي عن أبي عمرو قرأ بإبدال الهمزة الساكنة حرفا مديا من جنس حركة ما قبلها. حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بإبدالها حرفا مديا. باقي الرواة قرؤوا بتحقيق الهمزة الساكنة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3881,"position":12,"word":"الْمِهَادُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"}]},{"ayah":207,"from":207,"to":207,"text":"وَمِنَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالنَّاسِ: الدوري عن أبي عمرو قرأ بالإمالة بلا خلاف عنه. باقي الرواة قرؤوا بالفتح بلا خلاف عنه.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nمَنْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nخلف عن حمزة قرأ بالإدغام مع ترك الغنة. باقي الرواة قرؤوا بالإدغام مع الغنة.\n\nيَشْرِي: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nنَفْسَهُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nابْتِغَاءَ: هشام عن ابن عامر وَحمزة قرأ بتحقيق الهمزة وصلاً، ووقف بإبدال الهمزة ألفاً مع القصر والتوسط والطول. باقي الرواة قرؤوا بتحقيق الهمزة المتطرفة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nمَرْضَاتِ: الكسائي قرأ بالإمالة في الحالين، مع الوقف بالهاء. باقي الرواة قرؤوا بترك الإمالة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nاللَّهِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nوَاللَّهُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nرَءُوفٌ: قالون عن نافع وَأبو جعفر وَابن كثير وَابن عامر وَحفص عن عاصم قرأ بمد الهمزة، مع قصر مد البدل. ورش عن نافع قرأ بمد الهمزة، مع تثليث البدل. حمزة قرأ بقصر وتحقيق الهمزة وصلاً، ويقف بتسهيل الهمزة فقط. باقي الرواة قرؤوا بقصر الهمزة.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nبِالْعِبَادِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":3882,"position":1,"word":"وَمِنَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3883,"position":2,"word":"النَّاسِ","text":"الدوري عن أبي عمرو قرأ بالإمالة بلا خلاف عنه. باقي الرواة قرؤوا بالفتح بلا خلاف عنه.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3884,"position":3,"word":"مَنْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nخلف عن حمزة قرأ بالإدغام مع ترك الغنة. باقي الرواة قرؤوا بالإدغام مع الغنة."},{"wordId":3885,"position":4,"word":"يَشْرِي","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3886,"position":5,"word":"نَفْسَهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3887,"position":6,"word":"ابْتِغَاءَ","text":"هشام عن ابن عامر وَحمزة قرأ بتحقيق الهمزة وصلاً، ووقف بإبدال الهمزة ألفاً مع القصر والتوسط والطول. باقي الرواة قرؤوا بتحقيق الهمزة المتطرفة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3888,"position":7,"word":"مَرْضَاتِ","text":"الكسائي قرأ بالإمالة في الحالين، مع الوقف بالهاء. باقي الرواة قرؤوا بترك الإمالة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3889,"position":8,"word":"اللَّهِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3890,"position":9,"word":"وَاللَّهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3891,"position":10,"word":"رَءُوفٌ","text":"قالون عن نافع وَأبو جعفر وَابن كثير وَابن عامر وَحفص عن عاصم قرأ بمد الهمزة، مع قصر مد البدل. ورش عن نافع قرأ بمد الهمزة، مع تثليث البدل. حمزة قرأ بقصر وتحقيق الهمزة وصلاً، ويقف بتسهيل الهمزة فقط. باقي الرواة قرؤوا بقصر الهمزة.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":3892,"position":11,"word":"بِالْعِبَادِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"}]},{"ayah":208,"from":208,"to":208,"text":"يَاأَيُّهَا: حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بالتحقيق، والتسهيل مع المد والقصر. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالَّذِينَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nآمَنُوا: ورش عن نافع قرأ بتثليث مد البدل. باقي الرواة قرؤوا بقصر مد البدل.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nادْخُلُوا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nفِي: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالسِّلْمِ: نافع وَأبو جعفر وَابن كثير وَالكسائي قرأ بفتح السين. باقي الرواة قرؤوا بكسر السين.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nكَافَّةً: الكسائي قرأ بإمالة هاء التأنيث وقفا. باقي الرواة قرؤوا بفتح هاء التأنيث.\n\nعند الوصل\nخلف عن حمزة قرأ بالإدغام مع ترك الغنة. باقي الرواة قرؤوا بالإدغام مع الغنة.\n\nوَلَا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nتَتَّبِعُوا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nخُطُوَاتِ: أبو جعفر وَقنبل عن ابن كثير وَيعقوب وَابن عامر وَحفص عن عاصم وَالكسائي قرأ (خُطُوَاتِ) بضم الطاء. باقي الرواة قرؤوا (خُطْوَاتِ) بإسكان الطاء.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالشَّيْطَانِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nإِنَّهُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nلَكُمْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع.\n\nعَدُوٌّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nمُبِينٌ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":3893,"position":1,"word":"يَاأَيُّهَا","text":"حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بالتحقيق، والتسهيل مع