\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالتَّوَّابُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالرَّحِيمُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":2864,"position":1,"word":"إِلَّا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2865,"position":2,"word":"الَّذِينَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2866,"position":3,"word":"تَابُوا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2867,"position":4,"word":"وَأَصْلَحُوا","text":"ورش عن نافع قرأ بتغليظ اللام، مع تحقيق الهمزة. حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بالتسهيل، والتحقيق، مع ترقيق اللام في الحالين. باقي الرواة قرؤوا بترقيق اللام، مع تحقيق الهمزة.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2868,"position":5,"word":"وَبَيَّنُوا","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2869,"position":6,"word":"فَأُولَئِكَ","text":"حمزة قرأ بتحقيق الهمزتين وصلاً، ووقف بتحقيق وتسهيل الهمزة الأولى، مع تسهيل الثانية مع المد والقصر فتكون أربعة أوجه. باقي الرواة قرؤوا بتحقيق الهمزتين وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2870,"position":7,"word":"أَتُوبُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2871,"position":8,"word":"عَلَيْهِمْ","text":"يعقوب وَحمزة قرأ بضم هاء الضمير وصلاً ووقفا. باقي الرواة قرؤوا بكسر هاء الضمير وصلاً ووقفا.\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع."},{"wordId":2872,"position":9,"word":"وَأَنَا","text":"حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل وتحقيق الهمزة. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2873,"position":10,"word":"التَّوَّابُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":2874,"position":11,"word":"الرَّحِيمُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"}]},{"ayah":161,"from":161,"to":161,"text":"إِنَّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالَّذِينَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nكَفَرُوا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nوَمَاتُوا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nوَهُمْ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع.\n\nكُفَّارٌ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nورش عن نافع قرأ بالنقل وصلاً ووقفا. خلف عن حمزة قرأ بالسكت وعدمه وصلاً، ووقف بالسكت، والنقل، وتركهما. خلاد عن حمزة قرأ بترك السكت وصلاً، ووقف بالنقل والتحقيق. باقي الرواة قرؤوا بترك السكت مع تحقيق الهمزة وصلاً ووقفا.\n\nأُولَئِكَ: حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل الهمزة مع المد والقصر. باقي الرواة قرؤوا بتحقيق الهمزة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعَلَيْهِمْ: يعقوب وَحمزة قرأ بضم هاء الضمير وصلاً ووقفا. باقي الرواة قرؤوا بكسر هاء الضمير وصلاً ووقفا.\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع.\n\nلَعْنَةُ: الكسائي قرأ بإمالة هاء التأنيث وقفا. باقي الرواة قرؤوا بفتح هاء التأنيث.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nاللَّهِ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nوَالْمَلَائِكَةِ: حمزة قرأ بتحقيق الهمزة وصلاً، ووقف بتسهيل الهمزة مع المد والقصر، مع فتح هاء التأنيث وقفا. الكسائي قرأ بتحقيق الهمزة في الحالين، مع إمالة هاء التأنيث وقفا. باقي الرواة قرؤوا بتحقيق الهمزة في الح