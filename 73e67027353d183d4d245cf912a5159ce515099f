ِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، مِنْ مَادَّةِ: (قرض) .\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nقَرْضًا: {قَرْضًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قرض) .\n\nحَسَنًا: {حَسَنًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (حَسُنَ يَحْسُنُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (حسن) .\n\nيُضَاعَفُ: {يُضَاعَفُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ وَالْيَاءِ، مِنْ بَابِ: (فَاعَلَ) ، عَلَى وَزْنِ: (يُفَاعَلُ) ، مِنْ مَادَّةِ: (ضعف) .\n\nلَهُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nوَلَهُمْ: (اللَّامُ) : حَرْفٌ مَبْنِيٌّ.\n\nأَجْرٌ: {أَجْرٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أجر) .\n\nكَرِيمٌ: {كَرِيمٌ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَرُمَ يَكْرُمُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (كرم) .","words":[{"wordId":69578,"position":1,"word":"إِنَّ","text":"{إِنَّ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":69579,"position":2,"word":"الْمُصَّدِّقِينَ","text":"{الْمُصَّدِّقِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُصَّدِّقٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الْخُمَاسِيِّ: (تَصَدَّقَ) ، مِنْ بَابِ: (تَفَعَّلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: التَّاءِ وَالْمِيمِ وَحَرْفٍ مُضَعَّفٍ، أَصْلُهُ: (مُتَصَدِّقٌ) ، عَلَى وَزْنِ: (مُتَفَعِّلٌ) ، فِيهِ إِبْدَالُ حَرْفِ: التَّاءِ حَرْفًا مُجَانِسًا لِمَا بَعْدَهُ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (صدق) ."},{"wordId":69580,"position":3,"word":"وَالْمُصَّدِّقَاتِ","text":"{الْمُصَّدِّقَاتِ} : اسْمٌ، مُؤَنَّثُ