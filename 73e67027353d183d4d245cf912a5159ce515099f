 مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (عَظُمَ يَعْظُمُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، مِنْ مَادَّةِ: (عظم) ."}]},{"ayah":13,"from":13,"to":13,"text":"يَوْمَ: {يَوْمَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (يوم) .\n\nيَقُولُ: {يَقُولُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (يَقْوُلُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الضَّمَّةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nالْمُنَافِقُونَ: {الْمُنَافِقُونَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (مُنَافِقٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (نَافَقَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْمِيمِ، عَلَى وَزْنِ: (مُفَاعِلٌ) ، مِنْ مَادَّةِ: (نفق) .\n\nوَالْمُنَافِقَاتُ: {الْمُنَافِقَاتُ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (مُنَافِقَةٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (نَافَقَ) ، مِنْ بَابِ: (فَاعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْمِيمِ، عَلَى وَزْنِ: (مُفَاعِلٌ) ، مِنْ مَادَّةِ: (نفق) .\n\nلِلَّذِينَ: {الَّذِينَ} : اسْمٌ مَبْنِيٌّ.\n\nآمَنُوا: {آمَنُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَأْمَنَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ أَلِفًا لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ، مِنْ مَادَّةِ: (أمن) .\n\nانْظُرُونَا: {انْظُرُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (افْعُلْ) ، مِنْ مَادَّةِ: (نظر) .\n\nنَقْتَبِسْ: {نَقْتَبِسْ} : فِعْلٌ مُضَارِعٌ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالنُّونِ، مِنْ بَابِ: (افْتَعَلَ) ، عَلَى وَزْنِ: (نَفْتَعِلُ) ، مِنْ مَادَّةِ: (قبس) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nنُورِكُمْ: {نُورِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (نور) .\n\nقِيلَ: {قِيلَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قُوِلَ) ، عَلَى وَزْنِ: (فُعِلَ) ، فِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nارْجِعُوا: {ارْجِعُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (افْعِلْ) ، مِنْ مَادَّةِ: (رجع) .\n\nوَرَاءَكُمْ: {وَرَاءَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، مَمْدُودٌ، أَصْلُهُ: (وَرَايٌ) ، عَلَى وَزْنِ: (فَعَالٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (وري) .\n\nفَالْتَمِسُوا: {الْتَمِسُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، عَلَى وَزْنِ: (افْتَعِلْ) ، مِنْ مَادَّةِ: (لمس) .\n\nنُورًا: {نُورًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (نور) .\n\nفَضُرِبَ: {ضُرِبَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (فُعِلَ) ، مِنْ مَادَّةِ: (ضرب) .\n\nبَيْنَهُمْ: {بَيْنَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بين) .\n\nبِسُورٍ: {سُورٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (سور) .\n\nلَهُ: (اللَّامُ) : حَرْفٌ