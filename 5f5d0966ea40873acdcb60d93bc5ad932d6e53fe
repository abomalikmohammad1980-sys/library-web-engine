import {describe,expect,it}from"vitest";import{HmacBuildServiceTokenVerifier}from"./service-auth.js";describe("build service auth",()=>{it("accepts current and rotated previous only with required scope",async()=>{const v=new HmacBuildServiceTokenVerifier("current-secret","previous-secret");for(const token of["current-secret","previous-secret"])await expect(v.verify(new Request("https://x",{headers:{authorization:`Bearer ${token}`,"x-service-scopes":"build:claim artifact:write"}}),"build:claim")).resolves.toMatchObject({serviceId:"node-build-runner"});await expect(v.verify(new Request("https://x",{headers:{authorization:"Bearer current-secret","x-service-scopes":"revision:read"}}),"build:claim")).rejects.toMatchObject({status:403});await expect(v.verify(new Request("https://x",{headers:{authorization:"Bearer wrong","x-service-scopes":"build:claim"}}),"build:claim")).rejects.toMatchObject({status:401})})});
