# سطر النهايات
* text=auto eol=lf
*.ps1 text eol=crlf

# ملفات الحقيقة والكتب — Git LFS (ثنائية/كبيرة)
corpus/books/** filter=lfs diff=lfs merge=lfs -text
corpus/ground-truth/** filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.xps filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
