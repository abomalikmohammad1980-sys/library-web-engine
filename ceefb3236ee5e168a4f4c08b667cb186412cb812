{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":74,"records":[{"ayah":1,"from":1,"to":1,"text":"يا أيها المُتَغَشِّي بثيابه (وهو النبي صلّى الله عليه وسلّم)."},{"ayah":2,"from":2,"to":2,"text":"انهض وخوِّف من عذاب الله."},{"ayah":3,"from":3,"to":3,"text":"وعَظِّمْ ربك."},{"ayah":4,"from":4,"to":4,"text":"وطهِّر نفسك من الذنوب وثيابك من النجاسات."},{"ayah":5,"from":5,"to":5,"text":"وابتعد عن عبادة الأوثان."},{"ayah":6,"from":6,"to":6,"text":"ولا تمنن على ربك بأن تستكثر عملك الصالح."},{"ayah":7,"from":7,"to":7,"text":"واصبر لله على ما تلاقيه من الأذى."},{"ayah":8,"from":8,"to":8,"text":"فإذا نُفِخَ في القرن النفخة الثانية."},{"ayah":9,"from":9,"to":9,"text":"فذلك اليوم يوم شديد."},{"ayah":10,"from":10,"to":10,"text":"على الكافرين بالله وبرسله غير سهل."},{"ayah":11,"from":11,"to":11,"text":"اتركني - أيها الرسول - ومن خلقته وحيدًا في بطن أمه دون مال أو ولد (وهو الوليد بن المُغِيرة)."},{"ayah":12,"from":12,"to":12,"text":"وجعلت له مالًا كثيرًا."},{"ayah":13,"from":13,"to":13,"text":"وجعلت له بنين حاضرين معه ويشهدون المحافل معه لا يفارقونه لسفر لكثرة ماله."},{"ayah":14,"from":14,"to":14,"text":"وبسطت له في العيش والرزق والولد بسطًا."},{"ayah":15,"from":15,"to":15,"text":"ثم يطمع مع كفره بي أن أزيده بعد ما أعطيته من ذلك كله."},{"ayah":16,"from":16,"to":16,"text":"ليس الأمر كما تصوّر، إنه كان معاندًا لآياتنا المنزلة على رسولنا مكذبًا بها."},{"ayah":17,"from":17,"to":17,"text":"سأكلفه مشقة من العذاب لا يستطيع تحمّلها."},{"ayah":18,"from":18,"to":18,"text":"إن هذا الكافر الذي أنعمت عليه بتلك النعم فكّر فيما يقوله في القرآن لإبطاله، وقدّر ذلك في نفسه."},{"ayah":19,"from":19,"to":19,"text":"فلُعِن وعُذِّب كيف قَدَّر."},{"ayah":20,"from":20,"to":20,"text":"ثم لعن وعذّب كيف قَدَّر."},{"ayah":21,"from":21,"to":21,"text":"ثم أعاد النظر والتروِّي فيما يقول."},{"ayah":22,"from":22,"to":22,"text":"ثم قَطَّب وجهه وكَلَح حين لم يجد ما يطعن به في القرآن."},{"ayah":23,"from":23,"to":23,"text":"ثم أدبر عن الإيمان، واستكبر عن اتباع النبي صلّى الله عليه وسلّم."},{"ayah":24,"from":24,"to":24,"text":"فقال: ليس هذا الذي جاء به محمد كلام الله، بل هو سحر يرويه عن غيره."},{"ayah":25,"from":25,"to":25,"text":"ليس هذا كلام الله، بل هو كلام الإنس."},{"ayah":26,"from":26,"to":26,"text":"سأدخل هذا الكافر طبقة من طبقات النار، وهي سَقَر يقاسي حرّها."},{"ayah":27,"from":27,"to":27,"text":"وما أعلمك - يا محمد - ما سَقَر؟!"},{"ayah":28,"from":28,"to":28,"text":"لا تُبْقِي شيئًا من المُعَذَّب فيها إلا أتت عليه، ولا تتركه، ثم يعود كما كان، ثم تأتي عليه، وهكذا دَوَالَيْك."},{"ayah":29,"from":29,"to":29,"text":"شديدة الإحراق والتغيير للجلود."},{"ayah":30,"from":30,"to":30,"text":"عليها تسعة عشر ملكًا، وهم خَزَنتها."},{"ayah":31,"from":31,"to":31,"text":"وما جعلنا خَزَنة النار إلا ملائكة، فلا طاقة للبشر بهم، وقد كذب أبو جهل حين ادّعى أنه وقومه يقدرون على البطش بهم، ثمّ يخرجون من النار، وما جعلنا عددهم هذا إلا اختبارًا للذين كفروا بالله؛ ليقولوا ما قالوا فيُضاعَف عليهم العذاب، وليتيقّن اليهود الذين أعطوا التوراة، والنصارى الذين أعطوا الإنجيل حين نزل القرآن مصدقًا لما في كتابيهم، وليزداد المؤمنون إيمانًا عندما يوافقهم أهل الكتاب، ولا يرتاب اليهود والنصارى والمؤمنون، وليقول المترددون في الإيمان، والكافرون: أي شيء أراده الله بهذا العدد الغريب؟! مثل إضلال مُنْكِر هذا العدد وهداية المُصَدِّق به، يُضِلُّ الله من شاء أن يضلّه ويهدي من شاء أن يهديه، وما يعلم جنود ربك من كثرتها إلا هو سبحانه، فليعلم بذلك أبو جهل القائل: (أما لمحمد أعوان إلا تسعة عشر؟!) استخفافًا وتكذيبًا، وما النار إلا تذكرة للبشر يعلمون بها عظمة الله سبحانه."},{"ayah":32,"from":32,"to":32,"text":"ليس القول كما يزعم بعض المشركين أنه يكفي أصحابه خَزَنة جهنم حتى يُجْهِضهم عنها، أقسم الله بالقمر."},{"ayah":33,"from":33,"to":33,"text":"وأقسم بالليل حين ولّى."},{"ayah":34,"from":34,"to":34,"text":"وأقسم بالصبح إذا أضاء."},{"ayah":35,"from":35,"to":35,"text":"إنّ نار جهنم لإحدى البلايا العظيمة."},{"ayah":36,"from":36,"to":36,"text":"ترهيبًا وتخويفًا للناس."},{"ayah":37,"from":37,"to":37,"text":"لمن شاء منكم - أيها الناس - أن يتقدم بالإيمان بالله والعمل الصالح، أو يتأخر بالكفر والمعاصي."},{"ayah":38,"from":38,"to":38,"text":"كل نفس بما كسبته من الأعمال مأخوذة، فإما أن توبقها أعمالها، وإما أن تخلِّصها وتنقذها من الهلاك."},{"ayah":39,"from":39,"to":39,"text":"إلا المؤمنين فإنهم لا يُؤْخذون بذنوبهم، بل يتجاوز عنها لما لهم من عمل صالح"},{"ayah":40,"from":40,"to":40,"text":"وهم يوم القيامة في جنات يسأل بعضهم بعضًا."},{"ayah":41,"from":41,"to":41,"text":"عن الكافرين الذين أهلكوا أنفسهم بما عملوا من المعاصي."},{"ayah":42,"from":42,"to":42,"text":"يقولون لهم: ما أدخلكم في جهنم؟"},{"ayah":43,"from":43,"to":43,"text":"فيجيبهم الكفار قائلين: لم نكن من الذين يؤدون الصلاة الواجبة في الحياة الدنيا."},{"ayah":44,"from":44,"to":44,"text":"ولم نكن نطعم الفقير مما أعطانا الله."},{"ayah":45,"from":45,"to":45,"text":"وكنا مع أهل الباطل ندور معهم أينما داروا، ونتحدث مع أهل الضلال والغواية."},{"ayah":46,"from":46,"to":46,"text":"وكنا نكذب بيوم الجزاء."},{"ayah":47,"from":47,"to":47,"text":"وتمادينا في التكذيب به حتى جاءنا الموت، فحال بيننا وبين التوبة."},{"ayah":48,"from":48,"to":48,"text":"فما تنفعهم يوم القيامة وساطة الشافعين من الملائكة والنبيين والصالحين؛ لأن من شرط قَبول الشفاعة الرضا عن المشفوع."},{"ayah":49,"from":49,"to":49,"text":"أي شيء جعل هؤلاء المشركين معرضين عن القرآن؟!"},{"ayah":50,"from":50,"to":50,"text":"كأنهم في إعراضهم ونفورهم منه حُمُر وَحْش شديدة النفور."},{"ayah":51,"from":51,"to":51,"text":"نفرت من أسد خوفًا منه."},{"ayah":52,"from":52,"to":52,"text":"بل يريد كل واحد من هؤلاء المشركين أن يصبح عند رأسه كتاب منشور يخبره أن محمدًا رسول من الله، وليس سبب ذلك قلة البراهين أو ضعف الحجج، وإنما هو العناد والاستكبار."},{"ayah":53,"from":53,"to":53,"text":"ليس الأمر كذلك، بل السبب في تماديهم في ضلالهم أنهم لا يؤمنون بعذاب الآخرة، فبقوا على كفرهم."},{"ayah":54,"from":54,"to":54,"text":"ألا إن هذا القرآن موعظة وتذكير."},{"ayah":55,"from":55,"to":55,"text":"فمن شاء أن يقرأ القرآن ويتعظ به قرأه واتعظ به."},{"ayah":56,"from":56,"to":56,"text":"وما يتعظون إلا أن يشاء الله أن يتعظوا، هو سبحانه أهل لأن يُتَّقَى بامتثال أوامره واجتناب نواهيه، وأهل لأن يغفر ذنوب عباده إذا تابوا إليه."}]}