ر قرأ بصلة هاء الضمير خلافا لجمهور القراء. باقي الرواة قرؤوا بترك الصلة مع قصر الهاء.\n\nوَلَكِنَّ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nأَكْثَرَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nالنَّاسِ: الدوري عن أبي عمرو قرأ بالإمالة بلا خلاف عنه. باقي الرواة قرؤوا بالفتح بلا خلاف عنه.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nلَا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nيَعْلَمُونَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع","words":[{"wordId":64549,"position":1,"word":"قُلِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":64550,"position":2,"word":"اللَّهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":64551,"position":3,"word":"يُحْيِيكُمْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع."},{"wordId":64552,"position":4,"word":"ثُمَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":64553,"position":5,"word":"يُمِيتُكُمْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. باقي الرواة قرؤوا بترك صلة ميم الجمع."},{"wordId":64554,"position":6,"word":"ثُمَّ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":64555,"position":7,"word":"يَجْمَعُكُمْ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nقالون عن نافع قرأ بصلة ميم الجمع وصلاً بخلف عنه. ورش عن نافع قرأ بصلة ميم الجمع وصلاً مع الإشباع. أبو جعفر وَابن كثير قرأ بصلة ميم الجمع وصلا. خلف عن حمزة قرأ بالسكت وعدمه وصلاً ووقفا. باقي الرواة قرؤوا بترك السكت، وإسكان ميم الجمع وصلاً ووقفا."},{"wordId":64556,"pos