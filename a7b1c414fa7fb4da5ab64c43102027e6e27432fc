{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":91,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم الله بالشمس، وأقسم بوقت ارتفاعها بعد طلوعها من مشرقها."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالقمر إذا تبع أثرها بعد غروبها."},{"ayah":3,"from":3,"to":3,"text":"وأقسم بالنهار إذا كشف ما على وجه الأرض بضوئه."},{"ayah":4,"from":4,"to":4,"text":"وأقسم بالليل إذا يغشى وجه الأرض، فيصير مظلمًا."},{"ayah":5,"from":5,"to":5,"text":"وأقسم بالسماء، وأقسم ببنائها المتقن."},{"ayah":6,"from":6,"to":6,"text":"وأقسم بالأرض، وأقسم ببسطها؛ ليسكن الناس عليها."},{"ayah":7,"from":7,"to":7,"text":"وأقسم بكل نفس، وأقسم بخلق الله لها سوية."},{"ayah":8,"from":8,"to":8,"text":"فأفهمها من غير تعليم ما هو شرّ لتجتنبه، وما هو خير لتأتيه."},{"ayah":9,"from":9,"to":9,"text":"قد فاز بمطلوبه من طهّر نفسه بتحليتها بالفضائل، وتخليتها عن الرذائل."},{"ayah":10,"from":10,"to":10,"text":"وقد خسر من دَسَّ نفسه مخفيًا إياها في المعاصي والآثام."},{"ayah":11,"from":11,"to":11,"text":"كذبت ثمود نبيها صالحًا بسبب مجاوزتها الحدّ في ارتكاب المعاصي، واقتراف الآثام."},{"ayah":12,"from":12,"to":12,"text":"حين قام أشقاهم بعد انتداب قومه له."},{"ayah":13,"from":13,"to":13,"text":"فقال لهم رسول الله صالح عليه السلام: اتركوا ناقة الله، وشِرْبها في يومها، فلا تتعرضوا لها بسوء."},{"ayah":14,"from":14,"to":14,"text":"فكذبوا رسولهم في شأن الناقة، فقتلها أشقاهم مع رضاهم بما فعل، فكانوا شركاء في الإثم، فأطبق الله عليهم عذابه، فأهلكهم بالصيحة بسبب ذنوبهم، وسوّاهم في العقوبة التي أهلكهم بها."},{"ayah":15,"from":15,"to":15,"text":"فعل الله بهم من العذاب ما أهلكهم غير خائف سبحانه من تبعاته."}]}