ْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: النُّونِ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (نَفْعِلُ) ، مِنْ مَادَّةِ: (حمل) .\n\nخَطَايَاكُمْ: {خَطَايَا} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (خَطِيئَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْيَاءِ، مَقْصُورٌ، أَصْلُهُ: (خَطَائِئُ) ، عَلَى وَزْنِ: (فَعَائِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ يَاءً لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ وَالْيَاءِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (خطأ) .\n\nوَمَا: {مَا} : حَرْفٌ مَبْنِيٌّ.\n\nهُمْ: {هُمْ} : اسْمٌ مَبْنِيٌّ.\n\nبِحَامِلِينَ: {حَامِلِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (حَامِلٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (حَمَلَ يَحْمِلُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (حمل) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nخَطَايَاهُمْ: {خَطَايَا} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (خَطِيئَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْيَاءِ، مَقْصُورٌ، أَصْلُهُ: (خَطَائِئُ) ، عَلَى وَزْنِ: (فَعَائِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْهَمْزَةِ يَاءً لِاجْتِمَاعِ هَمْزَتَيْنِ مُتَحَرِّكَةٍ وَسَاكِنَةٍ وَالْيَاءِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (خطأ) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nشَيْءٍ: {شَيْءٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (شيأ) .\n\nإِنَّهُمْ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nلَكَاذِبُونَ: {كَاذِبُونَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (كَاذِبٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (كَذَبَ يَكْذِبُ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (