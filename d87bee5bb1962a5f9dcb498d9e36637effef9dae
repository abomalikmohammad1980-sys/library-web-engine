ْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nجَوَابَ: {جَوَابَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (جوب) .\n\nقَوْمِهِ: {قَوْمِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nإِلَّا: {إِلَّا} : حَرْفٌ مَبْنِيٌّ.\n\nأَنْ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nقَالُوا: {قَالُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (قول) .\n\nاقْتُلُوهُ: {اقْتُلُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (افْعُلْ) ، مِنْ مَادَّةِ: (قتل) .\n\nأَوْ: {أَوْ} : حَرْفٌ مَبْنِيٌّ.\n\nحَرِّقُوهُ: {حَرِّقُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (فَعِّلْ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (حرق) .\n\nفَأَنْجَاهُ: {أَنْجَى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْهَمْزَةِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (أَنْجَوَ) ، عَلَى وَزْنِ: (أَفْعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (نجو) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nمِنَ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nالنَّارِ: {النَّارِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (نور) .\n\nإِنَّ: {إِنَّ} : حَرْفٌ مَبْنِيٌّ.\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nذَلِكَ: {ذَلِكَ} : اسْمٌ مَبْنِيٌّ.\n\nلَآيَاتٍ: {آيَاتٍ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (آيَةٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، أَصْلُهُ: (أَيَيٌ) ، عَلَى وَزْنِ: (فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (أيي) .\n\nلِقَوْمٍ: {قَوْمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) .\n\nيُؤْمِنُونَ: {يُؤْمِنُونَ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (أَفْعَلَ) ، أَصْلُهُ: (يُؤَأْمِنُ) ، عَلَى وَزْنِ: (يُؤَفْعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، مِنْ مَادَّةِ: (أمن) .","words":[{"wordId":51327,"position":1,"word":"فَمَا","text":"{مَا} : حَرْفٌ مَبْنِيٌّ."},{"wordId":51328,"position":2,"word":"كَانَ","text":"{كَانَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) ."},{"wordId":51329,"position":3,"word":"جَوَابَ","text":"{جَوَابَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (جوب) ."},{"wordId":51330,"position":4,"word":"قَوْمِهِ","text":"{قَوْمِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قوم) ."},{"wordId":51331,"position":5,"word":"إِلَّا","text":"{إِلَّا} : حَرْفٌ مَبْنِيٌّ."},{"wordId":51332,"position":6,"word":"أَنْ","text":"{أَنْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":51333,"position":7,"word":"قَالُوا","text":"{قَالُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (قَوَلَ) ، عَلَى وَزْنِ: (فَعَلَ) 