{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":75,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم الله بيوم القيامة يوم يقوم الناس لرب العالمين."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالنفس الطيبة التي تلوم صاحبها على التقصير في الأعمال الصالحة، وعلى فعل السيئات، أقسم بهذين الأمرين ليبعثنّ الناس للحساب والجزاء."},{"ayah":3,"from":3,"to":3,"text":"أيظنّ الإنسان أن لن نجمع عظامه بعد موته للبعث؟!"},{"ayah":4,"from":4,"to":4,"text":"بلى، نقدر مع جمعها على إعادة أطراف أصابعه خلْقًا سويًّا كما كانت."},{"ayah":5,"from":5,"to":5,"text":"بل يريد الإنسان بإنكاره البعث أن يستمرّ على فجوره مستقبلًا دون رادع."},{"ayah":6,"from":6,"to":6,"text":"يسأل على وجه الاستبعاد عن يوم القيامة: متى يقع؟"},{"ayah":7,"from":7,"to":7,"text":"فإذا تحيّر البصر واندهش حين يرى ما كان يكذّب به."},{"ayah":8,"from":8,"to":8,"text":"وذهب ضوء القمر."},{"ayah":9,"from":9,"to":9,"text":"وجمع جرم الشمس والقمر."},{"ayah":10,"from":10,"to":10,"text":"يقول الإنسان الفاجر في ذلك اليوم: أين الفرار؟!"},{"ayah":11,"from":11,"to":11,"text":"لا فرار في ذلك اليوم، ولا مَلْجأ يلجأ إليه الفاجر، ولا مُعْتَصَم يعتصم به."},{"ayah":12,"from":12,"to":12,"text":"إلى ربك - أيها الرسول - في ذلك اليوم المرجع والمصير للحساب والجزاء"},{"ayah":13,"from":13,"to":13,"text":"يخبر الإنسان في ذلك اليوم بما قدّم من أعماله، وبما أخّر منها."},{"ayah":14,"from":14,"to":14,"text":"بل الإنسان شاهد على نفسه حيث تشهد عليه جوارحه بما اكتسبه من إثم."},{"ayah":15,"from":15,"to":15,"text":"ولو جاء بأعذار يجادل بها عن نفسه أنه ما عمل سوءًا لم تنفعه."},{"ayah":16,"from":16,"to":16,"text":"لا تحرِّك - أيها الرسول - لسانك بالقرآن مُتَعَجِّلًا أن ينفلت منك."},{"ayah":17,"from":17,"to":17,"text":"إن علينا أن نجمعه لك في صدرك، وإثبات قراءته على لسانك."},{"ayah":18,"from":18,"to":18,"text":"فإذا أتمّ جبريل قراءته عليك فأنصت إلى قراءته واستمع."},{"ayah":19,"from":19,"to":19,"text":"ثم إن علينا تفسيره لك."},{"ayah":20,"from":20,"to":20,"text":"كلّا، ليس الأمر كما ادعيتم من استحالة البعث، فأنتم تعلمون أن القادر على خلقكم ابتداءً لا يعجز عن إحيائكم بعد موتكم، لكن سبب تكذيبكم بالبعث هو حبكم للحياة الدنيا سريعة الانقضاء."},{"ayah":21,"from":21,"to":21,"text":"وترككم للحياة الآخرة التي طريقها القيام بما أمركم الله به من الطاعات، وترك ما نهاكم عنه من المحرمات."},{"ayah":22,"from":22,"to":22,"text":"وجوه أهل الإيمان والسعادة في ذلك اليوم بَهِيَّة لها نور."},{"ayah":23,"from":23,"to":23,"text":"ناظرة إلى ربها متمتِّعة بذلك."},{"ayah":24,"from":24,"to":24,"text":"ووجوه أهل الكفر والشقاء في ذلك اليوم عابسة."},{"ayah":25,"from":25,"to":25,"text":"توقن أن ينزل بها عقاب عظيم، وعذاب أليم."},{"ayah":26,"from":26,"to":26,"text":"ليس الأمر كما يتصور المشركون من أنهم إذا ماتوا لا يُعَذَّبون، فإذا وصلت نفس أحدهم أعالي صدره."},{"ayah":27,"from":27,"to":27,"text":"وقال بعض الناس لبعض: من يَرْقِي هذا لعله يُشْفَى؟!"},{"ayah":28,"from":28,"to":28,"text":"وأيقن من في النَّزْع حينئذ أنه فراق الدنيا بالموت."},{"ayah":29,"from":29,"to":29,"text":"واجتمعت الشدائد عند نهاية الدنيا وبداية الآخرة."},{"ayah":30,"from":30,"to":30,"text":"إذا حصل ذلك يُساق الميت إلى ربه."},{"ayah":31,"from":31,"to":31,"text":"فلا صَدَّق الكافر بما جاء به رسوله، ولا صلى لله سبحانه."},{"ayah":32,"from":32,"to":32,"text":"ولكن كذب بما جاءه به رسوله، وأعرض عنه."},{"ayah":33,"from":33,"to":33,"text":"ثم ذهب هذا الكافر إلى أهله يختال في مشيته من الكبر."},{"ayah":34,"from":34,"to":34,"text":"فتوعد الله الكافر بأن عذابه قد وليه وقرب منه."},{"ayah":35,"from":35,"to":35,"text":"ثم أعاد الجملة على سبيل التأكيد، فقال: ﴿ثُمَّ أَوْلَى لَكَ فَأَوْلَى﴾."},{"ayah":36,"from":36,"to":36,"text":"أيظنّ الإنسان أن الله تاركه مُهْمَلًا دون أن يكلفه بشرع؟"},{"ayah":37,"from":37,"to":37,"text":"ألم يكن هذا الإنسان يومًا نُطْفة من مني يُصَبّ في الرحم."},{"ayah":38,"from":38,"to":38,"text":"ثم كان بعد ذلك قطعة من دم جامد، ثم خلقه الله، وجعل خلقه سويًّا."},{"ayah":39,"from":39,"to":39,"text":"فجعل من جنسه النوعين: الذكر والأنثى؟!"},{"ayah":40,"from":40,"to":40,"text":"أليس الذي خلق الإنسان من نُطْفة فَعَلَقَة بقادر على إحياء الموتى للحساب والجزاء من جديد؟! بلى، إنه لقادر."}]}