{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":84,"records":[{"ayah":1,"from":1,"to":1,"text":"إذا السماء تَصَدَّعت لنزول الملائكة منها."},{"ayah":2,"from":2,"to":2,"text":"واستمعت لربها منقادة، وحُقَّ لها ذلك."},{"ayah":3,"from":3,"to":3,"text":"وإذا الأرض مدّها الله كما يمدّ الأديم."},{"ayah":4,"from":4,"to":4,"text":"وألقت ما فيها من الكنوز والأموات، وتخلّت عنهم."},{"ayah":5,"from":5,"to":5,"text":"واستمعت لربها منقادة، وحُقَّ لها ذلك."},{"ayah":6,"from":6,"to":6,"text":"يا أيها الإنسان، إنك عامل إما خيرًا وإما شرًّا، فملاقيه يوم القيامة؛ ليجازيك الله عليه."},{"ayah":7,"from":7,"to":7,"text":"فأما من أُعْطِي صحيفة أعماله بيده اليمنى."},{"ayah":8,"from":8,"to":8,"text":"فسوف يحاسبه الله حسابًا سهلًا يعرض عليه عمله دون مؤاخذة به."},{"ayah":9,"from":9,"to":9,"text":"ويرجع إلى أهله مسرورًا."},{"ayah":10,"from":10,"to":10,"text":"وأما من أُعْطِي كتابه بشماله من وراء ظهره."},{"ayah":11,"from":11,"to":11,"text":"فسينادي بالهلاك على نفسه."},{"ayah":12,"from":12,"to":12,"text":"ويدخل نار جهنم يقاسي حرّها."},{"ayah":13,"from":13,"to":13,"text":"إنه كان في الدنيا في أهله فرحًا بما هو عليه من الكفر والمعاصي."},{"ayah":14,"from":14,"to":14,"text":"إنه ظنّ أنه لن يرجع إلى الحياة بعد موته."},{"ayah":15,"from":15,"to":15,"text":"بلى، ليرجعنَّه الله إلى الحياة كما خلقه أول مرة، إن ربه كان بحاله بصيرًا لا يخفى عليه منه شيء، وسيجازيه على عمله."},{"ayah":16,"from":16,"to":16,"text":"أقسم الله بالحُمْرة التي تكون في الأفق بعد غروب الشمس."},{"ayah":17,"from":17,"to":17,"text":"وأقسم بالليل وما جُمِع فيه."},{"ayah":18,"from":18,"to":18,"text":"والقمر إذا اجتمع وتمّ وصار بدرًا."},{"ayah":19,"from":19,"to":19,"text":"لتركبّن - أيها الناس - حالًا بعد حال من نُطْفة فَعَلَقة فَمُضْغة، فحياة فموت فبعث."},{"ayah":20,"from":20,"to":20,"text":"فما لهؤلاء الكفار لا يؤمنون بالله، واليوم الآخر؟!"},{"ayah":21,"from":21,"to":21,"text":"وإذا قُرِئ عليهم القرآن لا يسجدون لربّهم؟!"},{"ayah":22,"from":22,"to":22,"text":"بل الذين كفروا يكذبون بما جاءهم به رسولهم."},{"ayah":23,"from":23,"to":23,"text":"والله أعلم بما تحويه صدورهم، لا يخفى عليه من أعمالهم شيء."},{"ayah":24,"from":24,"to":24,"text":"فأخْبِرْهم - أيها الرسول - بما ينتظرهم من عذاب موجع."},{"ayah":25,"from":25,"to":25,"text":"إلا الذين آمنوا بالله، وعملوا الأعمال الصالحات، لهم ثواب غير مقطوع؛ وهو الجنة."}]}