export function translateUiLabel(source: string, language: string): string | undefined {
  const exact = UI_TRANSLATIONS[language]?.[source]
  if (exact) return exact
  if (language === 'en') {
    const progress = source.match(/^أكمل قراءتك — فقد وصلتَ إلى ص\s*([0-9٠-٩]+)$/u)
    if (progress) return `Continue reading — you reached page ${progress[1]}`
    const bookCount = source.match(/^([0-9٠-٩]+)\s+كتابًا?$/u)
    if (bookCount) return `${bookCount[1]} books`
    const opened = source.match(/^فُتح\s+([0-9٠-٩]+)\s+مرة$/u)
    if (opened) return `Opened ${opened[1]} times`
  }
  if (language === 'fr') {
    const progress = source.match(/^أكمل قراءتك — فقد وصلتَ إلى ص\s*([0-9٠-٩]+)$/u)
    if (progress) return `Reprendre la lecture — page ${progress[1]}`
    const bookCount = source.match(/^([0-9٠-٩]+)\s+كتابًا?$/u)
    if (bookCount) return `${bookCount[1]} livres`
    const opened = source.match(/^فُتح\s+([0-9٠-٩]+)\s+مرة$/u)
    if (opened) return `Ouvert ${opened[1]} fois`
  }
  return undefined
}
