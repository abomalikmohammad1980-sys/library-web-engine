/* مفتاح الرسم داخل بطاقة الآية: يجب أن يبقى زرًا بصريًا واضحًا، لا رابطًا نصيًا. */
.quran-selected > .quran-reading-modes--compact {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(2, minmax(92px, 1fr));
  gap: 9px;
  width: min(100%, 286px);
  margin: 16px auto 0;
  padding: 8px;
  border: 3px solid color-mix(in srgb, #b88721 72%, var(--brand-primary));
  border-radius: 18px;
  background: linear-gradient(145deg, color-mix(in srgb, #d6ae52 18%, var(--paper-surface)), var(--paper-surface));
  box-shadow: 0 10px 24px color-mix(in srgb, var(--brand-primary) 17%, transparent), inset 0 0 0 2px color-mix(in srgb, #fff 58%, transparent);
}
.quran-selected > .quran-reading-modes--compact > .quran-reading-mode {
  box-sizing: border-box;
  display: grid;
  place-items: center;
  min-width: 0;
  min-height: 50px;
  padding: 10px 15px;
  border: 2px solid color-mix(in srgb, var(--brand-primary) 45%, var(--border-default));
  border-radius: 12px;
  color: var(--brand-primary-dark);
  background: var(--paper-surface);
  box-shadow: 0 4px 12px color-mix(in srgb, var(--brand-primary) 12%, transparent);
  font: 900 1rem/1 var(--font-ui);
}
.quran-selected > .quran-reading-modes--compact > .quran-reading-mode.is-active {
  color: #fff;
  border-color: #d6ae52;
  background: linear-gradient(145deg, var(--brand-primary), color-mix(in srgb, var(--brand-primary-dark) 76%, #052b22));
  box-shadow: 0 8px 18px color-mix(in srgb, var(--brand-primary) 30%, transparent), inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
}
.library-tafsir-books {
  margin-block: 1.5rem;
  padding: clamp(1rem, 2vw, 1.6rem);
  border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, var(--surface) 94%, var(--accent) 6%);
}
.library-tafsir-books__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.library-tafsir-book { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .75rem; align-items: center; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
.library-tafsir-book__mark { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; border-radius: 50%; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
.library-tafsir-book h3 { margin: .3rem 0 .15rem; }
.library-tafsir-book p { margin: 0; color: var(--muted); }
.library-tafsir-book .btn { grid-column: 1 / -1; justify-self: stretch; text-align: center; }
@media (max-width: 760px) { .library-tafsir-books__grid { grid-template-columns: 1fr; } }
.sunnah-hero { position: relative; isolation: isolate; overflow: hidden; width: min(100%, 980px); box-sizing: border-box; margin-inline: auto; display: grid; justify-items: center; gap: 8px; padding: 20px clamp(18px, 4vw, 42px) 22px; border: 1px solid var(--border-default); border-radius: 24px; background: linear-gradient(145deg, color-mix(in srgb, var(--brand-primary-soft) 74%, var(--paper-surface)), var(--paper-surface)); text-align: center; }
.sunnah-hero__mark { position: absolute; z-index: -1; pointer-events: none; user-select: none; object-fit: contain; }
.sunnah-hero__mark--muhammad { inset-inline-end: clamp(14px, 3.6vw, 40px); inset-block-start: clamp(14px, 2.5vw, 24px); width: clamp(72px, 9vw, 104px); max-height: 34%; opacity: .2; }
[data-app-theme='dark'] .sunnah-hero__mark--muhammad { filter: brightness(1.8) saturate(.82); opacity: .48; }
.sunnah-hero__mark--prophethood { inset-inline-start: clamp(16px, 4vw, 44px); inset-block-start: clamp(14px, 2.5vw, 24px); width: clamp(52px, 6.8vw, 76px); aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border: 1px solid color-mix(in srgb, var(--ink-primary) 14%, transparent); border-radius: 50%; background: #fff; box-shadow: 0 7px 22px color-mix(in srgb, var(--ink-primary) 9%, transparent); opacity: .72; }
.sunnah-hero__mark--prophethood img { width: 88%; height: 88%; object-fit: contain; filter: invert(1) contrast(1.28); }
.sunnah-hero .page-title { margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.65rem); }
.sunnah-hero .page-sub { margin: 0; }
.sunnah-search { position: relative; z-index: 1; width: min(760px, 100%); display: grid; gap: 8px; margin-block-start: 4px; padding: 8px; border: 1px solid color-mix(in srgb, var(--brand-primary) 42%, var(--border-default)); border-radius: 20px; background: var(--paper-surface); box-shadow: var(--shadow-soft); }
.sunnah-search__input { min-height: 52px; padding-inline: 18px; border: 0; border-radius: 14px; background: var(--paper-surface-alt); color: var(--ink-strong); font: inherit; font-size: var(--step-body-lg); }
.sunnah-search__meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-inline: 4px; }
.sunnah-search__category { min-width: min(260px, 48%); min-height: 40px; padding-inline: 10px; border: 1px solid var(--border-default); border-radius: 12px; background: var(--paper-surface); color: var(--ink-strong); font: inherit; }
.sunnah-search__count { padding-inline: 10px; color: var(--ink-muted); font-size: var(--step-caption); text-align: start; }
.sunnah-corpus-search { width: min(100%, 980px); margin: var(--space-6) auto 0; padding: clamp(18px, 3vw, 28px); border: 1px solid color-mix(in srgb, var(--brand-gold) 54%, var(--border-default)); border-radius: 22px; background: var(--paper-surface); box-shadow: var(--shadow-soft); }
.sunnah-corpus-search__head { display: flex; align-items: end; justify-content: space-between; gap: 14px; }
.sunnah-corpus-search__head h2 { margin: 0; }
.sunnah-corpus-search__head a { color: var(--brand-primary); font-weight: 800; }
.sunnah-corpus-search__controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-block: 18px; }
.sunnah-corpus-search__input { min-height: 52px; padding-inline: 18px; border: 1px solid var(--border-default); border-radius: 14px; background: var(--paper-surface-alt); color: var(--ink-strong); font: inherit; font-size: var(--step-body-lg); }
.sunnah-corpus-search__input:focus-visible { outline: 3px solid color-mix(in srgb, var(--brand-primary) 30%, transparent); border-color: var(--brand-primary); }
.sunnah-corpus-search__count { color: var(--ink-muted); font-size: var(--step-caption); }
.sunnah-corpus-results { display: grid; gap: 12px; }
.sunnah-corpus-result { display: grid; gap: 8px; padding: 18px; border: 1px solid var(--border-default); border-radius: 16px; background: var(--paper-surface-alt); }
.sunnah-corpus-result h3, .sunnah-corpus-result p { margin: 0; }
.sunnah-corpus-result__text { color: var(--ink-strong); font-size: var(--step-body-lg); line-height: 1.95; }
.sunnah-corpus-result__meta { color: var(--ink-secondary); line-height: 1.8; }
.sunnah-corpus-result > a { width: fit-content; color: var(--brand-primary); font-weight: 800; }
.sunnah-library { display: grid; gap: var(--space-4); margin-block: var(--space-8); }
.sunnah-library__head { display: flex; align-items: end; justify-content: space-between; gap: var(--space-3); }
.sunnah-library__head h2 { margin: 0; }
.sunnah-results { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
.sunnah-book-result { min-width: 0; display: grid; gap: 7px; padding: 18px; border: 1px solid var(--border-default); border-radius: 18px; background: var(--paper-surface); color: var(--ink-strong); text-decoration: none; box-shadow: var(--shadow-soft); }
.sunnah-book-result:hover { border-color: var(--brand-primary); transform: translateY(-2px); }
.sunnah-book-result__title { color: var(--ink-strong); font-family: var(--font-serif-display); font-size: var(--step-body-lg); font-weight: 800; text-decoration: none; }
.sunnah-book-result__author { color: var(--brand-primary); font-weight: 700; }
.sunnah-book-result__author a, .sunnah-book-result__category { color: inherit; text-decoration: none; }
.sunnah-book-result__category { width: fit-content; color: var(--ink-muted); font-size: var(--step-caption); }
.sunnah-book-result__read { width: fit-content; margin-block-start: 4px; color: var(--brand-primary); font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
.sunnah-book-result a:focus-visible { outline: 3px solid var(--brand-selection); outline-offset: 3px; border-radius: 5px; }
.sunnah-roadmap-note { margin-block: var(--space-5) var(--space-8); padding: 18px 20px; border-inline-start: 4px solid var(--brand-gold); border-radius: 16px; background: var(--paper-surface-alt); color: var(--ink-secondary); }
.sunnah-roadmap-note p { margin: 6px 0 0; }
@media (max-width: 820px) { .sunnah-results { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 540px) { .sunnah-results { grid-template-columns: 1fr; } .sunnah-library__head, .sunnah-corpus-search__head { align-items: stretch; flex-direction: column; } .sunnah-search__meta { align-items: stretch; flex-direction: column; } .sunnah-search__category { width: 100%; min-width: 0; } .sunnah-corpus-search__controls { grid-template-columns: 1fr; } .sunnah-hero { padding: 16px 12px 18px; } .sunnah-hero__mark--muhammad { inset-inline-end: 8px; inset-block-start: 8px; width: 54px; opacity: .13; } .sunnah-hero__mark--prophethood { inset-inline-start: 9px; inset-block-start: 9px; width: 42px; opacity: .54; } }
@media (max-width: 540px) { [data-app-theme='dark'] .sunnah-hero__mark--muhammad { width: 48px; opacity: .26; } }
.quran-copy-overlay__word.is-search-target,
.quran-selectable-ayah.is-search-target {
  background: color-mix(in srgb, var(--read-accent, #b8841d) 26%, transparent);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--read-accent, #b8841d) 55%, transparent);
  border-radius: .35rem;
}
.sunnah-source {
  width: min(920px, calc(100% - 32px));
  margin-inline: auto;
  padding: clamp(24px, 4vw, 48px);
  border: 1px solid var(--line);
  border-radius: 28px;
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.sunnah-source__status { margin-block: 24px; }
.sunnah-source__facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
}
.sunnah-source__facts > div {
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface-strong);
}
.sunnah-source__facts dt { color: var(--muted); font-size: .86rem; }
.sunnah-source__facts dd { margin: 5px 0 0; font-weight: 700; }
.sunnah-source__attribution { line-height: 1.9; }
.sunnah-source__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-block: 18px; }

@media (max-width: 560px) {
  .sunnah-source { width: calc(100% - 20px); padding: 20px 16px; }
  .sunnah-source__facts { grid-template-columns: 1fr; }
}
