/* أنماط شاشات محددة: الرئيسية، تصفح، عناوين الصفحات */

.page-eyebrow {
  font-size: var(--step-caption);
  font-weight: 600;
  color: var(--brand-primary);
  letter-spacing: 0.02em;
}

.page-title {
  margin-block: var(--space-1) var(--space-2);
}

.page-sub {
  color: var(--text-muted);
  font-size: var(--step-body-lg);
  max-width: 560px;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/* الرئيسية — لوحة اليوم (المرحلة السابعة، الجلسة ١) */
.home-page {
  position: relative;
  isolation: isolate;
  overflow-x: clip;
}

.home-page::before {
  content: '';
  position: absolute;
  z-index: -2;
  inset: calc(var(--space-8) * -1) calc(var(--page-pad) * -1) calc(var(--space-14) * -1);
  pointer-events: none;
  background:
    radial-gradient(circle at 9% 5%, rgba(175, 121, 38, .17), transparent 24%),
    radial-gradient(circle at 91% 13%, rgba(25, 104, 76, .18), transparent 27%),
    radial-gradient(circle at 75% 57%, rgba(191, 145, 67, .1), transparent 28%),
    linear-gradient(145deg, #f5f0e5 0%, #eee9dd 47%, #f6f2e8 100%);
}

.home-page::after {
  content: '';
  position: absolute;
  z-index: -1;
  inset: calc(var(--space-8) * -1) calc(var(--page-pad) * -1) calc(var(--space-14) * -1);
  pointer-events: none;
  opacity: .36;
  background-image:
    repeating-linear-gradient(45deg, transparent 0 31px, rgba(31, 91, 69, .055) 31px 32px, transparent 32px 63px),
    repeating-linear-gradient(-45deg, transparent 0 31px, rgba(155, 105, 34, .05) 31px 32px, transparent 32px 63px);
  background-size: 64px 64px;
  -webkit-mask-image: linear-gradient(to bottom, #000 0 36%, transparent 83%);
  mask-image: linear-gradient(to bottom, #000 0 36%, transparent 83%);
}

.home-page > * { position: relative; z-index: 1; }

.home-page .section-header h2 {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
}

.home-page .section-header h2::after {
  content: '';
  width: 46px;
  height: 8px;
  background: linear-gradient(90deg, rgba(172, 116, 35, .75), rgba(47, 111, 84, .25));
  clip-path: polygon(0 50%, 15% 0, 30% 50%, 45% 0, 60% 50%, 75% 0, 90% 50%, 100% 50%, 90% 100%, 75% 50%, 60% 100%, 45% 50%, 30% 100%, 15% 50%);
}

.home-hero {
  position: relative;
  isolation: isolate;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  min-height: 470px;
  overflow: hidden;
  margin-inline: calc(var(--page-pad) * -1);
  padding: var(--space-6) clamp(var(--space-4), 6vw, var(--space-10)) var(--space-8);
  border: 0;
  border-radius: 0;
  background: linear-gradient(180deg, #f9f5e9 0%, #e7ecdf 61%, #d8e2d2 100%);
  box-shadow: none;
}

.home-hero::before {
  content: '';
  position: absolute;
  z-index: -2;
  inset: 0;
  background:
    radial-gradient(circle at 18% 17%, rgba(193, 143, 57, .22), transparent 16%),
    radial-gradient(circle at 85% 9%, rgba(47, 111, 84, .2), transparent 24%),
    linear-gradient(135deg, rgba(255,255,255,.72), transparent 48%);
}

.home-hero::after {
  content: '◆  ❖  ◆';
  position: absolute;
  inset-block-start: 4px;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(159, 105, 30, .48);
  font-size: 12px;
  letter-spacing: .75em;
  white-space: nowrap;
}

.home-hero__landscape { position: absolute; z-index: -1; inset: 0; pointer-events: none; opacity: .56; }
.home-hero__landscape::before,
.home-hero__landscape::after,
.home-hero__landscape span { content: ''; position: absolute; inset-inline: -3%; inset-block-end: 0; transform-origin: bottom; }
.home-hero__landscape::before { height: 60%; background: #b4c5ad; clip-path: polygon(0 72%, 9% 54%, 17% 68%, 29% 31%, 39% 63%, 52% 20%, 64% 66%, 76% 38%, 87% 64%, 100% 35%, 100% 100%, 0 100%); }
.home-hero__landscape::after { height: 47%; background: #829c84; clip-path: polygon(0 63%, 12% 36%, 23% 68%, 34% 45%, 45% 72%, 57% 29%, 69% 61%, 81% 40%, 91% 67%, 100% 48%, 100% 100%, 0 100%); }
.home-hero__landscape span:first-child { height: 34%; background: #55765f; clip-path: polygon(0 70%, 10% 42%, 21% 73%, 32% 49%, 46% 81%, 58% 40%, 70% 76%, 82% 51%, 92% 72%, 100% 56%, 100% 100%, 0 100%); }
.home-hero__landscape span:last-child { height: 19%; background: linear-gradient(180deg, #41654f, #294c3a); clip-path: polygon(0 76%, 13% 43%, 25% 71%, 38% 48%, 50% 76%, 63% 46%, 74% 70%, 88% 39%, 100% 66%, 100% 100%, 0 100%); }

.home-hero__brand {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 78px;
  padding: 8px 18px;
  border: 1px solid rgba(47, 111, 84, .18);
  border-radius: 24px;
  background: #fbf8ef;
  color: var(--brand-primary-dark);
  box-shadow: 0 12px 32px rgba(53, 73, 57, .1), inset 0 1px rgba(255,255,255,.85);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  font-family: var(--font-serif-display);
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 800;
}

.home-hero__logo { width: 58px; height: 62px; }

.home-hero__wisdom { display: grid; justify-items: center; gap: 1px; }
.home-hero__ayah { color: var(--brand-primary-dark); font-family: var(--font-quran); font-size: clamp(22px, 3vw, 30px); line-height: 1.55; text-shadow: 0 1px rgba(255,255,255,.85); }
.home-hero__hadith { color: var(--ink-body-2); font-size: var(--step-caption); font-weight: 600; }

.home-hero h1 {
  font-size: clamp(34px, 5.3vw, 56px);
  color: var(--ink-strong);
  text-wrap: balance;
  text-shadow: 0 2px 0 rgba(255, 255, 255, .65), 0 10px 30px rgba(37, 72, 54, .1);
}

.home-hero__title-brand {
  color: var(--brand-primary-dark);
  text-shadow: 0 2px rgba(255,255,255,.75), 0 7px 24px rgba(47,111,84,.19);
  -webkit-text-decoration: underline rgba(174, 119, 35, .45) 3px;
  text-decoration: underline rgba(174, 119, 35, .45) 3px;
  text-underline-offset: .16em;
}

.home-hero__sub {
  color: var(--text-muted);
  font-size: var(--step-body-lg);
  max-width: 790px;
  text-wrap: balance;
  padding: 8px 14px;
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, #fbf8ef 88%, transparent);
}

.home-search {
  min-height: 52px;
  width: min(100%, 600px);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-block-start: var(--space-3);
  padding-inline: var(--space-5);
  border: 1px solid rgba(140, 99, 41, .28);
  border-radius: var(--radius-full);
  background: rgba(255, 253, 248, .9);
  color: var(--text-muted);
  box-shadow: 0 14px 36px rgba(54, 67, 53, .1), inset 0 1px rgba(255, 255, 255, .9);
  backdrop-filter: blur(14px);
  text-align: start;
  position: relative;
}

.home-search:hover {
  border-color: var(--brand-primary);
  color: var(--ink-strong);
}

.home-search:focus-within {
  border-color: var(--brand-primary);
  box-shadow: 0 0 0 3px var(--brand-selection), var(--shadow-sm);
}

.home-search input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text-body);
  font-size: var(--step-body);
}

.home-recent,
.daily-section,
.home-section {
  margin-block-end: var(--space-10);
}

.home-recent__loading,
.home-state,
.continue-card {
  min-height: 170px;
  border: 1px solid var(--border-default);
  border-radius: var(--radius-xl);
  background: var(--paper-surface);
}

.home-recent__loading {
  display: grid;
  place-items: center;
  color: var(--text-muted);
}

.continue-card {
  display: grid;
  grid-template-columns: 116px minmax(0, 1fr);
  align-items: center;
  gap: var(--space-6);
  padding: var(--space-6);
  border-color: rgba(47, 111, 84, .23);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, .96), rgba(232, 242, 235, .9)),
    repeating-linear-gradient(45deg, transparent 0 18px, rgba(47, 111, 84, .04) 18px 19px);
  color: var(--ink-strong);
  overflow: hidden;
  box-shadow: 0 18px 42px rgba(42, 78, 59, .13), inset 0 1px rgba(255, 255, 255, .9);
}

.continue-card__mark {
  height: 128px;
  border-radius: var(--radius-lg);
  display: grid;
  place-items: center;
  border: 1px solid rgba(225, 190, 118, .38);
  background:
    radial-gradient(circle, rgba(255, 255, 255, .13) 0 2px, transparent 3px) 0 0 / 16px 16px,
    linear-gradient(145deg, #28694f, #174433);
  color: var(--paper-surface);
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast), box-shadow var(--motion-fast);
}

.continue-card__mark:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 34px rgba(23, 68, 51, .22);
}

.continue-card__mark:focus-visible {
  outline: 3px solid var(--focus-ring);
  outline-offset: 3px;
}

.continue-card__copy h2 {
  margin-block: var(--space-1);
  color: var(--ink-strong);
  font-family: var(--font-serif-display);
  font-size: clamp(24px, 2.35vw, 34px);
  font-weight: 800;
  line-height: 1.25;
}

.continue-card__author {
  display: inline-block;
  margin-block-end: var(--space-2);
  color: var(--brand-primary-dark);
  font-family: var(--font-ui);
  font-size: var(--step-caption);
  font-weight: 600;
  text-decoration-color: color-mix(in srgb, var(--brand-primary) 42%, transparent);
  text-underline-offset: 3px;
}

.continue-card__author:hover,
.continue-card__author:focus-visible {
  color: var(--brand-primary);
  text-decoration-thickness: 2px;
}

.continue-card__copy > p:not(.home-kicker) {
  color: var(--text-muted);
  margin-block-end: var(--space-4);
}

.continue-card__resume {
  width: fit-content;
  margin-block-end: var(--space-2);
  font-family: var(--font-ui);
  font-size: var(--step-caption);
  font-variant-numeric: lining-nums;
}

.home-kicker {
  color: var(--brand-primary);
  font-size: var(--step-caption);
  font-weight: 700;
}

.home-state {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-6);
}

.home-state__icon,
.daily-card__icon,
.upload-card__icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  flex: 0 0 auto;
  background: var(--accent-soft);
  color: var(--brand-primary-dark);
}

.home-state--error { color: var(--danger); }

.daily-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
}

.daily-card {
  min-height: 160px;
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
  padding: var(--space-5);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  border-color: rgba(132, 105, 62, .2);
  background: rgba(255, 254, 250, .88);
  box-shadow: 0 12px 30px rgba(62, 65, 50, .07);
  backdrop-filter: blur(8px);
}

.daily-card h3 {
  font-size: var(--step-body-lg);
  margin-block: var(--space-2) var(--space-4);
}

.daily-card a { color: var(--brand-primary-dark); font-weight: 600; }
.daily-card__action { color: var(--brand-primary-dark); font-weight: 700; text-align: start; }
.daily-card__action:hover:not(:disabled) { text-decoration: underline; }
.daily-card__action:disabled { cursor: default; }
.daily-card--done { background: var(--accent-soft); border-color: color-mix(in srgb, var(--brand-primary) 35%, var(--border-default)); }

.daily-card--quote {
  display: block;
  margin: 0;
  background: linear-gradient(145deg, rgba(250, 244, 229, .94), rgba(255, 253, 247, .88));
}

.daily-card--quote > p:not(.home-kicker) {
  font-family: var(--font-serif-display);
  font-size: var(--step-title);
  line-height: 1.8;
  margin-block: var(--space-3);
}

.daily-card--quote cite { color: var(--text-muted); font-style: normal; }

/* لا يجوز أن تبقى أسطح الرئيسية الورقية الفاتحة تحت سمة داكنة؛ وإلا يرث
 * النص لون السمة الفاتح فيختفي فوق البطاقة البيضاء. */
[data-app-theme='dark'] .home-page::before {
  background:
    radial-gradient(circle at 9% 5%, rgba(175, 121, 38, .12), transparent 24%),
    radial-gradient(circle at 91% 13%, rgba(121, 205, 165, .11), transparent 27%),
    linear-gradient(145deg, #0b0e0c 0%, #111611 52%, #0d110e 100%);
}
[data-app-theme='dark'] .home-hero {
  background: linear-gradient(180deg, #151a16 0%, #111a15 61%, #0d130f 100%);
}
[data-app-theme='dark'] .home-hero__brand,
[data-app-theme='dark'] .home-hero__sub,
[data-app-theme='dark'] .home-search,
[data-app-theme='dark'] .daily-card,
[data-app-theme='dark'] .daily-card--quote,
[data-app-theme='dark'] .home-gateway__filter {
  background: var(--paper-surface);
  color: var(--text-body);
  border-color: var(--border-default);
  box-shadow: var(--shadow-card);
}
[data-app-theme='dark'] .continue-card {
  background:
    linear-gradient(135deg, var(--paper-surface), var(--paper-surface-alt)),
    repeating-linear-gradient(45deg, transparent 0 18px, rgba(121, 205, 165, .03) 18px 19px);
  color: var(--text-body);
  border-color: var(--border-default);
  box-shadow: var(--shadow-card);
}
[data-app-theme='dark'] .daily-card--done { background: var(--accent-soft); }
[data-app-theme='dark'] .home-hero__ayah,
[data-app-theme='dark'] .home-hero h1,
[data-app-theme='dark'] .home-hero__title-brand { text-shadow: none; }

.home-section .upload-card {
  min-height: 154px;
  padding-block: var(--space-6);
}

@media (max-width: 800px) {
  .daily-grid { grid-template-columns: 1fr 1fr; }
  .daily-card--quote { grid-column: 1 / -1; }
}

@media (max-width: 560px) {
  .home-hero { padding-block: var(--space-6); }
  .home-hero h1 { font-size: var(--step-title-lg); }
  .continue-card { grid-template-columns: 76px minmax(0, 1fr); padding: var(--space-4); }
  .continue-card__mark { height: 96px; }
  .daily-grid { grid-template-columns: 1fr; }
  .daily-card--quote { grid-column: auto; }
  .home-hero::before { inset-block-start: -58px; width: 112vw; }
  .home-page::after { opacity: .22; }
}

@media (prefers-reduced-transparency: reduce) {
  .home-search, .daily-card { backdrop-filter: none; background-color: var(--paper-surface); }
}

/* اكتشف — رفوف حقيقية من مكتبة الجهاز */
.discover-hero { padding-block: var(--space-8); }
.discover-search { margin-block-start: var(--space-6); }
.discover-content { margin-block-end: var(--space-12); }
.discover-loading { min-height: 220px; display: grid; place-items: center; color: var(--text-muted); }
.discover-controls { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin-block-end: var(--space-5); }
.discover-controls h2 { font-size: var(--step-title-lg); }
.chip[aria-current='true'] { background: var(--brand-primary-dark); color: var(--paper-surface); border-color: var(--brand-primary-dark); }
.discover-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
.discover-card { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-4); border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--paper-surface); transition: transform var(--dur-base), box-shadow var(--dur-base); }
.discover-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-card); }
.discover-card__mark { min-height: 94px; display: grid; place-items: center; border-radius: var(--radius-md); color: var(--paper-surface); background: linear-gradient(150deg, var(--brand-primary), var(--brand-primary-dark)); }
.discover-card__cover-art { width: 100%; height: 100%; }
.discover-card__copy { min-width: 0; align-self: center; }
.discover-card__title { display: block; color: var(--ink-strong); font-family: var(--font-serif-display); font-weight: 700; font-size: var(--step-title); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.discover-card__copy p { color: var(--text-muted); font-size: var(--step-caption); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.discover-card__status { display: inline-block; margin-block-start: var(--space-2); color: var(--brand-primary-dark); font-size: 11.5px; }
.discover-empty { grid-column: 1 / -1; padding: var(--space-10); text-align: center; color: var(--text-muted); }

@media (max-width: 850px) { .discover-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .discover-controls { align-items: flex-start; flex-direction: column; } }
@media (max-width: 560px) { .discover-hero { padding-block: var(--space-5); } .discover-grid { grid-template-columns: 1fr; } }

/* أنا — ملخص عملي محفوظ على الجهاز */
.me-hero { padding-block: var(--space-8) var(--space-6); }
.me-identity { width: fit-content; display: inline-flex; align-items: center; gap: var(--space-2); margin-block-start: var(--space-3); padding: 6px 10px; border-radius: var(--radius-pill); background: var(--paper-chip); color: var(--brand-primary-dark); font-size: var(--step-caption); }
.me-loading { min-height: 240px; display: grid; place-items: center; color: var(--text-muted); }
.me-install { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-4); margin-block-end: var(--space-5); padding: var(--space-5); border: 1px solid color-mix(in srgb, var(--brand-primary) 35%, var(--border-default)); border-radius: var(--radius-xl); background: linear-gradient(120deg, var(--paper-surface), var(--accent-soft)); color: var(--brand-primary-dark); }
.me-install h2 { color: var(--ink-strong); font-size: var(--step-title-lg); }
.me-install p:not(.page-eyebrow) { color: var(--text-muted); }
.me-install--ready { background: var(--accent-soft); }
.me-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
.me-stat { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--space-2) var(--space-3); padding: var(--space-5); border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--paper-surface); color: var(--brand-primary); }
.me-stat strong { color: var(--ink-strong); font-size: var(--step-title-lg); }
.me-stat span { grid-column: 1 / -1; color: var(--text-muted); font-size: var(--step-caption); }
.me-today { display: flex; align-items: center; gap: var(--space-4); margin-block: var(--space-6); padding: var(--space-5); border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--paper-warm); color: var(--text-muted); }
.me-today strong { color: var(--ink-strong); }
.me-today--done { background: var(--accent-soft); color: var(--brand-primary-dark); }
.me-actions { margin-block-end: var(--space-12); }
.me-actions h2 { margin-block-end: var(--space-4); font-size: var(--step-title-lg); }
.reading-insights { padding: var(--space-5); border: 1px solid var(--border-default); border-radius: var(--radius-xl); background: var(--paper-surface); }
.reading-insights__summary { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-block: var(--space-3); color: var(--ink-muted); }
.reading-insights__summary strong { color: var(--brand-primary-dark); }
.reading-heatmap { display: grid; grid-template-columns: repeat(14, minmax(12px, 1fr)); gap: 5px; }
.reading-heatmap__day { aspect-ratio: 1; border: 1px solid var(--border-default); border-radius: 4px; background: var(--paper-surface-sunken); }
.reading-heatmap__day.is-active { border-color: var(--brand-primary); background: var(--brand-primary); }
.me-action-grid { display: grid; gap: var(--space-3); }
.me-action { min-height: 72px; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--paper-surface); }
.me-action:hover { border-color: var(--brand-primary); background: var(--accent-soft); }
.me-action__icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-md); color: var(--brand-primary-dark); background: var(--accent-soft); }
.me-action strong, .me-action small { display: block; }
.me-action small { margin-block-start: 2px; color: var(--text-muted); }
@media (max-width: 620px) { .me-install { grid-template-columns: auto minmax(0, 1fr); } .me-install .btn { grid-column: 1 / -1; width: 100%; } .me-stats { grid-template-columns: 1fr; } .me-stat { grid-template-columns: auto auto 1fr; } .me-stat span { grid-column: auto; } }

/* مكتبتي — إدارة عملية للأصول */
.library-hero { padding-block: var(--space-8) var(--space-6); }
.library-shelves-preview { margin-block: 0 var(--space-8); }
.library-shelves-preview__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
