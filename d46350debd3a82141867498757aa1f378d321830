(فَعَلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (أيي) .\n\nوَيُزَكِّيهِمْ: {يُزَكِّي} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، أَصْلُهُ: (يُزَكِّوُ) ، عَلَى وَزْنِ: (يُفَعِّلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ يَاءً لِمَجِيءِ الْوَاوِ بَعْدَ كَسْرٍ، وَفِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (زكو) .\n\nوَيُعَلِّمُهُمُ: {يُعَلِّمُ} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ وَحَرْفٍ مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (يُفَعِّلُ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (علم) .\n\nالْكِتَابَ: {الْكِتَابَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فِعَالٌ) ، مِنْ مَادَّةِ: (كتب) .\n\nوَالْحِكْمَةَ: {الْحِكْمَةَ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (حَكُمَ يَحْكُمُ) ، مِنْ بَابِ: (شَرُفَ يَشْرُفُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، مِنْ مَادَّةِ: (حكم) .\n\nوَإِنْ: {إِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nكَانُوا: {كَانُوا} : فِعْلٌ مَاضٍ لِلْغَائِبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nقَبْلُ: {قَبْلُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (قبل) .\n\nلَفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nضَلَالٍ: {ضَلَالٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَعَالٌ) ، مِنْ مَادَّةِ: (ضلل) .\n\nمُبِينٍ: {مُبِينٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الرُّبَاعِيِّ: (أَبَانَ) ، مِنْ بَابِ: (أَفْعَلَ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْمِيمِ، أَصْلُهُ: (مُؤَبْيِنٌ) ، عَلَى وَزْنِ: (مُؤَفْعِلٌ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (بين) .","words":[{"wordId":71344,"position":1,"word":"هُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":71345,"position":2,"word":"الَّذِي","text":"{الَّذِي} : اسْمٌ مَبْنِيٌّ."},{"wordId":71346,"position":3,"word":"بَعَثَ","text":"{بَعَثَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (بعث) ."},{"wordId":71347,"position":4,"word":"فِي","text":"{فِي} : حَرْفٌ مَبْنِيٌّ."},{"wordId":71348,"position":5,"word":"الْأُمِّيِّينَ","text":"{الْأُمِّيِّينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (أُمِّيٌّ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أمم) ."},{"wordId":71349,"position":6,"word":"رَسُولًا","text":"{رَسُولًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، مِنْ مَادَّةِ: (رسل) ."},{"wordId":71350,"position":7,"word":"مِنْهُمْ","text":"{مِنْ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":71351,"position":8,"word":"يَتْلُو","text":"{يَتْلُو} : فِعْلٌ مُضَارِعٌ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ وَاوِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (يَفْعُلُ) ، مِنْ مَادَّةِ: (تلو) ."},{"wordId":71352,"position":9,"word":"عَلَيْهِمْ","text":"{عَلَى} : حَرْفٌ مَبْنِيٌّ."},{"wordId":71353,"position":10,"word":"آيَاتِهِ","text":"{آيَاتِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ مُؤَنَّثٍ سَالِمٌ، مُفْرَدُهُ: (آيَةٌ) ، ج