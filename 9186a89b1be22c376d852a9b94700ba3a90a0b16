import type{QuarantineRecord,QuarantineResolutionRequest}from"@library/source-sync";import{SourceRevisionAuthorityError}from"./contracts.js";
export interface QuarantineResolutionStore{list(limit:number):Promise<QuarantineRecord[]>;detail(id:string):Promise<QuarantineRecord|null>;lease(input:{id:string;leaseId:string;leaseUntilMs:number;expectedRecordVersion:number}):Promise<boolean>;findResolution(id:string,resolutionId:string):Promise<{status:"allowed"|"rejected";recordVersion:number}|null>;resolve(input:QuarantineResolutionRequest&{adminId:string}):Promise<boolean>}
export class QuarantineResolutionAuthority{constructor(private readonly store:QuarantineResolutionStore,private readonly now:()=>number=Date.now){}list(limit:number){return this.store.list(Math.max(1,Math.min(100,limit)))}async detail(id:string){const x=await this.store.detail(id);if(!x)throw new SourceRevisionAuthorityError("quarantine_not_found",404);return x}async lease(id:string,leaseId:string,leaseMs:number,version:number){if(!leaseId||leaseMs<1000||leaseMs>300_000)throw new SourceRevisionAuthorityError("invalid_request",400);if(!await this.store.lease({id,leaseId,leaseUntilMs:this.now()+leaseMs,expectedRecordVersion:version}))throw new SourceRevisionAuthorityError("quarantine_conflict",409);return{quarantineId:id,leaseId,recordVersion:version+1}}async resolve(admin:{adminId:string},input:QuarantineResolutionRequest){if(!admin.adminId||!input.reason?.trim()||input.reason.length>500||!input.resolutionId||!input.leaseId||!Number.isSafeInteger(input.expectedRecordVersion))throw new SourceRevisionAuthorityError("invalid_request",400);const replay=await this.store.findResolution(input.quarantineId,input.resolutionId);if(replay)return{quarantineId:input.quarantineId,...replay};if(!await this.store.resolve({...input,adminId:admin.adminId}))throw new SourceRevisionAuthorityError("quarantine_conflict",409);return{quarantineId:input.quarantineId,status:input.decision==="allow"?"allowed"as const:"rejected"as const,recordVersion:input.expectedRecordVersion+1}}}
