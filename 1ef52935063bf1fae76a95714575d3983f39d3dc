{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":55,"records":[{"ayah":1,"from":1,"to":1,"text":"الرحـمٰن ذو الرحمة الواسعة."},{"ayah":2,"from":2,"to":2,"text":"علّم الناس القرآن بتسهيل حفظه، وتيسير فهم معانيه."},{"ayah":3,"from":3,"to":3,"text":"خلق الإنسان سويًّا، وأحسن تصويره."},{"ayah":4,"from":4,"to":4,"text":"علّمه كيف يُبِين عمَّا في ضميره نطقًا وكتابة."},{"ayah":5,"from":5,"to":5,"text":"الشمس والقمر قَدَّرهما؛ يسيران بحساب متقن؛ ليعلم الناس عدد السنين والحساب."},{"ayah":6,"from":6,"to":6,"text":"وما لا ساق له من النبات والشجر يسجدان لله سبحانه منقادَينِ مستسلمَينِ له."},{"ayah":7,"from":7,"to":7,"text":"والسماء رفعها فوق الأرض سقفًا لها، وأثبت العدل في الأرض، وأمر به عباده."},{"ayah":8,"from":8,"to":8,"text":"أثبت العدل لئلا تجوروا - أيها الناس - وتخونوا في الوزن والكيل."},{"ayah":9,"from":9,"to":9,"text":"وأقيموا الوزن بينكم بالعدل، ولا تنقصوا الوزن أو الكيل إذا كلتم أو وزنتم لغيركم."},{"ayah":10,"from":10,"to":10,"text":"والأرض وضعها مُهَيَّأة لاستقرار الخلق عليها."},{"ayah":11,"from":11,"to":11,"text":"فيها الأشجار التي تثمر الفواكه، وفيها النخل ذات الأوعية التي يكون منها التمر."},{"ayah":12,"from":12,"to":12,"text":"وفيها الحب ذو التِّبْن كالبُر والشعير، وفيها النباتات التي تستطيبون رائحتها."},{"ayah":13,"from":13,"to":13,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":14,"from":14,"to":14,"text":"خلق آدم عليه السلام من طين يابس تسمع له صلصلة، مثل الطين المطبوخ."},{"ayah":15,"from":15,"to":15,"text":"وخلق أبا الجن من لهب خالص من الدخان."},{"ayah":16,"from":16,"to":16,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":17,"from":17,"to":17,"text":"رب مَشْرِقَي الشمس ومغربيها شتاءً وصيفًا."},{"ayah":18,"from":18,"to":18,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":19,"from":19,"to":19,"text":"خلط الله البحرين المالح والعَذْب يلتقيان فيما تراه العين."},{"ayah":20,"from":20,"to":20,"text":"بينهما حاجز يمنع كلًّا منهما أن يطغى على الآخر حتى يبقى العَذْب عَذْبًا والمالح مالحًا."},{"ayah":21,"from":21,"to":21,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":22,"from":22,"to":22,"text":"يخرج من مجموع البحرين كبار الدُّر وصغاره."},{"ayah":23,"from":23,"to":23,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":24,"from":24,"to":24,"text":"وله سبحانه وتعالى وحده التصرف في السفن الجارية في البحار مثل الجبال."},{"ayah":25,"from":25,"to":25,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":26,"from":26,"to":26,"text":"كل من على وجه الأرض من الخلائق هالك لا محالة."},{"ayah":27,"from":27,"to":27,"text":"ويبقى وجه ربك - أيها الرسول - ذو العظمة والإحسان والتفضل على عباده، فلا يلحقه فناء أبدًا."},{"ayah":28,"from":28,"to":28,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":29,"from":29,"to":29,"text":"يسأله كل من في السماوات من الملائكة، ومن في الأرض من الجن والإنس؛ حاجاتِهم، كل يوم هو في شأن من شؤون عباده؛ من إحياء وإماتة ورزق وغير ذلك."},{"ayah":30,"from":30,"to":30,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":31,"from":31,"to":31,"text":"سنفرغ لحسابكم - أيها الإنس والجن - فنجازي كلًّا بما يستحقه من ثواب أو عقاب."},{"ayah":32,"from":32,"to":32,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":33,"from":33,"to":33,"text":"ويقول الله يوم القيامة إذا جمع الجن والإنس: يا معشر الجن والإنس، إن استطعتم أن تجدوا لكم مخرجًا من ناحية من نواحي السماوات والأرض فافعلوا، ولن تستطيعوا أن تفعلوا ذلك إلا بقوة وبينة، وأنَّى لكم ذلك؟"},{"ayah":34,"from":34,"to":34,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":35,"from":35,"to":35,"text":"يُرْسَل عليكما - أيها الإنس والجن - لهب من النار خالٍ من الدخان، ودخان لا لهب فيه، فلا تستطيعان الامتناع من ذلك."},{"ayah":36,"from":36,"to":36,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":37,"from":37,"to":37,"text":"فإذا تشققت السماء لنزول الملائكة منها فكانت حمراء مثل الدهن في إشراق لونه."},{"ayah":38,"from":38,"to":38,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":39,"from":39,"to":39,"text":"ففي ذلك اليوم العظيم لا يُسْأل إنس ولا جنّ عن ذنوبهم؛ لعلم الله بأعمالهم."},{"ayah":40,"from":40,"to":40,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":41,"from":41,"to":41,"text":"يُعْرف المجرمون يوم القيامة بعلامتهم وهي سواد الوجوه وزرقة العيون، فتُضَمّ نواصيهم إلى أقدامهم فيرمون في جهنم."},{"ayah":42,"from":42,"to":42,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":43,"from":43,"to":43,"text":"ويقال لهم توبيخًا: هذه جهنم التي يكذب بها المجرمون في الدنيا أمام أعينهم لا يستطيعون إنكارها."},{"ayah":44,"from":44,"to":44,"text":"يتردَّدون بينها وبين ماء حارٍّ شديد الحرارة."},{"ayah":45,"from":45,"to":45,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":46,"from":46,"to":46,"text":"وللذي خاف القيام بين يدي ربه في الآخرة فآمن وعمل صالحًا، جنتان."},{"ayah":47,"from":47,"to":47,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":48,"from":48,"to":48,"text":"وهاتان الجنتان ذواتا أغصان عظيمة نضرة مثمرة."},{"ayah":49,"from":49,"to":49,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":50,"from":50,"to":50,"text":"في الجنتين عينان تجريان خلالهما بالماء."},{"ayah":51,"from":51,"to":51,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":52,"from":52,"to":52,"text":"فيهما من كل فاكهة يُتَفَكَّه بها صنفان."},{"ayah":53,"from":53,"to":53,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":54,"from":54,"to":54,"text":"متكئين على فرش بطائنها من الديباج الغليظ، وما يُجْنَى من الثمار والفواكه من الجنتين قريب يتناوله القائم والجالس والمتكئ."},{"ayah":55,"from":55,"to":55,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":56,"from":56,"to":56,"text":"فيهن نساء قصرن نظرهنّ على أزواجهنّ، لم يَفْتَضِضْ بكارتهنّ قبل أزواجهنّ إنس ولا جانّ."},{"ayah":57,"from":57,"to":57,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":58,"from":58,"to":58,"text":"كأنهنّ الياقوت والمرجان جمالًا وصفاء."},{"ayah":59,"from":59,"to":59,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":60,"from":60,"to":60,"text":"ما جزاء من أحسن بطاعة ربه إلا أن يحسن الله جزاءه؟!"},{"ayah":61,"from":61,"to":61,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":62,"from":62,"to":62,"text":"ومن دون هاتين الجنتين المذكورتين جنتان أخريان."},{"ayah":63,"from":63,"to":63,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":64,"from":64,"to":64,"text":"قد اشتدّت خضرتهما."},{"ayah":65,"from":65,"to":65,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":66,"from":66,"to":66,"text":"في هاتين الجنتين عينان شديدتا الفَوَران بالماء، لا ينقطع فَوَران مائهما."},{"ayah":67,"from":67,"to":67,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":68,"from":68,"to":68,"text":"في هاتين الجنتين فاكهة كثيرة ونخل عظيم ورُمَّان."},{"ayah":69,"from":69,"to":69,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":70,"from":70,"to":70,"text":"في هذه الجنان نساء طيبات الأخلاق حسان الوجوه."},{"ayah":71,"from":71,"to":71,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":72,"from":72,"to":72,"text":"حور مستورات في الخيام صونًا لهنّ."},{"ayah":73,"from":73,"to":73,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":74,"from":74,"to":74,"text":"لم يقترب منهنَّ قبل أزواجهنّ إنس ولا جانّ."},{"ayah":75,"from":75,"to":75,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":76,"from":76,"to":76,"text":"متكئين على وسائد مغطاة بأغطية خضر، وفرش حسان."},{"ayah":77,"from":77,"to":77,"text":"فبأي نعم الله الكثيرة عليكم - يا معشر الجن والإنس - تكذبان؟!"},{"ayah":78,"from":78,"to":78,"text":"تعاظم وكثر خير اسم ربك ذي العظمة والإحسان والتفضل على عباده."}]}