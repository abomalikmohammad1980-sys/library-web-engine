import{readFile}from"node:fs/promises";import{HttpSourceRevisionApi,SourceSyncApiError}from"./source-sync-api-client.js";import type{NodeRuntimeConfig,TokenSource}from"./node-runtime-factory.js";
export type UserCommand="revisions"|"devices"|"usage"|"rollback"|"device-revoke";
export async function runUserCommand(command:UserCommand,c:NodeRuntimeConfig,args:string[],io={out:(s:string)=>process.stdout.write(s+"\n"),err:(s:string)=>process.stderr.write(s+"\n")},fetchImpl:typeof fetch=fetch){try{const api=new HttpSourceRevisionApi(c.apiBase,()=>token(c.tokenSource),fetchImpl),confirm=args.includes("--confirm"),json=args.includes("--json");let value:unknown;if(command==="revisions")value=await api.revisions(required(args,"--book"));else if(command==="devices")value=await api.devices();else if(command==="usage")value=await api.usage();else if(!confirm){value={dryRun:true,command,requires:"--confirm"}}else if(command==="rollback")value=await api.rollback(required(args,"--book"),{operationId:required(args,"--operation"),targetRevisionId:required(args,"--revision"),expectedRecordVersion:Number(required(args,"--expected-version")),deviceId:required(args,"--device")});else value=await api.revokeDevice(required(args,"--device"));io.out(json?JSON.stringify(value):human(command,value));return 0}catch(e){const code=e instanceof SourceSyncApiError?e.status===404?6:e.status===409?7:e.retryable?5:1:2;io.err(JSON.stringify({error:e instanceof SourceSyncApiError?e.code:"client_error"}));return code}}
function required(a:string[],f:string){const i=a.indexOf(f),v=i<0?undefined:a[i+1];if(!v||v.startsWith("--"))throw Error(`${f} is required`);return v}async function token(s:TokenSource){if(s.kind==="env")return(process.env[s.name]??"").trim();if(s.kind==="file")return(await readFile(s.path,"utf8")).trim();throw Error("callback user token unavailable in CLI")}
function human(c:UserCommand,v:unknown){if(c==="devices"&&Array.isArray(v))return v.map((x:any)=>`${x.deviceId}\t${x.label}\t${x.platform}\t${x.revokedAt?"revoked":"active"}`).join("\n")||"No devices";if(c==="revisions")return JSON.stringify(v,null,2);if(c==="usage")return JSON.stringify(v,null,2);return JSON.stringify(v,null,2)}
