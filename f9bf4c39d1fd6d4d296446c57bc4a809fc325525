{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":100,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم الله بالخيل التي تجري حتى يُسْمَع لنَفَسِها صوتٌ من شدة الجري."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالخيل التي تُوقِد بحوافرها النار إذا لامست بها الصخور لشدة وقعها عليها."},{"ayah":3,"from":3,"to":3,"text":"وأقسم بالخيل التي تُغِير على الأعداء وقت الصباح."},{"ayah":4,"from":4,"to":4,"text":"فحركن بجريهنّ غبارًا."},{"ayah":5,"from":5,"to":5,"text":"فتوسّطن بفوارسهنّ جَمْعًا من الأعداء."},{"ayah":6,"from":6,"to":6,"text":"إن الإنسان لمَنُوع للخير الذي يريده منه ربه."},{"ayah":7,"from":7,"to":7,"text":"وإنه على منعه للخير لشاهد، لا يستطيع إنكار ذلك لوضوحه."},{"ayah":8,"from":8,"to":8,"text":"وإنه لفرط حبه للمال يبخل به."},{"ayah":9,"from":9,"to":9,"text":"أفلا يعلم هذا الإنسان المغترّ بالحياة الدنيا إذا بعث الله ما في القبور من الأموات وأخرجهم من الأرض للحساب والجزاء أن الأمر لم يكن كما كان يتوهم؟!"},{"ayah":10,"from":10,"to":10,"text":"وأُبْرِز وبُيِّن ما في القلوب من النيات والاعتقادات وغيرها."},{"ayah":11,"from":11,"to":11,"text":"إن ربهم بهم في ذلك اليوم لخبير، لا يخفى عليه من أمر عباده شيء، وسيجازيهم على ذلك."}]}