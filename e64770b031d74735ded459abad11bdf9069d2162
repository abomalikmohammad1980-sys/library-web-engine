) .\n\nالْبَحْرَ: {الْبَحْرَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بحر) .\n\nلِتَأْكُلُوا: {تَأْكُلُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مَهْمُوزُ الْفَاءِ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، مِنْ مَادَّةِ: (أكل) .\n\nمِنْهُ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nلَحْمًا: {لَحْمًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (لحم) .\n\nطَرِيًّا: {طَرِيًّا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِفَةٌ مُشَبَّهَةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (طَرِيَ يَطْرَى) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْيَاءِ، عَلَى وَزْنِ: (فَعِيلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (طري) .\n\nوَتَسْتَخْرِجُوا: {تَسْتَخْرِجُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، سُدَاسِيٌّ مَزِيدٌ بِثَلَاثَةِ أَحْرُفٍ: التَّاءِ وَالسِّينِ، مِنْ بَابِ: (اسْتَفْعَلَ) ، عَلَى وَزْنِ: (تَسْتَفْعِلُ) ، مِنْ مَادَّةِ: (خرج) .\n\nمِنْهُ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nحِلْيَةً: {حِلْيَةً} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فِعْلَةٌ) ، مِنْ مَادَّةِ: (حلي) .\n\nتَلْبَسُونَهَا: {تَلْبَسُونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، مِنْ مَادَّةِ: (لبس) .\n\nوَتَرَى: {تَرَى} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ مَهْمُوزُ الْعَيْنِ، نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، أَصْلُهُ: (تَرْأَيُ) ، عَلَى وَزْنِ: (تَفْعَلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْهَمْزَةِ لِلتَّخْفِيفِ، وَفِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (رأي) .\n\nالْفُلْكَ: {الْفُلْكَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (فَلَكٌ) ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، مِنْ مَادَّةِ: (فلك) .\n\nمَوَاخِرَ: {مَوَاخِرَ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، صِيغَةُ مُنْتَهَى الْجُمُوعِ، مُفْرَدُهُ: (مَاخِرَةٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (مَخَرَ يَمْخُرُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالْوَاوِ، أَصْلُهُ: (مَوَاخِرُ) ، عَلَى وَزْنِ: (فَوَاعِلُ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْأَلِفِ وَاوًا لِمَجِيئِهَا بَعْدَ ضَمٍّ، مِنْ مَادَّةِ: (مخر) .\n\nفِيهِ: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nوَلِتَبْتَغُوا: {تَبْتَغُوا} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، أَصْلُهُ: (تَبْتَغِيُ) ، عَلَى وَزْنِ: (تَفْتَعِلُ) ، فِيهِ إِعْلَالٌ بِحَذْفِ حَرْفِ: الْيَاءِ لِثِقَلِ الضَّمَّةِ عَلَى الْيَاءِ، مِنْ مَادَّةِ: (بغي) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nفَضْلِهِ: {فَضْلِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (فضل) .\n\nوَلَعَلَّكُمْ: {لَعَلَّ} : حَرْفٌ مَبْنِيٌّ.\n\nتَشْكُرُونَ: {تَشْكُرُونَ} : فِعْلٌ مُضَارِعٌ لِلْمُخَاطَبِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (تَفْعُلُ) ، مِنْ مَادَّةِ: (شكر) .","words":[{"wordId":34293,"position":1,"word":"وَهُوَ","text":"{هُوَ} : اسْمٌ مَبْنِيٌّ."},{"wordId":34294,"position":2,"word":"الَّذِي","text":"{الَّذِي} : اسْمٌ مَبْنِيٌّ."},{"wordId":34295,"position":3,"word":"سَخَّرَ","text":"{سَخَّرَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، رُبَاعِيٌّ مَزِيدٌ بِحَرْفِ: مُضَعَّفٍ، مِنْ بَابِ: (فَعَّلَ) ، عَلَى وَزْنِ: (فَعَّلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَاد