 حَرْفٌ مَبْنِيٌّ، {َمَا} : اسْمٌ مَبْنِيٌّ.\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nبُطُونِهِ: {بُطُونِ} : اسْمٌ، مُؤَنَّثُ، جَمْعُ تَكْسِيرٍ لِلْكَثْرَةِ، مُفْرَدُهُ: (بَطْنٌ) ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فُعُولٌ) ، مِنْ مَادَّةِ: (بطن) .\n\nمِنْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nبَيْنِ: {بَيْنِ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (بين) .\n\nفَرْثٍ: {فَرْثٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (فرث) .\n\nوَدَمٍ: {دَمٍ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (دمم) .\n\nلَبَنًا: {لَبَنًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعَلٌ) ، مِنْ مَادَّةِ: (لبن) .\n\nخَالِصًا: {خَالِصًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (خَلَصَ يَخْلُصُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (خلص) .\n\nسَائِغًا: {سَائِغًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (سَاغَ يَسُوغُ) ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، أَصْلُهُ: (سَاوِغٌ) ، عَلَى وَزْنِ: (فَاعِلٌ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ هَمْزَةً لِمَجِيئِهَا مُتَحَرِّكَةً بَعْدَ الْأَلِفِ، مِنْ مَادَّةِ: (سوغ) .\n\nلِلشَّارِبِينَ: {الشَّارِبِينَ} : اسْمٌ، مُذَكَّرٌ، جَمْعُ مُذَكَّرٍ سَالِمٌ، مُفْرَدُهُ: (شَارِبٌ) ، مُشْتَقٌّ، اسْمُ فَاعِلٍ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (شَرِبَ يَشْرَبُ) ، مِنْ بَابِ: (عَلِمَ يَعْلَمُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْأَلِفِ، عَلَى وَزْنِ: (فَاعِلٌ) ، مِنْ مَادَّةِ: (شرب) .","words":[{"wordId":34994,"position":1,"word":"وَإِنَّ","text":"{إِنَّ} : حَرْفٌ مَبْنِيٌّ."},{"wordId":34995,"position":2,"word":"لَكُمْ","text":"(اللَّامُ) : حَرْفٌ مَبْنِيٌّ."},{"wordId":34996,"position":3,"word":"فِي","text":"{فِي} : حَرْفٌ مَبْنِيٌّ