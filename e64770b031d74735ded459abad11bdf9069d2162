ِيهِ إِعْلَالٌ بِنَقْلِ: الْكَسْرَةِ لِلْحَرْفِ السَّاكِنِ قَبْلَهَا، مِنْ مَادَّةِ: (بين) ."}]},{"ayah":36,"from":36,"to":36,"text":"وَلَقَدْ: {قَدْ} : حَرْفٌ مَبْنِيٌّ.\n\nبَعَثْنَا: {بَعَثْنَا} : فِعْلٌ مَاضٍ لِلْمُتَكَلِّمِينِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، عَلَى وَزْنِ: (فَعَلَ) ، مِنْ مَادَّةِ: (بعث) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nكُلِّ: {كُلِّ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فُعْلٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (كلل) .\n\nأُمَّةٍ: {أُمَّةٍ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: التَّاءِ، عَلَى وَزْنِ: (فُعْلَةٌ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ سَاكِنٍ وَمُتَحَرِّكٍ، مِنْ مَادَّةِ: (أمم) .\n\nرَسُولًا: {رَسُولًا} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفِ: الْوَاوِ، عَلَى وَزْنِ: (فَعُولٌ) ، مِنْ مَادَّةِ: (رسل) .\n\nأَنِ: {أَنْ} : حَرْفٌ مَبْنِيٌّ.\n\nاعْبُدُوا: {اعْبُدُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (افْعُلْ) ، مِنْ مَادَّةِ: (عبد) .\n\nاللَّهَ: {اللَّهَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَاجْتَنِبُوا: {اجْتَنِبُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، خُمَاسِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، مِنْ بَابِ: (افْتَعَلَ) ، عَلَى وَزْنِ: (افْتَعِلْ) ، مِنْ مَادَّةِ: (جنب) .\n\nالطَّاغُوتَ: {الطَّاغُوتَ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، مُشْتَقٌّ، صِيغَةُ مُبَالَغَةٍ سَمَاعِيَّةٌ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (طَغَا يَطْغَى) ، مِنْ بَابِ: (فَتَحَ يَفْتَحُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: التَّاءِ وَالْوَاوِ، عَلَى وَزْنِ: (فَعَلُوتٌ) ، مِنْ مَادَّةِ: (طغو) .\n\nفَمِنْهُمْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nهَدَى: {هَدَى} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ نَاقِصٌ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (هَدَيَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْيَاءِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (هدي) .\n\nاللَّهُ: {اللَّهُ} : اسْمٌ، مُذَكَّرٌ، مُفْرَدٌ، جَامِدٌ، مِنْ مَادَّةِ: (أله) .\n\nوَمِنْهُمْ: {مِنْ} : حَرْفٌ مَبْنِيٌّ.\n\nمَنْ: {مَنْ} : اسْمٌ مَبْنِيٌّ.\n\nحَقَّتْ: {حَقَّتْ} : فِعْلٌ مَاضٍ لِلْغَائِبَةِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، صَحِيحٌ مُضَعَّفٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، أَصْلُهُ: (حَقَقَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِدْغَامُ حَرْفَيْنِ مُتَمَاثِلَيْنِ مُتَحَرِّكَيْنِ، مِنْ مَادَّةِ: (حقق) .\n\nعَلَيْهِ: {عَلَى} : حَرْفٌ مَبْنِيٌّ.\n\nالضَّلَالَةُ: {الضَّلَالَةُ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، مَصْدَرٌ سَمَاعِيٌّ، مِنَ الْفِعْلِ الثُّلَاثِيِّ: (ضَلَّ يَضِلُّ) ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، ثُلَاثِيٌّ مَزِيدٌ بِحَرْفَيْنِ: الْأَلِفِ وَالتَّاءِ، عَلَى وَزْنِ: (فَعَالَةٌ) ، مِنْ مَادَّةِ: (ضلل) .\n\nفَسِيرُوا: {سِيرُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ يَائِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (ضَرَبَ يَضْرِبُ) ، عَلَى وَزْنِ: (افْعِلْ) ، مِنْ مَادَّةِ: (سير) .\n\nفِي: {فِي} : حَرْفٌ مَبْنِيٌّ.\n\nالْأَرْضِ: {الْأَرْضِ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيٌّ مُجَرَّدٌ، عَلَى وَزْنِ: (فَعْلٌ) ، مِنْ مَادَّةِ: (أرض) .\n\nفَانْظُرُوا: {انْظُرُوا} : فِعْلُ أَمْرٍ لِلْمُخَاطَبِينِ، مُتَصَرِّفٌ، صَحِيحٌ سَالِمٌ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، عَلَى وَزْنِ: (افْعُلْ) ، مِنْ مَادَّةِ: (نظر) .\n\nكَيْفَ: {كَيْفَ} : اسْمٌ مَبْنِيٌّ.\n\nكَانَ: {كَانَ} : فِعْلٌ مَاضٍ لِلْغَائِبِ، مَبْنِيٌّ لِلْمَعْلُومِ، مُتَصَرِّفٌ، مُعْتَلٌّ أَجْوَفُ وَاوِيٌّ، ثُلَاثِيٌّ مُجَرَّدٌ، مِنْ بَابِ: (نَصَرَ يَنْصُرُ) ، أَصْلُهُ: (كَوَنَ) ، عَلَى وَزْنِ: (فَعَلَ) ، فِيهِ إِعْلَالٌ بِقَلْبِ حَرْفِ: الْوَاوِ أَلِفًا لِتَحَرُّكِهَا وَانْفِتَاحِ مَا قَبْلَهَا، مِنْ مَادَّةِ: (كون) .\n\nعَاقِبَةُ: {عَاقِبَةُ} : اسْمٌ، مُؤَنَّثُ، مُفْرَدٌ، جَامِدٌ، ثُلَاثِيّ