import{describe,expect,it}from"vitest";import{conflictResolutionIntent,pendingOperationIntent,syncActionPolicy,type SyncAction}from"./sync-action-policy.js";import type{SourceSyncPhase,SourceSyncViewState}from"./session-state.js";
const expected:Record<SourceSyncPhase,readonly SyncAction[]>={signedOut:["signIn","continueLocal"],guest:["continueLocal","upgradeAccount"],localOnly:["chooseManagedFolder","upgradeAccount"],connecting:["cancelConnection"],synced:["refresh","viewRevisions"],offline:["retryConnection","continueLocal"],pending:["viewPending"],conflict:["keepLocal","keepRemote","createCopy","viewRevisions"],quarantined:["viewQuarantine"],error:["retryConnection","continueLocal"]};
const device={deviceId:"device",label:"Here",platform:"web",createdAt:"now",lastSeenAt:"now",revokedAt:null};function state(phase:SourceSyncPhase,active=true):SourceSyncViewState{return{phase,uploadAllowed:active&&!["guest","signedOut","localOnly"].includes(phase),activeDevice:active?device:null,revision:null,usage:null,pendingCount:phase==="pending"?1:0,conflictCount:phase==="conflict"?1:0,quarantineCount:phase==="quarantined"?1:0,stale:phase==="offline",errorCode:null}}
describe("sync UX action policy",()=>{it("has an exhaustive stable message/action matrix",()=>{for(const phase of Object.keys(expected)as SourceSyncPhase[]){const policy=syncActionPolicy(state(phase));expect(policy.messageKey).toBe(`sync.${phase}`);expect(policy.actions).toEqual(expected[phase])}});it("makes quarantine read-only and guest upgrade an explicit boundary",()=>{expect(syncActionPolicy(state("quarantined")).mutatingActions).toEqual([]);expect(syncActionPolicy(state("guest",false))).toMatchObject({actions:["continueLocal","upgradeAccount"],uploadAllowed:false});expect(()=>syncActionPolicy({...state("guest"),uploadAllowed:true})).toThrow(/invariant/)});it("exposes pending retry/cancel only when server-derived constraints allow",()=>{expect(syncActionPolicy(state("pending"),{pendingRetryable:true,pendingCancelable:false}).actions).toEqual(["viewPending","retryPending"]);expect(syncActionPolicy(state("pending"),{pendingRetryable:true,pendingCancelable:true}).mutatingActions).toEqual(["retryPending","cancelPending"])});it("creates versioned idempotent conflict intents without performing a mutation",()=>{const input={operationId:"resolve-1",bookId:"book",deviceId:"device",conflictingRevisionId:"revision-2",expectedPublicationVersion:4,resolution:"createCopy"as const},intent=conflictResolutionIntent(state("conflict"),input);expect(intent).toEqual({kind:"resolveConflict",...input});expect(conflictResolutionIntent(state("conflict"),input)).toEqual(intent);expect(()=>conflictResolutionIntent(state("synced"),input)).toThrow(/not_allowed/)});it("enforces active-device/version/constraints for pending intents",()=>{const input={operationId:"retry-1",bookId:"book",deviceId:"device",pendingOperationId:"upload-1",expectedOperationVersion:2,action:"retryPending"as const};expect(pendingOperationIntent(state("pending"),input,{retryable:true,cancelable:false})).toMatchObject({kind:"retryPending",expectedOperationVersion:2});expect(()=>pendingOperationIntent(state("pending"),{...input,action:"cancelPending"},{retryable:true,cancelable:false})).toThrow(/not_allowed/);expect(()=>pendingOperationIntent(state("pending",false),input,{retryable:true,cancelable:true})).toThrow(/not_allowed/)})});
