,"text":""},{"paragraphIndex":2484,"physicalPage":317,"adjustedPage":316,"text":"يدعو فيُفتح كل بابٍ مقفلٍ"},{"paragraphIndex":2485,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2486,"physicalPage":317,"adjustedPage":316,"text":"ويصُكُّ سمعَ الغافلين صهيلُ"},{"paragraphIndex":2487,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2488,"physicalPage":317,"adjustedPage":316,"text":"ما زلتُ أبصره، وأبصر أمتي"},{"paragraphIndex":2489,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2490,"physicalPage":317,"adjustedPage":316,"text":"في عصرنا، وإزارُها محلولُ"},{"paragraphIndex":2491,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2492,"physicalPage":317,"adjustedPage":316,"text":"فأكاد أخرج من ثياب عزيمتي"},{"paragraphIndex":2493,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2494,"physicalPage":317,"adjustedPage":316,"text":"وينالني بعد الثبات نُكولُ"},{"paragraphIndex":2495,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2496,"physicalPage":317,"adjustedPage":316,"text":"عذرًا -أخا الإسلام- إنَّ مشاعري"},{"paragraphIndex":2497,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2498,"physicalPage":317,"adjustedPage":316,"text":"نهرٌ، خريرُ مياهه تبجيلُ"},{"paragraphIndex":2499,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2500,"physicalPage":317,"adjustedPage":316,"text":"كم من أخٍ قتلوه ظلمًا بينكم"},{"paragraphIndex":2501,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2502,"physicalPage":317,"adjustedPage":316,"text":"فكأّنما أنا، لا هو المقتولُ"},{"paragraphIndex":2503,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2504,"physicalPage":317,"adjustedPage":316,"text":"هذا دليل أخوَّةٍ في الله لا"},{"paragraphIndex":2505,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2506,"physicalPage":317,"adjustedPage":316,"text":"يخفى ولا يتغيرُ المدلولُ"},{"paragraphIndex":2507,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2508,"physicalPage":317,"adjustedPage":316,"text":"صبرًا -أخا الإسلام- إنَّ نهارنا"},{"paragraphIndex":2509,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2510,"physicalPage":317,"adjustedPage":316,"text":"آتٍ يصول بنوره ويجولُ"},{"paragraphIndex":2511,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2512,"physicalPage":317,"adjustedPage":316,"text":"طرقُ السياسة يا أخي معوَجةٌ"},{"paragraphIndex":2513,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2514,"physicalPage":317,"adjustedPage":316,"text":"كم ضاع فيها سائسٌ ودليلُ"},{"paragraphIndex":2515,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2516,"physicalPage":317,"adjustedPage":316,"text":"الله مولانا ومولاكم وفي"},{"paragraphIndex":2517,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2518,"physicalPage":317,"adjustedPage":316,"text":"كَنَفِ المهيمن نصرُنا المأمولُ(\u0002)"},{"paragraphIndex":2519,"physicalPage":317,"adjustedPage":316,"text":""},{"paragraphIndex":2520,"physicalPage":317,"adjustedPage":316,"text":"***"},{"paragraphIndex":2521,"physicalPage":317,"adjustedPage":316,"text":"الشبهة الرابعة: تخذيل الكافرين"},{"paragraphIndex":2522,"physicalPage":317,"adjustedPage":316,"text":"قالوا: إنَّ الدور الحقيقي الكبير الذي يمارسه الوزير وعضو البرلمان هو التخذيل عن أهل السنة، فعضوية البرلمان تُنبئ عن القوة التي وراءها، ولذا فإنَّ التعداد السكاني عادةً ما تظهر حقيقته وقوته بالانتخابات، وهو ثقلنا أمام العالم الخارجي، ومن يغيب عن الساحة كمن لا وجود له في البلد، ونحن السُنّة بغير شك أكثرية في البلد، فإذا وصل أهل السُنّة بأغلبية في البرلمان لم يكن أمام الغاصب أو الحكومة إلا أن تجعله أكثرية في الوزارة."},{"paragraphIndex":2523,"physicalPage":318,"adjustedPage":317,"text":"وهذه الرسالة وحدها كافية لأن تقول لمن ينوي استضعاف أهل السُنّة أو العدوان عليهم: هذه قوتنا، وهذه كثرتنا، ففكروا ألف مرة قبل أن تعتدوا علينا، وهذه هي غاية الإعداد والجهاد: ﴿وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ وَمِنْ رِبَاطِ الْخَيْلِ تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فِي سَبِيلِ اللَّهِ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ (60)﴾ [الأنفال: 60]، فإرهاب العدو حاصل بهذه الكثرة لأعداء نعرفهم وآخرين لا نعرفهم."},{"paragraphIndex":2524,"physicalPage":318,"adjustedPage":317,"text":"الجواب عن الشبهة الرابعة:"},{"paragraphIndex":2525,"physicalPage":318,"adjustedPage":317,"text":"بئس الممثل من أهل السُنّة عضو البرلمان في مجلس المحتل أو وزير في حكومة ردة واحتلال."},{"paragraphIndex":2526,"physicalPage":318,"adjustedPage":317,"text":"وصمة عارٍ يرتكبها هؤلاء في جباههم ثم يريدون إلصاقها في جبين أهل السنة في العراق."},{"paragraphIndex":2527,"physicalPage":318,"adjustedPage":317,"text":"وصمة عارٍ تقول للعالم والتاريخ: كل أهل السنة موافقون على الاحتلال بدليل أنهم مشاركون في عضوية البرلمان والوزارة! ولقد تبجح بها \"بوش\" من قبل أكثر من مرة، ورفع بها عقيرته في أكثر من محفل."},{"paragraphIndex":2528,"physicalPage":318,"adjustedPage":317,"text":"لا والله، فأهل السنة براء من مشاركة المحتل في وزارة أو برلمان أو إرسال ممثل عنهم؛ ليكون عودًا في حزمة الردة الرافضية الحاكمة."},{"paragraphIndex":2529,"physicalPage":318,"adjustedPage":317,"text":"وفرض على كل واحد من أهل السنة أن يعلنها لله ثم للتاريخ أننا برءاء من هؤلاء، لعل الله يعذرنا، اللهم فاشهد أنهم لا يمثلوننا، ويا أيها العالم اشهد أنهم ليسوا منا، ولسنا منهم، وإن تكلموا بألسنتنا، ونسبوا لنا ذلك."},{"paragraphIndex":2530,"physicalPage":318,"adjustedPage":317,"text":"وبعد هذا فإنَّ السؤال الأول الذي نطرحه على هؤلاء، وعلى فرض صحة ما ذكروه، من أنَّ في مشاركتهم تخذيلاً للكافرين هو: هل هذا المكسب عذر مقبول لانتهاك التوحيد بالوقوع في شرك التشريع؟!"},{"paragraphIndex":2531,"physicalPage":318,"adjustedPage":317,"text":"أليس تحقيق توحيد التشريع غاية، والمشاركة في البرلمان وسيلة، فكيف انتهكوا الغاية لأجل الوسيلة؟! فأيُّ تلبيس هذا؟!"},{"paragraphIndex":2532,"physicalPage":318,"adjustedPage":317,"text":"وأخيرًا، يقولون: لأنه بالانتخابات ينظر إلينا أننا أكثرية."},{"paragraphIndex":2533,"physicalPage":318,"adjustedPage":317,"text":"وهل الأكثرية لا تظهر إلا بالانتخابات؟!"},{"paragraphIndex":2534,"physicalPage":318,"adjustedPage":317,"text":"وماذا إذا زوروا، هل نصبح أكثرية؟!"},{"paragraphIndex":2535,"physicalPage":318,"adjustedPage":317,"text":"وهل تراهم إذا كانوا صادقين لا يستطيعون أن يظهروا أننا الأكثرية من خلال الإحصائية السكانية؟!"},{"paragraphIndex":2536,"physicalPage":318,"adjustedPage":317,"text":"وهل ترى ظهور حقيقة أننا أكثرية سيدفعهم إلى مزيد من استغلال الفرصة، وأخذ المزايا التاريخية ونحو ذلك؟ أم سيدعوهم إلى الحق والخضوع لحكم الأكثرية؟!"},{"paragraphIndex":2537,"physicalPage":319,"adjustedPage":318,"text":"ثم متى كانت الأكثرية قاعدة لرضوخ العالم الصليبي لها، وخصوصًا إذا كانت أكثرية إسلامية أو سنية؟!"},{"paragraphIndex":2538,"physicalPage":319,"adjustedPage":318,"text":"وبين يديك أمثلة كثيرة في هذا العالم، وكيف جعلوا الحكم للأقلية."},{"paragraphIndex":2539,"physicalPage":319,"adjustedPage":318,"text":"إن القراءة الصحيحة لهذه الانتخابات، حتى وإن فزنا بها، تقول: انظروا كم لهم من عضوٍ ولم يؤثِّروا في المجتمع..."},{"paragraphIndex":2540,"physicalPage":319,"adjustedPage":318,"text":"وانظر إلى الوزارات المؤثرة لمن سُلمت..."},{"paragraphIndex":2541,"physicalPage":319,"adjustedPage":318,"text":"وانظر إلى الوزراء الرافضة كصولاغ وغيره ممن ثبت إجرامهم بالأدلة القاطعة، ماذا حصل لهم، وأي عقوبة نزلت بهم؟!"},{"paragraphIndex":2542,"physicalPage":319,"adjustedPage":318,"text":"***"},{"paragraphIndex":2543,"physicalPage":319,"adjustedPage":318,"text":"الشبهة الخامسة: ضرورة مراعاة النتائج"},{"paragraphIndex":2544,"physicalPage":319,"adjustedPage":318,"text":"قالوا: من الأمور الأساسية التي علَّمنا إياها الشرعُ حُسن حساب النتائج قبل الإقدام على العمل، فكلما كان الحساب دقيقًا ومتقنًا كانت النتائج دقيقة ومضمونة بإذن الله تعالى، وبغير هذا الحساب ستذهب النتائج أدراج الرياح، ولأهمية حساب النتائج فإنَّ المنكر إذا أفضى إنكاره لما هو أكبر منه تُرك الإنكار، وإنَّ القائد الذي لا يُحسن القيادة فيقدِّم الإقدام دائمًا يُعدُّ مهلكة، وإنَّ الجهاد نفسه ما شرع في العهد المكي، وما شرع إلا بعدما بلغ حساب النتائج مبلغًا يغلب فيه على الظن -حسب نظام الأسباب- النصر، وهكذا كان النبي صلى الله عليه وسلم يحسب لكل معركة حسابها، ويُعد لها ما يناسبها، فالحساب والتدقيق أصل شرعي."},{"paragraphIndex":2545,"physicalPage":319,"adjustedPage":318,"text":"وكلما ازداد الخطر ازدادت أهمية حساب النتائج، وهل هي إلا من الإعداد؟!"},{"paragraphIndex":2546,"physicalPage":319,"adjustedPage":318,"text":"ولذا نجد أنَّ النبي صلى الله عليه وسلم جعل العيون على قريش في بدر؛ ليعرف كل شيء عنهم، وأمسك بالأسير وسأله؛ ليعرف أعدادهم كما روي."},{"paragraphIndex":2547,"physicalPage":319,"adjustedPage":318,"text":"وإنَّ وجود العضو في البرلمان والوزير في الوزارة أحسن رصدٍ لنا من داخلهم، وهذا من حسن الإعداد، وحسن حساب النتائج."},{"paragraphIndex":2548,"physicalPage":319,"adjustedPage":318,"text":"الجواب عن الشبهة الخامسة:"},{"paragraphIndex":2549,"physicalPage":320,"adjustedPage":319,"text":"أولاً: كم يحتج هذا الصنف من الناس، ويبرر لتخل عن الجهاد؛ مُستشهدًا بالمرحلة المكية؟! ولا ندري إلى متى نبقى في المرحلة المكية؟! وإلى کم سوف تمتد بالناس القرون، وهؤلاء لا يزالون يطالبون بأحكام المرحلة المكية مع أنها لم تأخذ إلا ثلاثة عشر عامًا؟!"},{"paragraphIndex":2550,"physicalPage":320,"adjustedPage":319,"text":"وإلى متى يتعلق هؤلاء بالمرحلة المكية؛ تبريرًا للقعود عن الجهاد؟!"},{"paragraphIndex":2551,"physicalPage":320,"adjustedPage":319,"text":"تُرى لِمَ لا يأخذون بالتدرج في بقية الأحكام في أول مراحل تشريع تحريمها بحجة أننا في مرحلة الابتداء، وأنه لا خلافة قائمة، ولا قوة لنا؟!"},{"paragraphIndex":2552,"physicalPage":320,"adjustedPage":319,"text":"تُرى هل كانت الحركات الجهادية التي طردت الاحتلال سوف تهزم المحتلين لو أنها أخذت بوجوب العودة إلى المرحلة المكية؟!"},{"paragraphIndex":2553,"physicalPage":320,"adjustedPage":319,"text":"وهل ستقبل أيُّ حركة تحررية عالمية غيورة على وطنها أبية على الاستسلام للاحتلال بهذا المنطق وأمثاله؟!"},{"paragraphIndex":2554,"physicalPage":320,"adjustedPage":319,"text":"وهل يورث الانتظار في مثل هذه الظروف إلا مزيدًا من تمكين الاحتلال؟!"},{"paragraphIndex":2555,"physicalPage":320,"adjustedPage":319,"text":"ثم هل كانت المرحلة المكية مرحلة توزير في وزارات طاغوتية، وترشيح لبرلمانات، وأخذ بوسائل السلم والترف؟! أم كانت مرحلة شدة وبلاء وسحل في الصحراء وحرق بالنار والجمر وخنق بالدخان وتجويع وتشريد؟!"},{"paragraphIndex":2556,"physicalPage":320,"adjustedPage":319,"text":"فما لكم تأخذون من المراحل ما يُلبي أهواءكم، فمن المرحلة المكية تأخذون ترك الجهاد ﴿كُفُّوا أَيْدِيَكُمْ﴾، ومن المرحلة المدنية تأخذون الصلح مع العدو المحتل ﴿وَإِنْ جَنَحُوا لِلسَّلْمِ﴾، والقرآن والسُنّة بريئان من تلفيقاتكم المسيئة."},{"paragraphIndex":2557,"physicalPage":320,"adjustedPage":319,"text":"إنه التلفيق المنهجي والجماعي في تناول دين الله عز وجل."},{"paragraphIndex":2558,"physicalPage":321,"adjustedPage":320,"text":"إنها منهجية التملص من عزائم الأمور في كل شؤون هذه النوعية من الجماعات، ويكفي شاهدًا عليهم أن تنظروا في جميع شؤون حياتهم، فلقد كانوا أشد الناس مناداةً بالجهاد قبل وقوعه، فمظاهر حياتهم تُنبيك أنَّ حياتهم جهادية، وخطبهم نارية، وأناشيدهم فدائية، فلما أتى الله بالجهاد إلى البلاد أخرجوا الأعذار القديمة، وما هي إلا أعذار المنافقين الأولى الذين تعالت أصواتهم بالجهاد وعلا صراخهم به، ثم لما كُتب عليهم تولوا، ولهؤلاء القدرة على التلون والتمطيط والالتفاف والروغان بطريقة يصعب على المؤمن المخلص تصورها، فمع أنَّ موقفهم من الجهاد هو التخذيل والتعويق، فإنَّ موقفهم بعد عودة المؤمنين هو دعوى رغبتهم في الجهاد، وأنهم ما تركوه حبًا في القعود، وربما اعترفوا بالحقيقة كما قال تعالى: ﴿سَيَقُولُ لَكَ الْمُخَلَّفُونَ مِنَ الْأَعْرَابِ شَغَلَتْنَا أَمْوَالُنَا وَأَهْلُونَا فَاسْتَغْفِرْ لَنَا يَقُولُونَ بِأَلْسِنَتِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ قُلْ فَمَنْ يَمْلِكُ لَكُمْ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًا بَلْ كَانَ اللَّهُ بِمَا تَعْمَلُونَ خَبِيرًا (11) بَلْ ظَنَنْتُمْ أَنْ لَنْ يَنْقَلِبَ الرَّسُولُ وَالْمُؤْمِنُونَ إِلَى أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَلِكَ فِي قُلُوبِكُمْ وَظَنَنْتُمْ ظَنَّ السَّوْءِ وَكُنْتُمْ قَوْمًا بُورًا (12) وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا (13) وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (14)﴾ [الفتح: 11-14]."},{"paragraphIndex":2559,"physicalPage":321,"adjustedPage":320,"text":"فإذا اقترب المغنم، أو ظنَّ ذلك المنافقون، ورأوا أنَّ رحلة الجهاد أصبحت ما بين انتصارات لا شوكة فيها، ومغانم باردة، بادروا بالمشاركة قبل غيرهم، كما قال سبحانه عنهم من قبل: ﴿سَيَقُولُ الْمُخَلَّفُونَ إِذَا انْطَلَقْتُمْ إِلَى مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ يُرِيدُونَ أَنْ يُبَدِّلُوا كَلَامَ اللَّهِ قُلْ لَنْ تَتَّبِعُونَا كَذَلِكُمْ قَالَ اللَّهُ مِنْ قَبْلُ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا بَلْ كَانُوا لَا يَفْقَهُونَ إِلَّا قَلِيلًا (15) قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَى قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُقَاتِلُونَهُمْ أَوْ يُسْلِمُونَ فَإِنْ تُطِيعُوا يُؤْتِكُمُ اللَّهُ أَجْرًا حَسَنًا وَإِنْ تَتَوَلَّوْا كَمَا تَوَلَّيْتُمْ مِنْ قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا (16)﴾ [الفتح: 15-16]."},{"paragraphIndex":2560,"physicalPage":321,"adjustedPage":320,"text":"ولا يمكن لسفينة الجهاد أن ترسو على بر النصر -وهي راسية راسية بإذن الله- إلا بأخذ كلام الله الذي تنزّل يومًا من الأيام كأنه يتنزّل اليوم، سواء ما كان منه في الإيمان أو ما كان منه في النفاق، وينبغي أن يكون حكمنا على المواقف والقرارات والكلام، فحتى الصحابة ما كانوا يعلمون المنافقين بأعيانهم وأسمائهم، كما قال شيخ الإسلام: «وكما أنه صلى الله عليه وسلم كان يعلم بعض المنافقين، ولا يعلم بعضهم، كما بينه قوله: ﴿وَمِمَّنْ حَوْلَكُمْ مِنَ الْأَعْرَابِ مُنَافِقُونَ وَمِنْ أَهْلِ الْمَدِينَةِ مَرَدُوا عَلَى النِّفَاقِ لَا تَعْلَمُهُمْ نَحْنُ نَعْلَمُهُمْ﴾ [التوبة: 101]، كذلك خلفاؤه بعده وورثته قد يعلمون بعض المنافقين، ولا يعلمون بعضهم، وفي المنتسبين إلى الإسلام من عامة الطوائف منافقون كثيرون في الخاصة والعامة، ويسمون الزنادقة»(\u0002)."},{"paragraphIndex":2561,"physicalPage":322,"adjustedPage":321,"text":"ولا تزال سِير المنتصرين من المؤمنين المجاهدين تُنبيك أنّ الوحي الذي ألهمهم النصر، ودلهم على دربه، هو الوحي الأول الذي أُنزل على محمد صلى الله عليه وسلم، وكم يقف المرء متعجبًا من أحوال بعض إخواننا حسني النوايا من الذين يحاولون أن يجاملوا على حساب آيات الله تعالى بحكم أنَّ هؤلاء المستوزرين أو البرلمانيين نياتهم طيبة، وأنهم يصلون، وأنهم اجتهدوا، وأنهم، وأنهم، وما علِموا أنَّ هذا الجهاد يُفرِّز ويمحص ويحكم على الجميع، وأن حكم الله ينبغي أن يُعمل به، ولا يُلغى على المنافقين وعلى المؤمنين من خلال المواقف والأقوال والأعمال."},{"paragraphIndex":2562,"physicalPage":322,"adjustedPage":321,"text":"فالفتنة التترية الكاسحة حين وصلت دمشق، سبقتها روائح عفن البشر من بغداد، وصراخ الفجائع، وأخبار الفضائح التي أطبقت أخبارها دمشق وما وراءها ... كتب شيخ الإسلام وهو القائد الإيماني والميداني رسالة، وما أعظمها من رسالة، أنقل بعضها؛ ليعتبر منها إخواننا هؤلاء، قال في أولها:"},{"paragraphIndex":2563,"physicalPage":322,"adjustedPage":321,"text":"«إلى من يصل إليه من المؤمنين والمسلمين، سلام عليكم ورحمة الله وبركاته، فإنا نحمد إليكم الله الذي لا إله إلا هو، وهو للحمد أهل، وهو على كل شيء قدير، ونسأله أن يصلي على صفوته من خليقته وخيرته من بريته محمد عبده ورسوله صلى الله عليه وعلى آله وسلم تسليمًا."},{"paragraphIndex":2564,"physicalPage":322,"adjustedPage":321,"text":"أما بعد: فقد صدق الله وعده، ونصر عبده، وأعز جنده، وهزم الأحزاب وحده: ﴿وَرَدَّ اللَّهُ الَّذِينَ كَفَرُوا بِغَيْظِهِمْ لَمْ يَنَالُوا خَيْرًا وَكَفَى اللَّهُ الْمُؤْمِنِينَ الْقِتَالَ وَكَانَ اللَّهُ قَوِيًّا عَزِيزًا (25)﴾ [الأحزاب: 25]، والله تعالى يُحَقِّقُ لنا التّمام بقوه: ﴿وَأَنْزَلَ الَّذِينَ ظَاهَرُوهُمْ مِنْ أَهْلِ الْكِتَابِ مِنْ صَيَاصِيهِمْ وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ فَرِيقًا تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًا (26) وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَارَهُمْ وَأَمْوَالَهُمْ وَأَرْضًا لَمْ تَطَئُوهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا (27)﴾ [الأحزاب: 26-27]، فإنَّ هذه الفتنة التي ابتلي بها المسلمون مع هذا العدو المفسد الخارج عن شريعة الإسلام، قد جرى فيها شبيه بما جرى للمسلمين مع عدوهم على عهد رسول الله صلى الله عليه وسلم في المغازي التي أنزل الله فيها كتبه، وابتلى بها نبيه والمؤمنين، مما هو أسوة لمن كان يرجو الله واليوم الآخر، وذكر الله كثيرًا إلى يوم القيامة، فإنَّ نصوص الكتاب والسنة، اللذين هما دعوة محمد صلى الله عليه وسلم يتناولان عموم الخلق بالعموم اللفظي والمعنوي، أو بالعموم المعنوي، وعهود الله في كتابه وسنة رسوله صلى الله عليه وسلم تنال آخر هذه الأمة كما نالت أولها، وإنما قص الله علينا قصص من قبلنا من الأمم؛ لتكون عبرة لنا، فنشّبه حالنا بحالهم، ونقيس أواخر الأمم بأوائلها، فيكون للمؤمن من المتأخرين شبه بما كان للمؤمن من المتقدمين، ويكون للكافر والمنافق من المتأخرين شبه بما كان للكافر والمنافق من المتقدمين، كما قال تعالى لما قصّ قصّة يوسف مفصلة وأجمل قصص الأنبياء، ثم قال: ﴿لَقَدْ كَانَ فِي قَصَصِهِمْ عِبْرَةٌ لِأُولِي الْأَلْبَابِ مَا كَانَ حَدِيثًا يُفْتَرَى﴾ [يوسف: 111]؛ أي: هذه القصص المذكورة في الكتاب ليست بمنزلة ما يُفترى من القصص المكذوبة، كنحو ما يُذكر في الحروب من السير المكذوبة."},{"paragraphIndex":2565,"physicalPage":323,"adjustedPage":322,"text":"وقال تعالى لما ذكر قصة فرعون: ﴿فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَى (25) إِنَّ فِي ذَلِكَ لَعِبْرَةً لِمَنْ يَخْشَى (26)﴾ [النازعات: 25-26]، وقال في سيرة نبينا محمد صلى الله عليه وسلم مع أعدائه ببدر وغيرها: ﴿قَدْ كَانَ لَكُمْ آيَةٌ فِي فِئَتَيْنِ الْتَقَتَا فِئَةٌ تُقَاتِلُ فِي سَبِيلِ اللَّهِ وَأُخْرَى كَافِرَةٌ يَرَوْنَهُمْ مِثْلَيْهِمْ رَأْيَ الْعَيْنِ وَاللَّهُ يُؤَيِّدُ بِنَصْرِهِ مَنْ يَشَاءُ إِنَّ فِي ذَلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ (13)﴾ [آل عمران: 13]، وقال تعالى في محاصرته لبني النَّضير: ﴿هُوَ الَّذِي أَخْرَجَ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ مِنْ دِيَارِهِمْ لِأَوَّلِ الْحَشْرِ مَا ظَنَنْتُمْ أَنْ يَخْرُجُوا وَظَنُّوا أَنَّهُمْ مَانِعَتُهُمْ حُصُونُهُمْ مِنَ اللَّهِ فَأَتَاهُمُ اللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ يُخْرِبُونَ بُيُوتَهُمْ بِأَيْدِيهِمْ وَأَيْدِي الْمُؤْمِنِينَ فَاعْتَبِرُوا يَا أُولِي الْأَبْصَارِ (2)﴾ [الحشر: 2]، فأمرنا أن نعتبر بأحوال المتقدمين علينا من هذه الأمة، وممّن قبلها من الأمم."},{"paragraphIndex":2566,"physicalPage":324,"adjustedPage":323,"text":"وذكر في غير موضع: أنَّ سُنَّته في ذلك سُنَّة مُطَّردة وعادته مستمرة، فقال تعالى: ﴿لَئِنْ لَمْ يَنْتَهِ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْمُرْجِفُونَ فِي الْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَا إِلَّا قَلِيلًا (60) مَلْعُونِينَ أَيْنَمَا ثُقِفُوا أُخِذُوا وَقُتِّلُوا تَقْتِيلًا (61) سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا (62)﴾ [الأحزاب: 60-62]، وقال تعالى: ﴿وَلَوْ قَاتَلَكُمُ الَّذِينَ كَفَرُوا لَوَلَّوُا الْأَدْبَارَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا (22) سُنَّةَ اللَّهِ الَّتِي قَدْ خَلَتْ مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا (23)﴾ [الفتح: 22-23]، وأخبر سبحانه أنَّ دأب الكافرين من المستأخرين كدأب الكافرين من المستقدمين؛ فينبغي للعقلاء أن يعتبروا بسُنّة الله، وأيامه في عباده، ودأب الأمم وعاداتهم، لا سيما في مثل هذه الحادثة العظيمة، التي طبق الخافقين خبرها، واستطار في جميع ديار الإسلام شررها، وأطلع فيها النفاق ناصية رأسه، وكشَّر فيها الكفر عن أنيابه وأضراسه، وكاد فيه عمود الكتاب أن يجتث ويخترم، وحبل الإيمان أن ينقطع ويصطلم، وعقر دار المؤمنين أن يحل بها البوار، وأن يزول هذا الدين باستيلاء الفجرة التتار، وظن المنافقون والذين في قلوبهم مرض أنَّ ما وعدهم الله ورسوله إلا غرورا، وأن لن ينقلب حزب الله ورسوله إلى أهليهم أبدا، وزُيّن ذلك في قلوبهم، وظنوا ظن السوء، وكانوا قومًا بورًا، ونزلت فتنة تركت الحليم فيها حيران، وأنزلت الرجل الصاحي منزلة السكران، وتركت الرجل اللبيب لكثرة الوسواس ليس بالنائم ولا اليقظان، وتناكرت فيها قلوب المعارف والإخوان، حتى بقي للرجل بنفسه شغل عن أن يغيث اللهفان، وميَّز الله فيها أهل البصائر والإيقان، من الذين في قلوبهم مرض أو نفاق وضعف إيمان، ورفع بها أقوامًا إلى الدرجات العالية، كما خفض بها أقوامًا إلى المنازل الهاوية، وكفَّر بها عن آخرين أعمالهم الخاطئة، وحدث من أنواع البلوى ما جعلها قيامة مختصرة من القيامة الكبرى، فإنَّ الناس تفرقوا فيها ما بين شقي وسعيد، كما يتفرقون كذلك في اليوم الموعود، وفرَّ الرجل فيها من أخيه وأمه وأبيه، إذ كان لكل امرئ منهم شأن يغنيه، وكان من الناس من أقصى همته النجاة بنفسه لا يلوي على ماله ولا ولده ولا عرسه، كما أنَّ منهم من فيه قوة على تخليص الأهل والمال، وآخر فيه زيادة معونة لمن هو منه ببال، وآخر منزلته منزلة الشفيع المطاع، وهم درجات عند الله في المنفعة والدفاع، ولم تنفع المنفعة الخالصة من الشكوى إلا الإيمان والعمل الصالح والبر والتقوى، وبُليت فيها السرائر، وظهرت الخبايا التي كانت تكنها الضمائر، وتبيّن أنَّ البهرج من الأقوال والأعمال يخون صاحبه أحوج ما كان إليه في المآل، وذم سادته وكبراءه من أطاعهم فأضلوه السبيلا، كما حمد ربه من صدق في إيمانه فاتخذ مع الرسول سبيلاً، وبان صدق ما جاءت به الآثار النبوية من الأخبار بما يكون، وواطأتها قلوب الذين هم في هذه الأمة مُحدَّثون، كما تواطأت عليه المبشرات التي أُريها المؤمنون، وتبيّن فيها الطائفة المنصورة الظاهرة على الدين، الذين لا يضرهم من خالفهم ولا من خذلهم إلى يوم القيامة، حيث تحزبت الناس ثلاثة أحزاب: حزب مجتهد في نصر الدين، وآخر خاذل له، وآخر خارج عن شريعة الإسلام، وانقسم الناس ما بين مأجور ومعذور، وآخر قد غره بالله الغرور، وكان هذا الامتحان تمييزًا من الله وتقسيمًا: ﴿لِيَجْزِيَ اللَّهُ الصَّادِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ الْمُنَافِقِينَ إِنْ شَاءَ أَوْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا (24)﴾ [الأحزاب: 24]»(\u0002)."},{"paragraphIndex":2567,"physicalPage":324,"adjustedPage":323,"text":"ولقد مرَّ بالمسلمين قريبًا من هذا الحال، فعاتبهم رب العالمين، فاستعتبوا وندموا، قال الله تعالى: ﴿أَلَمْ تَرَ إِلَى الَّذِينَ قِيلَ لَهُمْ كُفُّوا أَيْدِيَكُمْ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ إِذَا فَرِيقٌ مِنْهُمْ يَخْشَوْنَ النَّاسَ كَخَشْيَةِ اللَّهِ أَوْ أَشَدَّ خَشْيَةً وَقَالُوا رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ لَوْلَا أَخَّرْتَنَا إِلَى أَجَلٍ قَرِيبٍ قُلْ مَتَاعُ الدُّنْيَا قَلِيلٌ وَالْآخِرَةُ خَيْرٌ لِمَنِ اتَّقَى وَلَا تُظْلَمُونَ فَتِيلًا (77) أَيْنَمَا تَكُونُوا يُدْرِكْكُمُ الْمَوْتُ وَلَوْ كُنْتُمْ فِي بُرُوجٍ مُشَيَّدَةٍ وَإِنْ تُصِبْهُمْ حَسَنَةٌ يَقُولُوا هَذِهِ مِنْ عِنْدِ اللَّهِ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ يَقُولُوا هَذِهِ مِنْ عِنْدِكَ قُلْ كُلٌّ مِنْ عِنْدِ اللَّهِ فَمَالِ هَؤُلَاءِ الْقَوْمِ لَا يَكَادُونَ يَفْقَهُونَ حَدِيثًا (78) مَا أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ اللَّهِ وَمَا أَصَابَكَ مِنْ سَيِّئَةٍ فَمِنْ نَفْسِكَ وَأَرْسَلْنَاكَ لِلنَّاسِ رَسُولًا وَكَفَى بِاللَّهِ شَهِيدًا (79)﴾ [النساء: 77-79]."},{"paragraphIndex":2568,"physicalPage":325,"adjustedPage":324,"text":"قال ابن كثير: «كان المؤمنون في ابتداء الإسلام وهم بمكة مأمورين بالصلاة والزكاة، وإن لم تكن ذات النُّصُب، لكن كانوا مأمورين بمواساة الفقراء منهم، وكانوا مأمورين بالصفح والعفو عن المشركين والصبر إلى حين، وكانوا يتحرقون ويودون لو أمروا بالقتال؛ ليشتفوا من أعدائهم، ولم يكن الحال إذ ذاك مناسبًا؛ لأسباب كثيرة منها: قلة عددهم بالنسبة إلى كثرة عدد عدوهم، ومنها: كونهم كانوا في بلدهم، وهو بلد حرام، أشرف بقاع الأرض، فلم يكن الأمر بالقتال فيه ابتداءً لائقًا، فلهذا لم يؤمر بالجهاد إلا بالمدينة لما صارت لهم دار ومِنعة وأنصار، هذا لما أُمروا بما كانوا يودونه، جزع بعضهم منه، وخافوا من مواجهة الناس خوفًا شديدًا، ﴿وَقَالُوا رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ لَوْلَا أَخَّرْتَنَا إِلَى أَجَلٍ قَرِيبٍ﴾ [النساء: 77]؛ أي: لولا أخرت فرضه إلى مدة أخرى، فإن فيه سفك الدماء، ويتم الأبناء، وتأيَّم النساء، وهذه الآية كقوله تعالى: ﴿وَيَقُولُ الَّذِينَ آمَنُوا لَوْلَا نُزِّلَتْ سُورَةٌ فَإِذَا أُنْزِلَتْ سُورَةٌ مُحْكَمَةٌ وَذُكِرَ فِيهَا الْقِتَالُ﴾ [محمد: 20] ... الآيات، وقال مجاهد: إنَّ هذه الآية نزلت في اليهود، رواه ابن جرير، وقوله: ﴿قُلْ مَتَاعُ الدُّنْيَا قَلِيلٌ وَالْآخِرَةُ خَيْرٌ لِمَنِ اتَّقَى﴾ [النساء: 77]؛ أي: من أعمالكم بل توفونها أتم الجزاء، وهذه تسلية لهم عن الدنيا، وترغيب لهم في الآخرة، وتحريض لهم على الجهاد، وقال ابن أبي حاتم: حدثنا أبي، حدثنا يعقوب بن إبراهيم الدورقي، حدثنا عبد الرحمن بن مهدي، حدثنا حماد بن زيد عن هشام، قال: قرأ الحسن: ﴿وَلَا تُظْلَمُونَ فَتِيلًا (77)﴾، قال: رحم الله عبدًا صحبها على حسب ذلك، وما الدنيا كلها أولها وآخرها إلا كرجل نام نومة فرأى في منامه بعض ما يحب ثم انتبه، وقال ابن معين: كان أبو مسهر ينشد:"},{"paragraphIndex":2569,"physicalPage":325,"adjustedPage":324,"text":"ولا خير في الدنيا لمن لم يكن له"},{"paragraphIndex":2570,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2571,"physicalPage":325,"adjustedPage":324,"text":"من الله في دار المقام نصيب"},{"paragraphIndex":2572,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2573,"physicalPage":325,"adjustedPage":324,"text":"فإن تُعجب الدنيا رجالاً فإنها"},{"paragraphIndex":2574,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2575,"physicalPage":325,"adjustedPage":324,"text":"متاع قليل والزوال قريب"},{"paragraphIndex":2576,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2577,"physicalPage":325,"adjustedPage":324,"text":"وقوله تعالى: ﴿أَيْنَمَا تَكُونُوا يُدْرِكْكُمُ الْمَوْتُ وَلَوْ كُنْتُمْ فِي بُرُوجٍ مُشَيَّدَةٍ﴾ [النساء: 78]؛ أي: أنتم صائرون إلى الموت لا محالة، ولا ينجو منه أحدٌ منكم، كما قال تعالى: ﴿كُلُّ مَنْ عَلَيْهَا فَانٍ (26)﴾ [الرحمن: 26]، وقال تعالى: ﴿كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ﴾ [آل عمران: 185]، وقال تعالى: ﴿وَمَا جَعَلْنَا لِبَشَرٍ مِنْ قَبْلِكَ الْخُلْدَ﴾ [الأنبياء: 34]، والمقصود أن كل أحد صائر إلى الموت لا محالة، ولا ينجيه من ذلك شيء، وسواء عليه جاهد أو لم يجاهد، فإن له أجلاً محتومًا، وأمدًا مقسومًا، كما قال خالد بن الوليد حين جاء الموت على فراشه: لقد شهدت كذا وكذا موقفًا، وما من عضو من أعضائي إلا وفيه جرح من طعنة أو رمية، وها أنا أموت على فراشي، فلا نامت أعين الجبناء، وقوله: ﴿وَلَوْ كُنْتُمْ فِي بُرُوجٍ مُشَيَّدَةٍ﴾ [النساء: 78]؛ أي: حصينة منيعة عالية رفيعة، وقيل: هي بروج في السماء، قاله السدي، وهو ضعيف، والصحيح أنها المنيعة؛ أي: لا يغني حذر وتحصن من الموت، كما قال زهير بن أبي سلمى:"},{"paragraphIndex":2578,"physicalPage":325,"adjustedPage":324,"text":"ومن خاف أسباب المنية يلقها"},{"paragraphIndex":2579,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2580,"physicalPage":325,"adjustedPage":324,"text":"ولو رام أسباب السماء بسلَّم»(\u0002)"},{"paragraphIndex":2581,"physicalPage":325,"adjustedPage":324,"text":""},{"paragraphIndex":2582,"physicalPage":326,"adjustedPage":325,"text":"وإني -والله أعلم- لأرى أنَّ الأمر منسوب للصحابة رضي الله عنهم أجمعين، وليس لغيرهم من اليهود أو المنافقين؛ لأنَّ طلب القتال المذكور في الآية كان في مكة، وليس في مكة آنذاك منافقون، فلما كُتب عليهم القتال في المدينة، قالوا الذي قالوه، فإنَّ في القتال رهبة في أوله كما قال الله تعالى عن المؤمنين البدريين أول مرة: ﴿يُجَادِلُونَكَ فِي الْحَقِّ بَعْدَ مَا تَبَيَّنَ كَأَنَّمَا يُسَاقُونَ إِلَى الْمَوْتِ وَهُمْ يَنْظُرُونَ (6)﴾ [الأنفال: 6]."},{"paragraphIndex":2583,"physicalPage":326,"adjustedPage":325,"text":"ويكفي أن يكون هو قول ابن عباس، وكذا جمهور المفسرين."},{"paragraphIndex":2584,"physicalPage":326,"adjustedPage":325,"text":"قال ابن عباس رضي الله عنه: «إنَّ عبد الرحمن بن عوف وأصحابًا له أتوا النبي صلى الله عليه وسلم بمكة، فقالوا: يا نبي الله، كنا في عزٍّ ونحن مشركون، فلما آمنا صرنا أذلة، قال: (إني أمرت بالعفو فلا تقاتلوا القوم)، فلما حوّله الله إلى المدينة أمره بالقتال، فكفوا، فأنزل الله: ﴿أَلَمْ تَرَ إِلَى الَّذِينَ قِيلَ لَهُمْ كُفُّوا أَيْدِيَكُمْ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ إِذَا فَرِيقٌ مِنْهُمْ يَخْشَوْنَ النَّاسَ كَخَشْيَةِ اللَّهِ أَوْ أَشَدَّ خَشْيَةً وَقَالُوا رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ لَوْلَا أَخَّرْتَنَا إِلَى أَجَلٍ قَرِيبٍ قُلْ مَتَاعُ الدُّنْيَا قَلِيلٌ وَالْآخِرَةُ خَيْرٌ لِمَنِ اتَّقَى وَلَا تُظْلَمُونَ فَتِيلًا (77)﴾ [النساء: 77]»(\u0002)."},{"paragraphIndex":2585,"physicalPage":326,"adjustedPage":325,"text":"فإذا ثبت ذلك فمن المستحيل أن يكون مقصد المؤمنين الاعتراض على مشروعية القتال في قوله تعالى: ﴿لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ﴾، إنما مقصودهم لِمَ كتبته في هذا الوقت؟ لولا أخرته إلى وقت آخر نتمكن فيه من الإعداد، أو نأخذ فيه راحة من عناء مكة وبلاءاته، ولذا قال سبحانه على لسانهم: ﴿لَوْلَا أَخَّرْتَنَا إِلَى أَجَلٍ قَرِيبٍ﴾."},{"paragraphIndex":2586,"physicalPage":326,"adjustedPage":325,"text":"قال البقاعي: «﴿لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ﴾؛ أي: ونحن الضعفاء، ﴿لَوْلَا أَخَّرْتَنَا﴾؛ أي: عن الأمر بالقتال، ﴿إِلَى أَجَلٍ قَرِيبٍ﴾؛ أي: لنأخذ راحة مما كنا فيه من الجهد من الكفار بمكة»(\u0002)."},{"paragraphIndex":2587,"physicalPage":327,"adjustedPage":326,"text":"وينص على هذا ابن عاشور فيقول: «وقولهم: ﴿رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا الْقِتَالَ﴾، إنما هو قولهم في نفوسهم على معنى عدم الاهتداء لحكمة تعليل الأمر بالقتال وظنَّهم أنَّ ذلك بلوى، والأجل القريب، مدَّة متأخَّرة ريثما يتمُّ استعدادهم، مثل قوله: ﴿فَيَقُولَ رَبِّ لَوْلَا أَخَّرْتَنِي إِلَى أَجَلٍ قَرِيبٍ فَأَصَّدَّقَ﴾ [المنافقون: 10]»(\u0002)."},{"paragraphIndex":2588,"physicalPage":327,"adjustedPage":326,"text":"ثانيًا: أما الجواب الثاني على من يرى ضرورة الدخول في المجلس التشريعي والوزارة بناءً على حسن الحسبة المطلوبة لأحسن النتائج، فإنَّ المنافقين منذ العصر الأول وإلى يوم القيامة لا يفتؤون يدقون على جانب حسن حساب النتائج وضرورته، وضعف المجاهدين في هذا الجانب، وأنَّ التزام ذلك الحكم الذي التزمه المجاهدون مخالف للحسابات الصح وأنه يأتي بنتائج معكوسة، فالحسبة التي يذكرها طلاب الاستثناء لدخولنا البرلمان والوزارة هي حسبة قد تُقبل من الناحية المادية المجردة عن التوكل على الله، والمجردة عن التزام حكم الله، والتي يستوي في استخراج نتيجتها المؤمن وغير المؤمن، وهي نفس النتيجة التي توصل لها المنافقون في استنتاجاتهم المستقبلية أيام النبي صلى الله عليه وسلم، فحين جاءت الأحزاب من كل مكان إلى المدينة في معركة الخندق، ظنَّ المنافقون بناءً على الحسبة الواضحة والمقدمات المنطقية أنَّ نتيجة ذلك هي الهزيمة المحققة بالنبي صلى الله عليه وسلم وأصحابه، وذهاب المدينة كلها، فقال سبحانه: ﴿وَإِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ إِلَّا غُرُورًا (12) وَإِذْ قَالَتْ طَائِفَةٌ مِنْهُمْ يَا أَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَارْجِعُوا وَيَسْتَأْذِنُ فَرِيقٌ مِنْهُمُ النَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِيَ بِعَوْرَةٍ إِنْ يُرِيدُونَ إِلَّا فِرَارًا (13) وَلَوْ دُخِلَتْ عَلَيْهِمْ مِنْ أَقْطَارِهَا ثُمَّ سُئِلُوا الْفِتْنَةَ لَآتَوْهَا وَمَا تَلَبَّثُوا بِهَا إِلَّا يَسِيرًا (14) وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ مِنْ قَبْلُ لَا يُوَلُّونَ الْأَدْبَارَ وَكَانَ عَهْدُ اللَّهِ مَسْئُولًا (15) قُلْ لَنْ يَنْفَعَكُمُ الْفِرَارُ إِنْ فَرَرْتُمْ مِنَ الْمَوْتِ أَوِ الْقَتْلِ وَإِذًا لَا تُمَتَّعُونَ إِلَّا قَلِيلًا (16) قُلْ مَنْ ذَا الَّذِي يَعْصِمُكُمْ مِنَ اللَّهِ إِنْ أَرَادَ بِكُمْ سُوءًا أَوْ أَرَادَ بِكُمْ رَحْمَةً وَلَا يَجِدُونَ لَهُمْ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (17) قَدْ يَعْلَمُ اللَّهُ الْمُعَوِّقِينَ مِنْكُمْ وَالْقَائِلِينَ لِإِخْوَانِهِمْ هَلُمَّ إِلَيْنَا وَلَا يَأْتُونَ الْبَأْسَ إِلَّا قَلِيلًا (18) أَشِحَّةً عَلَيْكُمْ فَإِذَا جَاءَ الْخَوْفُ رَأَيْتَهُمْ يَنْظُرُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَالَّذِي يُغْشَى عَلَيْهِ مِنَ الْمَوْتِ فَإِذَا ذَهَبَ الْخَوْفُ سَلَقُوكُمْ بِأَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى الْخَيْرِ أُولَئِكَ لَمْ يُؤْمِنُوا فَأَحْبَطَ اللَّهُ أَعْمَالَهُمْ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (19) يَحْسَبُونَ الْأَحْزَابَ لَمْ يَذْهَبُوا وَإِنْ يَأْتِ الْأَحْزَابُ يَوَدُّوا لَوْ أَنَّهُمْ بَادُونَ فِي الْأَعْرَابِ يَسْأَلُونَ عَنْ أَنْبَائِكُمْ وَلَوْ كَانُوا فِيكُمْ مَا قَاتَلُوا إِلَّا قَلِيلًا (20)﴾ [الأحزاب: 12-20]."},{"paragraphIndex":2589,"physicalPage":327,"adjustedPage":326,"text":"وكم في هذه الآيات من كنوز عظيمة في علم الحساب الإيماني، أوجزُ بعضها في هذه الملاحظات:"},{"paragraphIndex":2590,"physicalPage":328,"adjustedPage":327,"text":"الملاحظة الأولى: إذا تأملت الآيات ثانيةً تبين أنَّ المنافقين ما أطلقوا صفة «الغرور» على وعد الله عز وجل ورسوله صلى الله عليه وسلم إلا لأنها لم تكن قائمة في نظرهم على حسبة منطقية، ولذا لم تأتِ بالنتائج الصحيحة، فلم يكن الوعد صحيحًا بشهادة ما يرونه بأعينهم من تجمع الأحزاب، ولذلك قالوا: ﴿مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ إِلَّا غُرُورًا﴾، وهل الغرور إلا مخالفة للواقع بتعظيم ما ليس بعظيم، ولذا لا بد أن تكون نتيجته غير محسوبة وغير صحيحة!"},{"paragraphIndex":2591,"physicalPage":328,"adjustedPage":327,"text":"قال ابن عطية الأندلسي في تفسيره ﴿غُرُورًا﴾: «أي أمرًا يغرُّنا، ويوقعنا فيما لا طاقة لنا به»(\u0002)."},{"paragraphIndex":2592,"physicalPage":328,"adjustedPage":327,"text":"الملاحظة الثانية: إن المنافقين لا يحسبون حسبة نظرية فحسب، بل يبنون على معتقدهم الفاسد موقفًا فاسدًا، فكان مقترحهم هو النجاة بالنفس، وترك ساح الجهاد، ﴿وَإِذْ قَالَتْ طَائِفَةٌ مِنْهُمْ يَا أَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَارْجِعُوا وَيَسْتَأْذِنُ فَرِيقٌ مِنْهُمُ النَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِيَ بِعَوْرَةٍ إِنْ يُرِيدُونَ إِلَّا فِرَارًا (13)﴾ [الأحزاب: 13]، ﴿يَحْسَبُونَ الْأَحْزَابَ لَمْ يَذْهَبُوا وَإِنْ يَأْتِ الْأَحْزَابُ يَوَدُّوا لَوْ أَنَّهُمْ بَادُونَ فِي الْأَعْرَابِ﴾ [الأحزاب: 20]."},{"paragraphIndex":2593,"physicalPage":328,"adjustedPage":327,"text":"فلم يكن بمقدور هؤلاء المنافقين الصبر على هذا الأمر، فهم يرون بأعينهم شيئًا، ويرون أنَّ الله وعدهم بشيء غير ما يرونه، فكانت دعواهم بعدم الحسبة الصحيحة من قبل!"},{"paragraphIndex":2594,"physicalPage":328,"adjustedPage":327,"text":"قال ابن كثير في تفسيره: «أما المنافق فنجم نفاقه، والذي في قلبه شبهة أو حسیكه [عداوة وحقد]، ضعف حاله، فتنفس بما يجده من الوسواس في نفسه؛ لضعف إيمانه، وشدة ما هو فيه من ضيق الحال»(\u0002)."},{"paragraphIndex":2595,"physicalPage":328,"adjustedPage":327,"text":"الملاحظة الثالثة: «إنَّ المنافقين حين يتبعون أسلوب الاتهام لأهل الحق، ﴿مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ إِلَّا غُرُورًا (12)﴾، فإنهم يتهمون كل من صدَّق هذا الوعد بأنه مغرور مخدوع، لا يُحسن حساب الأمور، ولا حساب النتائج!"},{"paragraphIndex":2596,"physicalPage":329,"adjustedPage":328,"text":"وهذه الشنشنة المنافقة التي قيلت على حواف الخندق، هي التي يلمز بها ويهمز أحفاد هؤلاء والمخدوعون بهم، وهي ذات الدعوى التي يقولونها اليوم بوجوب ترك ساح الجهاد، والعودة لحماية البيوت وستر الأعراض، وقبول العروض المغرية في ذلك؛ خشية التهديدات المخيفة بتسليط الأحزاب المجوسية على أعراضنا ومساجدنا، فليس ثمة نتيجة تُرى إلا ترك الجهاد، وأخذ زمام المبادرة في المشاركات مع الصليبيين والرافضة والأحزاب الأخرى في إدارة شؤون البلاد من أعلى الهرم، من البرلمان والوزارة!"},{"paragraphIndex":2597,"physicalPage":329,"adjustedPage":328,"text":"والمنافقون حين يلجؤون لاتهام المؤمنين بقلة الفقه، وسوء الحسبة، وقلة الإعداد، والاغترار، ونحو ذلك، فهم لا يريدونها مواقف شخصية، بل يسعون دائمًا لحشد المستغفلين من الذين لم يتمكنوا في العلم والإيمان، وممن ما زالوا يحسنون بهم الظن، ولذا فقد كانت دعوتهم لغيرهم عامة، كما قال سبحانه: ﴿وَإِذْ قَالَتْ طَائِفَةٌ مِنْهُمْ يَا أَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَارْجِعُوا﴾، ﴿وَالْقَائِلِينَ لِإِخْوَانِهِمْ هَلُمَّ إِلَيْنَا﴾."},{"paragraphIndex":2598,"physicalPage":329,"adjustedPage":328,"text":"ودعوةٌ مناقضة لدعوة الجهاد، لا بد لها من ستار شرعي ضخم، ودليل مقنع مفحم."},{"paragraphIndex":2599,"physicalPage":329,"adjustedPage":328,"text":"أما الستار الشرعي الذي لقَّوا به دعواهم، فقد ضمنه الله بقوله: ﴿إِنَّ بُيُوتَنَا عَوْرَةٌ﴾؛ فأيُّ عذر يمكن أن يقبله رسول الله صلى الله عليه وسلم أقوى من هذا العذر؟!"},{"paragraphIndex":2600,"physicalPage":329,"adjustedPage":328,"text":"ومن يتحمل عاقبة رد هذا العذر -الخوف على العرض- لو وقع أيُّ شيء بعد ذلك للعرض؟!"},{"paragraphIndex":2601,"physicalPage":329,"adjustedPage":328,"text":"وأيُّ غيرة تبقى كامنة لمن لا يغار على عرضه، وأعراض أهل المدينة وأهل بغداد وأهل البصرة وأهل الأنبار وأهل الشمال والجنوب، إذا لم يستجب لمطلبهم بستر الأعراض وحماية البيوت من خلال الإذن لهم بالعودة لحراستها مباشرة، أو ممارسة الأساليب السياسية في برلمان أو وزارة؛ لتكون النتيجة حمايتها؟!"},{"paragraphIndex":2602,"physicalPage":329,"adjustedPage":328,"text":"فليس أمام أيِّ مسؤول تجاه هذه الدعوة إلا أن يستسلم مقتنعًا أو مكرهًا، وجوابه عندها: نعم اذهبوا واستروا أعراضكم! وهل شرع الجهاد إلا لستر العورات؟ وهل جاءت الرسالات إلا لحفظ الضرورات الخمس؟"},{"paragraphIndex":2603,"physicalPage":329,"adjustedPage":328,"text":"لكن الله الذي لا تخفى عليه خافية يذكر حجتهم كما هي؛ لحكم عظيمة، منها: تكرر هذه الدعوى ما تكرر الجهاد ووجد منافقون."},{"paragraphIndex":2604,"physicalPage":329,"adjustedPage":328,"text":"ومنها: ليعذر الناس القائد إذا رأى أن لا يعذرهم."},{"paragraphIndex":2605,"physicalPage":329,"adjustedPage":328,"text":"ولا يذكر الله سبحانه حجتهم ويتركها، وإنما يظهر الحقيقة التي تغيب عن البشر، وخصوصًا عند ضغط الواقع، وشدة الإلحاح، واللحن في الحجة، والإكثار من المحتجين وحشدهم كما صنع أولئك المنافقون في صيغة خطابهم «يا أهل يثرب»، واليوم يصيحون: «يا أهل العراق»، «يا أهل بغداد»، «يا أهل الأنبار»، «يا أهل كابل» ... لا مقام في الجهاد فارجعوا."},{"paragraphIndex":2606,"physicalPage":330,"adjustedPage":329,"text":"ومن حكمها كذلك: أنه لولا هذه الشدة المزلزلة لربما بقي هؤلاء المنافقون وسط الصفوف المؤمنة آمنين ممكنين، وموطن الثقة، وموضع التقريب والبطانة."},{"paragraphIndex":2607,"physicalPage":330,"adjustedPage":329,"text":"يقول سيد رحمه الله تعالى: «فقد وجد هؤلاء في الكرب المزلزل، والشدة الآخذة بالخناق فرصة للكشف عن خبيثة نفوسهم، وهم آمنون من أن يلومهم أحد، وفرصة للتوهين والتخذيل وبث الشك والريبة في وعد الله ووعد رسوله، وهم مطمئنون أن يأخذهم أحد بما يقولون، فالواقع بظاهره يصدقهم في التوهين والتشكيك، وهم مع هذا منطقيون مع أنفسهم ومشاعرهم، فالهول قد أزاح عنهم ذلك الستار الرقيق من التجمل، وروَّع نفوسهم ترويعًا لا يثبت له إيمانهم المهلهل! فجهروا بحقيقة ما يشعرون غير مبقين ولا متجملين!"},{"paragraphIndex":2608,"physicalPage":330,"adjustedPage":329,"text":"ومثل هؤلاء المنافقين والمرجفين قائمون في كل جماعة، وموقفهم في الشدة هو موقف إخوانهم هؤلاء، فهم نموذج مكرر في الأجيال والجماعات على مدار الزمان!»(\u0002)."},{"paragraphIndex":2609,"physicalPage":330,"adjustedPage":329,"text":"ومن حكمها: أنه سبحانه بعد ما ذكر حجتهم نسفها بكلمة واحدة منه سبحانه نسفًا ﴿إِنْ يُرِيدُونَ إِلَّا فِرَارًا﴾، هذه هي الإرادة الحقيقة للمنافقين الأولين، ولمن سار على طريقهم أو اغتر بحديثهم."},{"paragraphIndex":2610,"physicalPage":330,"adjustedPage":329,"text":"نعم، ربما تكون حادثة أو حوادث فيها عدوان على العرض، وانتهاك للبيوت، فيتعلق بها هؤلاء، معظِّمين لها، ومستشهدين بها في كل مكان -على عاقبة من خالف تحذيراتهم- وهم لا يريدون منها إلا الوصول إلى مقصدهم الحقيقي، وهو الفرار من القتال، وفعلاً جاءت الأخبار إلى النبي صلى الله عليه وسلم، وأرسل النبي صلى الله عليه وسلم يتحقق من خيانة اليهود، ومحاولة اعتدائهم على أعراض المسلمات، ووجده حقيقة، ومع هذا ما ترك موقعه، ولا أمر أحدًا بترك موضعه، مكتفيًا بالتوكل على الله، والتزام مواجهة العدو، وتصرف المسلمات ومن معهن في الحصن(\u0002) كما ذكر ذلك أهل السير."},{"paragraphIndex":2611,"physicalPage":330,"adjustedPage":329,"text":"ومهما كانت أعراضنا اليوم منكشفة، وفي وضع خطير فإنها لن تكون مُعرضة للخطر أكثر من أعراض النبي صلى الله عليه وسلم وأعراض أصحابه في الخندق، فلقد جمع النساء والأطفال في حصن، وكان يشرف عليه اليهود، وليس في داخل المدينة من الرجال إلا المنافقون، وحدثت محاولة اعتداء فعلية على النساء من قبل اليهود."},{"paragraphIndex":2612,"physicalPage":331,"adjustedPage":330,"text":"الملاحظة الرابعة: ثبت الصحابة رضي الله عنها في ساح الجهاد، وما استجابوا لهذا النداء النفاقي والحجة المنافقة ﴿لَا مُقَامَ لَكُمْ فَارْجِعُوا وَيَسْتَأْذِنُ فَرِيقٌ مِنْهُمُ النَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِيَ بِعَوْرَةٍ﴾ [الأحزاب: 13]، إنما كان جوابهم هو مزيد الثبات، ومزيد التسليم، والإيمان، فالله لن يخذلهم في أعراضهم، وهم يذبون عن دينه، منشغلون في الجهاد في سبيله، والمسلم يعلم أنَّ ما يقع من ذلك على الأعراض مثله مثل سائر الابتلاءات كالقتل ظلمًا ونحو ذلك، وكل ذلك لا ينبغي أن يسحب أهل الجهاد من الميدان إلى ميادين أخرى حتى لو كانت حماية مباشرة للبيوت إلا في إطار الجهاد، فكيف إذا كانت حماية غير مباشرة، كالدخول في الوزارة أو البرلمان، مما يرجى منه حماية البيوت بطريق غير مباشر وغير شرعي؟! ومع كل هذا فقد كان الرد الرباني قاطعًا ومحددًا: ﴿إِنْ يُرِيدُونَ إِلَّا فِرَارًا﴾."},{"paragraphIndex":2613,"physicalPage":331,"adjustedPage":330,"text":"فما أقسى الميدان على قلوب هؤلاء المنافقين؟"},{"paragraphIndex":2614,"physicalPage":331,"adjustedPage":330,"text":"إن الحسبة المنطقية عند هؤلاء أنَّ الميدان يساوي الموت، والفرار يساوي الحياة، فلتكن الحياة في البيوت مع النساء والأطفال، أو فلتكن في بادي من بوادي الأعراب مع الإبل والأغنام، فما أحلى الفرار إلى الحياة من الموت؟ المهم أنها حياة ﴿يَوَدُّوا لَوْ أَنَّهُمْ بَادُونَ فِي الْأَعْرَابِ﴾ [الأحزاب: 20]."},{"paragraphIndex":2615,"physicalPage":331,"adjustedPage":330,"text":"الملاحظة الخامسة: لن يتوقف انحدار هؤلاء عند العودة إلى البيوت، وعبادة الله تعالى فيها، والاعتكاف في المساجد، والتفرغ للأعراض والمحتاجين، كما يدعي كثيرون من ورثة أولئك الأوائل، بل هو الانحدار المتواصل بعد الفرار حتى يبلغ قاع الفتنة، وقاع الفتنة هو الكفر، عياذًا بالله من ذلك، فتأمل قوله تعالى: ﴿وَلَوْ دُخِلَتْ عَلَيْهِمْ مِنْ أَقْطَارِهَا ثُمَّ سُئِلُوا الْفِتْنَةَ لَآتَوْهَا وَمَا تَلَبَّثُوا بِهَا إِلَّا يَسِيرًا (14)﴾ [الأحزاب: 14]."},{"paragraphIndex":2616,"physicalPage":331,"adjustedPage":330,"text":"قال ابن كثير: «لو دخل عليهم الأعداء من كل جانب من جوانب المدينة، وقطرٍ من أقطارها، ثم سئلوا الفتنة وهو الدخول في الكفر لدخلوا سريعًا، وهم لا يحافظون على الإيمان، ولا يتمسكون به مع أذى وخوف وفزع، هكذا فسرها قتادة وعبد الرحمن بن زيد وابن جرير، وهذا ذم لهم في غاية الذم»(\u0002)."},{"paragraphIndex":2617,"physicalPage":331,"adjustedPage":330,"text":"والفتنة هنا عامة شاملة لكل أنواع التخلص من أحكام الله إلى أحكام الهوى والشيطان، حتى تبلغ الفتنة العملية أن يتحول من كان مجاهدًا في سبيل الله إلى أن يصبح جاسوسًا على المجاهدين، بل مقاتلاً شرسًا ضد صفه الأول."},{"paragraphIndex":2618,"physicalPage":332,"adjustedPage":331,"text":"قال ابن عطية الأندلسي: «﴿ثُمَّ سُئِلُوا الْفِتْنَةَ﴾: الحرب لمحمد صلى الله عليه وسلم وأصحابه لطاروا إليها، وأتوها محبين فيها ﴿وَمَا تَلَبَّثُوا بِهَا﴾ في بيوتهم لحفظها ﴿إِلَّا يَسِيرًا﴾ قيل: قدر ما يأخذون سلاحهم»(\u0002)."},{"paragraphIndex":2619,"physicalPage":332,"adjustedPage":331,"text":"وقال الشيخ محي الدين زادة: «﴿ثُمَّ سُئِلُوا الْفِتْنَةَ﴾: الردة ومقاتلة المسلمين»(\u0002)."},{"paragraphIndex":2620,"physicalPage":332,"adjustedPage":331,"text":"الملاحظة السادسة: إن هؤلاء المنافقين أبعد الناس عن الالتزام بالحسبة ونتائجها، إنما هي لمجرد تمرير خورٍ وتبرير فرار، ذلك أنهم لا يوفون بعهد، ولا يصدقون في وعد، ولا يثبتون على كلمة، وكل ذلك يظهر وقت الشدة ﴿وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ مِنْ قَبْلُ لَا يُوَلُّونَ الْأَدْبَارَ وَكَانَ عَهْدُ اللَّهِ مَسْئُولًا (15)﴾ [الأحزاب: 15]، وهنا وقفتان مهتان:"},{"paragraphIndex":2621,"physicalPage":332,"adjustedPage":331,"text":"الأولى: إنَّ هؤلاء المنافقين لما كانوا عاهدوا النبي صلى الله عليه وسلم -من قبل- فإنَّ الله سبحانه سمَّی عهد نبيه صلى الله عليه وسلم وعهد المؤمنين عهده هو سبحانه، فقال: ﴿وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ﴾، وهو كما قال سبحانه: ﴿إِنَّ الَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ اللَّهَ﴾ [الفتح: 10]، فلينتبه هؤلاء الذين عاهدوا المؤمنين من قبل على الجهاد أنهم إنما عاهدوا الله، ونقضهم نقض لعهد الله ﴿وَكَانَ عَهْدُ اللَّهِ مَسْئُولًا (15)﴾ [الأحزاب: 15]، ومن لم يستدرك فلينتظر سؤال الله."},{"paragraphIndex":2622,"physicalPage":333,"adjustedPage":332,"text":"والثانية: إنَّ الاستئذان بترك ساح الجهاد بحجة حماية الأعراض ونحو ذلك إنما هو من تولي الأدبار، قال سبحانه: ﴿وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ مِنْ قَبْلُ لَا يُوَلُّونَ الْأَدْبَارَ﴾ [الأحزاب: 15]، وهم إنما قالوا ﴿إِنَّ بُيُوتَنَا عَوْرَةٌ﴾، ولذا فإنّ المتخلفين اليوم عن الجهاد من غير عذر شرعي ينبغي أن يحملوا قول الله تعالى على الجد المناسب له واللائق به، ولا يحصروا تطبيق الآيات على مدة زمنية معينة، فإنَّ كما قال الله تعالى: ﴿وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ مِنْ قَبْلُ لَا يُوَلُّونَ الْأَدْبَارَ وَكَانَ عَهْدُ اللَّهِ مَسْئُولًا (15)﴾ [الأحزاب: 15]، وها هم يطلبون ترك الجهاد بحجة الأعراض، والمحافظة على الأموال والمكتسبات ونحو ذلك، ومع هذا فإذا وافقناهم، وأمضينا لهم اعتذارهم، ورجعوا إلى بيوتهم، فإنهم لن يتوقفوا عند البيوت، إنما سيواصلون نقض العهد الجديد، فمن البيوت إلى البراري والبادية، ولن يتوقفوا هناك أو يقاتلوا عند عتبة البيوت حمايةً للأعراض، فإنه لو ألجأهم الظرف أن يخرجوا من الدين لخرجوا من الدين، ولو طلب منهم أن يقاتلوا في صف الكافرين ضد المؤمنين لقاتلوا!"},{"paragraphIndex":2623,"physicalPage":333,"adjustedPage":332,"text":"وهذا والله نذير خطير لأصحابنا هؤلاء، فالله ما ذكرها سبحانه إلا تحذيرًا لمن سلك هذا الدرب، فالنهاية كما قال الله تعالى هي الردة، وليست هي الردة المجردة، بل الردة العدوانية المغلظة، والمشاركة مع الكافرين ضد المؤمنين بالتجسس، بل بالمقاتلة كذلك."},{"paragraphIndex":2624,"physicalPage":333,"adjustedPage":332,"text":"وكم هو صعب على من سلك هذا السبيل، واستأذن من الجهاد متفرغًا لبيته أو للهدنة مع الصليبيين أو لدخول في المجالس النيابية أن يعود من بعد هذا، نسأل الله لهم الإياب بعد الذهاب! ومن فضل الله تعالى أن يدرك سبحانه من أصبح في قلبه ترددًا أو اضطرابًا من طريق الجهاد كما بينها القرآن، فيعود إلى الحق قبل أن يخطو خطوة واحدة أو حتى بعد ما خطى، فليس في العودة إلى الحق أيُّ عيب، فقد قال الله تعالى: ﴿إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ (122)﴾ [آل عمران: 122]."},{"paragraphIndex":2625,"physicalPage":333,"adjustedPage":332,"text":"الملاحظة السابعة: الحسبة الصحيحة: الأخذ بالأسباب أمرٌ من البداهة بحيث لم نفرده بالبيان لوضوحه، كيف وقد قال الله تعالى: ﴿وَأَعِدُّوا لَهُمْ﴾، فالإعداد وهو أخذٌ بالأسباب، وهذا ما لا يخالف فيه أحد لكنَّ ما يغفل عنه البعض في حساب الإعداد هو حد الاستطاعة ﴿مَا اسْتَطَعْتُمْ﴾ ولذا فإنهم يغفلون عن التوكل على الله بعد الاستطاعة، وإبقاء ما لا يقدرون عليه على الذي هو على كل شيء قدير، وهذه هي الحسبة المنطقية، فإنك ما دمت تعتقد أنَّ الله معك حقيقة فلا بد أن تجعله معك في الحسبة حقيقة، دون أن تتخلى أنت عن دورك أو لا تستنفد استطاعتك، أما الانتظار حتى نكافئ العدو ماديًا ثم نبتدأ، فهذا تخلٍ عن الله، وعدم حسبان قدرته في الحسبة، وفيه مواجهة المشركين وجهًا لوجه والقوة المادية بالقوة المادية، والإعداد بالإعداد والخطط بالخطط ونحو ذلك، إذن فأين الله؟! وإنَّ الاتكال الكامل على الحسبة يساوي انعدام الظن الحسن بالله، وهو في المقابل يساوي إيكال الله العبد لنفسه بل لذنبه، وسيأتي إيضاح لهذا الأمر في «فصل العلاج» إن شاء الله تعالى."},{"paragraphIndex":2626,"physicalPage":333,"adjustedPage":332,"text":"الملاحظة الثامنة: منهجية الحسبة المادية المبنية على المقدمات المادية ذات النتائج المنطقية المادية المحسوبة ليست جديدة علينا، إنما هي منهجية قديمة مطَّردة عند المنافقين مدى الزمان، قد كشفها الله عز وجل."},{"paragraphIndex":2627,"physicalPage":334,"adjustedPage":333,"text":"فحينما هددهم المشركون بالحصار خافوا الفقر والجوع والعيلة، وقالوا ما قالوا، فقال سبحانه: ﴿وَإِنْ خِفْتُمْ عَيْلَةً فَسَوْفَ يُغْنِيكُمُ اللَّهُ مِنْ فَضْلِهِ إِنْ شَاءَ إِنَّ اللَّهَ عَلِيمٌ حَكِيمٌ (28)﴾ [التوبة: 28]، وحينما أمروا بقتال فارس والروم حسبوها ماديًا، ووضعوا المقدمات، فخرجت النتائج المنطقية عندهم هي هزيمة النبي محمد صلى الله عليه وسلم، وأسر أصحابه، وذلك لأنَّ المقدمات هي أنَّ الروم أكثر، وأخبر بالقتال، وسلاحهم أوفر، وبلادهم أوسع، إذًا فالنتيجة المحتمة هي ما ذكروا، ولذا قال سبحانه عنهم: ﴿وَظَنَنْتُمْ ظَنَّ السَّوْءِ وَكُنْتُمْ قَوْمًا بُورًا (12)﴾ [الفتح: 12]."},{"paragraphIndex":2628,"physicalPage":334,"adjustedPage":333,"text":"إنَّ مراعاة المآلات والنتائج حقٌّ أمر الله سبحانه به كما ذكرنا ذلك عند قوله: ﴿وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ وَمِنْ رِبَاطِ الْخَيْلِ تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فِي سَبِيلِ اللَّهِ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ (60)﴾ [الأنفال: 60]."},{"paragraphIndex":2629,"physicalPage":334,"adjustedPage":333,"text":"وقوله: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا خُذُوا حِذْرَكُمْ فَانْفِرُوا ثُبَاتٍ أَوِ انْفِرُوا جَمِيعًا (71)﴾ [النساء: 71]."},{"paragraphIndex":2630,"physicalPage":334,"adjustedPage":333,"text":""},{"paragraphIndex":2631,"physicalPage":334,"adjustedPage":333,"text":"إلى آخر تلك الآيات، لكنَّ المذموم هو إيقاف كل شيء لأنَّ إعدادنا غير كافٍ، وأننا استنفرنا ما في وسعنا وهو لم يبلغ ما عند العدو ونحو ذلك، وكأن المطلوب هو أن نبلغ مبلغ العدو ونصل إلى مستواه."},{"paragraphIndex":2632,"physicalPage":334,"adjustedPage":333,"text":"((("},{"paragraphIndex":2633,"physicalPage":335,"adjustedPage":334,"text":"\u000eالفصل الخامس: العلاج"},{"paragraphIndex":2634,"physicalPage":335,"adjustedPage":334,"text":""},{"paragraphIndex":2635,"physicalPage":335,"adjustedPage":334,"text":"العلاج الأول"},{"paragraphIndex":2636,"physicalPage":335,"adjustedPage":334,"text":"قال تعالى: ﴿قُلْ يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُمْ أَلَّا نَعْبُدَ إِلَّا اللَّهَ وَلَا نُشْرِكَ بِهِ شَيْئًا وَلَا يَتَّخِذَ بَعْضُنَا بَعْضًا أَرْبَابًا مِنْ دُونِ اللَّهِ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ (64)﴾ [آل عمران: 64]."},{"paragraphIndex":2637,"physicalPage":335,"adjustedPage":334,"text":"دعوةٌ من الله عز وجل إلى أهل الكتاب بالعودة إلى الكلمة التي لا ينبغي أن يُختلف عليها، فكيف بأبناء الأمة الواحدة والكتاب الواحد والنبي صلى الله عليه وسلم الواحد؟!"},{"paragraphIndex":2638,"physicalPage":335,"adjustedPage":334,"text":"ونحن إذ نوجه هذه الدعوة لإخواننا جميعًا؛ فإنما نوجهها لأنفسنا كذلك، حيث إنها موجهة من الله سبحانه وتعالى ربنا ورب كل شيء ومليكه."},{"paragraphIndex":2639,"physicalPage":335,"adjustedPage":334,"text":"ولا تحسبوا أننا قد غفلنا عن كونها دعوة موجهة لأهل الكتاب، فنحن أولى منهم بالاستجابة لدعوة الله هذه، ثم هل مضمون هذه الدعوة إلا نبذ الشرك، والاستمساك بتوحيد الله؟"},{"paragraphIndex":2640,"physicalPage":335,"adjustedPage":334,"text":"وهل أخطر شركًا بالله في العصر الحديث وأعم وأطم من الشرك به في التشريع، واختيار خلقه بعض خلقه ليشاركوا في حكمه، وهو القائل: ﴿وَلَا يُشْرِكُ فِي حُكْمِهِ أَحَدًا (26)﴾ [الكهف: 26]، وفي قراءة: ﴿وَلَا تشْرِكُ فِي حُكْمِهِ أَحَدًا (26)﴾؟!"},{"paragraphIndex":2641,"physicalPage":335,"adjustedPage":334,"text":"يا إخواننا: أيسع أحدنا وهو يُدعى هذه الدعوة أن يردها؟!"},{"paragraphIndex":2642,"physicalPage":335,"adjustedPage":334,"text":"لقد دعا الله سبحانه أولئك النصارى، فخافوا ردها أشد الخوف، فقال سبحانه: ﴿يَا أَيُّهَا الَّذِينَ أُوتُوا الْكِتَابَ آمِنُوا بِمَا نَزَّلْنَا مُصَدِّقًا لِمَا مَعَكُمْ مِنْ قَبْلِ أَنْ نَطْمِسَ وُجُوهًا فَنَرُدَّهَا عَلَى أَدْبَارِهَا أَوْ نَلْعَنَهُمْ كَمَا لَعَنَّا أَصْحَابَ السَّبْتِ وَكَانَ أَمْرُ اللَّهِ مَفْعُولًا (47)﴾ [النساء: 47]."},{"paragraphIndex":2643,"physicalPage":336,"adjustedPage":335,"text":"فلا يحسبنَّ من تخلف عن الجهاد أنه في منجاة من وعيد الله في الدنيا والآخرة، وأنه وأهله وماله ودنياه التي تخلَّف لأجلها ولأجلهم سالمون له، فليس ثمة من خلاص إلا العودة بإخلاص، وإلا فإنَّ عليه أن يَعظُم إشفاقه على نفسه، خائفًا من وعيد الله، مشفقًا على نفسه من من يصيبه الله بقارعة أو طمس أو خزي، فكيف يجوز لهؤلاء أن يغفلوا عن ذلك أو يتهاونوا في وعيد الله وهو القائل: ﴿فَتَرَبَّصُوا﴾؟! فكيف وقد تحول البعض هذا التحول الكبير من النقيض إلى النقيض، من الجهاد إلى الإشراك بالله، شرك التشريع من دون الله، ثم تراهم يحاجون عن هذا الشرك، وكأنهم أصبحوا حماته الشرعيين، فكل المشاركين في المجالس التشريعية أو الوزارة من غير الإسلاميين لا يجيدون الدفاع عن شركهم هذا دفاعًا شرعيًا إلا هؤلاء الإسلاميون، فبئس الدور الدفاع عن الشرك!"},{"paragraphIndex":2644,"physicalPage":336,"adjustedPage":335,"text":"نعم: لقد استغربها عدي بن حاتم الطائي، كما يستغرب الكثيرون اليوم أن يقال لهم إن هذا شرك، فقد صح في الحديث عن عدي بن حاتم، قال: «أتيت النبي صلى الله عليه وسلم، وفي عُنُقي صليب من ذهب، قال: فسمعته يقول: ﴿اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِنْ دُونِ اللَّهِ﴾ [التوبة: 31]، قال: قلت: يا رسول الله إنهم لم يكونوا يعبدونهم، قال: (أجل، ولكن يُحلُّون لهم ما حرَّم الله، فيستحلُّونه، ويُحرِّمون عليهم ما أحلَّ الله، فيحرِّمونه، فتلك عبادتهم لهم)»(\u0002)."},{"paragraphIndex":2645,"physicalPage":336,"adjustedPage":335,"text":"سبحان الله كيف أصبح من هذه الأمة من يتتبع أهل الكتاب حذو القذة بالقذة؟!"},{"paragraphIndex":2646,"physicalPage":336,"adjustedPage":335,"text":"سبحان الله كيف أصبحت أفهام اليهود والنصارى آنذاك تحصر مفهوم العبادة بالصلاة والركوع والسجود ونحو ذلك؟! حتى إن عدي بن حاتم نفى عنهم عبادة الأحبار والرهبان، فبيّن له المصطفی صلى الله عليه وسلم المفهوم الصحيح للعبادة، وأن اتخاذ الأرباب ليس في الركوع والسجود لهم فحسب، وإنما في اتباعهم في التحليل والتحريم."},{"paragraphIndex":2647,"physicalPage":336,"adjustedPage":335,"text":"فماذا ترى الناس يصنعون إلا أنهم ينتخبون هؤلاء؛ ليحلوا ويحرموا ويشرِّعوا من دون الله في مجلس تشريعي متخصص في التشريع؟"},{"paragraphIndex":2648,"physicalPage":336,"adjustedPage":335,"text":"فيا أيها الناس: ﴿تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُمْ أَلَّا نَعْبُدَ إِلَّا اللَّهَ وَلَا نُشْرِكَ بِهِ شَيْئًا وَلَا يَتَّخِذَ بَعْضُنَا بَعْضًا أَرْبَابًا مِنْ دُونِ اللَّهِ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ (64)﴾ [آل عمران: 64]."},{"paragraphIndex":2649,"physicalPage":336,"adjustedPage":335,"text":"العلاج الثاني"},{"paragraphIndex":2650,"physicalPage":336,"adjustedPage":335,"text":"لا يكتفي المؤمن إذا عَرف خطر المنكر أن يستسلم، ويقتصر على نفسه، ويسكن، ويسكت، وهو يرى أخاه يهوي، ويرى الجموع تشارك في الشرك، وتهلك، ثم يسعه السكوت والسكون!"},{"paragraphIndex":2651,"physicalPage":337,"adjustedPage":336,"text":"ففي الحديث الصحيح: (مثل القائم على حدود الله، والواقع فيها، كمثل قوم استهموا على سفينة، فأصاب بعضهم أعلاها وبعضهم أسفلها، فكان الذين في أسفلها إذا استقوا من الماء مروا على من فوقهم، فقالوا: لو أنا خرقنا في نصيبنا خرقًا، ولم نؤذ من فوقنا، فإن يتركوهم وما أرادوا هلكوا جميعًا، وإن أخذوا على أيديهم نجوا ونجوا جميعًا)(\u0002)."},{"paragraphIndex":2652,"physicalPage":337,"adjustedPage":336,"text":"هذا المجتمع ليس مِلكًا لدعاة البرلمانات، ولا يسع المسلم السكوت على خرقهم سفينة التوحيد الكبيرة التي تحوي المجتمع كله."},{"paragraphIndex":2653,"physicalPage":337,"adjustedPage":336,"text":"وما هذا البحث إلا مساهمة في القيام بدور الذين في أعلى السفينة بإنكارهم على الذين في أسفلها، سائلين الله تعالى أن يعذرنا بإبلاغنا هذا، وأن يعين كل قارئ على إنكار الشرك الأكبر بكل طريقة مشروعة، وأما من أبى إلا القعود فليس له إلا أن يقرأ هذا الحديث: عن ابن مسعود رضي الله عنه، أنَّ رسول الله صلى الله عليه وسلم قال: (ما من نبي بعثه الله في أمة قبلي إلا كان له من أمته حواريون وأصحاب، يأخذون بسنته، ويقتدون بأمره، ثم إنها تخلُف من بعدهم خلوف، يقولون ما لا يفعلون، ويفعلون ما لا يؤمرون، فمن جاهدهم بيده فهو مؤمن، ومن جاهدهم بلسانه فهو مؤمن، ومن جاهدهم بقلبه فهو مؤمن، ليس وراء ذلك من الإيمان حبة خردل)(\u0002)."},{"paragraphIndex":2654,"physicalPage":337,"adjustedPage":336,"text":"يا إخوتاه: إنَّ السكوت على هذا المنكر -مع القدرة على إنكاره- يعني المخاطرة بآخر ذرة من إيمان، والنبي صلى الله عليه وسلم یقول: (ليس وراء ذلك من الإيمان حبة خردل) أو (ذرة من إيمان)."},{"paragraphIndex":2655,"physicalPage":337,"adjustedPage":336,"text":"فبمقدار ما يكون المنكر كبيرًا يجب أن يكون الإنكار كبيرًا."},{"paragraphIndex":2656,"physicalPage":337,"adjustedPage":336,"text":"لو كان العدو يريد إقامة نادٍ لعمل قوم لوط أو للعراة أو نحو ذلك لأنكره أكثر الناس، ولما شارك فيه إلا أقل الناس وأكثر الناس سقوطًا وحقارة في المجتمع!"},{"paragraphIndex":2657,"physicalPage":338,"adjustedPage":337,"text":"بينما يُعلَن بأنَّ مهمة هذا المجلس هي التشريع من دون الله، هذا فلا يكاد يُنكره أحد، وتشريعه الشركي يعم كل البلد، ولقد خطَّ العدو لهذا المجلس خطًّا وقال: هذا دربكم بعد تحريركم! فتقدم من كان يُعدُّ من دعاة الإسلام إلى المعبد التشريعي، وتقاحم الناس من ورائهم أزًّا وانتخابًا ونصرة، وهم يحسبون أنَّ النصر في البرلمان بعدما حول لهم العدو صورة المعركة إلى ساحة البرلمان."},{"paragraphIndex":2658,"physicalPage":338,"adjustedPage":337,"text":"وصوَّر لهم إحدى الحسنيين بالفوز بمقعد البرلمان أو مقعد الوزارة."},{"paragraphIndex":2659,"physicalPage":338,"adjustedPage":337,"text":"ومن أراد معرفة النتيجة فليتصور ماذا لو لم يخرج الجميع ليوم الزينة التشريعي أو كما يسمونه العرس الديمقراطي الذي يُذبح في ليلته معتقدُ توحيد التشريع؟!"},{"paragraphIndex":2660,"physicalPage":338,"adjustedPage":337,"text":"والجواب ظاهر هو انكشاف الكذب واللعب وظهور الحقيقة للناس، وهو أنَّ العراقيين قد اكتشفوا الكذب الأمريكي، فقاطعوه، وحتى لو كانت المقاطعة مُقتصرة على الإسلاميين وحدهم، فإنهم المقصود الأول للأمريكيين، وإنهم موطن ثقة العراقيين، والأمريكيون يعلمون أن هؤلاء الإسلاميين إذا تأبوا؛ تأبى الشعب العراقي على الترويض، وإذا رتعوا؛ رتع كثير من الناس من بعدهم."},{"paragraphIndex":2661,"physicalPage":338,"adjustedPage":337,"text":"ثم إنَّ الإحجام عن المشاركة في البرلمان والوزارة هو أقل درجات الإنكار، إذ لا يعقل الإنكار مع المشاركة."},{"paragraphIndex":2662,"physicalPage":338,"adjustedPage":337,"text":"لكنَّ ما نخشاه أن تكون النتيجة هي التدرج في سلالم التساقط شيئًا فشيئًا، فمن ترك الإنكار، إلى المشاركة في البرلمان، إلى قبول الوزارة، إلى الدخول في الحكومة بكل ثقل، إلى الإنكار على من يُنكر المشاركة، إلى الإنكار على المجاهدين، إلى وقوف بعض هؤلاء ضدهم ... ولن يتوقف هذا التدحرج إلا في قعر النفاق في الدنيا وقعر جهنم في الآخرة، كما قال الله تعالى: ﴿إِنَّ الْمُنَافِقِينَ فِي الدَّرْكِ الْأَسْفَلِ مِنَ النَّارِ وَلَنْ تَجِدَ لَهُمْ نَصِيرًا (145)﴾ [النساء: 145]، فاللهم أدرك هؤلاء بالهداية."},{"paragraphIndex":2663,"physicalPage":338,"adjustedPage":337,"text":"وهذه الخطوة تدع المسلم في تفكير دائم في وسائل يتخذها في إنقاذ إخوانه، وإلا فإقامة الحجة عليهم، ومن باب الإعانة على تحقيق الإعذار والإنذار، فإني أحسب أن إيصال هذا البحث إلى كل عضو برلمانٍ أو وزير محسوب على الإسلاميين ضرورة، وكذلك إبلاغ كل القيادات الإسلامية، وخصوصًا تلك التي سمحت لبعض أفرادها بالوزارة أو عضوية البرلمان، أو دخلت في هدنة أو نحو ذلك، وهكذا إبلاغ كل من نستطيع من الإخوة وعلى الأخص أولئك الذين يُخشى عليهم من الوقوع في هذا الأمر، ولو شفهيًا أو عمل مختصر لهذا الكتاب في ورقات، ولا بد أن يخصص بالإهداء لأصحاب التوجه الإسلامي من أئمة المساجد وغيرهم."},{"paragraphIndex":2664,"physicalPage":339,"adjustedPage":338,"text":"وحين يشعر كل فرد بعظم المنكر وخطورته على المستقبل العقدي للمسلمين، وعلى مستقبل الجهاد كله، وعلى الأمة، فإنه لن يبيت يومًا إذا لم يبلغ رسالته التي اعتقدها، ويصطف في صف المنكرين على هؤلاء، ويتخذ الجهاد سبيلاً ﴿إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُمْ بُنْيَانٌ مَرْصُوصٌ (4)﴾ [الصف: 4]."},{"paragraphIndex":2665,"physicalPage":339,"adjustedPage":338,"text":"ويخطأ من يظن أننا نقول إنه يجب أن نترك الانتخابات ونبقى متفرجين في الساحة وأننا سوف ننتصر! نعم نترك الانتخابات خير من أن نشارك، ولكن هذا بمجرده لا يحقق الواجب ولا يستجلب النصر، فإنَّ الواجب هو النصرة بكل ما نستطيع لأهل الجهاد ظاهرًا أو باطنًا، علنًا أو خفية، كلٌ حسب قدرته."},{"paragraphIndex":2666,"physicalPage":339,"adjustedPage":338,"text":"ومن ثم فليست المقارنة الصحيحة أن تكون بين المشاركة في البرلمان انتخابًا وترشيحًا وبين عدمها فحسب، وإنما بينها وبين ضدها من العمل الإيجابي كالدعوة إلى عقيدة الولاء والبراء والأمر بالمعروف والنهي عن المنكر والتربية والتزكية وفوق ذلك الدعوة إلى الجهاد والمشاركة فيه."},{"paragraphIndex":2667,"physicalPage":339,"adjustedPage":338,"text":"فالمقارنة ظالمة حين تكون بين المشاركة وبين تركها دون وضع الواقع في الحسبان، وبحذف الجهاد من المقارنة وإسقاطه من الكفة الأخرى للميزان."},{"paragraphIndex":2668,"physicalPage":339,"adjustedPage":338,"text":"ولذا فمن الطبيعي أن يكون جواب عامة الناس: نعم للمشاركة! وهذا من الظلم والعدوان، وإلا فإنَّ المقارنة الصحيحة هي أن نسأل: هل نشترك في الانتخابات البرلمانية أم نترك المشاركة فيها ونترك الجهاد ونترك نصرة المجاهدين ونتخلى عنهم؟"},{"paragraphIndex":2669,"physicalPage":339,"adjustedPage":338,"text":"هل نشارك في الانتخابات أم نمدُّ المجاهدين بما نستطيع من مال ومعلومات؟"},{"paragraphIndex":2670,"physicalPage":339,"adjustedPage":338,"text":"هل نقف في صف الانتخابات أم نقف في صف الجهاد؟"},{"paragraphIndex":2671,"physicalPage":339,"adjustedPage":338,"text":"هل نختار لبلدنا طريق الانتخابات البرلمانية ونسلم لنتائجها كيف كانت؛ لأننا رضينا بها ابتداءً ومبدءًا، حتى لو كانت مزورة، وحتى لو طالب البرلمان بإبقاء القوات في البلد عشرات السنين أو إلى الأبد، أو نختار مبدأ الجهاد في سبيل الله؟!"},{"paragraphIndex":2672,"physicalPage":339,"adjustedPage":338,"text":"هل نقف مع هذا ضد هذا أم مع هذا ضد هذا؟!"},{"paragraphIndex":2673,"physicalPage":339,"adjustedPage":338,"text":"فإن الجهاد والانتخابات لا يجتمعان إطلاقًا."},{"paragraphIndex":2674,"physicalPage":340,"adjustedPage":339,"text":"إنَّ الديمقراطية دين، وإنَّ الانتخابات تشريع في ذلك الدين، وهل اسمها إلا الانتخابات التشريعية، وكما لا يحل لمن دخل الدين أن يتركه، فإنَّ من دخل الانتخابات لم يُبح له الاعتراض على مقرراتها ومقررات مجلسها متى أُقرّت."},{"paragraphIndex":2675,"physicalPage":340,"adjustedPage":339,"text":"وكل توصيف للحقيقة في العراق غير هذا فهو تلبيس للحق بالباطل."},{"paragraphIndex":2676,"physicalPage":340,"adjustedPage":339,"text":"لا تقولوا: اليوم ضعف الجهاد فإنكم بهذه المشاركة تحاولون الإجهاز عليه ..."},{"paragraphIndex":2677,"physicalPage":340,"adjustedPage":339,"text":"ونحن حينما نقول ذلك لا نقول انسحبوا من غير أن يعلم أحد أو نقول قاطعوا بالسر، لا، فليس هذا طريق الجهاد، ولا هو طريق إنكار المنكر وطمسه، إنما الصحيح أننا نقاطع الانتخابات عقيدة راسخة، ونعلن ذلك للجميع، إعذارًا إلى الله، وإبلاغًا للقوم، وحجة على الجميع، وحفظًا للعقيدة، وحفظًا للدين، وحمايةً للأمانة."},{"paragraphIndex":2678,"physicalPage":340,"adjustedPage":339,"text":"نقاطعها لأنها ضد التوحيد، نقاطعها لأنها ضد الجهاد ونحن معه، نقاطعها لأنَّ فيها التسليم لنتائجها التي يجب علينا الرضا بها حتى لو كانت عاقبتها إقرار المحتمل في بلدنا."},{"paragraphIndex":2679,"physicalPage":340,"adjustedPage":339,"text":"العلاج الثالث"},{"paragraphIndex":2680,"physicalPage":340,"adjustedPage":339,"text":"﴿وَاعْتَصِمُوا بِحَبْلِ اللَّهِ جَمِيعًا وَلَا تَفَرَّقُوا وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ إِذْ كُنْتُمْ أَعْدَاءً فَأَلَّفَ بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُمْ بِنِعْمَتِهِ إِخْوَانًا وَكُنْتُمْ عَلَى شَفَا حُفْرَةٍ مِنَ النَّارِ فَأَنْقَذَكُمْ مِنْهَا كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَهْتَدُونَ (103)﴾ [آل عمران: 103]."},{"paragraphIndex":2681,"physicalPage":340,"adjustedPage":339,"text":"عماد خيمة الديمقراطية في أيّ بلد على أمور، من أهمها السماح للأحزاب بالمشاركة السياسية في انتخابات شعبية، وعلى إثرها ينقسم الشعب نفسه كلٌّ وراء مرشحه، وينقسم البلد إلى مناطق انتخابات، وتتقسم المنطقة الواحدة، وتتوزع الولاءات حتى تصل النصرة إلى الدعوة إلى مرشحهم، وإلى ذم الآخرين، وإنفاق المال ونحو ذلك."},{"paragraphIndex":2682,"physicalPage":340,"adjustedPage":339,"text":"ومنكر بلغ هذا المستوى من الشناعة لا ينبغي أن نختلف على مقاطعته جميعًا، ونتفق على النهي عنه، ونتفق كذلك على التوحد ضده، حيث إنَّ لازم الوقوف معه هو السعي في الفرقة بين المسلمين، والله تعالى يقول: ﴿إِنَّ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا لَسْتَ مِنْهُمْ فِي شَيْءٍ إِنَّمَا أَمْرُهُمْ إِلَى اللَّهِ ثُمَّ يُنَبِّئُهُمْ بِمَا كَانُوا يَفْعَلُونَ (159)﴾ [الأنعام: 159]."},{"paragraphIndex":2683,"physicalPage":341,"adjustedPage":340,"text":"وقد صح عن النبي صلى الله عليه وسلم أنه قال: (إن الله تعالى يرضى لكم ثلاثًا، ويكره لكم ثلاثًا، فيرضى لكم أن تعبدوه ولا تشركوا به شيئًا، وأن تعتصموا بحبل الله جميعًا ولا تفرقوا، وأن تناصحوا من ولاه الله أمركم، ويكره لكم قيل وقال، وكثرة السؤال، وإضاعة المال)(\u0002)، وفي الحديث المتفق عليه: (لا تباغضوا، ولا تقاطعوا، ولا تدابروا، ولا تحاسدوا، وكونوا عباد الله إخوانًا، كما أمركم الله، ولا يحل لمسلم أن يهجر أخاه فوق ثلاثة أيام)(\u0002)."},{"paragraphIndex":2684,"physicalPage":341,"adjustedPage":340,"text":"ولو لم يكن من قاسم مشترك وحبل جامع لنا جميعًا إلا الوقوف في وجه هذا الشر لكفانا سببًا للجماعة الواحدة أو الاجتماع الواحد على الغاية الواحدة بالوسائل الشرعية، والنبي صلى الله عليه وسلم یقول: (عليكم بالجماعة، وإياكم والفرقة، فإنّ الشيطان مع الواحد، وهو من الإثنين أبعد، مَن أراد بحبوحة الجنة فليلزم الجماعة)(\u0002)."},{"paragraphIndex":2685,"physicalPage":341,"adjustedPage":340,"text":"وكم من أحداث جمَّعت الأخوة المتفرقين في وقتٍ ما ظنَّ أحد اجتماعهم لشدة خصامهم، وما إن يحدث اجتماع فعلي حتى تذوب أسباب الفرقة الأخرى، وتلتحم أواصر الإخاء، ولكأنها لم تكن فرقة ولا اختلاف، فلتحول الدعوة الشركية من المشاركة في الانتخابات التشريعية أو المفاوضات النفاقية إلى دعوة لتوحيد الله وتوحيد الصف بين الجماعات الجهادية، وإذا لم تكن دعوة جماعية فلينهض كل الأفراد المنكرين هذا الشرك وينأوا بأنفسهم عمن أصرَّ عليه، فليس في البقاء بعيدًا عن الوحدة عذر، وليس التقليد واتباع نعيق الإشراك في هذا الأمر مقبولاً، ولو لم يشاركهم المسلم إلا من باب عدم تكثير سوادهم لكفاه، فكيف وفيها استجابة لقوله تعالى: ﴿وَاتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَيَّ﴾ [لقمان: 15]، وقوله تعالى: ﴿فَلَا تُطِعِ الْمُكَذِّبِينَ (8)﴾ [القلم: 8]، وقوله تعالى: ﴿وَمَنْ يُشَاقِقِ الرَّسُولَ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُ الْهُدَى وَيَتَّبِعْ غَيْرَ سَبِيلِ الْمُؤْمِنِينَ نُوَلِّهِ مَا تَوَلَّى وَنُصْلِهِ جَهَنَّمَ وَسَاءَتْ مَصِيرًا (115)﴾ [النساء: 115]، وهذه المشاركة هي بغير شك غير سبيل المؤمنين، ولو لم يشارك المؤمن وهو يعلم أنها كفتان وهو لا يريد أن يكون ثقلاً في كفة الباطل لكفاه، كيف والمطلوب أكبر من الامتناع المجرد؟!"},{"paragraphIndex":2686,"physicalPage":341,"adjustedPage":340,"text":"لا تقولوا: وإلى متى نقاطع، وهم ماضون، قاطعنا أم لم نقاطع؟"},{"paragraphIndex":2687,"physicalPage":342,"adjustedPage":341,"text":"دعوهم يقولون إلى متى يصابرون ويصطبرون؟ إلى متى صابرون ثابتون؟ إلى متى نتنازل لهم، وهم لا يتنازلون ﴿إِنَّهُ مَنْ يَتَّقِ وَيَصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ (90)﴾ [يوسف: 90]."},{"paragraphIndex":2688,"physicalPage":342,"adjustedPage":341,"text":"سيعود التيار يدور حولكم أيها الثابتون؛ لأنه لا يكون الحق إلا راسخًا، ومن الاعتصام بحبل الله التواصي بالحق والتواصي بالصبر، فالصبر الصبر في التواصي، والصبر على طول جدل الناس وتمنعهم، فلا ينبغي للمؤمن أن يعامل المسلمين المعارضين له من خلال قناعاته هو فحسب، فينكر على الناس كأنهم يعرفون أنه منكر، أو كأنهم يعرفون أنه منكر بالمستوى الذي يعرفه، فيبتدأ الصدام معهم من بعد تبليغهم لسعة الهوة بينهما."},{"paragraphIndex":2689,"physicalPage":342,"adjustedPage":341,"text":"والواجب أن يعرِّف الناس بأنه منكر، ويقنعهم بذلك ويحاورهم، وليتذكر أنه قبل مدة كان مثلهم ربما، وأنَّ هذا الوضوح الذي عنده كان بسبب كذا وكذا، فالصبر عليهم لا بد له من وقت مع عناء، وتنويع مع مضاء، فإنَّ اللجوء إلى قتلهم أسهل من إقناعهم، لكن هذا هو طريق الأنبياء، ولو استغرق ذلك وقتًا طويلاً، فرغم وضوح منكر الأقوام السابقة، واتضاح الحق بالمعجزة الظاهرة، إلا أنَّ الأنبياء صابروا بالدعوة حتى جاء أمر الله."},{"paragraphIndex":2690,"physicalPage":342,"adjustedPage":341,"text":"الصبر المبني على اليقين بالنصر ... الصبر حتى تسليم الأمانة لخلفٍ صالح، وتسليم الروح لباريها."},{"paragraphIndex":2691,"physicalPage":342,"adjustedPage":341,"text":"هذا هو الواجب نحو إخواننا المسلمين المخالفين، ولا عبرة بالمنافقين المتربصين، فسنة الأنبياء أن يبقى ثمة متربصون للمؤمنين، لكن سنة الله قاطعة في مجيء الفتح من الله عز وجل لأوليائه كما هي لأنبيائه ﴿إِنَّا لَنَنْصُرُ رُسُلَنَا وَالَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ يَقُومُ الْأَشْهَادُ (51)﴾ [غافر: 51]، فلنعاملهم بهذا اليقين القاطع باقتراب الفتح المبين اللامع، وكأننا نشاهده بأعيننا، قال سبحانه: ﴿الَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِنْ كَانَ لَكُمْ فَتْحٌ مِنَ اللَّهِ قَالُوا أَلَمْ نَكُنْ مَعَكُمْ وَإِنْ كَانَ لِلْكَافِرِينَ نَصِيبٌ قَالُوا أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُمْ مِنَ الْمُؤْمِنِينَ فَاللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ وَلَنْ يَجْعَلَ اللَّهُ لِلْكَافِرِينَ عَلَى الْمُؤْمِنِينَ سَبِيلًا (141)﴾ [النساء: 141]."},{"paragraphIndex":2692,"physicalPage":342,"adjustedPage":341,"text":"قال الشيخ السعدي رحمه الله تعالى في تفسيره: «أي: تسلطًا واستيلاءً عليهم، بل لا تزال طائفة من المؤمنين على الحق منصورة، لا يضرهم من خذلهم ولا من خالفهم، ولا يزال الله يُحدث من أسباب النصر للمؤمنين، ودفعٍ لتسلط الكافرين، ما هو مشهود بالعيان»(\u0002)."},{"paragraphIndex":2693,"physicalPage":343,"adjustedPage":342,"text":"وقد صح عن ثوبان رضي الله عنه، قال: رسول الله صلى الله عليه وسلم: (إن الله زوى ليّ الأرض، فرأيت مشارقها ومغاربها، وإنَّ أمتي سيبلغ ملكها ما زُوي ليّ منها، وأعطيت الكنزين الأحمر والأبيض، وإنيّ سألتُ ربي لأمتي أ أن لا يهلكها بسنة عامة، وأن لا يسلط عليهم عدوًا من سوى أنفسهم، فيستبيح بيضتهم، وإنَّ ربي قال: يا محمد إني إذا قضيت قضاء فإنه لا يرد، وإني قد أعطيتُك لأمتك أن لا أهلكهم بسنة عامة، وأن لا أسلط عليهم عدوًا من سوى أنفسهم يستبيح بيضتهم، ولو اجتمع عليهم من بأقطارها أو قال من بين أقطارها حتى يكون بعضهم يهلك بعضًا، ويسبي بعضهم بعضًا)(\u0002)."},{"paragraphIndex":2694,"physicalPage":343,"adjustedPage":342,"text":"فلا خوف على الدين، فأمان حفظه من الله عز وجل، وعدُ صدقٍ من الله تعالى، وعدم ذهاب أمة محمد صلى الله عليه وسلم وعدٌ من الله تعالى، وبقاء الطائفة المنصورة وعدٌ من الله تعالى، وحفظ الكتاب وعدٌ من الله تعالى، فلِم التنازل إلى البرلمانات والوزارات الجاهلية؟!"},{"paragraphIndex":2695,"physicalPage":343,"adjustedPage":342,"text":"إنَّ التناهي عن هذا المنكر هو الواجب، وإلا كنا كمن قال الله سبحانه فيهم: ﴿لُعِنَ الَّذِينَ كَفَرُوا مِنْ بَنِي إِسْرَائِيلَ عَلَى لِسَانِ دَاوُودَ وَعِيسَى ابْنِ مَرْيَمَ ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ (78) كَانُوا لَا يَتَنَاهَوْنَ عَنْ مُنْكَرٍ فَعَلُوهُ لَبِئْسَ مَا كَانُوا يَفْعَلُونَ (79) تَرَى كَثِيرًا مِنْهُمْ يَتَوَلَّوْنَ الَّذِينَ كَفَرُوا لَبِئْسَ مَا قَدَّمَتْ لَهُمْ أَنْفُسُهُمْ أَنْ سَخِطَ اللَّهُ عَلَيْهِمْ وَفِي الْعَذَابِ هُمْ خَالِدُونَ (80)﴾ [المائدة: 78-80]."},{"paragraphIndex":2696,"physicalPage":343,"adjustedPage":342,"text":"وما عَهِدنا المسلمين الصادقين تنازلوا إذا أصيبوا بمصيبة، بل يعدونها فرصة للتميز؛ لأنها اختبار من الله، والله ناظر لعباده، كما قال سبحانه: ﴿وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ إِذْ تَحُسُّونَهُمْ بِإِذْنِهِ حَتَّى إِذَا فَشِلْتُمْ وَتَنَازَعْتُمْ فِي الْأَمْرِ وَعَصَيْتُمْ مِنْ بَعْدِ مَا أَرَاكُمْ مَا تُحِبُّونَ مِنْكُمْ مَنْ يُرِيدُ الدُّنْيَا وَمِنْكُمْ مَنْ يُرِيدُ الْآخِرَةَ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ وَلَقَدْ عَفَا عَنْكُمْ وَاللَّهُ ذُو فَضْلٍ عَلَى الْمُؤْمِنِينَ (152)﴾ [آل عمران: 152]، وقال تعالى: ﴿وَلَنَبْلُوَنَّكُمْ حَتَّى نَعْلَمَ الْمُجَاهِدِينَ مِنْكُمْ وَالصَّابِرِينَ وَنَبْلُوَ أَخْبَارَكُمْ (31)﴾ [محمد: 31]."},{"paragraphIndex":2697,"physicalPage":343,"adjustedPage":342,"text":"وقـال جـل وعـلا: ﴿أَحَسِبَ النَّاسُ أَنْ يُتْرَكُوا أَنْ يَقُولُوا آمَنَّا وَهُمْ لَا يُفْتَنُونَ (2) وَلَقَدْ فَتَنَّا الَّذِينَ مِنْ قَبْلِهِمْ فَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ صَدَقُوا وَلَيَعْلَمَنَّ الْكَاذِبِينَ (3)﴾ [العنكبوت: 2-3]."},{"paragraphIndex":2698,"physicalPage":344,"adjustedPage":343,"text":"العلاج الرابع"},{"paragraphIndex":2699,"physicalPage":344,"adjustedPage":343,"text":"كما يظن أهل المشاركة في البرلمان والوزارة أننا نحن حالة خاصة، ومن ثم يجب علينا مراعاة هذا الظرف، والتحول إلى المشاركة المذكورة ... فنحن كذلك نرى أننا حالة خاصة، وأنَّ ذلك يوجب علينا أعمالاً خاصة، وتحولاً خاصًّا، ومن أعظم تلك الخصوصيات هي:"},{"paragraphIndex":2700,"physicalPage":344,"adjustedPage":343,"text":"«مزيد التوكل والاتباع»: يقول شيخ الإسلام ابن تيمية عن أهمية التوكل للجهاد: «وهذا وإن كان مأمورًا به في جميع الدين، فإنَّ ذلك في الجهاد أوكد؛ لأنه يحتاج إلى أن يجاهد الكفار والمنافقين، وذلك لا يتم إلا بتأييد قوي من الله، ولهذا كان الجهاد سنام العمل، وانتظم سنام جميع الأحوال الشريفة، ففيه سنام المحبة، كما في قوله : ﴿فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ﴾ [المائدة: 54]، وفـيـه سـنـام التوكل، وسنام الصبر، فإنَّ المجاهد أحوج الناس إلى الصبر والتوكل، ولهذا قال تعالى: ﴿وَالَّذِينَ هَاجَرُوا فِي اللَّهِ مِنْ بَعْدِ مَا ظُلِمُوا لَنُبَوِّئَنَّهُمْ فِي الدُّنْيَا حَسَنَةً وَلَأَجْرُ الْآخِرَةِ أَكْبَرُ لَوْ كَانُوا يَعْلَمُونَ (41) الَّذِينَ صَبَرُوا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (42)﴾ [النحل: 41-42]، ﴿قَالَ مُوسَى لِقَوْمِهِ اسْتَعِينُوا بِاللَّهِ وَاصْبِرُوا إِنَّ الْأَرْضَ لِلَّهِ يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ وَالْعَاقِبَةُ لِلْمُتَّقِينَ (128)﴾ [الأعراف: 128]."},{"paragraphIndex":2701,"physicalPage":344,"adjustedPage":343,"text":"ولهذا كان الصبر واليقين الذي هو أصل التوكل يوجبان الإمامة في الدين، كما دلَّ عليه قوله تعالى: ﴿وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا وَكَانُوا بِآيَاتِنَا يُوقِنُونَ (24)﴾ [السجدة: 24]."},{"paragraphIndex":2702,"physicalPage":344,"adjustedPage":343,"text":"ولهذا كان الجهاد موجبًا للهداية التي هي محيطة بأبواب العلم، كما دلَّ عليه قوله تعالى: ﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا﴾ [العنكبوت: 69]."},{"paragraphIndex":2703,"physicalPage":344,"adjustedPage":343,"text":"فجعل لمن جاهد فيه هداية جميع سُبله تعالى، ولهذا قال الإمامان عبد الله بن المبارك، وأحمد بن حنبل، وغيرهما: إذا اختلف الناس في شيء فأنظروا ما عليه أهل الثغر، فإنَّ الحق معهم؛ لأن الله تعالى قال: ﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ (69)﴾ [العنكبوت: 69]."},{"paragraphIndex":2704,"physicalPage":345,"adjustedPage":344,"text":"وفي الجهاد أيضًا حقيقة الزهد في الحياة الدنيا، وفي الدار الدنيا، وفيه أيضًا حقيقة الإخلاص، فإن الكلام فيمن جاهد في سبيل الله، لا في سبيل الرياسة، ولا في سبيل المال، ولا سبيل الحمية، وهذا لا يكون إلا لمن قاتل ليكون الدين كله لله، ولتكون كلمة الله هي العليا، وأعظم مراتب الإخلاص: تسليم النفس والمال للمعبود، كما قال تعالى: ﴿إِنَّ اللَّهَ اشْتَرَى مِنَ الْمُؤْمِنِينَ أَنْفُسَهُمْ وَأَمْوَالَهُمْ بِأَنَّ لَهُمُ الْجَنَّةَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَيَقْتُلُونَ وَيُقْتَلُونَ﴾ [التوبة: 111]»(\u0002)."},{"paragraphIndex":2705,"physicalPage":345,"adjustedPage":344,"text":"ونحن بحمد الله تعالى نرى أن حالتنا العراقية أحق بالخصوصية ... أحق بمزيد من الأخذ بالأسباب وإعداد القوة، وأحق بمزيد من التوكل على الله سبحانه، ومزيد الاستمساك بأمره سبحانه، والقاعدة في هذا هي: «استمسك بأمره وتوكل عليه بقدر حاجتك إليه»، ولا شك أن الإنسان فقير إلى الله تعالى في كل وقت لا ينقطع فقره، ولا تنتهي حاجته، ولكن تجتمع الحاجيات على المرء في ظروف معينة كما تجتمع في ظروف حياته الأخرى، فيحتاج إلى مزيد استعانة وتسليم وثقة وتوكل، وقد عاب الله على من اشتدت حاجته ألا يزيد من الاستغاثة والتضرع، فقال سبحانه: ﴿فَلَوْلَا إِذْ جَاءَهُمْ بَأْسُنَا تَضَرَّعُوا وَلَكِنْ قَسَتْ قُلُوبُهُمْ﴾ [الأنعام: 43]، بينما المؤمنون يزداد هرعهم إلى الله، واستغاثتهم به عند اشتداد الحاجة، قال سبحانه: ﴿الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ (173)﴾ [آل عمران: 173]، وقال سبحانه: ﴿وَلَمَّا رَأَى الْمُؤْمِنُونَ الْأَحْزَابَ قَالُوا هَذَا مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ وَصَدَقَ اللَّهُ وَرَسُولُهُ وَمَا زَادَهُمْ إِلَّا إِيمَانًا وَتَسْلِيمًا (22)﴾ [الأحزاب: 22]."},{"paragraphIndex":2706,"physicalPage":345,"adjustedPage":344,"text":"ومن قبل قال عن فتية الكهف: ﴿نَحْنُ نَقُصُّ عَلَيْكَ نَبَأَهُمْ بِالْحَقِّ إِنَّهُمْ فِتْيَةٌ آمَنُوا بِرَبِّهِمْ وَزِدْنَاهُمْ هُدًى (13) وَرَبَطْنَا عَلَى قُلُوبِهِمْ إِذْ قَامُوا فَقَالُوا رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا (14) هَؤُلَاءِ قَوْمُنَا اتَّخَذُوا مِنْ دُونِهِ آلِهَةً لَوْلَا يَأْتُونَ عَلَيْهِمْ بِسُلْطَانٍ بَيِّنٍ فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا (15)﴾ [الكهف: 13-15]."},{"paragraphIndex":2707,"physicalPage":345,"adjustedPage":344,"text":"وحاجتنا نحن اليوم ليس مثلها حاجة، ولم يمر علينا مثلها إطلاقًا شدة وكثرة، حاجتنا إلى النصير، حاجتنا إلى الثبات، حاجتنا إلى المال، حاجتنا إلى العيون، حاجتنا إلى...، ولهذا كان العلاج الأوحد هو الفرار إلى الله الصمد الذي يصمد لحوائج خلقه، وطريق ذلك مزيد الاستمساك بأمره، ومزيد التوكل عليه توكلاً لم نصل إلى مستواه من قبل أبدًا، وكم نُخطئ في التقدير، وفي اتخاذ القرار، إذا تعاملنا مع الأحداث الحالية بتوكل مثل توكلنا قبل ظهور الحاجيات الجديدة!"},{"paragraphIndex":2708,"physicalPage":346,"adjustedPage":345,"text":"إنها مسألة في غاية الأهمية وفي غاية الحساسية، وإنها لحاسمة في نتائج المعارك، ووالله لن يأتي النصر إلا بهذا المزيد في اللحظة الحاسمة، هذا ما حكاه الله سبحانه عن سير المنصورين: ﴿وَلَمَّا بَرَزُوا لِجَالُوتَ وَجُنُودِهِ قَالُوا رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ (250)﴾ [البقرة: 250]، ﴿وَكَأَيِّنْ مِنْ نَبِيٍّ قَاتَلَ مَعَهُ رِبِّيُّونَ كَثِيرٌ فَمَا وَهَنُوا لِمَا أَصَابَهُمْ فِي سَبِيلِ اللَّهِ وَمَا ضَعُفُوا وَمَا اسْتَكَانُوا وَاللَّهُ يُحِبُّ الصَّابِرِينَ (146) وَمَا كَانَ قَوْلَهُمْ إِلَّا أَنْ قَالُوا رَبَّنَا اغْفِرْ لَنَا ذُنُوبَنَا وَإِسْرَافَنَا فِي أَمْرِنَا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ (147) فَآتَاهُمُ اللَّهُ ثَوَابَ الدُّنْيَا وَحُسْنَ ثَوَابِ الْآخِرَةِ وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ (148)﴾ [آل عمران: 146-148]، فهم قد طلبوا المزيد من الصبر حتى عبّروا عنه بالإفراغ وتثبيت الأقدام ﴿رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ (250)﴾ [البقرة: 250]."},{"paragraphIndex":2709,"physicalPage":346,"adjustedPage":345,"text":"وقال عن محمد صلى الله عليه وسلم: ﴿الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ (173) فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ (174)﴾ [آل عمران: 173-174]."},{"paragraphIndex":2710,"physicalPage":346,"adjustedPage":345,"text":"فالإشارة لمزيد التوكل والإيمان ظاهرة في قوله تعالى: ﴿فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ (173)﴾ [آل عمران: 173]، والإشارة لالتزام حكمه واتباع أمره في قوله تعالى: ﴿وَاتَّبَعُوا رِضْوَانَ اللَّهِ﴾ [آل عمران: 174]، وهذا ما حكاه الله تعالى عنهم في غزوة بدر، فقال سبحانه: ﴿إِذْ تَقُولُ لِلْمُؤْمِنِينَ أَلَنْ يَكْفِيَكُمْ أَنْ يُمِدَّكُمْ رَبُّكُمْ بِثَلَاثَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُنْزَلِينَ (124) بَلَى إِنْ تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُمْ مِنْ فَوْرِهِمْ هَذَا يُمْدِدْكُمْ رَبُّكُمْ بِخَمْسَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُسَوِّمِينَ (125)﴾ [آل عمران: 124-125]، هكذا يستحثهم الله سبحانه على المزيد من الصبر، والثبات على أمره، والمزيد من الاستغاثة به سبحانه، ولسوف يعجل الله تعالى لهم بعدها بنصره ويضاعف لهم من مدد ملائكته."},{"paragraphIndex":2711,"physicalPage":346,"adjustedPage":345,"text":"ولقد سلك رسول الله صلى الله عليه وسلم هذا الطريق في كل شدة أصابته، وكانت هي الحاسمة في كل صراع، ففي الهجرة ذكر الله عز وجل حاله في غارِهِ، والمشركون بخيولهم على فم الغار المقطوع بين مكة والمدينة، فقال سبحانه: ﴿إِلَّا تَنْصُرُوهُ فَقَدْ نَصَرَهُ اللَّهُ إِذْ أَخْرَجَهُ الَّذِينَ كَفَرُوا ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَيْهِ وَأَيَّدَهُ بِجُنُودٍ لَمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ الَّذِينَ كَفَرُوا السُّفْلَى وَكَلِمَةُ اللَّهِ هِيَ الْعُلْيَا وَاللَّهُ عَزِيزٌ حَكِيمٌ (40)﴾ [التوبة: 40]، وقد صح عن نبينا صلى الله عليه وسلم أنه قال: (ما ظنك يا أبا بكر باثنين الله ثالثهما)(\u0002)."},{"paragraphIndex":2712,"physicalPage":347,"adjustedPage":346,"text":"وفي غزوة بدر وقف النبي صلى الله عليه وسلم بباب عريشه يدعو الله سبحانه دعاء لم يرَ الناسُ مثله قبل ذلك اليوم، فعن عمر بن الخطاب، قال: لما كان يوم بدر، نظر رسول الله صلى الله عليه وسلم إلى المشركين وهم ألف، وأصحابه ثلاث مئة وتسعة عشر رجلاً، فاستقبل نبي الله صلى الله عليه وسلم القبلة، ثُمَّ مدَّ يديه، فجعل يهتفُ بربِّه: (اللهم أنجز لي ما وعدتني، اللهم آت ما وعدتني، اللهم إن تُهلك هذه العصابة من أهل الإسلام، لا تُعبد في الأرض)، فما زال يهتف بربِّه، مادًّا يديه، مستقبل القبلة، حتّى سقط رداؤه عن منكبيه، فأتاه أبو بكر، فأخذ رداءه، فألقاه على منكبيه، ثُمَّ التزمه من ورائه، وقال: يا نبي الله، كذاك(\u0002) مناشدتك ربك، فإنّه سينجز لك ما وعدك، فأنزل الله عز وجل: ﴿إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9)﴾ [الأنفال: 9]، فأمده الله بالملائكة(\u0002)."},{"paragraphIndex":2713,"physicalPage":347,"adjustedPage":346,"text":"والنبي صلى الله عليه وسلم لما ناشد ربّه سبحانه وتعالى وقال له أبو بكر: إنَّ الله منجزٌ لك ما وعدك، خفق رسول الله صلى الله عليه وسلم خفقة، وهو في العريش ثم انتبه فقال: (يا أبا بكر أتاك نصر الله، هذا جبريل آخذٌ بعنان فرسه يقوده على ثناياه النقع)(\u0002)."},{"paragraphIndex":2714,"physicalPage":347,"adjustedPage":346,"text":"وهذا هو ما تضمنه قوله سبحانه: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَنْصُرُوا اللَّهَ يَنْصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ (7)﴾ [محمد: 7]."},{"paragraphIndex":2715,"physicalPage":347,"adjustedPage":346,"text":"فالواجب أن تدفعنا قوة العدو إلى مزيد اللجوء إلى الله، كما تدفعنا ابتلاءاتنا إلى تجديد التوبة مع الله، وتصحيح أخطائنا السابقة أيًّا كانت."},{"paragraphIndex":2716,"physicalPage":348,"adjustedPage":347,"text":"وقد ذكر ابن كثير أنَّ صلاح الدین مرض مرضًا شديدًا، ثم نذر لئن شفاه الله من مرضه هذا ليصرفن همته كلها إلى قتال الفرنج، ولا يقاتل بعد ذلك مسلمًا، وليجعل أكبر همه فتح بيت المقدس، ولو صرف في سبيل الله جميع ما يملكه من الأموال والذخائر، وليقتلن البرنس صاحب الكرك بيده؛ لأنه نقض العهد، وتنقَّص الرسول صلى الله عليه وسلم، وذلك أنه أخذ قافلة ذاهبة من مصر إلى الشام فأخذ أموالهم، وضرب رقابهم، وهو يقول: أين محمدكم، دعوه ينصركم؟ وكان هذا النذر كله بأشارة القاضي الفاضل، وهو أرشده إليه، وحثه عليه، حتى عقده مع الله عز وجل، فعند ذلك شفاه الله، وعافاه من ذلك المرض الذي كان فيه كفارة لذنوبه، وجاءت البشارات بذلك من كل ناحية، فدقت البشائر، وزينت البلاد(\u0002)."},{"paragraphIndex":2717,"physicalPage":348,"adjustedPage":347,"text":"فصلاح الدين صحح الطريق بتحويله من قتال المسلمين المخالفين له ولشرع الله إلى قتال من لا خلاف في قتاله، وهو العدو الأكبر والأخطر «الصليبيين»، كما زاد من لجوئه لله عز وجل بسبب هذا البلاء الذي أصابه، ومشورة هذا الناصح الأمين."},{"paragraphIndex":2718,"physicalPage":348,"adjustedPage":347,"text":"وهكذا سارت منهجية هذا القاضي الفاضل في سد خلل الهزيمة بصحة تشخيص سببها الأعظم، ألا إنه الذنوب، وكم كان له من فضل بعد الله بإنزال النصر حين كان ينبِّه صلاح الدين إلى هذا الأمر الخطير كلما أصيبت الأمة بدينها أو خلقها، يقول ابن كثير: «وكان القاضي الفاضل بمصر يدير الممالك بها، ويجهز إلى السلطان ما يحتاج إليه من الأموال، وعمل الأسطول والكتب السلطانية، فمنها كتاب يذكر فيه أنَّ سبب هذا التطويل في الحصار كثرة الذنوب، وارتكاب المحارم بين الناس، فإنَّ الله لا ينال ما عنده إلا بطاعته، ولا يفرِّج الشدائد إلا بالرجوع إليه، وامتثال أمره، فكيف لا يطول الحصار، والمعاصي في كل مكان فاشية، وقد صعد إلى الله منها ما يتوقع بعده الاستعاذة منه؟! وفيه أنه قد بلغه أنَّ بيت المقدس قد ظهر فيه المنكرات والفواحش والظلم في بلاده، ما لا يمكن تلافيه إلا بكلفة كثيرة، ومنها كتاب يقول فيه: إنما أُتينا من قبل أنفسنا، ولو صدقنا لعجَّل الله لنا عواقب صدقنا، ولو أطعناه لما عاقبنا بعدونا، ولو فعلنا ما نقدر عليه من أمره لفعل لنا ما لا نقدر عليه إلا به، فلا يختصم أحد إلا نفسه وعمله، ولا يرج إلا ربه، ولا يغتر بكثرة العساكر والأعوان ولا فلان الذي يعتمد عليه أن يقاتل، ولا فلان، فكل هذه مشاغل عن الله، ليس النصر بها، وإنما النصر من عند الله، ولا نأمن أن يكلنا الله إليها، والنصر به، واللطف منه، ونستغفر الله تعالى من ذنوبنا، فلولا أنها تسد طريق دعائنا لكان جواب دعائنا قد نزل وفيض دموع الخاشعين قد غسل، ولكن في الطريق عائق»(\u0002)."},{"paragraphIndex":2719,"physicalPage":348,"adjustedPage":347,"text":"هذه هي الخاصية التي ينبغي توافرها اليوم في وضعنا العراقي إذا كنا نري من الله أن ينصرنا عاجلاً غير آجل، حاسمًا غير مقطع أو مجزَّأ."},{"paragraphIndex":2720,"physicalPage":349,"adjustedPage":348,"text":"وأعظم ما تكون شفقة العارفين بسنن النصر الإلهي على مصير دينهم وأمتهم إذا نقص واحد من هذين الاثنين: مزيد الاستمساك بأمره، ومزيد التوكل عليه."},{"paragraphIndex":2721,"physicalPage":349,"adjustedPage":348,"text":"وإذا تدبرنا موقف المنهزمين في التاريخ وجدنا أنّ بدايتهم في العادة مزلزلة، لكنّ نهايتهم مخزية، فالله سبحانه كما بيَّن كيف ازداد صبر المؤمنين، وازداد توكلهم على الله، كلما اقترب لقاء جالوت وجنوده، فقد بيّن في الآية نفسها تناقص الصبر والتوكل للمنهزمين من الجيش نفسه، ففي كل موقف كان يتساقط منهم قسم حتى كان آخر جماعاتهم تساقطًا عندما برزوا لجالوت وجنوده، وهكذا تثبت هذه القاعدة بوجهيها: زيادة في التوكل والصبر، أو زيادة في التخلي عن أمر الله والتخلي عن التوكل عليه سبحانه، ونتيجة الزيادتين متوافقة مع مقدمتها."},{"paragraphIndex":2722,"physicalPage":349,"adjustedPage":348,"text":"إنَّ الخاصية التي نحتاجها اليوم فعلاً هي التفرد في الثبات والإقدام، يقول النبي صلى الله عليه وسلم: «ثلاثة يحبُّهم الله «فذكر»: أحدهم الرّجل كان في سريّة فلقوا العدوّ فهزموا فأقبل بصدره حتّى يُقتل أو يفتح بصدره»(\u0002)."},{"paragraphIndex":2723,"physicalPage":349,"adjustedPage":348,"text":"خاصية التميز بين عظماء المتفردين، وخاصية التميز الجماعي بين الجماعات الجهادية المتميزة."},{"paragraphIndex":2724,"physicalPage":349,"adjustedPage":348,"text":"وغالب هذا التميز يكون بالثبات حين يتساقط الآخرون، ويكون بالصبر حين ينفد صبر الآخرين."},{"paragraphIndex":2725,"physicalPage":349,"adjustedPage":348,"text":"ويكون بمزيد التوكل على الله عز وجل حين يضعف توكل المتوكلين."},{"paragraphIndex":2726,"physicalPage":349,"adjustedPage":348,"text":"ويكون بمزيد التمسك بالكتاب والسنة حين تعلو صيحات أهل الدنيا بالتخلي عن بعضها لأجل الأهواء، ويكون بالثبات في المواقع الأولى حين ينزل من علوهم إلى الغنائم الأكثرون، ويكون بأُلفة الغربة واستعذابها حين يصبح التخلف ظاهرة مألوفة، ولا ينكره المنكرون، ويكون بالذهول عن كل عرضٍ قريب أو ربحٍ مضمون مريح إلى الركض إلى لقاء الله مسلوب العقل مشتاق القلب هائمًا نحو الجنة كأنه خُلِق بغير صبوة في وقت يتنازع أقرائه الدنيا الحلال."},{"paragraphIndex":2727,"physicalPage":350,"adjustedPage":349,"text":"ويكون بالصبر بعد الصبر، والوفاء بعد الوفاء لله تعالى حتى اللقاء، والعطاء على الحاجة على الرغم من شح الأغنياء، فما أعظم هؤلاء المتميزين في عين الله سبحانه، فالله سبحانه يراهم لا يبالون إلا به ولا يعولون إلا عليه، ولا يخذلهم مخذل حتى لو كانت الأمة كلها."},{"paragraphIndex":2728,"physicalPage":350,"adjustedPage":349,"text":"﴿يَا قَوْمِ ادْخُلُوا الْأَرْضَ الْمُقَدَّسَةَ الَّتِي كَتَبَ اللَّهُ لَكُمْ وَلَا تَرْتَدُّوا عَلَى أَدْبَارِكُمْ فَتَنْقَلِبُوا خَاسِرِينَ (21) قَالُوا يَا مُوسَى إِنَّ فِيهَا قَوْمًا جَبَّارِينَ وَإِنَّا لَنْ نَدْخُلَهَا حَتَّى يَخْرُجُوا مِنْهَا فَإِنْ يَخْرُجُوا مِنْهَا فَإِنَّا دَاخِلُونَ (22)﴾ [المائدة: 21-22]."},{"paragraphIndex":2729,"physicalPage":350,"adjustedPage":349,"text":"نعم بقي اثنان فقط من أمة بأكملها، وما فتَّ في عضدهما تخلف الناس، وغربتهما وسط الأمة بأكملها."},{"paragraphIndex":2730,"physicalPage":350,"adjustedPage":349,"text":"تساقطت مناطق بأكملها في الردة بعد وفاة النبي صلى الله عليه وسلم، لكن ثبتت قرى أخرى بواحدٍ ثابتٍ في تلك القرية عاهد النبي صلى الله عليه وسلم من قبل وفاته، وعادت بلاد بأكملها للإسلام بثبات قرية كقرية جوانا في البحرين، وعادت بلاد الدنيا إلى الإسلام بثبات المدينة، وثبتت المدينة بثبات الصدّيق رضي الله عنه، وثبات أصحاب النبي صلى الله عليه وسلم رضي الله عنهم أجمعين."},{"paragraphIndex":2731,"physicalPage":350,"adjustedPage":349,"text":"هذه سُنّة لم يتخل عنها المنصورون طول رحلة النصر العظيم."},{"paragraphIndex":2732,"physicalPage":350,"adjustedPage":349,"text":"يا أهل العراق: هذا هو وقت التفرد الذي لا يطلبه إلا من كان ينتظر فرصة؛ ليشهد الله سبحانه على عمل يتميز به في عينه سبحانه."},{"paragraphIndex":2733,"physicalPage":350,"adjustedPage":349,"text":"أيتها الجماعات المجاهدة: وكما أنه وقت تميز الأفراد فأنه وقت تميز الجماعة من بين الجماعات، والتميز بالاستقامة على المنهج."},{"paragraphIndex":2734,"physicalPage":350,"adjustedPage":349,"text":"هذا وقت التفرد الذي يزأر فيه الأسدُ غيرة ونخوة في جموع الأسود الداجنة المتهالكة على الأعلاف أن عُودوا أسودًا، وإلا فلسوف أسير ضاربًا في الأرض باحثًا عن عرين أسود ما زالت أسودًا."},{"paragraphIndex":2735,"physicalPage":350,"adjustedPage":349,"text":"هذا وقت التفرد في الإقدام حيث يتجلى فيه بين العينين مشهد أنس بن النضر، وقد هام نحو الجنة ناظرًا للمقاتلين الجالسين في سفح الجبل: مالكم؟! قالوا: مات رسول الله! قال: فما تصنعون بالحياة بعده؟! قوموا فموتوا على ما مات عليه رسول الله صلى الله عليه وسلم."},{"paragraphIndex":2736,"physicalPage":351,"adjustedPage":350,"text":"وقت التفرد في اليقين حيث يعيش فيه المؤمن وكأنه يعيش النصر، ويسمع طرق الفاتحين للأبواب ﴿فَتَرَى الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ يُسَارِعُونَ فِيهِمْ يَقُولُونَ نَخْشَى أَنْ تُصِيبَنَا دَائِرَةٌ فَعَسَى اللَّهُ أَنْ يَأْتِيَ بِالْفَتْحِ أَوْ أَمْرٍ مِنْ عِنْدِهِ فَيُصْبِحُوا عَلَى مَا أَسَرُّوا فِي أَنْفُسِهِمْ نَادِمِينَ (52)﴾ [المائدة: 52]."},{"paragraphIndex":2737,"physicalPage":351,"adjustedPage":350,"text":"وعسى من الله للتحقيق كما يقول أهل التفسير(\u0002)."},{"paragraphIndex":2738,"physicalPage":351,"adjustedPage":350,"text":"***"},{"paragraphIndex":2739,"physicalPage":351,"adjustedPage":350,"text":"العلاج الخامس"},{"paragraphIndex":2740,"physicalPage":351,"adjustedPage":350,"text":"عدم الإصغاء للكافرين والمنافقين: إنَّ الأصل هو مخالفة نصائح الكافرين إذا نصحونا؛ لأنَّ الله سبحانه بيّن أنَّ حقيقتهم كرهنا إلا في حالات استثنائية، فقال سبحانه: ﴿هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِالْكِتَابِ كُلِّهِ وَإِذَا لَقُوكُمْ قَالُوا آمَنَّا وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ قُلْ مُوتُوا بِغَيْظِكُمْ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ (119) إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكُمْ سَيِّئَةٌ يَفْرَحُوا بِهَا وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا إِنَّ اللَّهَ بِمَا يَعْمَلُونَ مُحِيطٌ (120)﴾ [آل عمران: 119-120]،"},{"paragraphIndex":2741,"physicalPage":351,"adjustedPage":350,"text":"هذا ما أخبر به علَّام الغيوب سبحانه، فمهما بلغ بهؤلاء حسن التبرير لنصحهم، والأدلة المقنعة على مشاريعهم، والابتسامات الشاهدة على صدقهم وحبهم ... فإنَّ قول الله تعالى يكشفهم، ونحن إذا رجعنا إلى الدعوة لعمل الانتخابات البرلمانية أو التعيينات الوزارية نجدها دعوة منهم وليست منا، وطلبًا لنا بالمشاركة في انتخاباتهم ووزاراتهم، وما دام الأمر كذلك فإنَّ الحكم الشرعي يبقى على الأصل الذي ذكر الله سبحانه وتعالى في النهي عن طاعتهم: ﴿فَلَا تُطِعِ الْمُكَذِّبِينَ (8) وَدُّوا لَوْ تُدْهِنُ فَيُدْهِنُونَ (9) وَلَا تُطِعْ كُلَّ حَلَّافٍ مَهِينٍ (10)﴾ [القلم: 8-10]، ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا فَرِيقًا مِنَ الَّذِينَ أُوتُوا الْكِتَابَ يَرُدُّوكُمْ بَعْدَ إِيمَانِكُمْ كَافِرِينَ (100)﴾ [آل عمران: 100]، ﴿فَاتَّقُوا اللَّهَ وَأَطِيعُونِ (150) وَلَا تُطِيعُوا أَمْرَ الْمُسْرِفِينَ (151) الَّذِينَ يُفْسِدُونَ فِي الْأَرْضِ وَلَا يُصْلِحُونَ (152)﴾ [الشعراء: 150-152]، ﴿يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا (1) وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا (2) وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا (3)﴾ [الأحزاب: 1-3]."},{"paragraphIndex":2742,"physicalPage":352,"adjustedPage":351,"text":"والعدو أحرص ما يكون على اختراقنا، وذلك بإيقاعنا بمخالفات شرعية، فإذا ما وقع فيها من وقع اصطاده بصورة أو تقرير أوكتاب خطي أو اجتماع سري، وأصبح ذلك الذنب الذي أوقعه فيه سيفه المسلط على رقبته، فاستخدامه يعني سقوطه من عين المسلمين، فيبقى ذلك الذنب سببًا لابتزازه الدائم، ولو أنه صارح إخوانه بحقيقة الأمر، وبذل عرضه لله تعالى لوفَّر على نفسه سترًا وحماية من إخوانه، ولفوّت على عدوه الفرصة، كما قال النبي صلى الله عليه وسلم لعائشة رضي الله عنها في حادثة الإفك: (يا عائشة، فإنّه قد بلغني عنك كذا وكذا، فإن كنت بريئة فسيبرّئك الله، وإن كنت ألممت بذنب، فاستغفري الله وتوبي إليه، فإنَّ العبد إذا اعترف بذنب ثُمّ تاب، تاب الله عليه)(\u0002)."},{"paragraphIndex":2743,"physicalPage":352,"adjustedPage":351,"text":"إن منهجية استخدام الفتنة بالنساء الفاتنات لكسب ضعاف الإيمان منهج صليبي قديم، يقول ابن كثير: «ثم دخلت سنة ست وثمانين وخمس مئة استهلت والسلطان صلاح الدين محاصر لحصن عكا، وأمداد الفرنج تفد إليهم من البحر في كل وقت حتى أن نساء الفرنج ليخرجن بنية القتال، ومنهن من تأتي بنية راحة الغرباء لينكحوها في الغربة، فيجدون راحة وخدمة وقضاء وطر، قدم إليهم مركب فيه ثلاث مئة امرأة من أحسن النساء وأجملهن بهذه النية، فإذا وجدوا ذلك ثبتوا على الحرب والغربة حتى أنَّ كثيرًا من فسقة المسلمين تحيزوا إليهم من أجل هذه النسوة، واشتهر الخبر بذلك»(\u0002)."},{"paragraphIndex":2744,"physicalPage":352,"adjustedPage":351,"text":"الحذر أشد الحذر من طاعتهم، فالله يحذرنا: ﴿قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ قَدْ بَيَّنَّا لَكُمُ الْآيَاتِ إِنْ كُنْتُمْ تَعْقِلُونَ (118)﴾ [آل عمران: 118]."},{"paragraphIndex":2745,"physicalPage":352,"adjustedPage":351,"text":"الحذر من أن يبلِّغونا عن طريق محب مُستغفل بعض مقترحاتهم، وهم من وراء الستار يتلصصون، فنعطيه الأمل ونفتح له كُوَّة."},{"paragraphIndex":2746,"physicalPage":352,"adjustedPage":351,"text":"الحذر من قبول تنازل عن ثابت من الثوابت يكون إيذانًا بأنَّ ثوابتنا قابلة للتفاوض."},{"paragraphIndex":2747,"physicalPage":353,"adjustedPage":352,"text":"الحذر من الغفلة عن الله تعالى في كل شأن، والحذر من تحقير أدوارنا أو تصغيرها وتحجيمها بحدود ذواتنا أو جماعتنا أو حزبنا أو عشيرتنا أو نحو ذلك، فدورنا هو حراسة دين الله عز وجل في هذا الزمان، وفي هذه الأرض كلها، والحارس لا يملك ما يحرسه من أشياء حتى يتنازل أو يفاوض، وإنَّ العدو ربما يأتي من قبل هذا أو ذاك، أما من قبلنا فلا والله، ونسأل الله الكريم الثبات، وأن لا يكلنا إلى أنفسنا طرفة عين، إنها الحساسية الضرورية للوقاية، ﴿أَتُمِدُّونَنِ بِمَالٍ فَمَا آتَانِيَ اللَّهُ خَيْرٌ مِمَّا آتَاكُمْ بَلْ أَنْتُمْ بِهَدِيَّتِكُمْ تَفْرَحُونَ (36)﴾ [النمل: 36]."},{"paragraphIndex":2748,"physicalPage":353,"adjustedPage":352,"text":"والعجيب حقًّا أن يذكر الله سبحانه وتعالى وجوب التوكل عليه في مقابل النهي عن طاعتهم، إذ أمورهم تدخل فيها كل الحسابات المنطقية المادية إلا التوكل على الله والثقة به، فمن نظر قواعدهم الحسابية اقتنع، ومن نظر في قواعد القرآن اکتفی بالاستطاعة مع التوكل."},{"paragraphIndex":2749,"physicalPage":353,"adjustedPage":352,"text":"***"},{"paragraphIndex":2750,"physicalPage":353,"adjustedPage":352,"text":"العلاج السادس"},{"paragraphIndex":2751,"physicalPage":353,"adjustedPage":352,"text":"الحراسة الخطيرة حتى اللحظة الأخيرة: قبيل لحظة النصر الحاسمة تكثر عروض العدو المغرية؛ ليسكت صرخة النصر الأخيرة في لحظة ولادته المريرة ... فيعرض كل تنازل ممكن ليحول دون صرخة الحق القادمة الوليدة، فيرى المستغفلون عروضه مكاسب، وما هي إلا خنق للمولود الجديد."},{"paragraphIndex":2752,"physicalPage":353,"adjustedPage":352,"text":"فيا من ترجون السلامة لأنفسكم بوأد جنينٍ وقتل أمه أرْبعوا على أنفسكم."},{"paragraphIndex":2753,"physicalPage":353,"adjustedPage":352,"text":"فوالله ذاك أمر لستم ببالغيه، ومولود لستم بطاعنيه، فإنما تطعنون ماضيكم، وتقتلون أنفسكم ... فجنين النصر قد نُفخت فيه الروح، وكتبت -بإذن الله- سلامته وسعادته وعزيمته وعزته ... وقتله بإجماع الأمة حرام، بل قتله قتل لأمّه ولأمته، وذلك أمرٌ محال."},{"paragraphIndex":2754,"physicalPage":353,"adjustedPage":352,"text":"فإن عجزتم عن صبر لحظة، وغرّكم السمك الشُّرع عند الساحل، فارجعوا لبيوتكم وأغلقوها عليكم، وأسلموا الراية لمن يحملها ويطرق باب القرية المقدسة التي كتب الله لنا بإذنه دخولها، فما بيننا وبين كتاب الله بفتح البلاد إلا دخول الباب."},{"paragraphIndex":2755,"physicalPage":353,"adjustedPage":352,"text":"أرْبعوا على أنفسكم فإنَّ من رقى على بيوت من نصبوا الشباك -يوم سبتهم بعدما عادوا فرحين بالأسماك إلى بيوتهم- رآهم قردة خاسئين في بيوتهم! وقد ذكر بعض المفسرين أن المسخ شمل الساكتين."},{"paragraphIndex":2756,"physicalPage":353,"adjustedPage":352,"text":"والخشية الأكبر أن يُؤخذ من سكت عن المنكر، وهو يعلم، بوزر من دخل البرلمان أو الوزارة بتعليلات تصادم التوحيد والواقع."},{"paragraphIndex":2757,"physicalPage":353,"adjustedPage":352,"text":"فإن الله جل وعلا -كما يقول أهل العلم- لم يذكر مصير الذين سكتوا من أصحابهم، فكان ذلك دليلاً على أنَّ المسخ قردة وخنازير شمل الساكتين."},{"paragraphIndex":2758,"physicalPage":354,"adjustedPage":353,"text":"بينما ذكر الله تعالى أنَّ أخذه ونبذه فرعون شمله وجنده، فقال سبحانه: ﴿فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ (40)﴾ [القصص: 40]."},{"paragraphIndex":2759,"physicalPage":354,"adjustedPage":353,"text":"دعوا الكتائب الجهادية تتهادى نحو النصر المبين."},{"paragraphIndex":2760,"physicalPage":354,"adjustedPage":353,"text":"أما أنتم فاقعدوا إن شئتم في خفاء؛ لئلا تكونوا قدوة للمترددين، اقعدوا ولا تغروا الآخرين بالقعود؛ لئلا ترثوا من ﴿قَالُوا لِإِخْوَانِهِمْ وَقَعَدُوا﴾ ثم ترثوا آثام القاعدين إلى يوم الدين."},{"paragraphIndex":2761,"physicalPage":354,"adjustedPage":353,"text":"اقعدوا ولا تعترضوا طريق من اشترى الله أنفسهم وأموالهم؛ لئلا تكونوا من المعوقين الذين قال الله فيهم: ﴿وَإِنَّ مِنْكُمْ لَمَنْ لَيُبَطِّئَنَّ فَإِنْ أَصَابَتْكُمْ مُصِيبَةٌ قَالَ قَدْ أَنْعَمَ اللَّهُ عَلَيَّ إِذْ لَمْ أَكُنْ مَعَهُمْ شَهِيدًا (72)﴾ [النساء: 72]."},{"paragraphIndex":2762,"physicalPage":354,"adjustedPage":353,"text":"يا أخوتاه: أمن أجل ثمرة تريدونها في حياتكم من جهادكم كيفما كانت تقدمون هذا التنازل؛ طلبًا لعلوٍّ وعزة تتوهمونها في حياتكم، فماذا تركنا لمن قال الله فيهم: ﴿الَّذِينَ يَتَّخِذُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ فَإِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا (139)﴾ [النساء: 139]."},{"paragraphIndex":2763,"physicalPage":354,"adjustedPage":353,"text":"يا أخوتاه: هل من طعنةٍ في الإخلاص أكبر من أن يتنازل رجل عن الجهاد؛ ليكسب ثمرة عاجلة فانية من عدوه، هذا وإخوانه يهتفون به: بالله عليك لا تقبل من عدونا تنازلاً، دعه يتجرع الغرق حتى الموت، وإن استطعت أن تدسَّ في فيه وحلاً من القاع فافعل."},{"paragraphIndex":2764,"physicalPage":354,"adjustedPage":353,"text":"يا طلاب البرلمان والوزارة: دعوا مسيرة الجهاد لا تلوثوها..."},{"paragraphIndex":2765,"physicalPage":354,"adjustedPage":353,"text":"أيها الأخ المتردد: بالله عليك إن لم تستطع الصبر وخشيت الفتنة فاترك الميدان، وارجع لبيتك خفية، واستغفر الله من توليك عن زحفك، وابك على خطيئتك، وانتظر حكم الله فيك القيامة."},{"paragraphIndex":2766,"physicalPage":354,"adjustedPage":353,"text":"إنكم تعلمون أنَّ أمريكا سفينة كبيرة، وهي تغرق على مستوى العالم كما ترونها، وترون رأسها متجهًا نحو قاع المحيط العراقي، فهل يربط العاقل سفينته الصغيرة بسفينة عظيمة تغرق، أو يربط مصيره بمصيرها المشؤوم؟!"},{"paragraphIndex":2767,"physicalPage":354,"adjustedPage":353,"text":"فهل ترى الحكم الشرعي يسعنا، ونحن نعلم أنَّ ما نصنعه إنما هو قبول وزارة في حكومة شركية أو عضوية تشريعية شركية من دون الله على أوسع نطاق؟!"},{"paragraphIndex":2768,"physicalPage":354,"adjustedPage":353,"text":"أليس هذا تحولاً من حرب الشرك إلى المشاركة في الشرك، عياذًا بالله تعالى؟!"},{"paragraphIndex":2769,"physicalPage":355,"adjustedPage":354,"text":"وهل يسعكم ترك جهاد الشرك؟! وهل يجوز قتل روح بشرية معصومة، ولو كانت جنينًا، حتى لو أُكرهنا على ذلك؟! والإكراه على القتل لا يجوز، كما لا يجوز للمكره الاستجابة لمن أكرهه، لو فرض الإكراه."},{"paragraphIndex":2770,"physicalPage":355,"adjustedPage":354,"text":"كيف وأمرنا أعظم من إكراه على خنق جنين يستهل صارخًا."},{"paragraphIndex":2771,"physicalPage":355,"adjustedPage":354,"text":"إنها ولادة الأمة من جديد، وقتل راعي اليهودية والصليبية بإذن الله تعالى، فحسبنا الله ومن اتبعنا من المؤمنين ... وحسبنا الله ونعم الوكيل."},{"paragraphIndex":2772,"physicalPage":355,"adjustedPage":354,"text":"((("},{"paragraphIndex":2773,"physicalPage":355,"adjustedPage":354,"text":""},{"paragraphIndex":2774,"physicalPage":356,"adjustedPage":355,"text":"\u000eالخاتمة"},{"paragraphIndex":2775,"physicalPage":356,"adjustedPage":355,"text":""},{"paragraphIndex":2776,"physicalPage":356,"adjustedPage":355,"text":"أرجو أن نكون قد أجبنا عن كثير من المسائل، والفضل لله وحده، ومن تشكك في هذا فليرجع لمسائل البحث كلها، وليرجع التأمل فيها الكَرَّة بعد الأخرى، وسوف يجدها كما ذكرتُ إن شاء الله تعالى، معترفًا بأنه جهد بشري نعتقد صوابه ويرد عليه الوهم والله المستعان."},{"paragraphIndex":2777,"physicalPage":356,"adjustedPage":355,"text":"لكن بعد هذا البحث، يظهر السؤال الكبير، ذلك هو: ما هو الموقف الذي سيتخذه كلُّ من قرأ هذا الكتاب؟"},{"paragraphIndex":2778,"physicalPage":356,"adjustedPage":355,"text":"ما هو الموقف الذي ستتخذه كل جماعة أو حزب إسلامي جهادي أو غير جهادي؟"},{"paragraphIndex":2779,"physicalPage":356,"adjustedPage":355,"text":"ما هو الموقف الذي سيتخذه كل فردٍ تأخرت جماعته في اتخاذ القرار الحاسم أو أبَت جماعته عن اتخاذ هذا القرار؟"},{"paragraphIndex":2780,"physicalPage":356,"adjustedPage":355,"text":"ربما صلح الأخذ والرد، وطول الحوار، وتأخر القرار لكثيرين من العاملين في المجالات الإسلامية المختلفة، بينما هذا التأخر هو أضر ما يكون على أصحاب الجهاد بعد بلوغ العلم، وهو أنفع ما يكون للعدو المترصد."},{"paragraphIndex":2781,"physicalPage":356,"adjustedPage":355,"text":"سيتعدى الموقف من لم يحسم قراره في اللحظة المناسبة، وستعبر عليه بيارق النصر، وجحافل وقوافل الشهادة، وهو جالس يتردد ... نشيجه ونحيبه: ﴿يَا لَيْتَنِي كُنْتُ مَعَهُمْ فَأَفُوزَ فَوْزًا عَظِيمًا (73)﴾ [النساء: 73]، ولما فاته ذلك فاته أن يفوز الفوزين العظيمين، فوز الدنيا وفوز الآخرة."},{"paragraphIndex":2782,"physicalPage":356,"adjustedPage":355,"text":"ولن تتوقف الحياة عند هؤلاء، كما لم يتوقف الأمر عند هؤلاء المتخلفين على الندم والحسرة، فكما عبر الموقف هؤلاء القواعد، فسيعبر بهم الموت إلى الموقف الكبير؛ ليكون حكم الله حاسمًا فيهم، ولا معقب لحكمه، وهو سريع الحساب."},{"paragraphIndex":2783,"physicalPage":357,"adjustedPage":356,"text":"وهل يبقى بعد هذا أمام كل قارئ مستطيع إلا أن يحسم مادة القعود من سجل حركته للجهاد حسمًا، ويحسم مادة البخل حسمًا، مادام عنده حمل نفسه، أو حملان غيره أو كفالتهم وكفالة أسرهم، ويحسم مادة التردد والانتظار بكل نوع من المشاركة يقدر عليها، ويحسم مادة الجهل والغلو حسمًا من حياته حتى يرجع إلى الذين أمر الله بالرجوع إليهم من أهل العلم، ويحسم مادة النفاق بكل صوره حسمًا من عمله وقوله وقراره وموقفه، ويحسم مادة هدنة المحتلين وزنادقتهم حسمًا، ويعود فورًا لصفّ المجاهدين."},{"paragraphIndex":2784,"physicalPage":357,"adjustedPage":356,"text":"فما أعظم حسرة من لم يحسم أمره للحق، وجاءه الموت وهو في ريبه يتردد: ﴿إِنَّ الْمُنَافِقِينَ يُخَادِعُونَ اللَّهَ وَهُوَ خَادِعُهُمْ وَإِذَا قَامُوا إِلَى الصَّلَاةِ قَامُوا كُسَالَى يُرَاءُونَ النَّاسَ وَلَا يَذْكُرُونَ اللَّهَ إِلَّا قَلِيلًا (142) مُذَبْذَبِينَ بَيْنَ ذَلِكَ لَا إِلَى هَؤُلَاءِ وَلَا إِلَى هَؤُلَاءِ وَمَنْ يُضْلِلِ اللَّهُ فَلَنْ تَجِدَ لَهُ سَبِيلًا (143) يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ أَتُرِيدُونَ أَنْ تَجْعَلُوا لِلَّهِ عَلَيْكُمْ سُلْطَانًا مُبِينًا (144) إِنَّ الْمُنَافِقِينَ فِي الدَّرْكِ الْأَسْفَلِ مِنَ النَّارِ وَلَنْ تَجِدَ لَهُمْ نَصِيرًا (145) إِلَّا الَّذِينَ تَابُوا وَأَصْلَحُوا وَاعْتَصَمُوا بِاللَّهِ وَأَخْلَصُوا دِينَهُمْ لِلَّهِ فَأُولَئِكَ مَعَ الْمُؤْمِنِينَ وَسَوْفَ يُؤْتِ اللَّهُ الْمُؤْمِنِينَ أَجْرًا عَظِيمًا (146) مَا يَفْعَلُ اللَّهُ بِعَذَابِكُمْ إِنْ شَكَرْتُمْ وَآمَنْتُمْ وَكَانَ اللَّهُ شَاكِرًا عَلِيمًا (147)﴾ [النساء: 142-147]."},{"paragraphIndex":2785,"physicalPage":357,"adjustedPage":356,"text":"ألا هل بلغت اللهم فاشهد."},{"paragraphIndex":2786,"physicalPage":357,"adjustedPage":356,"text":"ألا هل بلغت اللهم فاشهد."},{"paragraphIndex":2787,"physicalPage":357,"adjustedPage":356,"text":"ألا هل بلغت اللهم فاشهد."},{"paragraphIndex":2788,"physicalPage":357,"adjustedPage":356,"text":"وصلى الله على نبينا محمد وعلى آله وصحبه وسلم."}],"totalPages":357}