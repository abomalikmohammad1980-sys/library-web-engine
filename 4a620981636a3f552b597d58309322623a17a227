قيق الهمزة الساكنة وصلاً ووقفا.\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nوَكَانَ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nاللَّهُ: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nغَفُورًا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nرَحِيمًا: لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع\n\nعند وصل السورة\nورش عن نافع وَأبو عمرو وَيعقوب وَابن عامر فصل بين السورتين بالبسملة، والوصل، والسكت، وله ما بين الآيات من أحكام الوصل. حمزة وَخلف العاشر قرأ بالوصل بين السورتين بلا بسملة، وله ما بين الآيات من أحكام الوصل. باقي الرواة فصل بالبسملة بين السورتين.","words":[{"wordId":55005,"position":1,"word":"لِيُعَذِّبَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55006,"position":2,"word":"اللَّهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55007,"position":3,"word":"الْمُنَافِقِينَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55008,"position":4,"word":"وَالْمُنَافِقَاتِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55009,"position":5,"word":"وَالْمُشْرِكِينَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55010,"position":6,"word":"وَالْمُشْرِكَاتِ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55011,"position":7,"word":"وَيَتُوبَ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55012,"position":8,"word":"اللَّهُ","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":55013,"position":9,"word":"عَلَى","text":"لا خلاف بين القراء في هذا الموضع\n\nعند الوصل\nلا خلاف بين القراء في هذا الموضع"},{"wordId":550