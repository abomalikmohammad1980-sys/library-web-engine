import{describe,expect,it}from"vitest";import{buildQuranSearchPack,normalizeArabicBroad,searchQuranPack}from"./quran-search-pack.js";const pack=buildQuranSearchPack([{ayahId:"1:1",text:"بِسْمِ ٱللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"},{ayahId:"1:2",text:"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"}]);describe("Quran broad Arabic search pack",()=>{it("normalizes diacritics, tatweel, hamza and alif variants",()=>expect(normalizeArabicBroad("إِلَـٰهٌ إلى" )).toBe("اله الي"));it("ranks exact/prefix/all terms and broad while ignoring diacritics by default",()=>{expect(searchQuranPack(pack,"الحمد لله")[0]).toMatchObject({ayahId:"1:2",rank:"prefix"});expect(searchQuranPack(pack,"بسم الرحمن")[0]).toMatchObject({ayahId:"1:1",rank:"all-terms"});expect(searchQuranPack(pack,"بسم الله الرحمن الرحيم")[0]?.rank).toBe("exact")});it("supports an explicit diacritic-sensitive mode",()=>expect(searchQuranPack(pack,"الحمد",{diacriticSensitive:true})).toHaveLength(0));it("rejects duplicate identities",()=>expect(()=>buildQuranSearchPack([{ayahId:"1:1",text:"أ"},{ayahId:"1:1",text:"ب"}])).toThrow())});
