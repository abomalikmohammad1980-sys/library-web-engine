import{describe,expect,it,vi}from"vitest";import{SourceSyncHttpClient,SourceSyncHttpError}from"./http-client.js";
describe("browser-safe source sync HTTP client",()=>{it("injects user token, supports ETag/304, and never persists a secret",async()=>{const f=vi.fn(async(_u:URL|RequestInfo,i?:RequestInit)=>new Response(null,{status:304,headers:{etag:'"v1"'}})),client=new SourceSyncHttpClient("https://sync.example/",async()=>"user-token",f as typeof fetch);expect(await client.devices('"v1"')).toMatchObject({notModified:true,etag:'"v1"'});expect(f.mock.calls[0]![1]?.headers).toMatchObject({authorization:"Bearer user-token","if-none-match":'"v1"'});expect(JSON.stringify(client)).not.toContain("user-token")});it("rejects missing tokens before fetch",async()=>{const f=vi.fn(),client=new SourceSyncHttpClient("https://sync.example/",async()=>null,f as typeof fetch);await expect(client.usage()).rejects.toBeInstanceOf(SourceSyncHttpError);expect(f).not.toHaveBeenCalled()});it("retries transient responses and honors AbortSignal",async()=>{const f=vi.fn().mockResolvedValueOnce(new Response(null,{status:503})).mockResolvedValueOnce(Response.json([])),client=new SourceSyncHttpClient("https://sync.example/",async()=>"t",f as typeof fetch,1);expect((await client.devices()).value).toEqual([]);expect(f).toHaveBeenCalledTimes(2);const c=new AbortController();c.abort();const abortFetch=vi.fn(async()=>{throw new DOMException("Aborted","AbortError")});await expect(new SourceSyncHttpClient("https://sync.example/",async()=>"t",abortFetch as typeof fetch).usage(undefined,c.signal)).rejects.toMatchObject({name:"AbortError"})});it("sends a versioned conflict intent to the authenticated conflict endpoint",async()=>{const f=vi.fn(async()=>Response.json({status:"archived"})),client=new SourceSyncHttpClient("https://sync.example/",async()=>"t",f as typeof fetch),input={operationId:"resolve",deviceId:"device",conflictingRevisionId:"revision",expectedPublicationVersion:4,resolution:"keepRemote"as const};await client.resolveConflict("book/1",input);expect(String(f.mock.calls[0]![0])).toContain("books/book%2F1/source-revisions/resolve-conflict");expect(JSON.parse(String(f.mock.calls[0]![1]?.body))).toEqual(input)})});
