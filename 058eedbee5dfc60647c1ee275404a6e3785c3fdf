{"schemaVersion":1,"resourceId":"2003","kind":"tafsir","slug":"mokhtasar-tafsir","title":"المختصر في تفسير القرآن الكريم","author":"مركز تفسير للدراسات القرآنية","surah":52,"records":[{"ayah":1,"from":1,"to":1,"text":"أقسم الله بالجبل الذي كلّم عليه موسى عليه السلام."},{"ayah":2,"from":2,"to":2,"text":"وأقسم بالكتاب الذي هو مسَطَّر."},{"ayah":3,"from":3,"to":3,"text":"في ورق مبسوط مفتوح كالكتب المنزلة."},{"ayah":4,"from":4,"to":4,"text":"وأقسم بالبيت الذي تعمره الملائكة في السماء بعبادة الله."},{"ayah":5,"from":5,"to":5,"text":"وأقسم بالسماء المرفوعة التي هي سقف الأرض."},{"ayah":6,"from":6,"to":6,"text":"وأقسم بالبحر المملوء ماء."},{"ayah":7,"from":7,"to":7,"text":"إن عذاب ربك - أيها الرسول - لواقع لا محالة على الكافرين."},{"ayah":8,"from":8,"to":8,"text":"ليس له من دافع يدفعه عنهم، ويمنعهم من وقوعه بهم."},{"ayah":9,"from":9,"to":9,"text":"يوم تتحرك السماء تحركًا، وتضطرب إيذانًا بالقيامة."},{"ayah":10,"from":10,"to":10,"text":"وتسير الجبال من مواقعها سيرًا."},{"ayah":11,"from":11,"to":11,"text":"فهلاك وخسار في ذلك اليوم للمكذبين بما وعد الله الكافرين به من العذاب."},{"ayah":12,"from":12,"to":12,"text":"الذين هم في خوض في الباطل يلعبون، لا يبالون ببعث ولا نشور."},{"ayah":13,"from":13,"to":13,"text":"يوم يُدْفعون بشدّة وعنف إلى نار جهنم دفعًا."},{"ayah":14,"from":14,"to":14,"text":"ويقال توبيخًا لهم: هذه النار التي كنتم بها تكذبون عندما تخوفكم رسلكم منها."},{"ayah":15,"from":15,"to":15,"text":"أفسحر هذا الذي عاينتموه من العذاب؟! أم أنتم لا تعاينونه؟!"},{"ayah":16,"from":16,"to":16,"text":"ذوقوا حرّ هذه النار وعانوها، فاصبروا على معاناة حرّها، أو لا تصبروا عليه، سواء صبركم وعدم صبركم، لا تجزون اليوم إلا ما كنتم تعملون في الدنيا من الكفر والمعاصي."},{"ayah":17,"from":17,"to":17,"text":"إن المتقين لربهم - بامتثال أوامره، واجتناب نواهيه - في جنات ونعيم عظيم لا ينقطع."},{"ayah":18,"from":18,"to":18,"text":"يتفكهون بما أعطاهم الله من لذائذ المأكل والمشرب والمنكح، ووقاهم ربهم سبحانه عذاب الجحيم؛ ففازوا بحصول مطلوبهم من الملذات، وبوقايتهم من المكدرات."},{"ayah":19,"from":19,"to":19,"text":"ويقال لهم: كلوا واشربوا مما اشتهته أنفسكم، هنيئًا، لا تخافون ضررًا ولا أذى مما تأكلون أو تشربون؛ جزاء لكم على أعمالكم الطيبة في الدنيا."},{"ayah":20,"from":20,"to":20,"text":"متكئون على الأرائك المزينة قد جعلت متقابلة بعضها إلى جانب بعض، وزوجناهم بنساء بيض واسعات العيون."},{"ayah":21,"from":21,"to":21,"text":"والذين آمنوا واتبعهم أولادهم في الإيمان، ألحقنا بهم أولادهم لتقرّ أعينهم بهم، ولو لم يبلغوا أعمالهم، وما نقصناهم شيئًا من ثواب أعمالهم، كل إنسان محبوس بما كسبه من عمل سيئ لا يحمل عنه غيره من عمله شيئًا."},{"ayah":22,"from":22,"to":22,"text":"وأمددنا أهل الجنة هؤلاء بصنوف من الفاكهة، وأمددناهم بكل ما اشتهوه من لحم."},{"ayah":23,"from":23,"to":23,"text":"يتعاطون في الجنة كأسًا لا يترتب على شربها ما يترتب عليها في الدنيا، من الكلام الباطل والإثم بسبب السكر."},{"ayah":24,"from":24,"to":24,"text":"ويدور عليهم غلمان سخروا لخدمتهم كأنهم في صفاء بشرتهم وبياضها لؤلؤ محفوظ في أصدافه."},{"ayah":25,"from":25,"to":25,"text":"وأقبل بعض أهل الجنة على بعض، يسأل بعضهم بعضًا عن حالهم في الدنيا."},{"ayah":26,"from":26,"to":26,"text":"فيجيبونهم: إنا كنا في الدنيا بين أهلينا خائفين من عذاب الله."},{"ayah":27,"from":27,"to":27,"text":"فمنّ الله علينا بالهداية إلى الإسلام، ووقانا العذاب البالغ في الحرارة."},{"ayah":28,"from":28,"to":28,"text":"إنا كنّا في حياتنا الدنيا نعبده، وندعوه أن يقينا عذاب النار، إنه هو المحسن الصادق في وعده لعباده، الرحيم بهم، ومن برّه ورحمته بنا أن هدانا للإيمان، وأدخلنا الجنة، وأبعدنا عن النار."},{"ayah":29,"from":29,"to":29,"text":"فذكّر - أيها الرسول - بالقرآن، فلست بما أنعم الله عليك به من الإيمان والعقل بكاهنٍ لكَ رَئِيٌّ من الجن، ولست بمجنون."},{"ayah":30,"from":30,"to":30,"text":"أم يقول هؤلاء المكذبون: إن محمدًا ليس رسولًا، بل هو شاعر ننتظر به أن يتخطفه الموت، فنستريح منه."},{"ayah":31,"from":31,"to":31,"text":"قل لهم - أيها الرسول -: انتظروا موتي، وأنا أنتظر ما يحلّ بكم من عذاب بسبب تكذيبكم إياي."},{"ayah":32,"from":32,"to":32,"text":"بل أتأمرهم عقولهم بقولهم: إنه كاهن ومجنون؟! فيجمعون بين ما لا يجتمع في شخص، بل هم قوم متجاوزون للحدود، فلا يرجعون إلى شرع ولا عقل."},{"ayah":33,"from":33,"to":33,"text":"أم يقولون: إن محمدًا اختلق هذا القرآن، ولم يوحَ إليه به؟! لم يختلقه، بل هم يستكبرون عن الإيمان به، فيقولون: اختلقه."},{"ayah":34,"from":34,"to":34,"text":"فليأتوا بحديث مثله ولو كان مُخْتَلَقًا إن كانوا صادقين في دعواهم أنه اختلقه."},{"ayah":35,"from":35,"to":35,"text":"أم خُلقوا من غير خالق يخلقهم؟! أم هم الخالقون لأنفسهم؟! لا يمكن وجود مخلوق دون خالق، ولا مخلوق يخلق، فلم لا يعبدون خالقهم؟!"},{"ayah":36,"from":36,"to":36,"text":"أم خلقوا السماوات والأرض؟! بل لا يوقنون أن الله هو خالقهم، إذ لو أيقنوا ذلك لوحَّدوه، ولآمنوا برسوله."},{"ayah":37,"from":37,"to":37,"text":"أم عندهم خزائن ربك من الرزق فيمنحوه من يشاؤون، ومن النبوّة فيعطوها ويمنعوها من أرادوا؟! أم هم المُتَسلِّطون المتصرفون حسب مشيئتهم؟!"},{"ayah":38,"from":38,"to":38,"text":"أم لهم مِرْقَاة يرقون بها إلى السماء يستمعون فيها إلى وحي الله يوحيه أنهم على حق؟! فليأت من استمع منهم إلى ذلك الوحي بحجة واضحة تصدقكم فيما تدّعونه من أنكم على حق."},{"ayah":39,"from":39,"to":39,"text":"أم له سبحانه وتعالى البنات التي تكرهونها، ولكم البنون الذين تحبّونهم؟!"},{"ayah":40,"from":40,"to":40,"text":"أم تطلب منهم - أيها الرسول - أجرًا على ما تبلغهم عن ربك؟! فهم بسبب ذلك مكلفون حِملًا لا يقدرون على حمله."},{"ayah":41,"from":41,"to":41,"text":"أم عندهم علم الغيب فهم يكتبون للناس ما يطلعون عليه من الغيوب، فيخبرونهم بما شاؤوا منها؟!"},{"ayah":42,"from":42,"to":42,"text":"أم يريد هؤلاء المكذبون كيدًا بك وبدينك؟! فثقْ بالله، فالذين كفروا بالله وبرسوله هم الممكور بهم، لا أنت."},{"ayah":43,"from":43,"to":43,"text":"أم لهم معبود بحق غير الله؟! تنزه الله وتقدس عما ينسبونه إليه من الشريك. كل ما تقدم لم يكن ولا يتصور بحال."},{"ayah":44,"from":44,"to":44,"text":"وإن يروا قطعًا من السماء ساقطة يقولوا عنه: هذا سحاب متراكم بعضه على بعض كالعادة، فلا يتعظون، ولا يؤمنون."},{"ayah":45,"from":45,"to":45,"text":"فاتركهم - أيها الرسول - في عنادهم وجحودهم حتى يلاقوا يومهم الذي فيه يعذبون، وهو يوم القيامة."},{"ayah":46,"from":46,"to":46,"text":"يوم لا يغني عنهم كيدهم شيئًا قليلًا أو كثيرًا، ولا هم ينصرون بإنقاذهم من العذاب."},{"ayah":47,"from":47,"to":47,"text":"وإن للذين ظلموا أنفسهم بالشرك والمعاصي عذابًا قبل عذاب الآخرة؛ في الدنيا بالقتل والسبي، وفي البَرْزَخ بعذاب القبر، ولكنّ معظمهم لا يعلمون ذلك، فلذلك يقيمون على كفرهم."},{"ayah":48,"from":48,"to":48,"text":"واصبر - أيها الرسول - لقضاء ربك، ولحكمه الشرعي، فإنك بمرأى منا وحفظ، وسبح بحمد ربك حين تقوم من نومك."},{"ayah":49,"from":49,"to":49,"text":"ومن الليل فسبّح ربك، وصلّ له، وصلّ صلاة الفجر حين إدبار النجوم بأفولها بضوء النهار."}]}